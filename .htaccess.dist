# +-------------------------------------------------------------------------+
# | Copyright (C) 2004-2026 The Cacti Group                                 |
# | Copyright (C) 2026 The Kadupul project and contributors                 |
# +-------------------------------------------------------------------------+
# | Optional security-header overlay for Apache deployments.                |
# |                                                                         |
# | Rename to `.htaccess` if you want Apache to apply these headers to      |
# | the PHP entry points AND to the static assets Cacti serves (images,    |
# | JS, CSS, robots.txt). PHP responses already get the full header set    |
# | via CactiSecureHeaders::emitHeaders(); this file covers the static     |
# | files that never touch PHP.                                            |
# |                                                                         |
# | Distros that manage Apache config centrally should put the same        |
# | directives in /etc/httpd/conf.d/cacti.conf instead of enabling this    |
# | file.                                                                   |
# +-------------------------------------------------------------------------+

# The copied file also denies the root paths the interface never serves:
# dotfiles, dot-directories such as .git/, and the dependency manifests.
# /.well-known/ stays reachable for ACME and similar clients. These rules
# live here rather than in a shipped root .htaccess so that upgrades never
# overwrite an operator's copy of this file.

<FilesMatch "^\.|^(composer\.(json|lock)|package(-lock)?\.json|phpunit[^/]*\.xml|mise\.toml)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order Allow,Deny
		Deny from all
	</IfModule>
</FilesMatch>

# Apache 2.4
<IfModule mod_authz_core.c>
	<If "%{REQUEST_URI} =~ m#(^|/)\.(?!well-known(/|$))#">
		Require all denied
	</If>
</IfModule>

# Apache 2.2 has no <If>, so dot-directories need mod_rewrite. The rules are
# not wrapped in <IfModule mod_rewrite.c> on purpose: without the module the
# server answers 500 instead of silently serving .git/.
<IfModule !mod_authz_core.c>
	RewriteEngine On
	RewriteRule (^|/)\.(?!well-known(/|$)) - [F]
</IfModule>

<IfModule mod_headers.c>
	# Applied to every response (including static files).
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"

	# Narrow CSP for static files. PHP responses overwrite this with the
	# richer policy from CactiSecureHeaders.
	<FilesMatch "\.(gif|jpg|jpeg|png|svg|webp|ico|css|js|woff|woff2|ttf|map|txt)$">
		Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self';"
	</FilesMatch>
</IfModule>
