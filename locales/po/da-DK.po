msgstr "Den skrifttype, der bruges til grafoverskrifter.  Angiv enten en gyldig True Type Font-fil eller en gyldig Pango font-config-værdi."

#: include/global_settings.php:1113 include/global_settings.php:2899
msgid "Legend Font Size"
msgstr "Skriftstørrelse for signaturforklaring"

#: include/global_settings.php:1114 include/global_settings.php:2900
