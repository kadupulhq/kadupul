msgstr "Alle strenge, der matcher dette regulære udtryk, udelukkes fra brugerens visning.  <strong>Hvis du f.eks. vil udelukke alle loglinjer, der indeholder ordene 'Admin' eller 'Login', skal du skrive '(Admin || Login)'</strong>"

#: include/global_settings.php
msgid "Real-time Graphs"
msgstr "Realtidsgrafer"

#: include/global_settings.php
msgid "Enable Real-time Graphing"
msgstr "Aktivér realtidsgrafer"

#: include/global_settings.php
msgid "When an option is checked, users will be able to put Kadupul into Real-time mode."
msgstr "Når en indstilling er afkrydset, kan brugere sætte Kadupul i realtidstilstand."

#: include/global_settings.php lib/html_reports.php
msgid "Graph Timespan"
msgstr "Graftidsrum"

#: include/global_settings.php
msgid "The timespan you wish to see on the default graph."
msgstr "Det tidsrum, du vil se på standardgrafen."

#: include/global_settings.php
msgid "Minimum Refresh Interval"
msgstr "Minimalt opdateringsinterval"

#: include/global_settings.php
msgid "This is the minimal supported time between Graph updates.  This value is also used to set certain RRDfile attributes.  If you have a Device that caches data and does not provide realtime updates, you may have to increase the default Minimum Refresh Interval to prevent creating Graphs with gaps."
msgstr "Dette er den mindste understøttede tid mellem grafopdateringer.  Denne værdi bruges også til at sætte visse RRDfil-attributter.  Hvis du har en enhed, der cacher data og ikke leverer realtidsopdateringer, kan du være nødt til at øge standardværdien for minimalt opdateringsinterval for at undgå at oprette grafer med huller."

#: include/global_settings.php
msgid "Cache Directory"
msgstr "Cachemappe"

#: include/global_settings.php
msgid "This is the location, on the web server where the RRDfiles and PNG files will be cached.  This cache will be managed by the poller.  Make sure you have the correct read and write permissions on this folder"
msgstr "Dette er den placering på webserveren, hvor RRDfiler og PNG-filer cachelagres.  Denne cache administreres af polleren.  Sørg for, at du har de rette læse- og skriverettigheder til denne mappe"

#: include/global_settings.php
msgid "RRDtool Graph Options"
msgstr "RRDtool-grafindstillinger"

#: include/global_settings.php
msgid "Custom Watermark"
msgstr "Brugerdefineret vandmærke"

#: include/global_settings.php
msgid "Text placed at the bottom center of every Graph."
msgstr "Tekst placeret nederst i midten af hver graf."

#: include/global_settings.php
msgid "Custom Date Format"
msgstr "Brugerdefineret datoformat"

#: include/global_settings.php
msgid "To be used when formatting |date_time| on a graph"
msgstr "Bruges ved formatering af |date_time| på en graf"

#: include/global_settings.php
msgid "Disable RRDtool Watermark"
msgstr "Deaktivér RRDtool-vandmærke"

#: include/global_settings.php
msgid "Provided your RRDtool version supports it, you may disable RRDtool advertisement on your Graphs by checking this option."
msgstr "Hvis din RRDtool-version understøtter det, kan du deaktivere RRDtool-reklamen på dine grafer ved at afkrydse denne indstilling."

#: include/global_settings.php
msgid "Font Selection Method"
msgstr "Metode til valg af skrifttype"

#: include/global_settings.php
msgid "How do you wish fonts to be handled by default?"
msgstr "Hvordan vil du have skrifttyper håndteret som standard?"

#: include/global_settings.php lib/api_device.php
msgid "System"
msgstr "System"

#: include/global_settings.php
msgid "Default Font"
msgstr "Standardskrifttype"

#: include/global_settings.php
msgid "When not using Theme based font control, the Pango font description to use for all Graphs, such as DejaVu Sans. Optionally, you may leave blank and control font settings on a per object basis."
msgstr "Når temabaseret skrifttypestyring ikke bruges, den Pango-skrifttypebeskrivelse, der skal bruges til alle grafer, f.eks. DejaVu Sans. Du kan eventuelt lade feltet stå tomt og styre skrifttypeindstillinger pr. objekt."

#: include/global_settings.php
msgid "Business Hours Settings"
msgstr "Indstillinger for åbningstider"

#: include/global_settings.php
msgid "Start of Business Day"
msgstr "Arbejdsdagens start"

#: include/global_settings.php
msgid "The time your business hours start. Format: hh:mm"
msgstr "Det tidspunkt, hvor dine åbningstider begynder. Format: tt:mm"

#: include/global_settings.php
msgid "End of Business Day"
msgstr "Arbejdsdagens slutning"

#: include/global_settings.php
msgid "The time your business hours end. Format: hh:mm"
msgstr "Det tidspunkt, hvor dine åbningstider slutter. Format: tt:mm"

#: include/global_settings.php
msgid "Hide Weekends"
msgstr "Skjul weekender"

#: include/global_settings.php
msgid "Only show business hours during weekdays."
msgstr "Vis kun åbningstider på hverdage."

#: include/global_settings.php
msgid "Show business hours"
msgstr "Vis åbningstider"

#: include/global_settings.php
msgid "Display business hours on rrd graphs."
msgstr "Vis åbningstider på rrd-grafer."

#: include/global_settings.php
msgid "Color to use for business hours"
msgstr "Farve til åbningstider"

#: include/global_settings.php
msgid "The color to be shown for business hours"
msgstr "Den farve, der vises for åbningstider"

#: include/global_settings.php
msgid "Maximum number of days to show business hours"
msgstr "Maksimalt antal dage med visning af åbningstider"

#: include/global_settings.php
msgid "After this number of days, the business hours will not be added to the graph. <br/>Recommended: 62 days"
msgstr "Efter dette antal dage tilføjes åbningstiderne ikke til grafen. <br/>Anbefalet: 62 dage"

#: include/global_settings.php
msgid "Data Collection Enabled"
msgstr "Dataindsamling aktiveret"

#: include/global_settings.php
msgid "If you wish to stop the polling process completely, uncheck this box."
msgstr "Hvis du vil stoppe pollingprocessen helt, så fjern afkrydsningen i dette felt."

#: include/global_settings.php
msgid "SNMP Agent Support Enabled"
msgstr "Understøttelse af SNMP-agent aktiveret"

#: include/global_settings.php
msgid "If this option is checked, Kadupul will populate SNMP Agent tables with Kadupul device and system information.  It does not enable the SNMP Agent itself."
msgstr "Hvis denne indstilling er afkrydset, udfylder Kadupul SNMP-agenttabellerne med oplysninger om Kadupul-enheder og -system.  Den aktiverer ikke selve SNMP-agenten."

#: include/global_settings.php
msgid "Poller Type"
msgstr "Pollertype"

#: include/global_settings.php
msgid "The poller type to use.  This setting will take effect at next polling interval."
msgstr "Den pollertype, der skal bruges.  Denne indstilling træder i kraft ved næste pollingsinterval."

#: include/global_settings.php
msgid "Poller Sync Interval"
msgstr "Poller-synkroniseringsinterval"

#: include/global_settings.php
msgid "The default polling sync interval to use when creating a poller.  This setting will affect how often remote pollers are checked and updated."
msgstr "Det standardsynkroniseringsinterval for polling, der skal bruges ved oprettelse af en poller.  Denne indstilling påvirker, hvor ofte fjernpollere kontrolleres og opdateres."

#: include/global_settings.php
msgid "The polling interval in use.  This setting will affect how often RRDfiles are checked and updated.  <strong><u>NOTE: If you change this value, you must re-populate the poller cache.  Failure to do so, may result in lost data.</u></strong>"
msgstr "Det pollingsinterval, der er i brug.  Denne indstilling påvirker, hvor ofte RRDfiler kontrolleres og opdateres.  <strong><u>BEMÆRK: Hvis du ændrer denne værdi, skal du gen-udfylde pollercachen.  Gør du ikke det, kan det medføre tab af data.</u></strong>"

#: include/global_settings.php
msgid "Cron/Daemon Interval"
msgstr "Cron/dæmon-interval"

#: include/global_settings.php
msgid "The frequency that the Kadupul data collector will be started.  You can use either crontab, a scheduled task (for windows), or the cactid systemd service to control launching the Kadupul data collector.  For instructions on using the cactid daemon, review the README.md file in the service directory."
msgstr "Den hyppighed, hvormed Kadupul-dataindsamleren startes.  Du kan bruge enten crontab, en planlagt opgave (til Windows) eller systemd-tjenesten cactid til at styre start af Kadupul-dataindsamleren.  Se filen README.md i mappen service for vejledning i brug af cactid-dæmonen."

#: include/global_settings.php
msgid "Balance Process Load"
msgstr "Afbalancér procesbelastning"

#: include/global_settings.php
msgid "If you choose this option, Kadupul will attempt to balance the load of each poller process by equally distributing poller items per process."
msgstr "Hvis du vælger denne indstilling, forsøger Kadupul at afbalancere belastningen på hver pollerproces ved at fordele pollerelementerne ligeligt mellem processerne."

#: include/global_settings.php
msgid "Debug Output Width"
msgstr "Bredde på debugoutput"

#: include/global_settings.php
msgid "If you choose this option, Kadupul will check for output that exceeds Kadupul's ability to store it and issue a warning when it finds it."
msgstr "Hvis du vælger denne indstilling, kontrollerer Kadupul for output, der overstiger Kadupuls evne til at gemme det, og udsender en advarsel, når det findes."

#: include/global_settings.php
msgid "Disable increasing OID Check"
msgstr "Deaktivér kontrol af stigende OID"

#: include/global_settings.php
msgid "Controls disabling check for increasing OID while walking OID tree."
msgstr "Styrer deaktivering af kontrollen for stigende OID under gennemgang af OID-træet."

#: include/global_settings.php
msgid "Remote Agent Timeout"
msgstr "Timeout for fjernagent"

#: include/global_settings.php
msgid "The amount of time, in seconds, that the Central Kadupul web server will wait for a response from the Remote Data Collector to obtain various Device information before abandoning the request.  On Devices that are associated with Data Collectors other than the Central Kadupul Data Collector, the Remote Agent must be used to gather Device information."
msgstr "Den tid i sekunder, som den centrale Kadupul-webserver venter på svar fra fjerndataindsamleren for at hente forskellige enhedsoplysninger, før forespørgslen opgives.  På enheder, der er knyttet til andre dataindsamlere end den centrale Kadupul-dataindsamler, skal fjernagenten bruges til at indsamle enhedsoplysninger."

#: include/global_settings.php
msgid "SNMP Bulkwalk Fetch Size"
msgstr "Hentestørrelse for SNMP Bulkwalk"

#: include/global_settings.php
msgid "How many OIDs should be returned per snmpbulkwalk request?  For Devices with large SNMP trees, increasing this size will increase re-index performance over a WAN."
msgstr "Hvor mange OID'er skal returneres pr. snmpbulkwalk-forespørgsel?  For enheder med store SNMP-træer øger en større værdi genindekseringsydeevnen over et WAN."

#: include/global_settings.php
msgid "SNMP Get OID Limit"
msgstr "SNMP Get OID-grænse"

#: include/global_settings.php
msgid "The default maximum number of SNMP Get OIDs to issue per snmpget request.  For Devices, this setting is controlled at the Device level.  You should only use this setting when using Kadupul's SNMP API natively in your scripts or plugins."
msgstr "Det standardmaksimale antal SNMP Get-OID'er, der udstedes pr. snmpget-forespørgsel.  For enheder styres denne indstilling på enhedsniveau.  Du bør kun bruge denne indstilling, når du bruger Kadupuls SNMP-API direkte i dine scripts eller plugins."

#: include/global_settings.php
msgid "Rejected Sample Retention"
msgstr "Opbevaring af afviste prøver"

#: include/global_settings.php
msgid "Hours that samples refused by RRDtool, for example after a data source schema change, stay queued for retry before they are moved to the poller_output_rejected table.  Repair the RRDfile, then run cli/replay_rejected_samples.php to process them."
msgstr "Antal timer, som prøver, der afvises af RRDtool, f.eks. efter en ændring af datakildeskemaet, forbliver i kø til genforsøg, før de flyttes til tabellen poller_output_rejected.  Reparer RRDfilen, og kør derefter cli/replay_rejected_samples.php for at behandle dem."

#: include/global_settings.php
msgid "Rejected Sample Limit"
msgstr "Grænse for afviste prøver"

#: include/global_settings.php
msgid "The most refused samples one data source may keep queued.  The oldest samples beyond this limit are moved to the poller_output_rejected table immediately."
msgstr "Det største antal afviste prøver, som én datakilde må have i kø.  De ældste prøver ud over denne grænse flyttes straks til tabellen poller_output_rejected."

#: include/global_settings.php
msgid "Disable Resource Cache Replication"
msgstr "Deaktivér replikering af ressourcecache"

#: include/global_settings.php
msgid "By default, the main Kadupul Data Collector will cache the entire web site and plugins into a Resource Cache.  Then, periodically the Remote Data Collectors will update themselves with any updates from the main Kadupul Data Collector.  This Resource Cache essentially allows Remote Data Collectors to self upgrade.  If you do not wish to use this option, you can disable it using this setting."
msgstr "Som standard cacher den primære Kadupul-dataindsamler hele webstedet og plugins i en ressourcecache.  Derefter opdaterer fjerndataindsamlerne med jævne mellemrum sig selv med eventuelle opdateringer fra den primære Kadupul-dataindsamler.  Denne ressourcecache gør det i bund og grund muligt for fjerndataindsamlere at opgradere sig selv.  Hvis du ikke ønsker at bruge denne funktion, kan du deaktivere den med denne indstilling."

#: include/global_settings.php
msgid "Additional Data Collector Settings"
msgstr "Yderligere indstillinger for dataindsamler"

#: include/global_settings.php
msgid "Invalid Data Logging"
msgstr "Logning af ugyldige data"

#: include/global_settings.php
msgid "How would you like the Data Collector output errors logged?  Options include: 'Detailed' which details every error, 'Summary' which provides the number of output errors per Device, and 'None', which does not provide error counts."
msgstr "Hvordan vil du have dataindsamlerens outputfejl logget?  Mulighederne er: 'Detaljeret', som specificerer hver fejl, 'Oversigt', som angiver antallet af outputfejl pr. enhed, og 'Ingen', som ikke angiver fejlantal."

#: include/global_settings.php utilities.php
msgid "Summary"
msgstr "Oversigt"

#: include/global_settings.php
msgid "Detailed"
msgstr "Detaljeret"

#: include/global_settings.php
msgid "Number of PHP Script Servers"
msgstr "Antal PHP-scriptservere"

#: include/global_settings.php
msgid "The number of concurrent script server processes to run per spine process.  Settings between 1 and 15 are accepted.  This parameter will help if you are running several threads and script server scripts and is only valid for the spine Data Collector."
msgstr "Antallet af samtidige scriptserverprocesser, der køres pr. spine-proces.  Indstillinger mellem 1 og 15 accepteres.  Denne parameter hjælper, hvis du kører flere tråde og scriptserver-scripts, og gælder kun for spine-dataindsamleren."

#: include/global_settings.php
msgid "Script and Script Server Timeout Value"
msgstr "Timeoutværdi for script og scriptserver"

#: include/global_settings.php
msgid "The maximum time that spine will wait on a script to complete.  This timeout value is in seconds and is only valid for the spine Data Collector."
msgstr "Den maksimale tid, spine venter på, at et script bliver færdigt.  Denne timeoutværdi er i sekunder og gælder kun for spine-dataindsamleren."

#: include/global_settings.php
msgid "Periodic All Device Re-Index"
msgstr "Periodisk genindeksering af alle enheder"

#: include/global_settings.php
msgid "Re-Index All Device Schedule"
msgstr "Tidsplan for genindeksering af alle enheder"

#: include/global_settings.php
msgid "At what frequency do you wish to Re-Index all Devices.  This Re-Index will occur at midnight at the frequency that you select."
msgstr "Hvor ofte vil du genindeksere alle enheder?  Denne genindeksering sker ved midnat med den hyppighed, du vælger."

#: include/global_settings.php
msgid "Weekly on Sunday"
msgstr "Ugentligt om søndagen"

#: include/global_settings.php
msgid "Monthly on Sunday"
msgstr "Månedligt om søndagen"

#: include/global_settings.php
msgid "Background Timeout and Concurrent Process Settings"
msgstr "Indstillinger for baggrundstimeout og samtidige processer"

#: include/global_settings.php
msgid "Report Generation Timeout"
msgstr "Timeout for rapportgenerering"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Reports Generation script can run without generating a timeout error and being killed."
msgstr "Den maksimale tid, Kadupuls script til rapportgenerering kan køre, uden at det giver en timeoutfejl og bliver dræbt."

#: include/global_settings.php
#, php-format
msgid "%s Minute"
msgstr "%s minut"

#: include/global_settings.php
msgid "Data Source Statistics Timeout"
msgstr "Timeout for datakildestatistik"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Data Source Statistics script can run without generating a timeout error and being killed."
msgstr "Den maksimale tid, Kadupuls script til datakildestatistik kan køre, uden at det giver en timeoutfejl og bliver dræbt."

#: include/global_settings.php
msgid "RRDChecker Timeout"
msgstr "RRDChecker-timeout"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's RRDfile check script can run without generating a timeout error and being killed."
msgstr "Den maksimale tid, Kadupuls script til kontrol af RRDfiler kan køre, uden at det giver en timeoutfejl og bliver dræbt."

#: include/global_settings.php
#, php-format
msgid "%s Hour"
msgstr "%s time"

#: include/global_settings.php
msgid "Poller Commands Timeout"
msgstr "Timeout for pollerkommandoer"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Background Commands script can run without generating a timeout error and being killed.  This script will perform tasks such as re-indexing Devices and pruning devices from Remote Data Collectors."
msgstr "Den maksimale tid, Kadupuls script til baggrundskommandoer kan køre, uden at det giver en timeoutfejl og bliver dræbt.  Dette script udfører opgaver som genindeksering af enheder og oprydning af enheder fra fjerndataindsamlere."

#: include/global_settings.php
msgid "Poller Command Concurrent Processes"
msgstr "Samtidige processer for pollerkommandoer"

#: include/global_settings.php
msgid "The number of concurrent Poller Command processes.  There will be at most one concurrent command per host within the Poller Command pool."
msgstr "Antallet af samtidige pollerkommandoprocesser.  Der er højst én samtidig kommando pr. vært i pollerkommandopuljen."

#: include/global_settings.php
msgid "1 Process"
msgstr "1 proces"

#: include/global_settings.php
#, php-format
msgid "%d Processes"
msgstr "%d processer"

#: include/global_settings.php
msgid "Maintenance Background Generation Timeout"
msgstr "Timeout for baggrundsgenerering af vedligeholdelse"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Maintenance script can run without generating a timeout error and being killed."
msgstr "Den maksimale tid, Kadupuls vedligeholdelsesscript kan køre, uden at det giver en timeoutfejl og bliver dræbt."

#: include/global_settings.php
msgid "Spikekill Background Generation Timeout"
msgstr "Timeout for baggrundsgenerering af Spikekill"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Spikekill script can run without generating a timeout error and being killed."
msgstr "Den maksimale tid, Kadupuls Spikekill-script kan køre, uden at det giver en timeoutfejl og bliver dræbt."

#: include/global_settings.php
msgid "Data Collector Defaults"
msgstr "Standarder for dataindsamler"

#: include/global_settings.php
msgid "These settings are maintained at the Data Collector level.  The values here are only defaults used when first creating a Data Collector."
msgstr "Disse indstillinger vedligeholdes på dataindsamlerniveau.  Værdierne her er kun standarder, der bruges, når en dataindsamler oprettes første gang."

#: include/global_settings.php
msgid "Data Collector Processes"
msgstr "Dataindsamlerprocesser"

#: include/global_settings.php
msgid "The default number of concurrent processes to execute per Data Collector.  NOTE: Starting from Kadupul 1.2, this setting is maintained in the Data Collector.  Moving forward, this value is only a preset for the Data Collector.  Using a higher number when using cmd.php will improve performance.  Performance improvements in Spine are best resolved with the threads parameter.  When using Spine, we recommend a lower number and leveraging threads instead.  When using cmd.php, use no more than 2x the number of CPU cores."
msgstr "Standardantallet af samtidige processer, der udføres pr. dataindsamler.  BEMÆRK: Fra og med Kadupul 1.2 vedligeholdes denne indstilling i dataindsamleren.  Fremover er denne værdi kun et forvalg for dataindsamleren.  Et højere tal ved brug af cmd.php forbedrer ydeevnen.  Ydeevneforbedringer i Spine løses bedst med trådparameteren.  Ved brug af Spine anbefaler vi et lavere tal og at bruge tråde i stedet.  Ved brug af cmd.php skal du højst bruge 2 gange antallet af CPU-kerner."

#: include/global_settings.php
msgid "Threads per Process"
msgstr "Tråde pr. proces"

#: include/global_settings.php
msgid "The Default Threads allowed per process.  NOTE: Starting in Kadupul 1.2+, this setting is maintained in the Data Collector, and this is simply the Preset.  Using a higher number when using Spine will improve performance.  However, ensure that you have enough MySQL/MariaDB connections to support the following equation: connections = data collectors * processes * (threads + script servers).  You must also ensure that you have enough spare connections for user login connections as well."
msgstr "Standardantallet af tilladte tråde pr. proces.  BEMÆRK: Fra og med Kadupul 1.2+ vedligeholdes denne indstilling i dataindsamleren, og dette er blot forvalget.  Et højere tal ved brug af Spine forbedrer ydeevnen.  Sørg dog for, at du har nok MySQL/MariaDB-forbindelser til at understøtte følgende ligning: forbindelser = dataindsamlere * processer * (tråde + scriptservere).  Du skal også sikre, at du har nok ledige forbindelser til brugernes loginforbindelser."

#: include/global_settings.php
msgid "Authentication Method"
msgstr "Godkendelsesmetode"

#: include/global_settings.php
msgid "<blockquote><i>Built-in Authentication</i> - Kadupul handles user authentication, which allows you to create users and give them rights to different areas within Kadupul.<br><br><i>Web Basic Authentication</i> - Authentication is handled by the web server. Users can be added or created automatically on first login if the Template User is defined, otherwise the defined guest permissions will be used.<br><br><i>LDAP Authentication</i> - Allows for authentication against an LDAP server. Users will be created automatically on first login if the Template User is defined, otherwise the defined guest permissions will be used.  If PHP's LDAP module is not enabled, LDAP Authentication will not appear as a selectable option.<br><br><i>Multiple LDAP/AD Domain Authentication</i> - Allows administrators to support multiple disparate groups from different LDAP/AD directories to access Kadupul resources.  Just as LDAP Authentication, the PHP LDAP module is required to utilize this method.</blockquote>"
msgstr "<blockquote><i>Indbygget godkendelse</i> - Kadupul håndterer brugergodkendelsen, så du kan oprette brugere og give dem rettigheder til forskellige områder i Kadupul.<br><br><i>Web Basic-godkendelse</i> - Godkendelsen håndteres af webserveren. Brugere kan tilføjes eller oprettes automatisk ved første login, hvis skabelonbrugeren er defineret; ellers bruges de definerede gæsterettigheder.<br><br><i>LDAP-godkendelse</i> - Giver mulighed for godkendelse mod en LDAP-server. Brugere oprettes automatisk ved første login, hvis skabelonbrugeren er defineret; ellers bruges de definerede gæsterettigheder.  Hvis PHP's LDAP-modul ikke er aktiveret, vises LDAP-godkendelse ikke som en valgbar mulighed.<br><br><i>Godkendelse mod flere LDAP/AD-domæner</i> - Giver administratorer mulighed for at understøtte flere forskellige grupper fra forskellige LDAP/AD-kataloger med adgang til Kadupul-ressourcer.  Ligesom ved LDAP-godkendelse kræves PHP's LDAP-modul for at bruge denne metode.</blockquote>"

#: include/global_settings.php
msgid "Support Authentication Cookies"
msgstr "Understøt godkendelsescookies"

#: include/global_settings.php
msgid "If a user authenticates and selects 'Keep me signed in', an authentication cookie will be created on the user's computer allowing that user to stay logged in.  The authentication cookie expires after 90 days of non-use."
msgstr "Hvis en bruger godkendes og vælger 'Hold mig logget ind', oprettes en godkendelsescookie på brugerens computer, så brugeren forbliver logget ind.  Godkendelsescookien udløber efter 90 dages inaktivitet."

#: include/global_settings.php
msgid "Special Users"
msgstr "Særlige brugere"

#: include/global_settings.php
msgid "Primary Admin"
msgstr "Primær administrator"

#: include/global_settings.php
msgid "The name of the primary administrative account that will automatically receive Emails when the Kadupul system experiences issues.  To receive these Emails, ensure that your mail settings are correct, and the administrative account has an Email address that is set."
msgstr "Navnet på den primære administrative konto, der automatisk modtager e-mails, når Kadupul-systemet har problemer.  For at modtage disse e-mails skal du sikre, at dine mailindstillinger er korrekte, og at den administrative konto har en e-mailadresse."

#: include/global_settings.php user_domains.php
msgid "No User"
msgstr "Ingen bruger"

#: include/global_settings.php
msgid "Guest User"
msgstr "Gæstebruger"

#: include/global_settings.php
msgid "The name of the guest user for viewing graphs; is 'No User' by default."
msgstr "Navnet på gæstebrugeren til visning af grafer; er som standard 'Ingen bruger'."

#: include/global_settings.php user_domains.php
msgid "User Template"
msgstr "Brugerskabelon"

#: include/global_settings.php
msgid "The name of the user that Kadupul will use as a template for new Web Basic and LDAP users; is 'guest' by default.  This user account will be disabled from logging in upon being selected."
msgstr "Navnet på den bruger, som Kadupul bruger som skabelon for nye Web Basic- og LDAP-brugere; er som standard 'guest'.  Denne brugerkonto kan ikke logge ind, når den er valgt."

#: include/global_settings.php
msgid "Basic Authentication Settings"
msgstr "Indstillinger for Basic-godkendelse"

#: include/global_settings.php
msgid "Basic Auth Login Failure Message"
msgstr "Fejlmeddelelse ved Basic Auth-login"

#: include/global_settings.php
msgid "When using basic authentication, if there are issues mapping the username to a valid Kadupul account, the message included here will be displayed to users.  It can include both text and HTML."
msgstr "Ved brug af basic-godkendelse vises den meddelelse, der er angivet her, for brugerne, hvis der er problemer med at knytte brugernavnet til en gyldig Kadupul-konto.  Den kan indeholde både tekst og HTML."

#: include/global_settings.php
msgid "Basic Auth Mapfile"
msgstr "Basic Auth-mapfil"

#: include/global_settings.php
msgid "When using basic authentication, if the basic account needs to be translated to a different login account, you can specify a CSV file here to map the basic account to the desired login account."
msgstr "Ved brug af basic-godkendelse kan du angive en CSV-fil her, der knytter basic-kontoen til den ønskede loginkonto, hvis basic-kontoen skal oversættes til en anden loginkonto."

#: include/global_settings.php
msgid "Local Account Complexity Requirements"
msgstr "Kompleksitetskrav til lokale konti"

#: include/global_settings.php
msgid "Minimum Length"
msgstr "Minimumslængde"

#: include/global_settings.php
msgid "This is the minimal length of allowed passwords."
msgstr "Dette er den mindste længde på tilladte adgangskoder."

#: include/global_settings.php
msgid "Require Mix Case"
msgstr "Kræv blandede store og små bogstaver"

#: include/global_settings.php
msgid "This will require new passwords to contain both lower and upper-case characters."
msgstr "Dette kræver, at nye adgangskoder indeholder både små og store bogstaver."

#: include/global_settings.php
msgid "Require Number"
msgstr "Kræv tal"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 numerical character."
msgstr "Dette kræver, at nye adgangskoder indeholder mindst 1 numerisk tegn."

#: include/global_settings.php
msgid "Require Special Character"
msgstr "Kræv specialtegn"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 special character."
msgstr "Dette kræver, at nye adgangskoder indeholder mindst 1 specialtegn."

#: include/global_settings.php
msgid "Force Complexity Upon Old Passwords"
msgstr "Gennemtving kompleksitet på gamle adgangskoder"

#: include/global_settings.php
msgid "This will require all old passwords to also meet the new complexity requirements upon login.  If not met, it will force a password change."
msgstr "Dette kræver, at alle gamle adgangskoder også opfylder de nye kompleksitetskrav ved login.  Hvis de ikke gør det, tvinges der et skift af adgangskode."

#: include/global_settings.php
msgid "Expire Inactive Accounts"
msgstr "Lad inaktive konti udløbe"

#: include/global_settings.php
msgid "This is the maximum number of days before inactive accounts are disabled.  The Admin account is excluded from this policy."
msgstr "Dette er det maksimale antal dage, før inaktive konti deaktiveres.  Administratorkontoen er undtaget fra denne politik."

#: include/global_settings.php
msgid "Expire Password"
msgstr "Adgangskodeudløb"

#: include/global_settings.php
msgid "This is the maximum number of days before a password is set to expire."
msgstr "Dette er det maksimale antal dage, før en adgangskode udløber."

#: include/global_settings.php
msgid "Password History"
msgstr "Adgangskodehistorik"

#: include/global_settings.php
msgid "Remember this number of old passwords and disallow reusing them."
msgstr "Husk dette antal gamle adgangskoder, og forbyd genbrug af dem."

#: include/global_settings.php
msgid "1 Change"
msgstr "1 ændring"

#: include/global_settings.php
#, php-format
msgid "%d Changes"
msgstr "%d ændringer"

#: include/global_settings.php
msgid "Account Locking"
msgstr "Kontolåsning"

#: include/global_settings.php
msgid "Lock Accounts"
msgstr "Lås konti"

#: include/global_settings.php
msgid "Lock an account after this many failed attempts in 1 hour."
msgstr "Lås en konto efter dette antal mislykkede forsøg på 1 time."

#: include/global_settings.php
msgid "1 Attempt"
msgstr "1 forsøg"

#: include/global_settings.php
#, php-format
msgid "%d Attempts"
msgstr "%d forsøg"

#: include/global_settings.php
msgid "Auto Unlock"
msgstr "Automatisk oplåsning"

#: include/global_settings.php
msgid "An account will automatically be unlocked after this many minutes.  Even if the correct password is entered, the account will not unlock until this time limit has been met.  Max of 1440 minutes (1 Day)"
msgstr "En konto låses automatisk op efter dette antal minutter.  Selv om den korrekte adgangskode indtastes, låses kontoen ikke op, før denne tidsgrænse er nået.  Maks. 1440 minutter (1 dag)"

#: include/global_settings.php
msgid "1 Day"
msgstr "1 dag"

#: include/global_settings.php
msgid "LDAP General Settings"
msgstr "Generelle LDAP-indstillinger"

#: include/global_settings.php user_domains.php
msgid "Server(s)"
msgstr "Server(e)"

#: include/global_settings.php user_domains.php
msgid "A space delimited list of DNS hostnames or IP addresses for valid LDAP servers.  Kadupul will attempt to use the LDAP servers from left to right to authenticate a user."
msgstr "En mellemrumsseparereret liste over DNS-værtsnavne eller IP-adresser til gyldige LDAP-servere.  Kadupul forsøger at bruge LDAP-serverne fra venstre mod højre til at godkende en bruger."

#: include/global_settings.php user_domains.php
msgid "Port Standard"
msgstr "Standardport"

#: include/global_settings.php
msgid "TCP port for Non-SSL communications including LDAP + TLS.  Default is 389."
msgstr "TCP-port til kommunikation uden SSL, herunder LDAP + TLS.  Standard er 389."

#: include/global_settings.php user_domains.php
msgid "Port SSL"
msgstr "SSL-port"

#: include/global_settings.php
msgid "TCP port for LDAPS for SSL communications.  Default is 636."
msgstr "TCP-port til LDAPS til SSL-kommunikation.  Standard er 636."

#: include/global_settings.php user_domains.php
msgid "Protocol Version"
msgstr "Protokolversion"

#: include/global_settings.php
msgid "Protocol Version to connect to the server with."
msgstr "Den protokolversion, der skal bruges til at oprette forbindelse til serveren."

#: include/global_settings.php
msgid "Connect Timeout"
msgstr "Forbindelsestimeout"

#: include/global_settings.php
msgid "The Network Connect Timeout in seconds."
msgstr "Netværksforbindelsestimeout i sekunder."

#: include/global_settings.php
msgid "Bind Timeout"
msgstr "Bind-timeout"

#: include/global_settings.php
msgid "The Bind Timeout in seconds."
msgstr "Bind-timeout i sekunder."

#: include/global_settings.php
msgid "LDAP Debug Mode"
msgstr "LDAP-debugtilstand"

#: include/global_settings.php
msgid "If Checked Kadupul will log extra LDAP information to the Kadupul log during Binding and Searching activities."
msgstr "Hvis afkrydset, logger Kadupul ekstra LDAP-oplysninger i Kadupul-loggen under bind- og søgeaktiviteter."

#: include/global_settings.php user_domains.php
msgid "Encryption"
msgstr "Kryptering"

#: include/global_settings.php
msgid "Encryption that the server supports. NOTE: When using LDAP + TLS you must use version 3."
msgstr "Den kryptering, serveren understøtter. BEMÆRK: Ved brug af LDAP + TLS skal du bruge version 3."

#: include/global_settings.php
msgid "TLS Certificate Requirements"
msgstr "Krav til TLS-certifikater"

#: include/global_settings.php
msgid "Should LDAP verify TLS Certificates when received by the Client.  Demand and Hard refuse a server whose certificate does not verify.  Never and Allow skip that check, so anyone on the network path can pose as the directory and read the passwords sent to it."
msgstr "Skal LDAP verificere TLS-certifikater, når klienten modtager dem.  Demand og Hard afviser en server, hvis certifikat ikke kan verificeres.  Never og Allow springer den kontrol over, så alle på netværksstien kan udgive sig for at være kataloget og læse de adgangskoder, der sendes til det."

#: include/global_settings.php user_domains.php
msgid "Referrals"
msgstr "Referencer"

#: include/global_settings.php user_domains.php
msgid "Enable or Disable LDAP referrals.  If disabled, it may increase the speed of searches."
msgstr "Aktivér eller deaktivér LDAP-referrals.  Hvis de er deaktiveret, kan det øge søgehastigheden."

#: include/global_settings.php user_domains.php
msgid "Mode"
msgstr "Tilstand"

#: include/global_settings.php user_domains.php
msgid "Mode which cacti will attempt to authenticate against the LDAP server.<blockquote><i>No Searching</i> - No Distinguished Name (DN) searching occurs, just attempt to bind with the provided Distinguished Name (DN) format.<br><br><i>Anonymous Searching</i> - Attempts to search for username against LDAP directory via anonymous binding to locate the user's Distinguished Name (DN).<br><br><i>Specific Searching</i> - Attempts to search for username against LDAP directory via Specific Distinguished Name (DN) and Specific Password for binding to locate the user's Distinguished Name (DN)."
msgstr "Den tilstand, hvormed Kadupul forsøger at godkende mod LDAP-serveren.<blockquote><i>Ingen søgning</i> - Der sker ingen søgning efter Distinguished Name (DN); der forsøges blot at binde med det angivne Distinguished Name (DN)-format.<br><br><i>Anonym søgning</i> - Forsøger at søge efter brugernavnet i LDAP-kataloget via anonym binding for at finde brugerens Distinguished Name (DN).<br><br><i>Specifik søgning</i> - Forsøger at søge efter brugernavnet i LDAP-kataloget via et specifikt Distinguished Name (DN) og en specifik adgangskode til binding for at finde brugerens Distinguished Name (DN)."

#: include/global_settings.php user_domains.php
msgid "Distinguished Name (DN)"
msgstr "Distinguished Name (DN)"

#: include/global_settings.php user_domains.php
msgid "The \"Distinguished Name\" syntax, applicable for both OpenLDAP and Windows AD configurations, offers flexibility in defining user identity. For OpenLDAP, the format follows this structure: <i>\"uid=&lt;username&gt;,ou=people,dc=domain,dc=local\"</i>. Windows AD provides an alternative syntax: <i>\"&lt;username&gt;@win2kdomain.local\"</i>, commonly known as \"userPrincipalName (UPN)\". In this context, \"&lt;username&gt;\" represents the specific username provided during the login prompt. This is particularly pertinent when operating in \"No Searching\" mode, or \"Require Group Membership\" enabled."
msgstr "Syntaksen \"Distinguished Name\", der gælder for både OpenLDAP- og Windows AD-konfigurationer, giver fleksibilitet ved definition af brugeridentitet. For OpenLDAP følger formatet denne struktur: <i>\"uid=&lt;username&gt;,ou=people,dc=domain,dc=local\"</i>. Windows AD tilbyder en alternativ syntaks: <i>\"&lt;username&gt;@win2kdomain.local\"</i>, almindeligvis kendt som \"userPrincipalName (UPN)\". I denne sammenhæng repræsenterer \"&lt;username&gt;\" det specifikke brugernavn, der angives ved loginprompten. Dette er især relevant, når der arbejdes i tilstanden \"Ingen søgning\" eller med \"Kræv gruppemedlemskab\" aktiveret."

#: include/global_settings.php user_domains.php
msgid "Require Group Membership"
msgstr "Kræv gruppemedlemskab"

#: include/global_settings.php user_domains.php
msgid "Require user to be member of group to authenticate. Group settings must be set for this to work, enabling without proper group settings will cause authentication failure."
msgstr "Kræv, at brugeren er medlem af gruppen for at blive godkendt. Gruppeindstillinger skal være angivet, for at dette virker; hvis det aktiveres uden korrekte gruppeindstillinger, mislykkes godkendelsen."

#: include/global_settings.php user_domains.php
msgid "LDAP Group Settings"
msgstr "LDAP-gruppeindstillinger"

#: include/global_settings.php user_domains.php
msgid "Group Distinguished Name (DN)"
msgstr "Gruppens Distinguished Name (DN)"

#: include/global_settings.php user_domains.php
msgid "Distinguished Name of the group that user must have membership."
msgstr "Distinguished Name for den gruppe, som brugeren skal være medlem af."

#: include/global_settings.php user_domains.php
msgid "Group Member Attribute"
msgstr "Gruppemedlemsattribut"

#: include/global_settings.php user_domains.php
msgid "This refers to the specific attribute within the LDAP directory that holds the usernames of group members. It is crucial to ensure that the attribute value aligns with the configuration specified in the \"Distinguished Name\" or that the actual attribute value is searchable using the settings outlined in the \"Distinguished Name\"."
msgstr "Dette henviser til den specifikke attribut i LDAP-kataloget, der indeholder gruppemedlemmernes brugernavne. Det er afgørende at sikre, at attributværdien stemmer overens med den konfiguration, der er angivet i \"Distinguished Name\", eller at den faktiske attributværdi kan søges frem med de indstillinger, der er beskrevet i \"Distinguished Name\"."

#: include/global_settings.php user_domains.php
msgid "Group Member Type"
msgstr "Gruppemedlemstype"

#: include/global_settings.php user_domains.php
msgid "Defines if users use full Distinguished Name or just Username in the defined Group Member Attribute."
msgstr "Definerer, om brugere bruger fuldt Distinguished Name eller blot brugernavn i den definerede gruppemedlemsattribut."

#: include/global_settings.php
msgid "Distinguished Name"
msgstr "Distinguished Name"

#: include/global_settings.php user_domains.php
msgid "LDAP Specific Search Settings"
msgstr "Specifikke LDAP-søgeindstillinger"

#: include/global_settings.php user_domains.php
msgid "Search Base"
msgstr "Søgebase"

#: include/global_settings.php
msgid "Search base for searching the LDAP directory, such as <i>'dc=win2kdomain,dc=local'</i> or <i>'ou=people,dc=domain,dc=local'</i>."
msgstr "Søgebase til søgning i LDAP-kataloget, f.eks. <i>'dc=win2kdomain,dc=local'</i> eller <i>'ou=people,dc=domain,dc=local'</i>."

#: include/global_settings.php user_domains.php
msgid "Search Filter"
msgstr "Søgefilter"

#: include/global_settings.php
msgid "Search filter to use to locate the user in the LDAP directory, such as for windows: <i>'(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))'</i> or for OpenLDAP: <i>'(&(objectClass=account)(uid=&lt;username&gt))'</i>.  '&lt;username&gt' is replaced with the username that was supplied at the login prompt. "
msgstr "Søgefilter, der bruges til at finde brugeren i LDAP-kataloget, f.eks. til Windows: <i>'(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))'</i> eller til OpenLDAP: <i>'(&(objectClass=account)(uid=&lt;username&gt))'</i>.  '&lt;username&gt' erstattes med det brugernavn, der blev angivet ved loginprompten. "

#: include/global_settings.php user_domains.php
msgid "Search Distinguished Name (DN)"
msgstr "Søge-Distinguished Name (DN)"

#: include/global_settings.php user_domains.php
msgid "Distinguished Name for Specific Searching binding to the LDAP directory."
msgstr "Distinguished Name til binding til LDAP-kataloget ved specifik søgning."

#: include/global_settings.php user_domains.php
msgid "Search Password"
msgstr "Søgeadgangskode"

#: include/global_settings.php user_domains.php
msgid "Password for Specific Searching binding to the LDAP directory."
msgstr "Adgangskode til binding til LDAP-kataloget ved specifik søgning."

#: include/global_settings.php user_domains.php
msgid "LDAP CN Settings"
msgstr "LDAP CN-indstillinger"

#: include/global_settings.php user_domains.php
msgid "Field that will replace the Full Name when creating a new user, taken from LDAP. (on windows: displayname) "
msgstr "Felt, der erstatter det fulde navn, når der oprettes en ny bruger, hentet fra LDAP. (på Windows: displayname) "

#: include/global_settings.php package_import.php
msgid "Email"
msgstr "E-mail"

#: include/global_settings.php
msgid "Field that will replace the Email taken from LDAP. (on windows: mail)"
msgstr "Felt, der erstatter e-mailadressen hentet fra LDAP. (på Windows: mail)"

#: include/global_settings.php
msgid "URL Linking"
msgstr "URL-linking"

#: include/global_settings.php
msgid "Server Base URL"
msgstr "Serverens base-URL"

#: include/global_settings.php
msgid "This is the server location that will be used for links to the Kadupul site. This should include the subdirectory if Kadupul does not run from root folder."
msgstr "Dette er den serverplacering, der bruges til links til Kadupul-webstedet. Den skal inkludere undermappen, hvis Kadupul ikke kører fra rodmappen."

#: include/global_settings.php
msgid "Emailing Options"
msgstr "E-mailindstillinger"

#: include/global_settings.php
msgid "Notify Primary Admin of Issues"
msgstr "Underret primær administrator om problemer"

#: include/global_settings.php
msgid "In cases where the Kadupul server is experiencing problems, should the Primary Administrator be notified by Email?  The Primary Administrator's Kadupul user account is specified under the Authentication tab on Kadupul's settings page. It defaults to the 'admin' account."
msgstr "Skal den primære administrator underrettes via e-mail, når Kadupul-serveren har problemer?  Den primære administrators Kadupul-brugerkonto angives under fanen Godkendelse på Kadupuls indstillingsside. Den er som standard kontoen 'admin'."

#: include/global_settings.php
msgid "Test Email"
msgstr "Test-e-mail"

#: include/global_settings.php
msgid "This is an Email account used for sending a test message to ensure everything is working properly."
msgstr "Dette er en e-mailkonto, der bruges til at sende en testmeddelelse for at sikre, at alt fungerer korrekt."

#: include/global_settings.php
msgid "Mail Services"
msgstr "Mailtjenester"

#: include/global_settings.php
msgid "Which mail service to use in order to send mail"
msgstr "Hvilken mailtjeneste der skal bruges til at sende mail"

#: include/global_settings.php
msgid "Ping Mail Server"
msgstr "Ping mailserver"

#: include/global_settings.php
msgid "Ping the Mail Server before sending test Email?"
msgstr "Ping mailserveren, før test-e-mailen sendes?"

#: include/global_settings.php lib/html_reports.php
msgid "From Email Address"
msgstr "Afsender-e-mailadresse"

#: include/global_settings.php
msgid "This is the Email address that the Email will appear from."
msgstr "Dette er den e-mailadresse, som e-mailen vises som sendt fra."

#: include/global_settings.php lib/html_reports.php
msgid "From Name"
msgstr "Afsendernavn"

#: include/global_settings.php
msgid "This is the actual name that the Email will appear from."
msgstr "Dette er det faktiske navn, som e-mailen vises som sendt fra."

#: include/global_settings.php
msgid "Word Wrap"
msgstr "Ombrydning af ord"

#: include/global_settings.php
msgid "This is how many characters will be allowed before a line in the Email is automatically word wrapped. (0 = Disabled)"
msgstr "Dette er, hvor mange tegn der tillades, før en linje i e-mailen automatisk ombrydes. (0 = deaktiveret)"

#: include/global_settings.php
msgid "Sendmail Options"
msgstr "Sendmail-indstillinger"

#: include/global_settings.php lib/functions.php
msgid "Sendmail Path"
msgstr "Sendmail-sti"

#: include/global_settings.php
msgid "This is the path to sendmail on your server. (Only used if Sendmail is selected as the Mail Service)"
msgstr "Dette er stien til sendmail på din server. (Bruges kun, hvis Sendmail er valgt som mailtjeneste)"

#: include/global_settings.php
msgid "SMTP Options"
msgstr "SMTP-indstillinger"

#: include/global_settings.php
msgid "SMTP Hostname"
msgstr "SMTP-værtsnavn"

#: include/global_settings.php
msgid "This is the hostname/IP of the SMTP Server you will send the Email to. For failover, separate your hosts using a semi-colon."
msgstr "Dette er værtsnavnet/IP-adressen på den SMTP-server, du sender e-mailen til. Ved failover skal du adskille dine værter med semikolon."

#: include/global_settings.php
msgid "SMTP Port"
msgstr "SMTP-port"

#: include/global_settings.php
msgid "The port on the SMTP Server to use."
msgstr "Den port på SMTP-serveren, der skal bruges."

#: include/global_settings.php
msgid "SMTP Username"
msgstr "SMTP-brugernavn"

#: include/global_settings.php
msgid "The username to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr "Det brugernavn, der skal godkendes med ved afsendelse via SMTP. (Lad feltet stå tomt, hvis du ikke kræver godkendelse.)"

#: include/global_settings.php
msgid "SMTP Password"
msgstr "SMTP-adgangskode"

#: include/global_settings.php
msgid "The password to authenticate with when sending via SMTP. (Leave blank if you do not require authentication.)"
msgstr "Den adgangskode, der skal godkendes med ved afsendelse via SMTP. (Lad feltet stå tomt, hvis du ikke kræver godkendelse.)"

#: include/global_settings.php
msgid "SMTP Security"
msgstr "SMTP-sikkerhed"

#: include/global_settings.php
msgid "The encryption method to use for the Email."
msgstr "Den krypteringsmetode, der skal bruges til e-mailen."

#: include/global_settings.php
msgid "SSL"
msgstr "SSL"

#: include/global_settings.php
msgid "TLS"
msgstr "TLS"

#: include/global_settings.php
msgid "SMTP Timeout"
msgstr "SMTP-timeout"

#: include/global_settings.php
msgid "Please enter the SMTP timeout in seconds."
msgstr "Angiv SMTP-timeout i sekunder."

#: include/global_settings.php
msgid "Reporting Presets"
msgstr "Forvalg for rapportering"

#: include/global_settings.php
msgid "Default Graph Image Format"
msgstr "Standardbilledformat for grafer"

#: include/global_settings.php
msgid "When creating a new report, what image type should be used for the inline graphs?"
msgstr "Hvilken billedtype skal bruges til de indlejrede grafer, når der oprettes en ny rapport?"

#: include/global_settings.php
msgid "Maximum Email Size"
msgstr "Maksimal e-mailstørrelse"

#: include/global_settings.php
msgid "The maximum size of the Email message including all attachments."
msgstr "Den maksimale størrelse af e-mailmeddelelsen inklusive alle vedhæftede filer."

#: include/global_settings.php
msgid "Poller Logging Level for Kadupul Reporting"
msgstr "Pollerlogniveau for Kadupul-rapportering"

#: include/global_settings.php
msgid "What level of detail do you want sent to the log file? WARNING: Leaving in any other status than NONE or LOW can exhaust your disk space rapidly."
msgstr "Hvilket detaljeringsniveau vil du have sendt til logfilen? ADVARSEL: Hvis du lader andre status end NONE eller LOW stå, kan det hurtigt opbruge din diskplads."

#: include/global_settings.php
msgid "Enable Lotus Notes (R) tweak"
msgstr "Aktivér Lotus Notes (R)-tilpasning"

#: include/global_settings.php
msgid "Enable code tweak for specific handling of Lotus Notes Mail Clients."
msgstr "Aktivér kodetilpasning til specifik håndtering af Lotus Notes-mailklienter."

#: include/global_settings.php
msgid "DNS Options"
msgstr "DNS-indstillinger"

#: include/global_settings.php
msgid "Primary DNS IP Address"
msgstr "Primær DNS-IP-adresse"

#: include/global_settings.php
msgid "Enter the primary DNS IP Address to utilize for reverse lookups."
msgstr "Angiv den primære DNS-IP-adresse, der skal bruges til omvendte opslag."

#: include/global_settings.php
msgid "Secondary DNS IP Address"
msgstr "Sekundær DNS-IP-adresse"

#: include/global_settings.php
msgid "Enter the secondary DNS IP Address to utilize for reverse lookups."
msgstr "Angiv den sekundære DNS-IP-adresse, der skal bruges til omvendte opslag."

#: include/global_settings.php
msgid "DNS Timeout"
msgstr "DNS-timeout"

#: include/global_settings.php
msgid "Please enter the DNS timeout in milliseconds.  Kadupul uses a PHP based DNS resolver."
msgstr "Angiv DNS-timeout i millisekunder.  Kadupul bruger en PHP-baseret DNS-resolver."

#: include/global_settings.php
msgid "On-demand RRD Update Settings"
msgstr "Indstillinger for RRD-opdatering efter behov"

#: include/global_settings.php
msgid "Enable On-demand RRD Updating"
msgstr "Aktivér RRD-opdatering efter behov"

#: include/global_settings.php
msgid "Should Boost enable on demand RRD updating in Kadupul?  If you disable, this change will not take effect until after the next polling cycle.  When you have Remote Data Collectors, this setting is required to be on."
msgstr "Skal Boost aktivere RRD-opdatering efter behov i Kadupul?  Hvis du deaktiverer det, træder ændringen først i kraft efter næste pollingscyklus.  Når du har fjerndataindsamlere, skal denne indstilling være slået til."

#: include/global_settings.php
msgid "System Level RRD Updater"
msgstr "RRD-opdatering på systemniveau"

#: include/global_settings.php
msgid "Before RRD On-demand Update Can be Cleared, a poller run must always pass"
msgstr "Før RRD-opdatering efter behov kan ryddes, skal en pollerkørsel altid være gennemført"

#: include/global_settings.php
msgid "How Often Should Boost Update All RRDs"
msgstr "Hvor ofte skal Boost opdatere alle RRD'er"

#: include/global_settings.php
msgid "When you enable boost, your RRD files are only updated when they are requested by a user, or when this time period elapses."
msgstr "Når du aktiverer boost, opdateres dine RRD-filer kun, når en bruger anmoder om dem, eller når denne tidsperiode er gået."

#: include/global_settings.php
msgid "Number of Boost Processes"
msgstr "Antal Boost-processer"

#: include/global_settings.php
msgid "The number of concurrent boost processes to use to process all of the RRDs in the boost table."
msgstr "Antallet af samtidige boost-processer, der skal bruges til at behandle alle RRD'erne i boost-tabellen."

#: include/global_settings.php
msgid "Boost Processing Mode"
msgstr "Boost-behandlingstilstand"

#: include/global_settings.php
msgid "How Boost distributes RRD updates. Forked processes start the number of Boost processes above on every run. Message queue workers hand each partition to Messenger workers instead."
msgstr "Hvordan Boost fordeler RRD-opdateringer. Forkede processer starter ovenstående antal Boost-processer ved hver kørsel. Meddelelseskø-workere afleverer i stedet hver partition til Messenger-workere."

#: include/global_settings.php
msgid "Forked processes"
msgstr "Forkede processer"

#: include/global_settings.php
msgid "Message queue workers"
msgstr "Meddelelseskø-workere"

#: include/global_settings.php
msgid "Maximum Records"
msgstr "Maksimalt antal poster"

#: include/global_settings.php
msgid "If the boost output table exceeds this size, in records, an update will take place."
msgstr "Hvis boost-outputtabellen overstiger denne størrelse i poster, udføres en opdatering."

#: include/global_settings.php
msgid "Maximum Data Source Items Per Pass"
msgstr "Maksimalt antal datakildeelementer pr. gennemløb"

#: include/global_settings.php
msgid "To optimize performance, the boost RRD updater needs to know how many Data Source Items should be retrieved in one pass.  Please be careful not to set too high as graphing performance during major updates can be compromised.  If you encounter graphing or polling slowness during updates, lower this number.  The default value is 50000."
msgstr "For at optimere ydeevnen skal boost-RRD-opdateren vide, hvor mange datakildeelementer der skal hentes i ét gennemløb.  Pas på ikke at sætte den for højt, da grafydeevnen under større opdateringer kan forringes.  Hvis du oplever langsom grafgenerering eller polling under opdateringer, så sænk dette tal.  Standardværdien er 50000."

#: include/global_settings.php
msgid "Maximum Argument Length"
msgstr "Maksimal argumentlængde"

#: include/global_settings.php
msgid "When boost sends update commands to RRDtool, it must not exceed the operating system's Maximum Argument Length.  This varies by operating system and kernel level.  For example: Windows 2000 <= 2048, FreeBSD <= 65535, Linux 2.6.22-- <= 131072, Linux 2.6.23++ unlimited"
msgstr "Når boost sender opdateringskommandoer til RRDtool, må den ikke overstige operativsystemets maksimale argumentlængde.  Denne varierer efter operativsystem og kerneniveau.  For eksempel: Windows 2000 <= 2048, FreeBSD <= 65535, Linux 2.6.22-- <= 131072, Linux 2.6.23++ ubegrænset"

#: include/global_settings.php
msgid "Memory Limit for Boost and Poller"
msgstr "Hukommelsesgrænse for Boost og poller"

#: include/global_settings.php
msgid "The maximum amount of memory for the Kadupul Poller and Boosts Poller"
msgstr "Den maksimale mængde hukommelse til Kadupul-polleren og Boost-polleren"

#: include/global_settings.php
msgid "Maximum RRD Update Script Run Time"
msgstr "Maksimal køretid for RRD-opdateringsscript"

#: include/global_settings.php
msgid "If the boost poller exceeds this runtime, a warning will be placed in the cacti log."
msgstr "Hvis boost-polleren overstiger denne køretid, placeres en advarsel i cacti-loggen."

#: include/global_settings.php
msgid "Enable direct population of poller_output_boost table"
msgstr "Aktivér direkte udfyldning af tabellen poller_output_boost"

#: include/global_settings.php
msgid "Enables direct insert of records into poller output boost which results in a 25% time reduction in each poll cycle."
msgstr "Aktiverer direkte indsættelse af poster i poller output boost, hvilket giver en tidsreduktion på 25 % i hver pollingscyklus."

#: include/global_settings.php
msgid "Boost Debug Log"
msgstr "Boost-debuglog"

#: include/global_settings.php
msgid "If this field is non-blank, Boost will log RRDUpdate output from the boost poller process."
msgstr "Hvis dette felt ikke er tomt, logger Boost RRDUpdate-output fra boost-pollerprocessen."

#: include/global_settings.php utilities.php
msgid "Image Caching"
msgstr "Billedcaching"

#: include/global_settings.php
msgid "Enable Image Caching"
msgstr "Aktivér billedcaching"

#: include/global_settings.php
msgid "Should image caching be enabled?"
msgstr "Skal billedcaching være aktiveret?"

#: include/global_settings.php
msgid "Location for Image Files"
msgstr "Placering af billedfiler"

#: include/global_settings.php
msgid "Specify the location where Boost should place your image files.  These files will be automatically purged by the poller when they expire."
msgstr "Angiv den placering, hvor Boost skal placere dine billedfiler.  Disse filer ryddes automatisk af polleren, når de udløber."

#: include/global_settings.php
msgid "Data Sources Statistics"
msgstr "Datakildestatistik"

#: include/global_settings.php
msgid "Enable Data Source Statistics Collection"
msgstr "Aktivér indsamling af datakildestatistik"

#: include/global_settings.php
msgid "Should Data Source Statistics be collected for this Kadupul system?"
msgstr "Skal datakildestatistik indsamles for dette Kadupul-system?"

#: include/global_settings.php
msgid "Number of DSStats Processes"
msgstr "Antal DSStats-processer"

#: include/global_settings.php
msgid "The number of concurrent DSStats processes to use to process all of the Data Sources."
msgstr "Antallet af samtidige DSStats-processer, der skal bruges til at behandle alle datakilder."

#: include/global_settings.php
msgid "Daily Update Frequency"
msgstr "Daglig opdateringshyppighed"

#: include/global_settings.php
msgid "How frequently should Daily Stats be updated?"
msgstr "Hvor ofte skal daglig statistik opdateres?"

#: include/global_settings.php
msgid "Hourly Average Window"
msgstr "Vindue for timegennemsnit"

#: include/global_settings.php
msgid "The number of consecutive hours that represent the hourly average.  Keep in mind that a setting too high can result in very large memory tables"
msgstr "Antallet af på hinanden følgende timer, der udgør timegennemsnittet.  Husk, at en for høj indstilling kan give meget store hukommelsestabeller"

#: include/global_settings.php
msgid "Maintenance Time"
msgstr "Vedligeholdelsestidspunkt"

#: include/global_settings.php
msgid "What time of day should Weekly, Monthly, and Yearly Data be updated?  Format is HH:MM [am/pm]"
msgstr "Hvornår på dagen skal ugentlige, månedlige og årlige data opdateres?  Formatet er HH:MM [am/pm]"

#: include/global_settings.php
msgid "Memory Limit for Data Source Statistics Data Collector"
msgstr "Hukommelsesgrænse for dataindsamler til datakildestatistik"

#: include/global_settings.php
msgid "The maximum amount of memory for the Kadupul Poller and Data Source Statistics Poller"
msgstr "Den maksimale mængde hukommelse til Kadupul-polleren og polleren til datakildestatistik"

#: include/global_settings.php
msgid "Native Alerting"
msgstr "Indbygget alarmering"

#: include/global_settings.php
msgid "Enable Native Alert Evaluation"
msgstr "Aktivér indbygget alarmevaluering"

#: include/global_settings.php
msgid "Should the main Data Collector evaluate alert rules after each polling cycle and send their notifications? Alert rules read the rates that Data Source Statistics collects, so Data Source Statistics Collection must also be enabled."
msgstr "Skal den primære dataindsamler evaluere alarmregler efter hver pollingscyklus og sende deres notifikationer? Alarmregler læser de rater, som datakildestatistik indsamler, så indsamling af datakildestatistik skal også være aktiveret."

#: include/global_settings.php
msgid "Alert Rules per Batch"
msgstr "Alarmregler pr. batch"

#: include/global_settings.php
msgid "The number of alert rules read and evaluated together. The time budget is checked between batches."
msgstr "Antallet af alarmregler, der læses og evalueres sammen. Tidsbudgettet kontrolleres mellem batches."

#: include/global_settings.php
#, php-format
msgid "%d Rules"
msgstr "%d regler"

#: include/global_settings.php
msgid "Alert Evaluation Time Budget"
msgstr "Tidsbudget for alarmevaluering"

#: include/global_settings.php
msgid "How long one evaluation run may start new batches of rules. Sending queued notifications follows evaluation with the time left, and may send one batch even when the budget is spent. Rules not reached are evaluated first by the next run."
msgstr "Hvor længe én evalueringskørsel må starte nye batches af regler. Afsendelse af køede notifikationer følger efter evalueringen med den resterende tid og kan sende én batch, selv om budgettet er brugt. Regler, der ikke nås, evalueres først ved næste kørsel."

#: include/global_settings.php
msgid "RRDfile Check"
msgstr "RRDfil-kontrol"

#: include/global_settings.php
msgid "Enable RRDfile Check"
msgstr "Aktivér RRDfil-kontrol"

#: include/global_settings.php
msgid "Should RRDfile check be enabled for this Kadupul system?"
msgstr "Skal RRDfil-kontrol være aktiveret for dette Kadupul-system?"

#: include/global_settings.php
msgid "Number of RRDfile Check Processes"
msgstr "Antal processer til RRDfil-kontrol"

#: include/global_settings.php
msgid "The number of concurrent RRDfile check processes to use to process all of rrd files."
msgstr "Antallet af samtidige processer til RRDfil-kontrol, der skal bruges til at behandle alle rrd-filer."

#: include/global_settings.php
msgid "Check Frequency"
msgstr "Kontrolhyppighed"

#: include/global_settings.php
msgid "How frequently should RRD be checked?"
msgstr "Hvor ofte skal RRD kontrolleres?"

#: include/global_settings.php
msgid "Data Storage Settings"
msgstr "Indstillinger for datalagring"

#: include/global_settings.php
msgid "Choose if RRDs will be stored locally or being handled by an external RRDtool proxy server."
msgstr "Vælg, om RRD'er skal lagres lokalt eller håndteres af en ekstern RRDtool-proxyserver."

#: include/global_settings.php
msgid "RRDtool Proxy Server"
msgstr "RRDtool-proxyserver"

#: include/global_settings.php
msgid "Structure RRDfile Paths"
msgstr "Strukturér RRDfil-stier"

#: include/global_settings.php
msgid "Enable Structured Paths"
msgstr "Aktivér strukturerede stier"

#: include/global_settings.php
msgid "Use a separate subfolder for each host's RRD files.  The naming of the RRDfiles will be one of the following:<br><ul><li>&lt;path_cacti&gt;/rra/host_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_id/data_query_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_hash/device_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_hash/device_id/data_query_id/local_data_id.rrd.</li></ul><br>You can make this change after install by running the CLI script <b>structure_rra_paths.php</b> after you make the change.  NOTE: If you change Max Directories value to decrease the number of directories, or if you change the Directory Pattern, empty directories will not be pruned after you rerun the <b>structure_rra_paths.php</b> script."
msgstr "Brug en separat undermappe til hver værts RRD-filer.  Navngivningen af RRDfilerne er en af følgende:<br><ul><li>&lt;path_cacti&gt;/rra/host_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_id/data_query_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_hash/device_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_hash/device_id/data_query_id/local_data_id.rrd.</li></ul><br>Du kan foretage denne ændring efter installationen ved at køre CLI-scriptet <b>structure_rra_paths.php</b>, når du har foretaget ændringen.  BEMÆRK: Hvis du ændrer værdien Maks. mapper for at mindske antallet af mapper, eller hvis du ændrer mappemønsteret, ryddes tomme mapper ikke, når du kører scriptet <b>structure_rra_paths.php</b> igen."

#: include/global_settings.php
msgid "Directory Pattern"
msgstr "Mappemønster"

#: include/global_settings.php
msgid "Which Directory Pattern do you wish to use for Structured RRD Paths?  'Device ID' is the default.  The setting 'Device ID/Data Query ID' should be used when you have Devices with thousands of Graphs.  After Changing the Directory Pattern, you must run the Structured Path CLI script again to modify the RRDfile paths to the new Pattern."
msgstr "Hvilket mappemønster vil du bruge til strukturerede RRD-stier?  'Enheds-ID' er standard.  Indstillingen 'Enheds-ID/dataforespørgsels-ID' bør bruges, når du har enheder med tusindvis af grafer.  Efter ændring af mappemønsteret skal du køre CLI-scriptet til strukturerede stier igen for at ændre RRDfilernes stier til det nye mønster."

#: include/global_settings.php
msgid "Device ID"
msgstr "Enheds-ID"

#: include/global_settings.php
msgid "Device ID/Data Query ID"
msgstr "Enheds-ID/dataforespørgsels-ID"

#: include/global_settings.php
msgid "Device Hash/Device ID"
msgstr "Enhedshash/enheds-ID"

#: include/global_settings.php
msgid "Device Hash/Device ID/Data Query ID"
msgstr "Enhedshash/enheds-ID/dataforespørgsels-ID"

#: include/global_settings.php
msgid "Max Device Hash Directories"
msgstr "Maks. enhedshash-mapper"

#: include/global_settings.php
msgid "The maximum number of Device Directories to be created based upon hashed Device IDs."
msgstr "Det maksimale antal enhedsmapper, der oprettes baseret på hashede enheds-ID'er."

#: include/global_settings.php
msgid "Proxy Server"
msgstr "Proxyserver"

#: include/global_settings.php
msgid "The DNS hostname or IP address of the RRDtool proxy server."
msgstr "DNS-værtsnavnet eller IP-adressen på RRDtool-proxyserveren."

#: include/global_settings.php
msgid "Proxy Port Number"
msgstr "Proxyportnummer"

#: include/global_settings.php
msgid "TCP port for encrypted communication."
msgstr "TCP-port til krypteret kommunikation."

#: include/global_settings.php utilities.php
msgid "RSA Fingerprint"
msgstr "RSA-fingeraftryk"

#: include/global_settings.php
msgid "The fingerprint of the current public RSA key the proxy is using. This is required to establish a trusted connection."
msgstr "Fingeraftrykket af den aktuelle offentlige RSA-nøgle, som proxyen bruger. Dette er påkrævet for at etablere en betroet forbindelse."

#: include/global_settings.php
msgid "RRDtool Proxy Server - Backup"
msgstr "RRDtool-proxyserver - backup"

#: include/global_settings.php
msgid "Load Balancing"
msgstr "Belastningsfordeling"

#: include/global_settings.php
msgid "If both main and backup proxy are receivable this option allows to spread all requests against RRDtool."
msgstr "Hvis både hoved- og backupproxy kan nås, gør denne indstilling det muligt at fordele alle forespørgsler til RRDtool."

#: include/global_settings.php
msgid "The DNS hostname or IP address of the RRDtool backup proxy server if proxy is running in MSR mode."
msgstr "DNS-værtsnavnet eller IP-adressen på RRDtool-backupproxyserveren, hvis proxyen kører i MSR-tilstand."

#: include/global_settings.php
msgid "TCP port for encrypted communication with the backup proxy."
msgstr "TCP-port til krypteret kommunikation med backupproxyen."

#: include/global_settings.php
msgid "The fingerprint of the current public RSA key the backup proxy is using. This is required to establish a trusted connection."
msgstr "Fingeraftrykket af den aktuelle offentlige RSA-nøgle, som backupproxyen bruger. Dette er påkrævet for at etablere en betroet forbindelse."

#: include/global_settings.php
msgid "Spike Kill Settings"
msgstr "Indstillinger for Spike Kill"

#: include/global_settings.php
msgid "Removal Method"
msgstr "Fjernelsesmetode"

#: include/global_settings.php
msgid "There are two removal methods.  The first, Standard Deviation, will remove any sample that is X number of standard deviations away from the average of samples.  The second method, Variance, will remove any sample that is X% more than the Variance average.  The Variance method takes into account a certain number of 'outliers'.  Those are exceptional samples, like the spike, that need to be excluded from the Variance Average calculation."
msgstr "Der er to fjernelsesmetoder.  Den første, standardafvigelse, fjerner alle prøver, der ligger X standardafvigelser fra gennemsnittet af prøverne.  Den anden metode, varians, fjerner alle prøver, der er X % over variansgennemsnittet.  Variansmetoden tager højde for et vist antal 'outliers'.  Det er ekstraordinære prøver, som spiken, der skal udelukkes fra beregningen af variansgennemsnittet."

#: include/global_settings.php
msgid "Standard Deviation"
msgstr "Standardafvigelse"

#: include/global_settings.php
msgid "Variance Based w/Outliers Removed"
msgstr "Variansbaseret med outliers fjernet"

#: include/global_settings.php lib/html.php
msgid "Replacement Method"
msgstr "Erstatningsmetode"

#: include/global_settings.php
msgid "There are three replacement methods.  The first method replaces the spike with the average of the data source in question.  The second method replaces the spike with a 'NaN'.  The last replaces the spike with the last known good value found."
msgstr "Der er tre erstatningsmetoder.  Den første metode erstatter spiken med gennemsnittet for den pågældende datakilde.  Den anden metode erstatter spiken med en 'NaN'.  Den sidste erstatter spiken med den sidst kendte gode værdi."

#: include/global_settings.php lib/html.php
msgid "Average"
msgstr "Gennemsnit"

#: include/global_settings.php lib/html.php
msgid "NaNs"
msgstr "NaN'er"

#: include/global_settings.php lib/html.php
msgid "Last Known Good"
msgstr "Sidst kendte gode"

#: include/global_settings.php
msgid "Number of Standard Deviations"
msgstr "Antal standardafvigelser"

#: include/global_settings.php
msgid "Any value that is this many standard deviations above the average will be excluded.  A good number will be dependent on the type of data to be operated on.  We recommend a number no lower than 5 Standard Deviations."
msgstr "Enhver værdi, der ligger så mange standardafvigelser over gennemsnittet, udelukkes.  Et godt tal afhænger af typen af data, der behandles.  Vi anbefaler et tal på mindst 5 standardafvigelser."

#: include/global_settings.php
#, php-format
msgid "%d Standard Deviations"
msgstr "%d standardafvigelser"

#: include/global_settings.php
msgid "Variance Percentage"
msgstr "Variansprocent"

#: include/global_settings.php
#, php-format
msgid "This value represents the percentage above the adjusted sample average once outliers have been removed from the sample.  For example, a Variance Percentage of 100%% on an adjusted average of 50 would remove any sample above the quantity of 100 from the graph."
msgstr "Denne værdi repræsenterer procentdelen over det justerede prøvegennemsnit, når outliers er fjernet fra prøven.  For eksempel vil en variansprocent på 100 %% ved et justeret gennemsnit på 50 fjerne alle prøver over mængden 100 fra grafen."

#: include/global_settings.php
msgid "Variance Number of Outliers"
msgstr "Antal outliers for varians"

#: include/global_settings.php
msgid "This value represents the number of high and low average samples that will be removed from the sample set prior to calculating the Variance Average.  If you choose an outlier value of 5, then both the top and bottom 5 averages are removed."
msgstr "Denne værdi repræsenterer antallet af høje og lave gennemsnitsprøver, der fjernes fra prøvesættet, før variansgennemsnittet beregnes.  Hvis du vælger en outlierværdi på 5, fjernes både de 5 højeste og de 5 laveste gennemsnit."

#: include/global_settings.php
#, php-format
msgid "%d High/Low Samples"
msgstr "%d høje/lave prøver"

#: include/global_settings.php
msgid "Max Kills Per RRA"
msgstr "Maks. fjernelser pr. RRA"

#: include/global_settings.php
msgid "This value represents the maximum number of spikes to remove from a Graph RRA."
msgstr "Denne værdi repræsenterer det maksimale antal spikes, der fjernes fra en grafs RRA."

#: include/global_settings.php
#, php-format
msgid "%d Spikes"
msgstr "%d spikes"

#: include/global_settings.php
msgid "RRDfile Backup Directory"
msgstr "Backupmappe til RRDfiler"

#: include/global_settings.php
msgid "If this directory is not empty, then your original RRDfiles will be backed up to this location."
msgstr "Hvis denne mappe ikke er tom, sikkerhedskopieres dine originale RRDfiler til denne placering."

#: include/global_settings.php
msgid "Batch Spike Kill Settings"
msgstr "Indstillinger for batch-Spike Kill"

#: include/global_settings.php
msgid "Removal Schedule"
msgstr "Fjernelsesplan"

#: include/global_settings.php
msgid "Do you wish to periodically remove spikes from your graphs?  If so, select the frequency below."
msgstr "Vil du med jævne mellemrum fjerne spikes fra dine grafer?  Hvis ja, så vælg hyppigheden nedenfor."

#: include/global_settings.php
msgid "Once a Day"
msgstr "Én gang om dagen"

#: include/global_settings.php
msgid "Every Other Day"
msgstr "Hver anden dag"

#: include/global_settings.php
msgid "Base Time"
msgstr "Basistidspunkt"

#: include/global_settings.php
msgid "The Base Time for Spike removal to occur.  For example, if you use '12:00am' and you choose once per day, the batch removal would begin at approximately midnight every day."
msgstr "Basistidspunktet for fjernelse af spikes.  Hvis du f.eks. bruger '12:00am' og vælger én gang om dagen, begynder batchfjernelsen cirka ved midnat hver dag."

#: include/global_settings.php
msgid "Graph Templates to Spike Kill"
msgstr "Grafskabeloner til Spike Kill"

#: include/global_settings.php
msgid "When performing batch spike removal, only the templates selected below will be acted on."
msgstr "Ved batchfjernelse af spikes behandles kun de skabeloner, der er valgt nedenfor."

#: include/global_settings.php
msgid "Backup Retention"
msgstr "Opbevaring af backup"

#: include/global_settings.php
msgid "When SpikeKill kills spikes in graphs, it makes a backup of the RRDfile.  How long should these backup files be retained?"
msgstr "Når SpikeKill fjerner spikes i grafer, laves en sikkerhedskopi af RRDfilen.  Hvor længe skal disse backupfiler opbevares?"

#: include/global_settings.php
msgid "Default View Mode"
msgstr "Standardvisningstilstand"

#: include/global_settings.php
msgid "Which Graph mode do you want displayed by default when you first visit the Graphs page?"
msgstr "Hvilken graftilstand vil du have vist som standard, når du første gang besøger siden Grafer?"

#: include/global_settings.php
msgid "TimeZone Support"
msgstr "Understøttelse af tidszone"

#: include/global_settings.php
msgid "How would you like Kadupul to present dates?  This setting will also change the way that Kadupul Graphs dates are represented."
msgstr "Hvordan vil du have Kadupul til at præsentere datoer?  Denne indstilling ændrer også den måde, Kadupul-grafer repræsenterer datoer på."

#: include/global_settings.php
msgid "Kadupul Server Timezone"
msgstr "Kadupul-serverens tidszone"

#: include/global_settings.php
msgid "My Browser's Timezone"
msgstr "Min browsers tidszone"

#: include/global_settings.php
msgid "User Language"
msgstr "Brugersprog"

#: include/global_settings.php
msgid "Defines the preferred GUI language."
msgstr "Definerer det foretrukne sprog i brugergrænsefladen."

#: include/global_settings.php
msgid "Show Graph Title"
msgstr "Vis graftitel"

#: include/global_settings.php
msgid "Display the graph title on the page so that it may be searched using the browser."
msgstr "Vis graftitlen på siden, så der kan søges i den med browseren."

#: include/global_settings.php
msgid "Hide Disabled"
msgstr "Skjul deaktiverede"

#: include/global_settings.php
msgid "Hides Disabled Devices and Graphs when viewing outside of Console tab."
msgstr "Skjuler deaktiverede enheder og grafer, når de vises uden for fanen Konsol."

#: include/global_settings.php
msgid "Show Device Aggregates"
msgstr "Vis enhedsaggregater"

#: include/global_settings.php
msgid "If a Device Data Source is included in an Aggregate Graph, show that Graph along with other Device Graphs"
msgstr "Hvis en enheds datakilde indgår i en aggregeret graf, vis da den graf sammen med enhedens andre grafer"

#: include/global_settings.php
msgid "Enable Horizontal Scrolling"
msgstr "Aktivér vandret rulning"

#: include/global_settings.php
msgid "Enable Horizontal Scrolling of Tables, Disabling Responsive Column Visibility."
msgstr "Aktivér vandret rulning af tabeller, og deaktivér responsiv kolonnesynlighed."

#: include/global_settings.php
msgid "The date format to use in Kadupul."
msgstr "Det datoformat, der skal bruges i Kadupul."

#: include/global_settings.php
msgid "The date separator to be used in Kadupul."
msgstr "Den datoseparator, der skal bruges i Kadupul."

#: include/global_settings.php
msgid "Page Refresh"
msgstr "Sideopdatering"

#: include/global_settings.php
msgid "The number of seconds between automatic page refreshes."
msgstr "Antallet af sekunder mellem automatiske sideopdateringer."

#: include/global_settings.php
msgid "Preview Graphs Per Page"
msgstr "Eksempelgrafer pr. side"

#: include/global_settings.php
msgid "The number of graphs to display on one page in preview mode."
msgstr "Antallet af grafer, der vises på én side i eksempeltilstand."

#: include/global_settings.php
msgid "Default Time Range"
msgstr "Standardtidsinterval"

#: include/global_settings.php
msgid "The default RRA to use in rare occasions."
msgstr "Den standard-RRA, der bruges i sjældne tilfælde."

#: include/global_settings.php
msgid "The default Timespan displayed when viewing Graphs and other time specific data."
msgstr "Det standardtidsrum, der vises, når grafer og andre tidsspecifikke data ses."

#: include/global_settings.php
msgid "Default Timeshift"
msgstr "Standardtidsforskydning"

