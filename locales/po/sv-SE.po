msgstr "Tema"

#: include/global_settings.php:878 include/global_settings.php:2632
msgid "Please select one of the available Themes to skin your Cacti with."
msgstr "Välj ett av tillgängliga teman för att klä din Cacti med."

#: include/global_settings.php:884
msgid "Table Settings"
msgstr "Tabellinställningar"

#: include/global_settings.php:889
msgid "Rows Per Page"
msgstr "Rader per sida"

#: include/global_settings.php:890
