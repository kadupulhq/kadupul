msgstr "LDAP CN-inställningar"

#: include/global_settings.php:1872 user_domains.php:483
msgid "Field that will replace the Full Name when creating a new user, taken from LDAP. (on windows: displayname) "
msgstr "Fält som ersätter det fullständiga namnet när du skapar en ny användare, hämtat från LDAP. (på Windows: displayname) "

#: include/global_settings.php:1877 package_import.php:498
