msgstr "RRA Storlek (i byte)"

#: include/global_form.php:304
msgid "Based upon the number of Rows and the number of Consolidation Functions selected, the size of this RRA in the RRDfile."
msgstr "Baserat på antalet rader och antalet konsolideringsfunktioner som valts, storleken på denna RRA i RRD-filen."

#: include/global_form.php:322
msgid "A useful name for this CDEF."
msgstr "Ett användbart namn för denna CDEF."

#: include/global_form.php:342
msgid "The name of this Color."
msgstr "Namnet på denna färg."

#: include/global_form.php:349
msgid "Hex Value"
msgstr "Hex-värde"

#: include/global_form.php:350
msgid "The hex value for this color; valid range: 000000-FFFFFF."
msgstr "Hexvärdet för denna färg; giltigt intervall: 000000-FFFFFF."

#: include/global_form.php:358
msgid "Any named color should be read only."
msgstr "Alla namngivna färger ska vara skrivskyddade."

#: include/global_form.php:383 include/global_form.php:449
msgid "Enter a meaningful name for this data input method."
msgstr "Ange ett meningsfullt namn för denna datainmatningsmetod."

#: include/global_form.php:390
msgid "Input Type"
msgstr "Inmatning Typ"

#: include/global_form.php:391
msgid "Choose the method you wish to use to collect data for this Data Input method."
msgstr "Välj den metod som du vill använda för att samla in data för denna datainmatningsmetod."

#: include/global_form.php:397
msgid "Input String"
msgstr "Inmatningssträng"

#: include/global_form.php:398
msgid "The data that is sent to the script, which includes the complete path to the script and input sources in &lt;&gt; brackets."
msgstr "De data som skickas till skriptet, vilket inkluderar den fullständiga sökvägen till skriptet och indatakällor inom parentes."

#: include/global_form.php:408
msgid "White List Check"
msgstr "Kontroll av vit lista"

#: include/global_form.php:409
msgid "The result of the Whitespace verification check for the specific Input Method.  If the Input String changes, and the Whitelist file is not update, Graphs will not be allowed to be created."
msgstr "Resultatet av kontrollen av blanksteg för den specifika indatametoden.  Om indatasträngen ändras och filen med vitlistan inte uppdateras kommer grafer inte att kunna skapas."

#: include/global_form.php:425 include/global_form.php:436
#, php-format
msgid "Field [%s]"
msgstr "Fält [%s]"

#: include/global_form.php:426
#, php-format
msgid "Choose the associated field from the %s field."
msgstr "Välj det associerade fältet från %s-fältet."

#: include/global_form.php:437
#, php-format
msgid "Enter a name for this %s field.  Note: If using name value pairs in your script, for example: NAME:VALUE, it is important that the name match your output field name identically to the script output name or names."
msgstr "Ange ett namn för detta %s-fält.  Obs: Om du använder namn-värde-par i ditt skript, t.ex: NAME:VALUE, är det viktigt att namnet matchar namnet på utdatafältet på samma sätt som namnet eller namnen på skriptets utdata."

#: include/global_form.php:456
msgid "Update RRDfile"
msgstr "Uppdatera RRD-fil"

#: include/global_form.php:457
msgid "Whether data from this output field is to be entered into the RRDfile."
msgstr "Om data från detta utmatningsfält ska föras in i RRD-filen."

#: include/global_form.php:464
msgid "Regular Expression Match"
msgstr "Matchning med reguljärt uttryck"

#: include/global_form.php:465
msgid "If you want to require a certain regular expression to be matched against input data, enter it here (preg_match format)."
msgstr "Om du vill att ett visst reguljärt uttryck ska matchas mot indata anger du det här (preg_match-format)."

#: include/global_form.php:472
msgid "Allow Empty Input"
msgstr "Tillåt tom inmatning"

#: include/global_form.php:473
msgid "Check here if you want to allow NULL input in this field from the user."
msgstr "Markera här om du vill tillåta NULL-inmatning i detta fält från användaren."

#: include/global_form.php:480
msgid "Special Type Code"
msgstr "Kod för särskild typ"

#: include/global_form.php:481
#, php-format
msgid "If this field should be treated specially by host templates, indicate so here. Valid keywords for this field are %s"
msgstr "Om detta fält ska behandlas speciellt av värdmallar, ange det här. Giltiga nyckelord för det här fältet är %s"

#: include/global_form.php:513
msgid "The name given to this data template."
msgstr "Det namn som ges till denna datamall."

#: include/global_form.php:554
msgid "Choose a name for this data source.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "Välj ett namn för den här datakällan.  Det kan inkludera ersättningsvariabler som |host_description| eller |query_fieldName|.  För en fullständig lista över ersättningstaggar som stöds, se Kadupul-dokumentationen."

#: include/global_form.php:558
msgid "Data Source Path"
msgstr "Datakällans sökväg"

#: include/global_form.php:563
msgid "The full path to the RRDfile."
msgstr "Den fullständiga sökvägen till RRD-filen."

#: include/global_form.php:572
msgid "The script/source used to gather data for this data source."
msgstr "Det skript/den källa som används för att samla in data för denna datakälla."

#: include/global_form.php:578 include/global_form.php:1685
#: package_import.php:877
msgid "Select the Data Source Profile.  The Data Source Profile controls polling interval, the data aggregation, and retention policy for the resulting Data Sources."
msgstr "Välj datakällans profil.  Datakällprofilen styr pollningsintervallet, dataaggregeringen och lagringspolicyn för de resulterande datakällorna."

#: include/global_form.php:589
msgid "The amount of time in seconds between expected updates."
msgstr "Tiden i sekunder mellan förväntade uppdateringar."

#: include/global_form.php:593
msgid "Data Source Active"
msgstr "Datakälla Aktiv"

#: include/global_form.php:597
msgid "Whether Kadupul should gather data for this data source or not."
msgstr "Om Kadupul ska samla in data för denna datakälla eller inte."

#: include/global_form.php:605
msgid "Internal Data Source Name"
msgstr "Namn på intern datakälla"

#: include/global_form.php:610
msgid "Choose unique name to represent this piece of data inside of the RRDfile."
msgstr "Välj ett unikt namn för att representera denna del av data i RRD-filen."

#: include/global_form.php:613
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "Minimivärde (\"U\" för inget minimivärde)"

#: include/global_form.php:618
msgid "The minimum value of data that is allowed to be collected."
msgstr "Det lägsta värdet för data som får samlas in."

#: include/global_form.php:621
msgid "Maximum Value (\"U\" for No Maximum)"
msgstr "Maximalt värde (\"U\" för inget maximalt värde)"

#: include/global_form.php:626
msgid "The maximum value of data that is allowed to be collected."
msgstr "Det högsta värdet för data som får samlas in."

#: include/global_form.php:629
msgid "Data Source Type"
msgstr "Typ av datakälla"

#: include/global_form.php:633
msgid "How data is represented in the RRA."
msgstr "Hur data representeras i RRA."

#: include/global_form.php:641
msgid "The maximum amount of time that can pass before data is entered as 'unknown'. (Usually 2x300=600)"
msgstr "Den maximala tid som kan gå innan data anges som \"okänd\". (Vanligtvis 2x300=600)"

#: include/global_form.php:647 lib/html_utility.php:280
msgid "Not Selected"
msgstr "Inte valt"

#: include/global_form.php:648
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "När data samlas in kommer data för det här fältet att läggas in i den här datakällan."

#: include/global_form.php:657
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "Ange ett namn för denna GPRINT-förinställning, se till att det är något du känner igen."

#: include/global_form.php:664
msgid "GPRINT Text"
msgstr "GPRINT-text"

#: include/global_form.php:665
msgid "Enter the custom GPRINT string here."
msgstr "Ange den anpassade GPRINT-strängen här."

#: include/global_form.php:683
msgid "Common Options"
msgstr "Vanliga inställningar"

#: include/global_form.php:688
msgid "Title (--title)"
msgstr "Titel (--titel)"

#: include/global_form.php:692
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "Det namn som skrivs ut på grafen.  Det kan innehålla ersättningsvariabler som |host_description| eller |query_fieldName|.  En fullständig lista över ersättningstaggar som stöds finns i Kadupul-dokumentationen."

#: include/global_form.php:696
msgid "Vertical Label (--vertical-label)"
msgstr "Vertikal etikett (--vertical-label)"

#: include/global_form.php:700
msgid "The label vertically printed to the left of the graph."
msgstr "Etiketten som skrivs ut vertikalt till vänster om diagrammet."

#: include/global_form.php:704
msgid "Image Format (--imgformat)"
msgstr "Bildformat (--imgformat)"

#: include/global_form.php:708
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "Den typ av graf som genereras; PNG, GIF eller SVG.  Valet av typ av grafbild är mycket RRDtool-beroende."

#: include/global_form.php:711
msgid "Height (--height)"
msgstr "Höjd (--höjd)"

#: include/global_form.php:715
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Höjden (i pixlar) på grafområdet inom grafen. Detta område inkluderar inte teckenförklaringen, axelteckningarna eller titeln."

#: include/global_form.php:719
msgid "Width (--width)"
msgstr "Bredd (--bredd)"

#: include/global_form.php:723
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Bredden (i pixlar) på grafområdet inom grafen. Detta område inkluderar inte teckenförklaringen, axelteckningarna eller titeln."

#: include/global_form.php:727
msgid "Base Value (--base)"
msgstr "Basvärde (--base)"

#: include/global_form.php:731
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "Bör ställas in på 1024 för minne och 1000 för trafikmätningar."

#: include/global_form.php:735
msgid "Slope Mode (--slope-mode)"
msgstr "Lutningsläge (--slope-mode)"

#: include/global_form.php:739
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Slope Mode jämnar ut formen på graferna på bekostnad av en viss upplösning på skärmen."

#: include/global_form.php:742
msgid "Scaling Options"
msgstr "Alternativ för skalning"

#: include/global_form.php:747
msgid "Auto Scale"
msgstr "Automatisk skala"

#: include/global_form.php:751
msgid "Auto scale the y-axis instead of defining an upper and lower limit. Note: if this is check both the Upper and Lower limit will be ignored."
msgstr "Automatisk skalning av y-axeln istället för att definiera en övre och nedre gräns. Obs: om detta är markerat ignoreras både den övre och den nedre gränsen."

#: include/global_form.php:755
msgid "Auto Scale Options"
msgstr "Alternativ för automatisk skala"

#: include/global_form.php:758
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "Använd <br> --alt-autoscale för att skala till absolut minimum och maximum <br> --alt-autoscale-max för att skala till maximivärdet med en given nedre gräns <br> --alt-autoscale-min för att skala till minimivärdet med en given övre gräns <br> --alt-autoscale (with limits) för att skala med både nedre och övre gränser (RRDtool standard) <br>"

#: include/global_form.php:762
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "Använd --alt-autoscale (ignorerar givna gränser)"

#: include/global_form.php:766
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "Använd --alt-autoscale-max (accepterar en lägre gräns)"

#: include/global_form.php:770
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "Använd --alt-autoscale-min (accepterar en övre gräns)"

#: include/global_form.php:774
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "Använd --alt-autoscale (accepterar båda gränserna, RRDtool standard)"

#: include/global_form.php:779
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Logaritmisk skalning (--logaritmisk)"

#: include/global_form.php:783
msgid "Use Logarithmic y-axis scaling"
msgstr "Använd logaritmisk skalning av y-axeln"

#: include/global_form.php:786
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "SI-enheter för logaritmisk skalning (--units=si)"

#: include/global_form.php:789
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "Använd SI-enheter för logaritmisk skalning istället för att använda exponentiell notation.<br> Linjära grafer använder SI-notation som standard."

#: include/global_form.php:792
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "Läge för fasta gränser (--rigid)"

#: include/global_form.php:795
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "Expandera inte den nedre och övre gränsen om grafen innehåller ett värde utanför det giltiga intervallet."

#: include/global_form.php:798
msgid "Upper Limit (--upper-limit)"
msgstr "Övre gräns (--övre-gräns)"

#: include/global_form.php:802
msgid "The maximum vertical value for the graph."
msgstr "Det maximala vertikala värdet för grafen."

#: include/global_form.php:806
msgid "Lower Limit (--lower-limit)"
msgstr "Lägre gräns (--lower-limit)"

#: include/global_form.php:810
msgid "The minimum vertical value for the graph."
msgstr "Det lägsta vertikala värdet för grafen."

#: include/global_form.php:814
msgid "Grid Options"
msgstr "Alternativ för rutnät"

#: include/global_form.php:819
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "Enhetens rutnätsvärde (--unit/--y-grid)"

#: include/global_form.php:823
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "Ställer in exponentvärdet på Y-axeln för tal. Obs: Detta alternativ är inte längre aktuellt och ersätts av alternativet --y-grid.  I det här alternativet visas Y-axelns rutnätslinjer vid varje rutnätsstegsintervall.  Etiketter placeras vid varje etikettfaktorlinje."

#: include/global_form.php:827
msgid "Unit Exponent Value (--units-exponent)"
msgstr "Värde för enhetsexponent (--units-exponent)"

#: include/global_form.php:831
msgid "What unit Kadupul should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Vilken enhet Kadupul ska använda på Y-axeln. Använd 3 för att visa allt i \"k\" eller -6 för att visa allt i \"u\" (mikro)."

#: include/global_form.php:835
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "Enhetslängd (--units-length &lt;length&gt;)"

#: include/global_form.php:840
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "Hur många siffror ska RRDtool anta att y-axelns etiketter är? Du kan behöva använda det här alternativet för att få tillräckligt med utrymme när du börjar mixtra med y-axelns märkning."

#: include/global_form.php:843
msgid "No Gridfit (--no-gridfit)"
msgstr "Ingen Gridfit (--no-gridfit)"

#: include/global_form.php:846
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "För att undvika suddiga effekter av anti-aliasing snäpper RRDtool punkter till pixlar med enhetsupplösning, vilket resulterar i ett skarpare utseende. Om du inte gillar detta kan du använda den här omkopplaren för att stänga av detta beteende.<br><strong>Notera: </strong>Gridfitting är avstängt för PDF-, EPS- och SVG-utdata som standard."

#: include/global_form.php:849
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "Alternativt Y-nät (--alt-y-nät)"

#: include/global_form.php:852
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "Algoritmen säkerställer att du alltid har ett rutnät, att det finns tillräckligt många men inte för många rutnätslinjer och att rutnätet är metriskt. Denna parameter säkerställer också att tillräckligt många decimaler visas även om grafen går från 69,998 till 70,001.<br><strong>Observera: </strong>Denna parameter kan störa alternativen --alt-autoscale."

#: include/global_form.php:855
msgid "Axis Options"
msgstr "Alternativ för axel"

#: include/global_form.php:860
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "Höger axel (--höger axel &lt;scale:shift&gt;)"

#: include/global_form.php:865
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "En andra axel kommer att ritas till höger om diagrammet. Den är kopplad till den vänstra axeln via parametrarna scale och shift."

#: include/global_form.php:868
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "Etikett för höger axel (--right-axis-label &lt;string&gt;)"

#: include/global_form.php:873
msgid "The label for the right axis."
msgstr "Etiketten för den högra axeln."

#: include/global_form.php:876
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "Format för höger axel (--right-axis-format &lt;format&gt;)"

#: include/global_form.php:881
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "Som standard bestäms formatet för axeletiketterna automatiskt.  Om du vill göra det själv använder du detta alternativ med samma %lf-argument som du känner igen från kommandona PRINT och GPRINT."

#: include/global_form.php:884
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "Formaterare för höger axel (--formaterare för höger axel &lt;formatnamn&gt;)"

#: include/global_form.php:889
msgid "When you setup the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "När du konfigurerar högeraxelns märkning ska du tillämpa en regel för dataformatet.  Format som stöds är \"numeric\" där data behandlas som numeriska, \"timestamp\" där värden tolkas som UNIX-tidsstämplar (antal sekunder sedan januari 1970) och uttrycks med strftime-format (standard är \"%Y-%m-%d %H:%M:%S\").  Se även --units-length och --right-axis-format.  Slutligen \"duration\" där värden tolkas som varaktighet i millisekunder.  Formatering följer reglerna för valstrfduration kvalificerad PRINT/GPRINT."

#: include/global_form.php:892
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "Formatering av vänster axel (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php:897
msgid "When you setup the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "När du konfigurerar märkningen av vänster axel tillämpar du en regel för dataformatet.  Format som stöds är \"numeric\" där data behandlas som numeriska, \"timestamp\" där värden tolkas som UNIX-tidsstämplar (antal sekunder sedan januari 1970) och uttrycks med strftime-format (standard är \"%Y-%m-%d %H:%M:%S\").  Se även --units-length.  Slutligen \"duration\" där värden tolkas som varaktighet i millisekunder.  Formatering följer reglerna för valstrfduration kvalificerad PRINT/GPRINT."

#: include/global_form.php:900
msgid "Legend Options"
msgstr "Alternativ för teckenförklaring"

#: include/global_form.php:905
msgid "Auto Padding"
msgstr "Auto stoppning"

#: include/global_form.php:909
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "Fyll i text så att teckenförklaring och diagramdata alltid är i linje med varandra. Observera: Detta kan leda till att det tar längre tid att rendera grafer på grund av den större overheaden. Auto Padding kanske inte heller är korrekt för alla typer av grafer, men konsekvent märkning hjälper vanligtvis."

#: include/global_form.php:912
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "Dynamiska etiketter (--dynamiska-etiketter)"

#: include/global_form.php:915
msgid "Draw line markers as a line."
msgstr "Rita linjemarkörer som en linje."

#: include/global_form.php:918
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "Tvinga regelförklaring (--force-rules-legend)"

#: include/global_form.php:921
msgid "Force the generation of HRULE and VRULE legends."
msgstr "Tvinga fram HRULE- och VRULE-legendarer."

#: include/global_form.php:924
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "Flikbredd (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php:929
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "Som standard är flikbredden 40 pixlar, använd det här alternativet för att ändra den."

#: include/global_form.php:932
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "Position för teckenförklaring (--legend-position=&lt;position&gt;)"

#: include/global_form.php:936
msgid "Place the legend at the given side of the graph."
msgstr "Placera teckenförklaringen på den angivna sidan av diagrammet."

#: include/global_form.php:939
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Legend riktning (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php:943
msgid "Place the legend items in the given vertical order."
msgstr "Placera de legendariska föremålen i den angivna vertikala ordningen."

#: include/global_form.php:950 lib/api_aggregate.php:1740 lib/html.php:1232
msgid "Graph Item Type"
msgstr "Typ av grafiskt objekt"

#: include/global_form.php:954
msgid "How data for this item is represented visually on the graph."
msgstr "Hur data för detta objekt representeras visuellt i diagrammet."

#: include/global_form.php:969
msgid "The data source to use for this graph item."
msgstr "Den datakälla som ska användas för detta grafobjekt."

#: include/global_form.php:976
msgid "The color to use for the legend."
msgstr "Färgen som ska användas för legenden."

#: include/global_form.php:979
msgid "Opacity/Alpha Channel"
msgstr "Opacitet / Alfa kanal"

#: include/global_form.php:983
msgid "The opacity/alpha channel of the color."
msgstr "Färgens opacitet / alfakanal."

#: include/global_form.php:986 lib/rrd.php:3815
msgid "Consolidation Function"
msgstr "Konsolideringsfunktion"

#: include/global_form.php:990
msgid "How data for this item is represented statistically on the graph."
msgstr "Hur data för detta objekt representeras statistiskt i diagrammet."

#: include/global_form.php:993
msgid "CDEF Function"
msgstr "CDEF-funktion"

#: include/global_form.php:998
