msgstr "Om boost-pollern överskrider denna körtid kommer en varning att placeras i Kadupul-loggen,"

#: include/global_settings.php:2147
msgid "Enable direct population of poller_output_boost table"
msgstr "Aktivera direktpopulation av poller_output_boost-tabellen"

#: include/global_settings.php:2148
msgid "Enables direct insert of records into poller output boost with results in a 25% time reduction in each poll cycle."
msgstr "Aktiverar direktinsättning av poster i pollerutmatningshöjning med resultat i en 25% tidsminskning i varje pollscykel."

