msgstr "Låst"

#: include/global_form.php:1535
msgid "Determines if the user account is locked."
msgstr "Avgör om användarkontot är låst."

#: include/global_form.php:1540
msgid "Account Options"
msgstr "Kontoalternativ"

#: include/global_form.php:1542
msgid "Set any user account specific options here."
msgstr "Ställ in eventuella specifika alternativ för användarkontot här."

#: include/global_form.php:1546
msgid "Must Change Password at Next Login"
msgstr "Måste byta lösenord vid nästa inloggning"

#: include/global_form.php:1558
msgid "Maintain Custom Graph and User Settings"
msgstr "Behåll anpassade graf- och användarinställningar"

#: include/global_form.php:1565
msgid "Graph Options"
msgstr "Alternativ för diagram"

#: include/global_form.php:1567
msgid "Set any graph specific options here."
msgstr "Ställ in eventuella grafspecifika alternativ här."

#: include/global_form.php:1571
msgid "User Has Rights to Tree View"
msgstr "Användaren har rättigheter till trädvyn"

#: include/global_form.php:1577
msgid "User Has Rights to List View"
msgstr "Användaren har rättigheter till List View"

#: include/global_form.php:1583
msgid "User Has Rights to Preview View"
msgstr "Användaren har rättigheter till Preview View"

#: include/global_form.php:1590 user_group_admin.php:119
msgid "Login Options"
msgstr "Val vid inloggning"

#: include/global_form.php:1593
msgid "What to do when this user logs in."
msgstr "Vad ska göras när den här användaren loggar in."

#: include/global_form.php:1598
msgid "Show the page that user pointed their browser to."
msgstr "Visa den sida som användaren pekade på med sin webbläsare."

#: include/global_form.php:1602
msgid "Show the default console screen."
msgstr "Visa standardskärmen för konsolen."

