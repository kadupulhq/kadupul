msgstr "Metode enkripsi yang digunakan untuk Email."

#: include/global_settings.php:2042
msgid "SSL"
msgstr "SSL"

#: include/global_settings.php:2043
msgid "TLS"
msgstr "TLS"

#: include/global_settings.php:2048
msgid "SMTP Timeout"
