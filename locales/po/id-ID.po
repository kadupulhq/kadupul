msgstr "Harus Mengubah Kata Sandi pada Login Berikutnya"

#: include/global_form.php:1579
msgid "Maintain Custom Graph and User Settings"
msgstr "Pertahankan Pengaturan Grafik dan Pengguna Kustom"

