msgstr "Ukuran font yang digunakan untuk Sumbu Grafik"

#: include/global_settings.php
msgid "The size of the font used for Graph Legend items"
msgstr "Ukuran font yang digunakan untuk item Legenda Grafik"

#: include/global_settings.php
