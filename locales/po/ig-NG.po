msgstr "Ma a ga-etinye data sitere na ogige mmepụta a n'ime RRDfile."

#: include/global_form.php:481
msgid "Regular Expression Match"
msgstr "Nkwekọ Okwu Mgbe Niile"

#: include/global_form.php:482
