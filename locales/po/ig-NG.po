#: about.php:29 include/global_arrays.php:2654 lib/html.php:2900
msgid "About Cacti"
msgstr "Banyere Cacti"

#: about.php:42
msgid "Cacti is designed to be a complete graphing solution based on the RRDtool Time Series Database (TSDB) and Graphing solution. Its goal is to make the Network Administrator's job easier by taking care of all the important details necessary to create meaningful Graphs."
msgstr "Emebere Cacti ka ọ bụrụ ngwọta eserese zuru oke dabere na RRDtool Time Series Database (TSDB) na ngwọta Eserese. Ebumnuche ya bụ ime ka ọrụ Onye Nchịkwa Netwọkụ dị mfe site n'ilekọta nkọwa niile dị mkpa iji mepụta Eserese bara uru."

#: about.php:44
#, php-format
msgid "Please see the official %sCacti website%s for information on how to use Cacti, get support, and updates."
msgstr "Biko lee %swebụsaịtị Cacti gọọmentị%s maka ozi gbasara otu esi eji Cacti, nweta nkwado, na mmelite."

#: about.php:48
msgid "Active Developers"
msgstr "Ndị Mmepe Na-arụ Ọrụ"

#: about.php:49
msgid "Developers working on Cacti, its Architecture, Documentation and Future Releases."
msgstr "Ndị mmepe na-arụ ọrụ na Cacti, Nhazi ya, Akwụkwọ ya na Mwepụta Ọdịnihu."

#: about.php:61
msgid "Honorable Mentions"
msgstr "Nkwanye Ugwu Kwesịrị Ekwesị"

#: about.php:62
msgid "Contributors to Documentation, QA, Packaging, the Forums and our YouTube page."
msgstr "Ndị nyere aka na Akwụkwọ, QA, Nkwakọ ngwaahịa, Nzukọ na ibe YouTube anyị."

#: about.php:70
msgid "Emeritus Members"
msgstr "Ndị Otu Emeritus"

#: about.php:71
msgid "Members of the original Cacti Group that have since moved on in their careers.  We continue to wish them the best."
msgstr "Ndị otu Cacti Group mbụ ndị gara n'ihu n'ọrụ ha. Anyị na-aga n'ihu na-achọrọ ha ihe kacha mma."

#: about.php:84
msgid "Thanks"
msgstr "Daalụ"

#: about.php:87
#, php-format
msgid "A very special thanks to %sTobi Oetiker%s, the creator of %sRRDtool%s and the very popular %sMRTG%s."
msgstr "Ekele pụrụ iche dịrị %sTobi Oetiker%s, onye mepụtara %sRRDtool%s na %sMRTG%s a ma ama."

#: about.php:90
msgid "The users of Cacti"
msgstr "Ndị ọrụ Cacti"

#: about.php:91
msgid "Especially anyone who has taken the time to create an issue report, or otherwise help fix a Cacti related problems. Also to anyone who has contributed to supporting Cacti."
msgstr "Karịsịa onye ọ bụla wepụtara oge iji mepụta akụkọ nsogbu, ma ọ bụ nyere aka dozie nsogbu metụtara Cacti. Nakwa onye ọ bụla nyere aka n'ịkwado Cacti."

#: about.php:96
msgid "License"
msgstr "Ikike"

#: about.php:98
msgid "Cacti is licensed under the GNU GPL:"
msgstr "Enyere ikike Cacti n'okpuru GNU GPL:"

#: about.php:102 lib/installer.php:1866
msgid "This program is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation; either version 2 of the License, or (at your option) any later version."
msgstr "Mmemme a bụ ngwanrọ n'efu; ị nwere ike ikesa ya ọzọ ma ọ bụ gbanwee ya n'okpuru usoro nke GNU General Public License dịka Free Software Foundation bipụtara; ma ọ bụ ụdị 2 nke Ikikere ahụ, ma ọ bụ (na nhọrọ gị) ụdị ọ bụla sochirinụ."

#: about.php:110
msgid "This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details."
msgstr "A na-ekesa mmemme a n'olileanya na ọ ga-aba uru, mana ENWEGHỊ NKWA Ọ BỤLA; ọbụlagodi na-enweghị nkwa ezoro ezo nke ỊZỤ AHỊA ma ọ bụ NTỌZU MAKA Otu EBUMNUCHE. Lee GNU General Public License maka nkọwa ndị ọzọ."

