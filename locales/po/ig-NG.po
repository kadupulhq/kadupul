msgstr "Oge Nkwụsị RRDChecker"

#: include/global_settings.php:1402
msgid "The maximum amount of time Cacti's RRDfile check script can run without generating a timeout error and being killed."
msgstr "Oge kachasị script nnyocha RRDfile nke Cacti nwere ike ịgba n'emeghị njehie nkwụsị oge ma gbuo ya."

