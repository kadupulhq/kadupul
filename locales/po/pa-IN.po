msgstr "dashes ਮਾਡੀਫ਼ਾਇਰ ਡੈਸ਼ ਵਾਲੀ ਲਾਈਨ ਸ਼ੈਲੀ ਨੂੰ ਸਮਰੱਥ ਕਰਦਾ ਹੈ।"

#: include/global_form.php:1085
msgid "Dash Offset (dash-offset=offset)"
msgstr "ਡੈਸ਼ ਔਫ਼ਸੈੱਟ (dash-offset=offset)"

