#: lib/installer.php
msgid "The following PHP extensions are recommended, and should be installed before continuing your Kadupul install.  NOTE: If you are planning on supporting SNMPv3 with IPv6, you should not install the php-snmp module at this time."
msgstr "ਹੇਠ ਲਿਖੇ PHP ਐਕਸਟੈਨਸ਼ਨਾਂ ਦੀ ਸਿਫ਼ਾਰਸ਼ ਕੀਤੀ ਜਾਂਦੀ ਹੈ, ਅਤੇ ਆਪਣੀ Kadupul ਇੰਸਟਾਲੇਸ਼ਨ ਜਾਰੀ ਰੱਖਣ ਤੋਂ ਪਹਿਲਾਂ ਇਹ ਇੰਸਟਾਲ ਹੋਣੇ ਚਾਹੀਦੇ ਹਨ।  ਨੋਟ: ਜੇ ਤੁਸੀਂ IPv6 ਨਾਲ SNMPv3 ਸਹਾਇਤਾ ਦੀ ਯੋਜਨਾ ਬਣਾ ਰਹੇ ਹੋ, ਤਾਂ ਇਸ ਸਮੇਂ php-snmp ਮੌਡਿਊਲ ਇੰਸਟਾਲ ਨਾ ਕਰੋ।"

#: lib/installer.php
msgid "Optional Modules"
msgstr "ਵਿਕਲਪਿਕ ਮੌਡਿਊਲ"

#: lib/installer.php
msgid "Optional"
msgstr "ਵਿਕਲਪਿਕ"

#: lib/installer.php
msgid "MySQL - TimeZone Support"
msgstr "MySQL - ਟਾਈਮਜ਼ੋਨ ਸਹਾਇਤਾ"

#: lib/installer.php
msgid "Your MySQL TimeZone database is not populated.  Please populate this database before proceeding."
msgstr "ਤੁਹਾਡਾ MySQL ਟਾਈਮਜ਼ੋਨ ਡਾਟਾਬੇਸ ਭਰਿਆ ਨਹੀਂ ਗਿਆ ਹੈ।  ਅੱਗੇ ਵਧਣ ਤੋਂ ਪਹਿਲਾਂ ਕਿਰਪਾ ਕਰਕੇ ਇਹ ਡਾਟਾਬੇਸ ਭਰੋ।"

#: lib/installer.php
msgid "Your Kadupul database login account does not have access to the MySQL TimeZone database.  Please provide the Kadupul database account \"select\" access to the \"time_zone_name\" table in the \"mysql\" database, and populate MySQL's TimeZone information before proceeding."
msgstr "ਤੁਹਾਡੇ Kadupul ਡਾਟਾਬੇਸ ਲੌਗਇਨ ਖਾਤੇ ਕੋਲ MySQL ਟਾਈਮਜ਼ੋਨ ਡਾਟਾਬੇਸ ਤੱਕ ਪਹੁੰਚ ਨਹੀਂ ਹੈ।  ਕਿਰਪਾ ਕਰਕੇ ਅੱਗੇ ਵਧਣ ਤੋਂ ਪਹਿਲਾਂ Kadupul ਡਾਟਾਬੇਸ ਖਾਤੇ ਨੂੰ \"mysql\" ਡਾਟਾਬੇਸ ਦੀ \"time_zone_name\" ਟੇਬਲ ਉੱਤੇ \"select\" ਪਹੁੰਚ ਦਿਓ, ਅਤੇ MySQL ਦੀ ਟਾਈਮਜ਼ੋਨ ਜਾਣਕਾਰੀ ਭਰੋ।"

#: lib/installer.php
msgid "Your Kadupul database account has access to the MySQL TimeZone database and that database is populated with global TimeZone information."
msgstr "ਤੁਹਾਡੇ Kadupul ਡਾਟਾਬੇਸ ਖਾਤੇ ਕੋਲ MySQL ਟਾਈਮਜ਼ੋਨ ਡਾਟਾਬੇਸ ਤੱਕ ਪਹੁੰਚ ਹੈ ਅਤੇ ਉਹ ਡਾਟਾਬੇਸ ਗਲੋਬਲ ਟਾਈਮਜ਼ੋਨ ਜਾਣਕਾਰੀ ਨਾਲ ਭਰਿਆ ਹੋਇਆ ਹੈ।"

#: lib/installer.php
msgid "MySQL - Settings"
msgstr "MySQL - ਸੈਟਿੰਗਾਂ"

#: lib/installer.php
msgid "These MySQL performance tuning settings will help your Kadupul system perform better without issues for a longer time."
msgstr "ਇਹ MySQL ਕਾਰਗੁਜ਼ਾਰੀ ਟਿਊਨਿੰਗ ਸੈਟਿੰਗਾਂ ਤੁਹਾਡੇ Kadupul ਸਿਸਟਮ ਨੂੰ ਲੰਮੇ ਸਮੇਂ ਤੱਕ ਬਿਨਾਂ ਸਮੱਸਿਆਵਾਂ ਦੇ ਬਿਹਤਰ ਕੰਮ ਕਰਨ ਵਿੱਚ ਮਦਦ ਕਰਨਗੀਆਂ।"

#: lib/installer.php
msgid "Recommended MySQL System Variable Settings"
msgstr "ਸਿਫ਼ਾਰਸ਼ੀ MySQL ਸਿਸਟਮ ਵੇਰੀਏਬਲ ਸੈਟਿੰਗਾਂ"

#: lib/installer.php
msgid "Installation Type"
msgstr "ਇੰਸਟਾਲੇਸ਼ਨ ਦੀ ਕਿਸਮ"

#: lib/installer.php
#, php-format
msgid "Upgrade from <strong>%s</strong> to <strong>%s</strong>"
msgstr "<strong>%s</strong> ਤੋਂ <strong>%s</strong> ਵਿੱਚ ਅੱਪਗ੍ਰੇਡ"

#: lib/installer.php
msgid "In the event of issues, it is highly recommended that you clear your browser cache, closing then reopening your browser (not just the tab Kadupul is on) and retrying, before raising an issue with Kadupul"
msgstr "ਸਮੱਸਿਆਵਾਂ ਹੋਣ ਦੀ ਸੂਰਤ ਵਿੱਚ, Kadupul ਨਾਲ ਸਮੱਸਿਆ ਦਰਜ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਆਪਣਾ ਬ੍ਰਾਊਜ਼ਰ ਕੈਸ਼ ਸਾਫ਼ ਕਰਨ, ਬ੍ਰਾਊਜ਼ਰ (ਸਿਰਫ਼ ਉਹ ਟੈਬ ਨਹੀਂ ਜਿਸ ਵਿੱਚ Kadupul ਖੁੱਲ੍ਹਾ ਹੈ) ਨੂੰ ਬੰਦ ਕਰਕੇ ਮੁੜ ਖੋਲ੍ਹਣ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰਨ ਦੀ ਪੁਰਜ਼ੋਰ ਸਿਫ਼ਾਰਸ਼ ਕੀਤੀ ਜਾਂਦੀ ਹੈ"

#: lib/installer.php
msgid "On rare occasions, we have had reports from users who experience some minor issues due to changes in the code.  These issues are caused by the browser retaining pre-upgrade code and whilst we have taken steps to minimise the chances of this, it may still occur.  If you need instructions on how to clear your browser cache, <a href='https://www.refreshyourcache.com' target='_blank'>https://www.refreshyourcache.com/</a> is a good starting point."
msgstr "ਕਦੇ-ਕਦਾਈਂ, ਸਾਨੂੰ ਉਪਭੋਗਤਾਵਾਂ ਤੋਂ ਕੋਡ ਵਿੱਚ ਤਬਦੀਲੀਆਂ ਕਾਰਨ ਕੁਝ ਮਾਮੂਲੀ ਸਮੱਸਿਆਵਾਂ ਦੀਆਂ ਰਿਪੋਰਟਾਂ ਮਿਲੀਆਂ ਹਨ।  ਇਹ ਸਮੱਸਿਆਵਾਂ ਬ੍ਰਾਊਜ਼ਰ ਵੱਲੋਂ ਅੱਪਗ੍ਰੇਡ ਤੋਂ ਪਹਿਲਾਂ ਦਾ ਕੋਡ ਰੱਖਣ ਕਾਰਨ ਹੁੰਦੀਆਂ ਹਨ ਅਤੇ ਭਾਵੇਂ ਅਸੀਂ ਇਨ੍ਹਾਂ ਦੀ ਸੰਭਾਵਨਾ ਘਟਾਉਣ ਲਈ ਕਦਮ ਚੁੱਕੇ ਹਨ, ਫਿਰ ਵੀ ਇਹ ਹੋ ਸਕਦੀਆਂ ਹਨ।  ਜੇ ਤੁਹਾਨੂੰ ਬ੍ਰਾਊਜ਼ਰ ਕੈਸ਼ ਸਾਫ਼ ਕਰਨ ਦੀਆਂ ਹਦਾਇਤਾਂ ਚਾਹੀਦੀਆਂ ਹਨ, ਤਾਂ <a href='https://www.refreshyourcache.com' target='_blank'>https://www.refreshyourcache.com/</a> ਇੱਕ ਚੰਗੀ ਸ਼ੁਰੂਆਤ ਹੈ।"

#: lib/installer.php
msgid "If after clearing your cache and restarting your browser, you still experience issues, please raise the issue with us and we will try to identify the cause of it."
msgstr "ਜੇ ਕੈਸ਼ ਸਾਫ਼ ਕਰਨ ਅਤੇ ਬ੍ਰਾਊਜ਼ਰ ਮੁੜ ਸ਼ੁਰੂ ਕਰਨ ਤੋਂ ਬਾਅਦ ਵੀ ਤੁਹਾਨੂੰ ਸਮੱਸਿਆਵਾਂ ਆਉਂਦੀਆਂ ਹਨ, ਤਾਂ ਕਿਰਪਾ ਕਰਕੇ ਸਮੱਸਿਆ ਸਾਡੇ ਕੋਲ ਦਰਜ ਕਰੋ ਅਤੇ ਅਸੀਂ ਇਸ ਦਾ ਕਾਰਨ ਲੱਭਣ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰਾਂਗੇ।"

#: lib/installer.php
#, php-format
msgid "Downgrade from <strong>%s</strong> to <strong>%s</strong>"
msgstr "<strong>%s</strong> ਤੋਂ <strong>%s</strong> ਵਿੱਚ ਡਾਊਨਗ੍ਰੇਡ"

#: lib/installer.php
msgid "You appear to be downgrading to a previous version.  Database changes made for the newer version will not be reversed and <i>could</i> cause issues."
msgstr "ਤੁਸੀਂ ਪਿਛਲੇ ਵਰਜ਼ਨ ਵਿੱਚ ਡਾਊਨਗ੍ਰੇਡ ਕਰਦੇ ਜਾਪਦੇ ਹੋ।  ਨਵੇਂ ਵਰਜ਼ਨ ਲਈ ਕੀਤੀਆਂ ਡਾਟਾਬੇਸ ਤਬਦੀਲੀਆਂ ਵਾਪਸ ਨਹੀਂ ਹੋਣਗੀਆਂ ਅਤੇ ਇਨ੍ਹਾਂ ਨਾਲ ਸਮੱਸਿਆਵਾਂ <i>ਹੋ ਸਕਦੀਆਂ</i> ਹਨ।"

