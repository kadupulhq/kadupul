msgstr "ਟੈਬ ਚੌੜਾਈ (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "ਮੂਲ ਰੂਪ ਵਿੱਚ ਟੈਬ ਦੀ ਚੌੜਾਈ 40 ਪਿਕਸਲ ਹੁੰਦੀ ਹੈ, ਇਸ ਨੂੰ ਬਦਲਣ ਲਈ ਇਹ ਚੋਣ ਵਰਤੋ।"

#: include/global_form.php
