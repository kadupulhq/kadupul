#: include/global_settings.php
msgid "Enter the secondary DNS IP Address to utilize for reverse lookups."
msgstr "ਰਿਵਰਸ ਲੁੱਕਅੱਪ ਲਈ ਵਰਤਣ ਵਾਲਾ ਸੈਕੰਡਰੀ DNS IP ਪਤਾ ਦਰਜ ਕਰੋ।"

#: include/global_settings.php
msgid "DNS Timeout"
msgstr "DNS ਟਾਈਮਆਊਟ"

#: include/global_settings.php
msgid "Please enter the DNS timeout in milliseconds.  Kadupul uses a PHP based DNS resolver."
msgstr "ਕਿਰਪਾ ਕਰਕੇ ਮਿਲੀਸਕਿੰਟਾਂ ਵਿੱਚ DNS ਟਾਈਮਆਊਟ ਦਰਜ ਕਰੋ।  Kadupul PHP ਆਧਾਰਿਤ DNS ਰੈਜ਼ੋਲਵਰ ਵਰਤਦਾ ਹੈ।"

#: include/global_settings.php
msgid "On-demand RRD Update Settings"
msgstr "ਮੰਗ ਅਨੁਸਾਰ RRD ਅੱਪਡੇਟ ਸੈਟਿੰਗਾਂ"

#: include/global_settings.php
msgid "Enable On-demand RRD Updating"
msgstr "ਮੰਗ ਅਨੁਸਾਰ RRD ਅੱਪਡੇਟ ਸਮਰੱਥ ਕਰੋ"

#: include/global_settings.php
msgid "Should Boost enable on demand RRD updating in Kadupul?  If you disable, this change will not take effect until after the next polling cycle.  When you have Remote Data Collectors, this setting is required to be on."
msgstr "ਕੀ Boost ਨੂੰ Kadupul ਵਿੱਚ ਮੰਗ ਅਨੁਸਾਰ RRD ਅੱਪਡੇਟ ਸਮਰੱਥ ਕਰਨੇ ਚਾਹੀਦੇ ਹਨ?  ਜੇ ਤੁਸੀਂ ਅਸਮਰੱਥ ਕਰਦੇ ਹੋ, ਤਾਂ ਇਹ ਤਬਦੀਲੀ ਅਗਲੇ ਪੋਲਿੰਗ ਚੱਕਰ ਤੋਂ ਬਾਅਦ ਹੀ ਲਾਗੂ ਹੋਵੇਗੀ।  ਜਦੋਂ ਤੁਹਾਡੇ ਕੋਲ ਰਿਮੋਟ ਡਾਟਾ ਕੁਲੈਕਟਰ ਹੋਣ, ਤਾਂ ਇਸ ਸੈਟਿੰਗ ਦਾ ਚਾਲੂ ਹੋਣਾ ਲਾਜ਼ਮੀ ਹੈ।"

#: include/global_settings.php
msgid "System Level RRD Updater"
msgstr "ਸਿਸਟਮ ਪੱਧਰ RRD ਅੱਪਡੇਟਰ"

#: include/global_settings.php
msgid "Before RRD On-demand Update Can be Cleared, a poller run must always pass"
msgstr "RRD ਮੰਗ ਅਨੁਸਾਰ ਅੱਪਡੇਟ ਸਾਫ਼ ਕੀਤੇ ਜਾਣ ਤੋਂ ਪਹਿਲਾਂ, ਇੱਕ ਪੋਲਰ ਰਨ ਦਾ ਲੰਘਣਾ ਹਮੇਸ਼ਾ ਲਾਜ਼ਮੀ ਹੈ"

#: include/global_settings.php
msgid "How Often Should Boost Update All RRDs"
msgstr "Boost ਕਿੰਨੀ ਵਾਰ ਸਾਰੀਆਂ RRD ਅੱਪਡੇਟ ਕਰੇ"

#: include/global_settings.php
msgid "When you enable boost, your RRD files are only updated when they are requested by a user, or when this time period elapses."
msgstr "ਜਦੋਂ ਤੁਸੀਂ boost ਸਮਰੱਥ ਕਰਦੇ ਹੋ, ਤਾਂ ਤੁਹਾਡੀਆਂ RRD ਫਾਈਲਾਂ ਸਿਰਫ਼ ਉਦੋਂ ਅੱਪਡੇਟ ਹੁੰਦੀਆਂ ਹਨ ਜਦੋਂ ਉਪਭੋਗਤਾ ਉਹਨਾਂ ਦੀ ਮੰਗ ਕਰੇ, ਜਾਂ ਜਦੋਂ ਇਹ ਸਮਾਂ-ਮਿਆਦ ਪੂਰੀ ਹੋ ਜਾਵੇ।"

#: include/global_settings.php
msgid "Number of Boost Processes"
msgstr "Boost ਪ੍ਰਕਿਰਿਆਵਾਂ ਦੀ ਗਿਣਤੀ"

#: include/global_settings.php
msgid "The number of concurrent boost processes to use to process all of the RRDs in the boost table."
msgstr "boost ਸਾਰਣੀ ਵਿਚਲੀਆਂ ਸਾਰੀਆਂ RRD ਪ੍ਰੋਸੈਸ ਕਰਨ ਲਈ ਵਰਤੀਆਂ ਜਾਣ ਵਾਲੀਆਂ ਇੱਕੋ ਸਮੇਂ ਦੀਆਂ boost ਪ੍ਰਕਿਰਿਆਵਾਂ ਦੀ ਗਿਣਤੀ।"

#: include/global_settings.php
msgid "Boost Processing Mode"
msgstr "Boost ਪ੍ਰੋਸੈਸਿੰਗ ਮੋਡ"

#: include/global_settings.php
msgid "How Boost distributes RRD updates. Forked processes start the number of Boost processes above on every run. Message queue workers hand each partition to Messenger workers instead."
msgstr "Boost RRD ਅੱਪਡੇਟਾਂ ਨੂੰ ਕਿਵੇਂ ਵੰਡਦਾ ਹੈ। ਫੋਰਕ ਕੀਤੀਆਂ ਪ੍ਰਕਿਰਿਆਵਾਂ ਹਰ ਰਨ ਉੱਤੇ ਉੱਪਰ ਦਿੱਤੀ Boost ਪ੍ਰਕਿਰਿਆਵਾਂ ਦੀ ਗਿਣਤੀ ਸ਼ੁਰੂ ਕਰਦੀਆਂ ਹਨ। ਮੈਸੇਜ ਕਿਊ ਵਰਕਰ ਇਸ ਦੀ ਬਜਾਏ ਹਰ ਪਾਰਟੀਸ਼ਨ ਨੂੰ Messenger ਵਰਕਰਾਂ ਨੂੰ ਸੌਂਪਦੇ ਹਨ।"

#: include/global_settings.php
msgid "Forked processes"
msgstr "ਫੋਰਕ ਕੀਤੀਆਂ ਪ੍ਰਕਿਰਿਆਵਾਂ"

#: include/global_settings.php
msgid "Message queue workers"
msgstr "ਮੈਸੇਜ ਕਿਊ ਵਰਕਰ"

#: include/global_settings.php
msgid "Maximum Records"
msgstr "ਵੱਧ ਤੋਂ ਵੱਧ ਰਿਕਾਰਡ"

#: include/global_settings.php
msgid "If the boost output table exceeds this size, in records, an update will take place."
msgstr "ਜੇ boost ਆਉਟਪੁੱਟ ਸਾਰਣੀ ਦਾ ਆਕਾਰ, ਰਿਕਾਰਡਾਂ ਵਿੱਚ, ਇਸ ਤੋਂ ਵੱਧ ਹੋ ਜਾਵੇ, ਤਾਂ ਅੱਪਡੇਟ ਕੀਤਾ ਜਾਵੇਗਾ।"

#: include/global_settings.php
msgid "Maximum Data Source Items Per Pass"
msgstr "ਪ੍ਰਤੀ ਪਾਸ ਵੱਧ ਤੋਂ ਵੱਧ ਡਾਟਾ ਸਰੋਤ ਆਈਟਮਾਂ"

#: include/global_settings.php
msgid "To optimize performance, the boost RRD updater needs to know how many Data Source Items should be retrieved in one pass.  Please be careful not to set too high as graphing performance during major updates can be compromised.  If you encounter graphing or polling slowness during updates, lower this number.  The default value is 50000."
msgstr "ਕਾਰਗੁਜ਼ਾਰੀ ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਲਈ, boost RRD ਅੱਪਡੇਟਰ ਨੂੰ ਪਤਾ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ ਕਿ ਇੱਕ ਪਾਸ ਵਿੱਚ ਕਿੰਨੀਆਂ ਡਾਟਾ ਸਰੋਤ ਆਈਟਮਾਂ ਲਈਆਂ ਜਾਣ।  ਕਿਰਪਾ ਕਰਕੇ ਧਿਆਨ ਰੱਖੋ ਕਿ ਇਸ ਨੂੰ ਬਹੁਤ ਜ਼ਿਆਦਾ ਨਾ ਰੱਖੋ, ਕਿਉਂਕਿ ਵੱਡੇ ਅੱਪਡੇਟਾਂ ਦੌਰਾਨ ਗ੍ਰਾਫ਼ਿੰਗ ਦੀ ਕਾਰਗੁਜ਼ਾਰੀ ਪ੍ਰਭਾਵਿਤ ਹੋ ਸਕਦੀ ਹੈ।  ਜੇ ਅੱਪਡੇਟਾਂ ਦੌਰਾਨ ਗ੍ਰਾਫ਼ਿੰਗ ਜਾਂ ਪੋਲਿੰਗ ਵਿੱਚ ਹੌਲੀਪਣ ਆਵੇ, ਤਾਂ ਇਹ ਗਿਣਤੀ ਘਟਾਓ।  ਮੂਲ ਮੁੱਲ 50000 ਹੈ।"

#: include/global_settings.php
msgid "Maximum Argument Length"
msgstr "ਆਰਗੂਮੈਂਟ ਦੀ ਵੱਧ ਤੋਂ ਵੱਧ ਲੰਬਾਈ"

#: include/global_settings.php
msgid "When boost sends update commands to RRDtool, it must not exceed the operating system's Maximum Argument Length.  This varies by operating system and kernel level.  For example: Windows 2000 <= 2048, FreeBSD <= 65535, Linux 2.6.22-- <= 131072, Linux 2.6.23++ unlimited"
msgstr "ਜਦੋਂ boost RRDtool ਨੂੰ ਅੱਪਡੇਟ ਕਮਾਂਡਾਂ ਭੇਜਦਾ ਹੈ, ਤਾਂ ਇਹ ਓਪਰੇਟਿੰਗ ਸਿਸਟਮ ਦੀ ਵੱਧ ਤੋਂ ਵੱਧ ਆਰਗੂਮੈਂਟ ਲੰਬਾਈ ਤੋਂ ਵੱਧ ਨਹੀਂ ਹੋਣੀ ਚਾਹੀਦੀ।  ਇਹ ਓਪਰੇਟਿੰਗ ਸਿਸਟਮ ਅਤੇ ਕਰਨਲ ਪੱਧਰ ਅਨੁਸਾਰ ਵੱਖਰੀ ਹੁੰਦੀ ਹੈ।  ਉਦਾਹਰਨ ਲਈ: Windows 2000 <= 2048, FreeBSD <= 65535, Linux 2.6.22-- <= 131072, Linux 2.6.23++ ਅਸੀਮਤ"

