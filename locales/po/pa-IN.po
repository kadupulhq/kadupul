msgstr "ਗਤੀਸ਼ੀਲ ਲੇਬਲ (--dynamic-labels)"

#: include/global_form.php
msgid "Draw line markers as a line."
msgstr "ਲਾਈਨ ਮਾਰਕਰਾਂ ਨੂੰ ਲਾਈਨ ਵਜੋਂ ਬਣਾਓ।"

#: include/global_form.php
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "ਨਿਯਮ ਲੈਜੈਂਡ ਜ਼ਬਰਦਸਤੀ ਲਾਗੂ ਕਰੋ (--force-rules-legend)"

#: include/global_form.php
msgid "Force the generation of HRULE and VRULE legends."
msgstr "HRULE ਅਤੇ VRULE ਲੈਜੈਂਡ ਬਣਾਉਣ ਨੂੰ ਜ਼ਬਰਦਸਤੀ ਲਾਗੂ ਕਰੋ।"

