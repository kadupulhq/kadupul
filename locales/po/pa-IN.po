msgstr "ਰਿਵਰਸ ਲੁੱਕਅੱਪ ਲਈ ਵਰਤਣ ਵਾਲਾ ਮੁੱਖ DNS IP ਪਤਾ ਦਰਜ ਕਰੋ।"

#: include/global_settings.php
msgid "Secondary DNS IP Address"
