msgstr "Jazyk"

#: include/global_settings.php:359
msgid "Default language for this system."
msgstr "Výchozí jazyk tohoto systému."

#: include/global_settings.php:365
msgid "Auto Language Detection"
msgstr "Automatická detekce jazyka"

#: include/global_settings.php:366
msgid "Allow to automatically determine the 'default' language of the user and provide it at login time if that language is supported by Cacti. If disabled, the default language will be in force until the user elects another language."
msgstr "Umožňuje automaticky zjistit 'výchozí' jazyk uživatele a nabídnout jej při přihlášení, pokud je tento jazyk podporován Cacti. Je-li zakázáno, platí výchozí jazyk, dokud uživatel nezvolí jiný."

#: include/global_settings.php:375
