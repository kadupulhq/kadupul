#: include/global_settings.php
msgid "Spine Config File Path"
msgstr "Cesta ke konfiguračnímu souboru Spine"

#: include/global_settings.php
msgid "The path to Spine configuration file.  By default, in the cwd of Spine, or /etc if not specified."
msgstr "Cesta ke konfiguračnímu souboru Spine.  Ve výchozím nastavení v aktuálním pracovním adresáři Spine, případně /etc, pokud není zadána."

#: include/global_settings.php
msgid "RRDfile Auto Clean"
msgstr "Automatické čištění RRDfile"

#: include/global_settings.php
msgid "Automatically archive or delete RRDfiles when their corresponding Data Sources are removed from Kadupul"
msgstr "Automaticky archivovat nebo mazat soubory RRDfile, když jsou jejich odpovídající zdroje dat z Kadupul odstraněny"

#: include/global_settings.php
msgid "RRDfile Auto Clean Method"
msgstr "Metoda automatického čištění RRDfile"

#: include/global_settings.php
