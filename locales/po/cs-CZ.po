msgstr "Frekvence rotace"

#: include/global_settings.php
msgid "At what frequency would you like to rotate your logs?"
msgstr "S jakou frekvencí chcete své protokoly rotovat?"

#: include/global_settings.php
msgid "Log Retention"
msgstr "Uchovávání protokolů"

#: include/global_settings.php
msgid "How many log files do you wish to retain?  Use 0 to never remove any logs. (0-365)"
msgstr "Kolik souborů protokolu chcete uchovávat?  Použijte 0, pokud se žádné protokoly nemají nikdy odstraňovat. (0-365)"

#: include/global_settings.php
