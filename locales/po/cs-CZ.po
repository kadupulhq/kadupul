#: include/global_settings.php
msgid "Poller Standard Error Log Path"
msgstr "Cesta k protokolu standardní chyby pollera"

#: include/global_settings.php
msgid "If you are having issues with Kadupul's Data Collectors, set this file path and the Data Collectors' standard error will be redirected to this file"
msgstr "Pokud máte potíže se sběrači dat Kadupul, nastavte tuto cestu k souboru a standardní chyba sběračů dat se přesměruje do tohoto souboru"

#: include/global_settings.php
msgid "Rotate the Kadupul Log"
msgstr "Rotovat protokol Kadupul"

#: include/global_settings.php
msgid "This option will rotate the Kadupul Log periodically."
msgstr "Tato volba bude protokol Kadupul pravidelně rotovat."

#: include/global_settings.php
