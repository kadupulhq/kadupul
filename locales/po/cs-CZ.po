msgstr "Skript/zdroj použitý ke sběru dat pro tento zdroj dat."

#: include/global_form.php package_import.php
msgid "Select the Data Source Profile.  The Data Source Profile controls polling interval, the data aggregation, and retention policy for the resulting Data Sources."
msgstr "Vyberte profil zdroje dat.  Profil zdroje dat řídí interval dotazování, agregaci dat a zásady uchování výsledných zdrojů dat."

#: include/global_form.php
msgid "The amount of time in seconds between expected updates."
msgstr "Doba v sekundách mezi očekávanými aktualizacemi."

#: include/global_form.php
msgid "Data Source Active"
msgstr "Zdroj dat aktivní"

#: include/global_form.php
msgid "Whether Kadupul should gather data for this data source or not."
msgstr "Zda má Kadupul pro tento zdroj dat sbírat data, či nikoli."

#: include/global_form.php
msgid "Internal Data Source Name"
msgstr "Interní název zdroje dat"

#: include/global_form.php
msgid "Choose a unique name to represent this piece of data inside of the RRDfile."
msgstr "Zvolte jedinečný název, který bude tento údaj v RRDfile reprezentovat."

#: include/global_form.php
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "Minimální hodnota (\"U\" pro bez minima)"

#: include/global_form.php
msgid "The minimum value of data that is allowed to be collected."
msgstr "Minimální hodnota dat, kterou je povoleno sbírat."

#: include/global_form.php
msgid "Maximum Value (\"U\" for No Maximum)"
msgstr "Maximální hodnota (\"U\" pro bez maxima)"

#: include/global_form.php
msgid "The maximum value of data that is allowed to be collected."
msgstr "Maximální hodnota dat, kterou je povoleno sbírat."

#: include/global_form.php
msgid "Data Source Type"
msgstr "Typ zdroje dat"

#: include/global_form.php
msgid "How data is represented in the RRA."
msgstr "Způsob reprezentace dat v RRA."

#: include/global_form.php
msgid "The maximum amount of time that can pass before data is entered as 'unknown'. (Usually 2x300=600)"
msgstr "Maximální doba, která může uplynout, než se data zapíší jako 'neznámá'. (Obvykle 2x300=600)"

#: include/global_form.php
msgid "Output Field"
msgstr "Výstupní pole"

#: include/global_form.php lib/html_utility.php
msgid "Not Selected"
msgstr "Nevybráno"

#: include/global_form.php
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "Při sběru dat budou data tohoto pole vložena do tohoto zdroje dat."

#: include/global_form.php
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "Zadejte název této předvolby GPRINT, a to tak, abyste jej poznali."

#: include/global_form.php
msgid "GPRINT Text"
msgstr "Text GPRINT"

#: include/global_form.php
msgid "Enter the custom GPRINT string here."
msgstr "Zde zadejte vlastní řetězec GPRINT."

#: include/global_form.php
msgid "Common Options"
msgstr "Běžné možnosti"

#: include/global_form.php
msgid "Title (--title)"
msgstr "Titulek (--title)"

#: include/global_form.php
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "Název vytištěný na grafu.  Může obsahovat zástupné proměnné jako |host_description| nebo |query_fieldName|.  Úplný seznam podporovaných zástupných značek naleznete v dokumentaci Kadupul."

#: include/global_form.php
msgid "Vertical Label (--vertical-label)"
msgstr "Svislý popisek (--vertical-label)"

#: include/global_form.php
msgid "The label vertically printed to the left of the graph."
msgstr "Popisek vytištěný svisle vlevo od grafu."

#: include/global_form.php
msgid "Image Format (--imgformat)"
msgstr "Formát obrázku (--imgformat)"

#: include/global_form.php
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "Typ generovaného grafu; PNG, GIF nebo SVG.  Výběr typu obrázku grafu výrazně závisí na RRDtool."

#: include/global_form.php
msgid "Height (--height)"
msgstr "Výška (--height)"

#: include/global_form.php
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Výška (v pixelech) oblasti grafu uvnitř grafu. Tato oblast nezahrnuje legendu, legendy os ani titulek."

#: include/global_form.php
msgid "Width (--width)"
msgstr "Šířka (--width)"

#: include/global_form.php
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Šířka (v pixelech) oblasti grafu uvnitř grafu. Tato oblast nezahrnuje legendu, legendy os ani titulek."

#: include/global_form.php
msgid "Base Value (--base)"
msgstr "Základní hodnota (--base)"

#: include/global_form.php
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "Pro paměť by mělo být nastaveno na 1024 a pro měření provozu na 1000."

#: include/global_form.php
msgid "Slope Mode (--slope-mode)"
msgstr "Režim sklonu (--slope-mode)"

#: include/global_form.php
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Použití režimu sklonu vyhladí tvar grafů na úkor části rozlišení na obrazovce."

#: include/global_form.php
msgid "Scaling Options"
msgstr "Možnosti škálování"

#: include/global_form.php
msgid "Auto Scale"
msgstr "Automatické škálování"

#: include/global_form.php
msgid "When enabled, the selected Auto Scale Option determines which limits RRDtool uses: --alt-autoscale ignores both limits, --alt-autoscale-max keeps the lower limit, --alt-autoscale-min keeps the upper limit, and --alt-autoscale (accepting both limits) keeps both limits. When disabled, the configured lower and upper limits are used directly. Rigid Boundaries controls whether values outside those limits expand the graph range."
msgstr "Je-li povoleno, vybraná možnost automatického škálování určuje, které meze RRDtool použije: --alt-autoscale ignoruje obě meze, --alt-autoscale-max ponechá dolní mez, --alt-autoscale-min ponechá horní mez a --alt-autoscale (s přijetím obou mezí) ponechá obě meze. Je-li zakázáno, použijí se přímo nakonfigurované dolní a horní meze. Pevné hranice určují, zda hodnoty mimo tyto meze rozšíří rozsah grafu."

#: include/global_form.php
msgid "Auto Scale Options"
msgstr "Možnosti automatického škálování"

#: include/global_form.php
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "Použijte <br> --alt-autoscale pro škálování na absolutní minimum a maximum <br> --alt-autoscale-max pro škálování na maximální hodnotu s použitím zadané dolní meze <br> --alt-autoscale-min pro škálování na minimální hodnotu s použitím zadané horní meze <br> --alt-autoscale (s mezemi) pro škálování s použitím dolní i horní meze (výchozí v RRDtool) <br>"

#: include/global_form.php
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "Použít --alt-autoscale (zadané meze se ignorují)"

#: include/global_form.php
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "Použít --alt-autoscale-max (s přijetím dolní meze)"

#: include/global_form.php
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "Použít --alt-autoscale-min (s přijetím horní meze)"

#: include/global_form.php
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "Použít --alt-autoscale (s přijetím obou mezí, výchozí v RRDtool)"

#: include/global_form.php
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Logaritmické škálování (--logarithmic)"

#: include/global_form.php
msgid "Use Logarithmic y-axis scaling"
msgstr "Použít logaritmické škálování osy y"

#: include/global_form.php
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "Jednotky SI pro logaritmické škálování (--units=si)"

#: include/global_form.php
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "Použít jednotky SI pro logaritmické měřítko místo exponenciálního zápisu.<br> Poznámka: Lineární grafy ve výchozím nastavení používají zápis SI."

#: include/global_form.php
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "Režim pevných mezí (--rigid)"

#: include/global_form.php
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "Nerozšiřovat dolní a horní mez, pokud graf obsahuje hodnotu mimo platný rozsah."

#: include/global_form.php
msgid "Upper Limit (--upper-limit)"
msgstr "Horní mez (--upper-limit)"

#: include/global_form.php
msgid "The maximum vertical value for the graph."
msgstr "Maximální svislá hodnota grafu."

#: include/global_form.php
msgid "Lower Limit (--lower-limit)"
msgstr "Dolní mez (--lower-limit)"

#: include/global_form.php
msgid "The minimum vertical value for the graph."
msgstr "Minimální svislá hodnota grafu."

#: include/global_form.php
msgid "Grid Options"
msgstr "Možnosti mřížky"

#: include/global_form.php
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "Hodnota jednotky mřížky (--unit/--y-grid)"

#: include/global_form.php
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "Nastavuje hodnotu exponentu na ose Y pro čísla. Poznámka: Tato volba je zastaralá a nahrazena volbou --y-grid.  U této volby se čáry mřížky osy Y zobrazují v každém kroku mřížky.  Popisky se umísťují každých několik čar podle faktoru popisků."

#: include/global_form.php
msgid "Unit Exponent Value (--units-exponent)"
msgstr "Hodnota exponentu jednotky (--units-exponent)"

#: include/global_form.php
msgid "What unit Kadupul should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Jakou jednotku má Kadupul použít na ose Y. Použijte 3 pro zobrazení všeho v \"k\" nebo -6 pro zobrazení všeho v \"u\" (mikro)."

#: include/global_form.php
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "Délka jednotky (--units-length &lt;length&gt;)"

#: include/global_form.php
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "Kolik číslic má RRDtool předpokládat u popisků osy Y? Tuto volbu možná budete muset použít k vytvoření dostatečného místa, jakmile začnete upravovat popisky osy Y."

#: include/global_form.php
msgid "No Gridfit (--no-gridfit)"
msgstr "Bez přichycení k mřížce (--no-gridfit)"

#: include/global_form.php
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "Aby se předešlo rozmazání způsobenému vyhlazováním, RRDtool přichytává body k pixelům rozlišení zařízení, což vede k ostřejšímu vzhledu. Pokud vám to nevyhovuje, můžete toto chování tímto přepínačem vypnout.<br><strong>Poznámka: </strong>Přichytávání k mřížce je u výstupu PDF, EPS, SVG ve výchozím nastavení vypnuto."

#: include/global_form.php
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "Alternativní mřížka Y (--alt-y-grid)"

#: include/global_form.php
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "Algoritmus zajišťuje, že mřížka vždy existuje, že je čar mřížky dostatek, ale ne příliš mnoho, a že mřížka je metrická. Tento parametr také zajistí zobrazení dostatečného počtu desetinných míst, i když se graf pohybuje od 69.998 do 70.001.<br><strong>Poznámka: </strong>Tento parametr může kolidovat s volbami --alt-autoscale."

#: include/global_form.php
msgid "Axis Options"
msgstr "Možnosti os"

#: include/global_form.php
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "Pravá osa (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "Napravo od grafu se vykreslí druhá osa. S levou osou je svázána pomocí parametrů měřítka a posunu."

#: include/global_form.php
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "Popisek pravé osy (--right-axis-label &lt;string&gt;)"

#: include/global_form.php
msgid "The label for the right axis."
msgstr "Popisek pravé osy."

#: include/global_form.php
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "Formát pravé osy (--right-axis-format &lt;format&gt;)"

#: include/global_form.php
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "Ve výchozím nastavení se formát popisků os určuje automaticky.  Pokud to chcete provést sami, použijte tuto volbu se stejnými argumenty %lf, které znáte z příkazů PRINT a GPRINT."

#: include/global_form.php
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "Formátovač pravé osy (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you set up the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Při nastavení popisků pravé osy použijte na formát dat pravidlo.  Podporované formáty zahrnují \"numeric\", kde se data považují za číselná, \"timestamp\", kde se hodnoty interpretují jako časová razítka UNIX (počet sekund od ledna 1970) a vyjadřují se ve formátu strftime (výchozí je \"%Y-%m-%d %H:%M:%S\").  Viz také --units-length a --right-axis-format.  Nakonec \"duration\", kde se hodnoty interpretují jako doba trvání v milisekundách.  Formátování se řídí pravidly valstrfduration kvalifikovaného PRINT/GPRINT."

#: include/global_form.php
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "Formátovač levé osy (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you set up the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Při nastavení popisků levé osy použijte na formát dat pravidlo.  Podporované formáty zahrnují \"numeric\", kde se data považují za číselná, \"timestamp\", kde se hodnoty interpretují jako časová razítka UNIX (počet sekund od ledna 1970) a vyjadřují se ve formátu strftime (výchozí je \"%Y-%m-%d %H:%M:%S\").  Viz také --units-length.  Nakonec \"duration\", kde se hodnoty interpretují jako doba trvání v milisekundách.  Formátování se řídí pravidly valstrfduration kvalifikovaného PRINT/GPRINT."

#: include/global_form.php
msgid "Legend Options"
msgstr "Možnosti legendy"

#: include/global_form.php
msgid "Auto Padding"
msgstr "Automatické odsazení"

#: include/global_form.php
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "Doplnit text mezerami tak, aby legenda a data grafu byly vždy zarovnány. Poznámka: může to způsobit delší vykreslování grafů kvůli větší režii. Automatické odsazení také nemusí být přesné u všech typů grafů, konzistentní popisky obvykle pomáhají."

#: include/global_form.php
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "Dynamické popisky (--dynamic-labels)"

#: include/global_form.php
msgid "Draw line markers as a line."
msgstr "Vykreslit značky čar jako čáru."

#: include/global_form.php
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "Vynutit legendu pravidel (--force-rules-legend)"

#: include/global_form.php
msgid "Force the generation of HRULE and VRULE legends."
msgstr "Vynutit vygenerování legend HRULE a VRULE."

#: include/global_form.php
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "Šířka tabulátoru (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "Ve výchozím nastavení je šířka tabulátoru 40 pixelů, tuto volbou ji můžete změnit."

#: include/global_form.php
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "Umístění legendy (--legend-position=&lt;position&gt;)"

#: include/global_form.php
msgid "Place the legend at the given side of the graph."
msgstr "Umístit legendu na zadanou stranu grafu."

#: include/global_form.php
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Směr legendy (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php
msgid "Place the legend items in the given vertical order."
msgstr "Umístit položky legendy v zadaném svislém pořadí."

#: include/global_form.php lib/api_aggregate.php lib/html.php
msgid "Graph Item Type"
msgstr "Typ položky grafu"

#: include/global_form.php
msgid "How data for this item is represented visually on the graph."
msgstr "Jak jsou data této položky na grafu vizuálně znázorněna."

#: include/global_form.php
msgid "The data source to use for this graph item."
msgstr "Zdroj dat, který se má pro tuto položku grafu použít."

#: include/global_form.php
msgid "The color to use for the legend."
msgstr "Barva, která se má použít pro legendu."

#: include/global_form.php
msgid "Opacity/Alpha Channel"
msgstr "Průhlednost/kanál alfa"

#: include/global_form.php
msgid "The opacity/alpha channel of the color."
msgstr "Průhlednost/kanál alfa barvy."

#: include/global_form.php lib/rrd.php
msgid "Consolidation Function"
msgstr "Konsolidační funkce"

#: include/global_form.php
msgid "How data for this item is represented statistically on the graph."
msgstr "Jak jsou data této položky na grafu znázorněna statisticky."

#: include/global_form.php
msgid "CDEF Function"
msgstr "Funkce CDEF"

#: include/global_form.php
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "Funkce CDEF (matematická), která se použije na tuto položku grafu nebo legendy."

#: include/global_form.php
msgid "VDEF Function"
msgstr "Funkce VDEF"

#: include/global_form.php
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "Funkce VDEF (matematická), která se použije na tuto položku v legendě grafu."

#: include/global_form.php
msgid "Shift Data"
msgstr "Posunout data"

#: include/global_form.php
msgid "Offset your data on the time axis (x-axis) by the amount specified in the 'value' field."
msgstr "Posune vaše data na časové ose (ose X) o hodnotu zadanou v poli 'value'."

#: include/global_form.php
msgid "[HRULE|VRULE]: The value of the graph item.<br/> [TICK]: The fraction for the tick line.<br/> [SHIFT]: The time offset in seconds."
msgstr "[HRULE|VRULE]: Hodnota položky grafu.<br/> [TICK]: Zlomek pro čáru značky.<br/> [SHIFT]: Časový posun v sekundách."

#: include/global_form.php
msgid "GPRINT Type"
msgstr "Typ GPRINT"

#: include/global_form.php
msgid "If this graph item is a GPRINT, you can optionally choose another format here. You can define additional types under \"GPRINT Presets\"."
msgstr "Pokud je tato položka grafu GPRINT, můžete zde volitelně zvolit jiný formát. Další typy můžete definovat v části \"Předvolby GPRINT\"."

#: include/global_form.php
msgid "Text Alignment (TEXTALIGN)"
msgstr "Zarovnání textu (TEXTALIGN)"

#: include/global_form.php
msgid "All subsequent legend line(s) will be aligned as given here.  You may use this command multiple times in a single graph.  This command does not produce tabular layout.<br/><strong>Note: </strong>You may want to insert a &lt;HR&gt; on the preceding graph item.<br/> <strong>Note: </strong>A &lt;HR&gt; on this legend line will obsolete this setting!"
msgstr "Všechny následující řádky legendy budou zarovnány tak, jak je zde zadáno.  Tento příkaz můžete v jednom grafu použít vícekrát.  Tento příkaz nevytváří tabulkové rozvržení.<br/><strong>Poznámka: </strong>Možná budete chtít vložit &lt;HR&gt; do předchozí položky grafu.<br/> <strong>Poznámka: </strong>&lt;HR&gt; na tomto řádku legendy toto nastavení zruší!"

#: include/global_form.php
msgid "Text Format"
msgstr "Formát textu"

#: include/global_form.php
msgid "Text that will be displayed on the legend for this graph item."
msgstr "Text, který se zobrazí v legendě pro tuto položku grafu."

#: include/global_form.php
msgid "Insert Hard Return"
msgstr "Vložit tvrdý návrat"

#: include/global_form.php
msgid "Forces the legend to the next line after this item."
msgstr "Vynutí přechod legendy na další řádek za touto položkou."

#: include/global_form.php
msgid "Dashes (dashes[=on_s[,off_s[,on_s,off_s]...]])"
msgstr "Čárkování (dashes[=on_s[,off_s[,on_s,off_s]...]])"

#: include/global_form.php
msgid "The dashes modifier enables dashed line style."
msgstr "Modifikátor dashes povolí styl čárkované čáry."

#: include/global_form.php
msgid "Dash Offset (dash-offset=offset)"
msgstr "Posun čárkování (dash-offset=offset)"

#: include/global_form.php
msgid "The dash-offset parameter specifies an offset into the pattern at which the stroke begins."
msgstr "Parametr dash-offset určuje posun ve vzoru, od kterého tah začíná."

#: include/global_form.php lib/api_automation.php lib/html_reports.php
msgid "Sequence"
msgstr "Pořadí"

