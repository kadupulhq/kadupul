#: include/global_settings.php:1721 user_domains.php:435
msgid "Port SSL"
msgstr "Puerto SSL"

#: include/global_settings.php:1722
msgid "TCP port for LDAPS for SSL communications.  Default is 636."
msgstr "Puerto TCP/UDP para comunicaciones no SSL."

#: include/global_settings.php:1729 user_domains.php:444
msgid "Protocol Version"
msgstr "Versión del Protocolo"

#: include/global_settings.php:1730
msgid "Protocol Version to connect to the server with."
msgstr "Versión del Protocolo que soporta el servidor."

#: include/global_settings.php:1736
msgid "Connect Timeout"
msgstr "Tiempo de conexión agotado"

#: include/global_settings.php:1737
msgid "The Network Connect Timeout in seconds."
msgstr "Ingrese el tiempo de espera SMTP en segundos."

#: include/global_settings.php:1744
msgid "Bind Timeout"
msgstr "Tiempo de espera"

#: include/global_settings.php:1745
msgid "The Bind Timeout in seconds."
msgstr "Ingrese el tiempo de espera SMTP en segundos."

#: include/global_settings.php:1752
msgid "LDAP Debug Mode"
