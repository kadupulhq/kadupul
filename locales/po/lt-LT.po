msgstr "Didžiausias plotis, iki kurio medis gali išsiplėsti; jį viršijus medžio šakos bus slenkamos puslapyje."

#: include/global_settings.php
msgid "Filter Settings"
msgstr "Filtro nustatymai"

#: include/global_settings.php
