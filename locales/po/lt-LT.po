msgstr "Aptikti automatiškai pakartotinio indeksavimo metu"

#: include/global_form.php:178
msgid "Auto Detect/Set on first Re-Index"
msgstr "Aptikti / nustatyti automatiškai per pirmąjį pakartotinį indeksavimą"

