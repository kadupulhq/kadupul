msgstr "Текст постављен у дну центра сваког графикона."

#: include/global_settings.php
msgid "Custom Date Format"
msgstr "Прилагођени формат датума"

#: include/global_settings.php
msgid "To be used when formatting |date_time| on a graph"
msgstr "Користи се при форматирању |date_time| на графикону"

#: include/global_settings.php
