msgid "Select the Data Source Profile.  The Data Source Profile controls polling interval, the data aggregation, and retention policy for the resulting Data Sources."
msgstr "Изаберите профил извора података.  Профил извора података контролише интервал прикупљања, агрегацију података и политику задржавања за резултујуће изворе података."

#: include/global_form.php
msgid "The amount of time in seconds between expected updates."
msgstr "Количина времена у секундама између очекиваних ажурирања."

#: include/global_form.php
msgid "Data Source Active"
msgstr "Извор података је активан"

#: include/global_form.php
msgid "Whether Kadupul should gather data for this data source or not."
msgstr "Да ли Kadupul треба да прикупља податке за овај извор података или не."

#: include/global_form.php
msgid "Internal Data Source Name"
msgstr "Интерни назив извора података"

#: include/global_form.php
msgid "Choose a unique name to represent this piece of data inside of the RRDfile."
msgstr "Изаберите јединствен назив који представља овај податак унутар RRDfile."

#: include/global_form.php
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "Минимална вредност (\"U\" за без минимума)"

#: include/global_form.php
msgid "The minimum value of data that is allowed to be collected."
msgstr "Минимална вредност података која се сме прикупити."

#: include/global_form.php
msgid "Maximum Value (\"U\" for No Maximum)"
msgstr "Максимална вредност (\"U\" за без максимума)"

#: include/global_form.php
msgid "The maximum value of data that is allowed to be collected."
msgstr "Максимална вредност података која се сме прикупити."

#: include/global_form.php
msgid "Data Source Type"
msgstr "Врста извора података"

#: include/global_form.php
msgid "How data is represented in the RRA."
msgstr "Како су подаци представљени у RRA."

#: include/global_form.php
msgid "The maximum amount of time that can pass before data is entered as 'unknown'. (Usually 2x300=600)"
msgstr "Највећа количина времена која може проћи пре него што се подаци унесу као „непознати“. (Обично 2x300=600)"

#: include/global_form.php
msgid "Output Field"
msgstr "Излазно поље"

#: include/global_form.php lib/html_utility.php
msgid "Not Selected"
msgstr "Није изабрано"

#: include/global_form.php
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "Када се подаци прикупе, подаци за ово поље биће смештени у овај извор података."

#: include/global_form.php
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "Унесите назив за ово GPRINT претподешавање, обавезно нешто што препознајете."

#: include/global_form.php
msgid "GPRINT Text"
msgstr "GPRINT текст"

#: include/global_form.php
msgid "Enter the custom GPRINT string here."
msgstr "Овде унесите прилагођени GPRINT низ."

#: include/global_form.php
msgid "Common Options"
msgstr "Уобичајене опције"

#: include/global_form.php
msgid "Title (--title)"
msgstr "Наслов (--title)"

#: include/global_form.php
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "Назив који се штампа на графикону.  Може садржати променљиве замене као што су |host_description| или |query_fieldName|.  За комплетну листу подржаних ознака замене погледајте Kadupul документацију."

#: include/global_form.php
msgid "Vertical Label (--vertical-label)"
msgstr "Вертикална ознака (--vertical-label)"

#: include/global_form.php
msgid "The label vertically printed to the left of the graph."
msgstr "Ознака која се вертикално штампа лево од графикона."

#: include/global_form.php
msgid "Image Format (--imgformat)"
msgstr "Формат слике (--imgformat)"

#: include/global_form.php
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "Врста генерисаног графикона; PNG, GIF или SVG.  Избор врсте слике графикона у великој мери зависи од RRDtool-а."

#: include/global_form.php
msgid "Height (--height)"
msgstr "Висина (--height)"

#: include/global_form.php
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Висина (у пикселима) површине графикона унутар графикона. Ова површина не укључује легенду, легенде оса или наслов."

#: include/global_form.php
msgid "Width (--width)"
msgstr "Ширина (--width)"

#: include/global_form.php
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Ширина (у пикселима) површине графикона унутар графикона. Ова површина не укључује легенду, легенде оса или наслов."

#: include/global_form.php
msgid "Base Value (--base)"
msgstr "Основна вредност (--base)"

#: include/global_form.php
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "Требало би да буде 1024 за меморију и 1000 за мерења саобраћаја."

#: include/global_form.php
msgid "Slope Mode (--slope-mode)"
msgstr "Режим нагиба (--slope-mode)"

#: include/global_form.php
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Коришћење режима нагиба изглађује облик графикона на рачун дела резолуције на екрану."

#: include/global_form.php
msgid "Scaling Options"
msgstr "Опције скалирања"

#: include/global_form.php
msgid "Auto Scale"
msgstr "Аутоматско скалирање"

#: include/global_form.php
msgid "When enabled, the selected Auto Scale Option determines which limits RRDtool uses: --alt-autoscale ignores both limits, --alt-autoscale-max keeps the lower limit, --alt-autoscale-min keeps the upper limit, and --alt-autoscale (accepting both limits) keeps both limits. When disabled, the configured lower and upper limits are used directly. Rigid Boundaries controls whether values outside those limits expand the graph range."
msgstr "Када је омогућено, изабрана опција аутоматског скалирања одређује које границе RRDtool користи: --alt-autoscale занемарује обе границе, --alt-autoscale-max задржава доњу границу, --alt-autoscale-min задржава горњу границу, а --alt-autoscale (прихвата обе границе) задржава обе границе. Када је онемогућено, директно се користе подешене доња и горња граница. Круте границе контролишу да ли вредности изван тих граница проширују опсег графикона."

#: include/global_form.php
msgid "Auto Scale Options"
msgstr "Опције аутоматског скалирања"

#: include/global_form.php
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "Користите <br> --alt-autoscale за скалирање на апсолутни минимум и максимум <br> --alt-autoscale-max за скалирање на максималну вредност, уз задату доњу границу <br> --alt-autoscale-min за скалирање на минималну вредност, уз задату горњу границу <br> --alt-autoscale (са границама) за скалирање уз обе, доњу и горњу границу (подразумевано за RRDtool) <br>"

#: include/global_form.php
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "Користи --alt-autoscale (занемарује задате границе)"

#: include/global_form.php
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "Користи --alt-autoscale-max (прихвата доњу границу)"

#: include/global_form.php
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "Користи --alt-autoscale-min (прихвата горњу границу)"

#: include/global_form.php
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "Користи --alt-autoscale (прихвата обе границе, подразумевано за RRDtool)"

#: include/global_form.php
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Логаритамско скалирање (--logarithmic)"

#: include/global_form.php
msgid "Use Logarithmic y-axis scaling"
msgstr "Користи логаритамско скалирање y-осе"

#: include/global_form.php
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "SI јединице за логаритамско скалирање (--units=si)"

#: include/global_form.php
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "Користите SI јединице за логаритамско скалирање уместо експоненцијалне нотације.<br> Напомена: Линеарни графикони подразумевано користе SI нотацију."

#: include/global_form.php
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "Режим крутих граница (--rigid)"

#: include/global_form.php
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "Не проширујте доњу и горњу границу ако графикон садржи вредност ван важећег опсега."

#: include/global_form.php
msgid "Upper Limit (--upper-limit)"
msgstr "Горња граница (--upper-limit)"

#: include/global_form.php
msgid "The maximum vertical value for the graph."
msgstr "Максимална вертикална вредност за графикон."

#: include/global_form.php
msgid "Lower Limit (--lower-limit)"
msgstr "Доња граница (--lower-limit)"

#: include/global_form.php
msgid "The minimum vertical value for the graph."
msgstr "Минимална вертикална вредност за графикон."

#: include/global_form.php
msgid "Grid Options"
msgstr "Опције мреже"

#: include/global_form.php
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "Јединична вредност мреже (--unit/--y-grid)"

#: include/global_form.php
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "Поставља вредност експонента на Y-оси за бројеве. Напомена: Ова опција је застарела и замењена је опцијом --y-grid.  Код ове опције линије мреже Y-осе појављују се на сваком кораку мреже.  Ознаке се постављају на сваких неколико линија према фактору ознаке."

#: include/global_form.php
msgid "Unit Exponent Value (--units-exponent)"
msgstr "Вредност јединичног експонента (--units-exponent)"

#: include/global_form.php
msgid "What unit Kadupul should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Коју јединицу Kadupul треба да користи на Y-оси. Користите 3 да се све прикаже у \"k\" или -6 да се све прикаже у \"u\" (микро)."

#: include/global_form.php
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "Дужина јединице (--units-length &lt;length&gt;)"

#: include/global_form.php
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "Колико цифара RRDtool треба да претпостави за ознаке y-осе? Можда ћете морати да користите ову опцију да обезбедите довољно простора када почнете да подешавате означавање y-осе."

#: include/global_form.php
msgid "No Gridfit (--no-gridfit)"
msgstr "Без прилагођавања мрежи (--no-gridfit)"

#: include/global_form.php
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "Да би се избегли ефекти замућења услед изглађивања ивица, RRDtool поравнава тачке на пикселе резолуције уређаја, што даје оштрији изглед. Ако вам то не одговара, можете користити овај прекидач да искључите то понашање.<br><strong>Напомена: </strong>Прилагођавање мрежи је подразумевано искључено за PDF, EPS, SVG излаз."

#: include/global_form.php
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "Алтернативна Y мрежа (--alt-y-grid)"

#: include/global_form.php
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "Алгоритам обезбеђује да увек имате мрежу, да има довољно, али не превише линија мреже, и да је мрежа метричка. Овај параметар ће такође обезбедити да се прикаже довољно децимала чак и ако ваш графикон иде од 69.998 до 70.001.<br><strong>Напомена: </strong>Овај параметар може ометати опције --alt-autoscale."

#: include/global_form.php
msgid "Axis Options"
msgstr "Опције оса"

#: include/global_form.php
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "Десна оса (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "Друга оса ће бити нацртана десно од графикона. Повезана је са левом осом преко параметара размере и помака."

#: include/global_form.php
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "Ознака десне осе (--right-axis-label &lt;string&gt;)"

#: include/global_form.php
msgid "The label for the right axis."
msgstr "Ознака за десну осу."

#: include/global_form.php
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "Формат десне осе (--right-axis-format &lt;format&gt;)"

#: include/global_form.php
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "Подразумевано се формат ознака осе одређује аутоматски.  Ако желите то да урадите сами, користите ову опцију са истим %lf аргументима које познајете из команди PRINT и GPRINT."

#: include/global_form.php
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "Форматер десне осе (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you set up the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Када подешавате означавање десне осе, примените правило на формат података.  Подржани формати укључују \"numeric\" где се подаци третирају као бројеви, \"timestamp\" где се вредности тумаче као UNIX временске ознаке (број секунди од јануара 1970) и изражавају помоћу strftime формата (подразумевано је \"%Y-%m-%d %H:%M:%S\").  Погледајте и --units-length и --right-axis-format.  На крају \"duration\" где се вредности тумаче као трајање у милисекундама.  Форматирање прати правила valstrfduration квалификованог PRINT/GPRINT."

#: include/global_form.php
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "Форматер леве осе (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you set up the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Када подешавате означавање леве осе, примените правило на формат података.  Подржани формати укључују \"numeric\" где се подаци третирају као бројеви, \"timestamp\" где се вредности тумаче као UNIX временске ознаке (број секунди од јануара 1970) и изражавају помоћу strftime формата (подразумевано је \"%Y-%m-%d %H:%M:%S\").  Погледајте и --units-length.  На крају \"duration\" где се вредности тумаче као трајање у милисекундама.  Форматирање прати правила valstrfduration квалификованог PRINT/GPRINT."

#: include/global_form.php
msgid "Legend Options"
msgstr "Опције легенде"

#: include/global_form.php
msgid "Auto Padding"
msgstr "Аутоматско попуњавање"

#: include/global_form.php
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "Попуните текст тако да се легенда и подаци графикона увек поравнају. Напомена: ово може узроковати спорије приказивање графикона због већег оптерећења. Такође, аутоматско попуњавање можда није прецизно на свим типовима графикона, доследно означавање обично помаже."

#: include/global_form.php
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "Динамичке ознаке (--dynamic-labels)"

#: include/global_form.php
msgid "Draw line markers as a line."
msgstr "Нацртајте маркере линија као линију."

#: include/global_form.php
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "Наметни легенду правила (--force-rules-legend)"

#: include/global_form.php
msgid "Force the generation of HRULE and VRULE legends."
msgstr "Наметните генерисање HRULE и VRULE легенди."

#: include/global_form.php
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "Ширина табулатора (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "Подразумевано је ширина табулатора 40 пиксела, користите ову опцију да је промените."

#: include/global_form.php
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "Позиција легенде (--legend-position=&lt;position&gt;)"

#: include/global_form.php
msgid "Place the legend at the given side of the graph."
msgstr "Поставите легенду на дату страну графикона."

#: include/global_form.php
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Смер легенде (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php
msgid "Place the legend items in the given vertical order."
msgstr "Поставите ставке легенде датим вертикалним редоследом."

#: include/global_form.php lib/api_aggregate.php lib/html.php
msgid "Graph Item Type"
msgstr "Тип ставке графикона"

#: include/global_form.php
msgid "How data for this item is represented visually on the graph."
msgstr "Како су подаци за ову ставку визуелно приказани на графикону."

#: include/global_form.php
msgid "The data source to use for this graph item."
msgstr "Извор података који ће се користити за ову ставку графикона."

#: include/global_form.php
msgid "The color to use for the legend."
msgstr "Боја која ће се користити за легенду."

#: include/global_form.php
msgid "Opacity/Alpha Channel"
msgstr "Непрозирност/алфа канал"

#: include/global_form.php
msgid "The opacity/alpha channel of the color."
msgstr "Непрозирност/алфа канал боје."

#: include/global_form.php lib/rrd.php
msgid "Consolidation Function"
msgstr "Функција консолидације"

#: include/global_form.php
msgid "How data for this item is represented statistically on the graph."
msgstr "Како су подаци за ову ставку статистички приказани на графикону."

#: include/global_form.php
msgid "CDEF Function"
msgstr "CDEF функција"

#: include/global_form.php
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "CDEF (математичка) функција која се примењује на ову ставку на графикону или легенди."

#: include/global_form.php
msgid "VDEF Function"
msgstr "VDEF функција"

#: include/global_form.php
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "VDEF (математичка) функција која се примењује на ову ставку на легенди графикона."

#: include/global_form.php
msgid "Shift Data"
msgstr "Помери податке"

#: include/global_form.php
msgid "Offset your data on the time axis (x-axis) by the amount specified in the 'value' field."
msgstr "Померите своје податке на временској оси (x-оси) за износ наведен у пољу 'value'."

#: include/global_form.php
msgid "[HRULE|VRULE]: The value of the graph item.<br/> [TICK]: The fraction for the tick line.<br/> [SHIFT]: The time offset in seconds."
