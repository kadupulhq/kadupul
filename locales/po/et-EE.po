msgstr "Graafikute pealkirjade jaoks kasutatav font.  Sisesta kas kehtiv True Type Fondi fail või kehtiv Pango font-config väärtus."

#: include/global_settings.php:1113 include/global_settings.php:2899
msgid "Legend Font Size"
msgstr "Legendi fondi suurus"

#: include/global_settings.php:1114 include/global_settings.php:2900
msgid "The size of the font used for Graph Legend items"
msgstr "Graafiku legendi kirjete jaoks kasutatava fondi suurus"

#: include/global_settings.php:1121
msgid "Legend Font Setting"
msgstr "Legendi fondi seadistus"

#: include/global_settings.php:1122
msgid "The font to use for Graph Legends.  Enter either a valid True Type Font file or valid Pango font-config value."
msgstr "Graafikute legendide jaoks kasutatav font.  Sisesta kas kehtiv True Type Fondi fail või kehtiv Pango font-config väärtus."

#: include/global_settings.php:1128 include/global_settings.php:2912
msgid "Axis Font Size"
msgstr "Telje fondi suurus"

#: include/global_settings.php:1129 include/global_settings.php:2913
msgid "The size of the font used for Graph Axis"
msgstr "Graafiku telje jaoks kasutatava fondi suurus"

#: include/global_settings.php:1136
msgid "Axis Font Setting"
msgstr "Telje fondi seadistus"

#: include/global_settings.php:1137
msgid "The font to use for Graph Axis items.  Enter either a valid True Type Font file or valid Pango font-config value."
msgstr "Graafikute telgede kirjete jaoks kasutatav font.  Sisesta kas kehtiv True Type Fondi fail või kehtiv Pango font-config väärtus."

#: include/global_settings.php:1143 include/global_settings.php:2925
msgid "Unit Font Size"
msgstr "Ühiku fondi suurus"

#: include/global_settings.php:1144 include/global_settings.php:2926
msgid "The size of the font used for Graph Units"
msgstr "Graafiku ühikute jaoks kasutatava fondi suurus"

#: include/global_settings.php:1151
msgid "Unit Font Setting"
msgstr "Ühiku fondi seadistus"

#: include/global_settings.php:1152
msgid "The font to use for Graph Unit items.  Enter either a valid True Type Font file or valid Pango font-config value."
msgstr "Graafikute ühikute kirjete jaoks kasutatav font.  Sisesta kas kehtiv True Type Fondi fail või kehtiv Pango font-config väärtus."

#: include/global_settings.php:1158
msgid "Business Hours Settings"
msgstr "Tööaja seaded"

#: include/global_settings.php:1163
msgid "Start of Business Day"
msgstr "Tööpäeva algus"

#: include/global_settings.php:1164
msgid "The time your business hours start. Format: hh:mm"
msgstr "Aeg, mil sinu tööaeg algab. Vorming: hh:mm"

#: include/global_settings.php:1171
msgid "End of Business Day"
msgstr "Tööpäeva lõpp"

#: include/global_settings.php:1172
msgid "The time your business hours end. Format: hh:mm"
msgstr "Aeg, mil sinu tööaeg lõpeb. Vorming: hh:mm"

#: include/global_settings.php:1179
msgid "Hide Weekends"
msgstr "Peida nädalavahetused"

#: include/global_settings.php:1180
msgid "Only show business hours during weekdays."
msgstr "Kuva tööaega ainult tööpäevadel."

#: include/global_settings.php:1185
msgid "Show business hours"
msgstr "Kuva tööaeg"

#: include/global_settings.php:1186
msgid "Display business hours on rrd graphs."
msgstr "Kuva tööaega rrd-graafikutel."

#: include/global_settings.php:1191
msgid "Color to use for business hours"
msgstr "Tööaja jaoks kasutatav värv"

#: include/global_settings.php:1192
msgid "The color to be shown for business hours"
msgstr "Tööaja jaoks kuvatav värv"

#: include/global_settings.php:1199
msgid "Maximum number of days to show business hours"
msgstr "Maksimaalne päevade arv tööaja kuvamiseks"

#: include/global_settings.php:1200
msgid "After this number of days, the business hours will not be added to the graph. <br/>Recommended: 62 days"
msgstr "Pärast seda päevade arvu ei lisata tööaega graafikule. <br/>Soovitatav: 62 päeva"

#: include/global_settings.php:1215
msgid "Data Collection Enabled"
msgstr "Andmekogumine lubatud"

#: include/global_settings.php:1216
msgid "If you wish to stop the polling process completely, uncheck this box."
msgstr "Kui soovid pollimisprotsessi täielikult peatada, eemalda see märge."

#: include/global_settings.php:1222
msgid "SNMP Agent Support Enabled"
msgstr "SNMP agendi tugi lubatud"

#: include/global_settings.php:1223
msgid "If this option is checked, Cacti will populate SNMP Agent tables with Cacti device and system information.  It does not enable the SNMP Agent itself."
msgstr "Kui see suvand on märgitud, täidab Cacti SNMP agendi tabelid Cacti seadme- ja süsteemiteabega.  See ei luba SNMP agenti ennast."

#: include/global_settings.php:1228
msgid "Poller Type"
msgstr "Pollija tüüp"

#: include/global_settings.php:1229
msgid "The poller type to use.  This setting will take affect at next polling interval."
msgstr "Kasutatav pollija tüüp.  See säte jõustub järgmisel pollimisintervallil."

#: include/global_settings.php:1235
msgid "Poller Sync Interval"
msgstr "Pollija sünkroonimisintervall"

#: include/global_settings.php:1236
msgid "The default polling sync interval to use when creating a poller.  This setting will affect how often remote pollers are checked and updated."
msgstr "Pollija loomisel kasutatav vaikimisi pollimise sünkroonimisintervall.  See seadistus mõjutab, kui sageli kaugpollijaid kontrollitakse ja uuendatakse."

#: include/global_settings.php:1243
msgid "The polling interval in use.  This setting will affect how often RRDfiles are checked and updated.  <strong><u>NOTE: If you change this value, you must re-populate the poller cache.  Failure to do so, may result in lost data.</u></strong>"
msgstr "Kasutatav pollimisintervall.  See seadistus mõjutab, kui sageli RRDfile'e kontrollitakse ja uuendatakse.  <strong><u>MÄRKUS: kui sa seda väärtust muudad, pead pollija vahemälu uuesti täitma.  Selle tegemata jätmine võib põhjustada andmete kadumist.</u></strong>"

#: include/global_settings.php:1249
msgid "Cron/Daemon Interval"
msgstr "Cron/deemoni intervall"

#: include/global_settings.php:1250
msgid "The frequency that the Cacti data collector will be started.  You can use either crontab, a scheduled task (for windows), or the cactid systemd service to control launching the Cacti data collector.  For instructions on using the cactid daemon, review the README.md file in the service directory."
msgstr "Sagedus, millega Cacti andmekoguja käivitatakse.  Cacti andmekoguja käivitamise juhtimiseks võid kasutada kas crontabi, ajastatud ülesannet (Windowsi jaoks) või cactid systemd teenust.  Cactid deemoni kasutamise juhised leiad kataloogis service asuvast failist README.md."

#: include/global_settings.php:1256
msgid "Balance Process Load"
msgstr "Tasakaalusta protsesside koormust"

#: include/global_settings.php:1257
msgid "If you choose this option, Cacti will attempt to balance the load of each poller process by equally distributing poller items per process."
msgstr "Kui valid selle suvandi, proovib Cacti iga pollija protsessi koormust tasakaalustada, jaotades pollija kirjed protsesside vahel võrdselt."

#: include/global_settings.php:1262
msgid "Debug Output Width"
msgstr "Silumisväljundi laius"

#: include/global_settings.php:1263
msgid "If you choose this option, Cacti will check for output that exceeds Cacti's ability to store it and issue a warning when it finds it."
msgstr "Kui valid selle suvandi, kontrollib Cacti väljundit, mis ületab Cacti salvestusvõime, ja annab leidmisel hoiatuse."

#: include/global_settings.php:1268
msgid "Disable increasing OID Check"
msgstr "Keela kasvava OID kontroll"

#: include/global_settings.php:1269
msgid "Controls disabling check for increasing OID while walking OID tree."
msgstr "Juhib OID-puu läbimisel kasvava OID kontrolli keelamist."

#: include/global_settings.php:1274
msgid "Remote Agent Timeout"
msgstr "Kaugagendi ajalõpp"

#: include/global_settings.php:1275
msgid "The amount of time, in seconds, that the Central Cacti web server will wait for a response from the Remote Data Collector to obtain various Device information before abandoning the request.  On Devices that are associated with Data Collectors other than the Central Cacti Data Collector, the Remote Agent must be used to gather Device information."
msgstr "Aeg sekundites, mille Cacti keskne veebiserver ootab kaugandmekoguja vastust erinevate seadmeteabe saamiseks, enne kui päringust loobub.  Seadmete puhul, mis on seotud muude andmekogujatega kui Cacti keskne andmekoguja, tuleb seadmeteabe kogumiseks kasutada kaugagenti."

#: include/global_settings.php:1288
msgid "SNMP Bulkwalk Fetch Size"
msgstr "SNMP Bulkwalk'i toomise suurus"

#: include/global_settings.php:1289
msgid "How many OID's should be returned per snmpbulkwalk request?  For Devices with large SNMP trees, increasing this size will increase re-index performance over a WAN."
msgstr "Mitu OID-i tuleks snmpbulkwalk päringu kohta tagastada?  Suurte SNMP puudega seadmete puhul parandab selle suuruse suurendamine uuesti indekseerimise jõudlust üle WAN-i."

#: include/global_settings.php:1308
msgid "SNMP Get OID Limit"
msgstr "SNMP Get OID piirang"

#: include/global_settings.php:1309
msgid "The default maximum number of SNMP Get OIDs to issue per snmpget request.  For Devices, this setting is controlled at the Device level.  You should only use this setting when using Cacti's SNMP API natively in your scripts or plugins."
msgstr "Vaikimisi maksimaalne SNMP Get OID-ide arv snmpget päringu kohta.  Seadmete puhul juhitakse seda sätet seadme tasemel.  Seda sätet peaksid kasutama ainult siis, kui kasutad Cacti SNMP API-t natiivselt oma skriptides või pistikprogrammides."

#: include/global_settings.php:1316
msgid "Disable Resource Cache Replication"
msgstr "Keela ressursivahemälu replikatsioon"

#: include/global_settings.php:1317
msgid "By default, the main Cacti Data Collector will cache the entire web site and plugins into a Resource Cache.  Then, periodically the Remote Data Collectors will update themselves with any updates from the main Cacti Data Collector.  This Resource Cache essentially allows Remote Data Collectors to self upgrade.  If you do not wish to use this option, you can disable it using this setting."
msgstr "Vaikimisi salvestab Cacti peamine andmekoguja kogu veebisaidi ja pistikprogrammid ressursivahemällu.  Seejärel uuendavad kaugandmekogujad end perioodiliselt Cacti peamise andmekoguja uuendustega.  See ressursivahemälu võimaldab kaugandmekogujatel sisuliselt ennast ise uuendada.  Kui sa seda suvandit kasutada ei soovi, saad selle sättega keelata."

#: include/global_settings.php:1322
msgid "Additional Data Collector Settings"
msgstr "Täiendavad andmekoguja seaded"

#: include/global_settings.php:1327
msgid "Invalid Data Logging"
msgstr "Kehtetute andmete logimine"

#: include/global_settings.php:1328
msgid "How would you like the Data Collector output errors logged?  Options include: 'Detailed' which details every error, 'Summary' which provides the number of output errors per Device, and 'None', which does not provide error counts."
msgstr "Kuidas soovid andmekoguja väljundvigu logida?  Valikud: „Üksikasjalik“, mis annab iga vea üksikasjad, „Kokkuvõte“, mis annab väljundvigade arvu seadme kohta, ja „Puudub“, mis ei anna vigade arvu."

#: include/global_settings.php:1333 utilities.php:180
msgid "Summary"
msgstr "Kokkuvõte"

#: include/global_settings.php:1334
msgid "Detailed"
msgstr "Üksikasjalik"

#: include/global_settings.php:1338
msgid "Number of PHP Script Servers"
msgstr "PHP skriptiserverite arv"

#: include/global_settings.php:1339
msgid "The number of concurrent script server processes to run per spine process.  Settings between 1 and 15 are accepted.  This parameter will help if you are running several threads and script server scripts and is only valid for the spine Data Collector."
msgstr "Ühe spine-protsessi kohta käivitatavate samaaegsete skriptiserveri protsesside arv.  Aktsepteeritakse seadeid vahemikus 1 kuni 15.  See parameeter aitab, kui käivitad mitu lõime ja skriptiserveri skripti, ning kehtib ainult spine'i andmekoguja puhul."

#: include/global_settings.php:1346
msgid "Script and Script Server Timeout Value"
msgstr "Skripti ja skriptiserveri ajalõpu väärtus"

#: include/global_settings.php:1347
msgid "The maximum time that spine will wait on a script to complete.  This timeout value is in seconds and is only valid for the spine Data Collector."
msgstr "Maksimaalne aeg, mille spine skripti lõppemist ootab.  See ajalõpu väärtus on sekundites ja kehtib ainult spine'i andmekoguja puhul."

#: include/global_settings.php:1354
msgid "Periodic All Device Re-Index"
msgstr "Perioodiline kõigi seadmete uuesti indekseerimine"

#: include/global_settings.php:1359
msgid "Re-Index All Device Schedule"
msgstr "Kõigi seadmete uuesti indekseerimise ajakava"

#: include/global_settings.php:1360
msgid "At what frequency do you wish to Re-Index all Devices.  This Re-Index will occur at midnight at the frequency that you select."
msgstr "Kui sageli soovid kõiki seadmeid uuesti indekseerida.  See uuesti indekseerimine toimub keskööl valitud sagedusega."

#: include/global_settings.php:1366
msgid "Weekly on Sunday"
msgstr "Iganädalaselt pühapäeviti"

#: include/global_settings.php:1367
msgid "Monthly on Sunady"
msgstr "Igakuiselt pühapäeval"

#: include/global_settings.php:1371
msgid "Background Timeout and Concurrent Process Settings"
msgstr "Taustaprotsesside ajalõpu ja samaaegsete protsesside seaded"

#: include/global_settings.php:1376
msgid "Report Generation Timeout"
msgstr "Aruande loomise ajalõpp"

#: include/global_settings.php:1377
msgid "The maximum amount of time Cacti's Reports Generation script can run without generating a timeout error and being killed."
msgstr "Maksimaalne aeg, mille Cacti aruannete genereerimise skript võib töötada, ilma et tekiks ajalõpu viga ja skript lõpetataks."

#: include/global_settings.php:1381 include/global_settings.php:1394
#: include/global_settings.php:1422 include/global_settings.php:1463
#: include/global_settings.php:1477
#, php-format
msgid "%s Minute"
msgstr "%s minut"

#: include/global_settings.php:1389
msgid "Data Source Statistics Timeout"
msgstr "Andmeallika statistika ajalõpp"

#: include/global_settings.php:1390
msgid "The maximum amount of time Cacti's Data Source Statistics script can run without generating a timeout error and being killed."
msgstr "Maksimaalne aeg, mille Cacti andmeallikate statistika skript võib töötada, ilma et tekiks ajalõpu viga ja skript lõpetataks."

#: include/global_settings.php:1404
msgid "RRDChecker Timeout"
msgstr "RRDCheckeri ajalõpp"

#: include/global_settings.php:1405
msgid "The maximum amount of time Cacti's RRDfile check script can run without generating a timeout error and being killed."
msgstr "Maksimaalne aeg, mille Cacti RRDfile'i kontrolli skript võib töötada, ilma et tekiks ajalõpu viga ja skript lõpetataks."

#: include/global_settings.php:1411 include/global_settings.php:1412
#: include/global_settings.php:1413 include/global_settings.php:1468
#: include/global_settings.php:1482
#, php-format
msgid "%s Hour"
msgstr "%s tund"

#: include/global_settings.php:1417
msgid "Poller Commands Timeout"
msgstr "Pollija käskude ajalõpp"

#: include/global_settings.php:1418
msgid "The maximum amount of time Cacti's Background Commands script can run without generating a timeout error and being killed.  This script will perform tasks such as re-indexing Devices and pruning devices from Remote Data Collectors."
msgstr "Maksimaalne aeg, mille Cacti taustakäskude skript võib töötada, ilma et tekiks ajalõpu viga ja skript lõpetataks.  See skript täidab selliseid ülesandeid nagu seadmete uuesti indekseerimine ja seadmete eemaldamine kaugandmekogujatest."

#: include/global_settings.php:1430
msgid "Poller Command Concurrent Processes"
msgstr "Pollija käskude samaaegsed protsessid"

#: include/global_settings.php:1431
msgid "The number of concurrent Poller Command processes.  The will be at most one concurrent command per host within the Poller Command pool."
msgstr "Samaaegsete pollija käskude protsesside arv.  Pollija käskude kogumis on hosti kohta kõige rohkem üks samaaegne käsk."

