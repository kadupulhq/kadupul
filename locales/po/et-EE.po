msgstr "Samaaegsete boost-protsesside arv, mida kasutada kõigi boost-tabelis olevate RRD-de töötlemiseks."

#: include/global_settings.php:2169
msgid "Maximum Records"
msgstr "Maksimaalne kirjete arv"

