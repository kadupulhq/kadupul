msgid "Lock Accounts"
msgstr "கணக்குகளைப் பூட்டு"

#: include/global_settings.php:1674
msgid "Lock an account after this many failed attempts in 1 hour."
msgstr "1 மணிநேரத்தில் இத்தனை தோல்வியடைந்த முயற்சிகளுக்குப் பிறகு கணக்கைப் பூட்டு."

