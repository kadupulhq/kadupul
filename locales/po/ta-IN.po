msgstr "சேவையகத்திற்கான இணைப்பு காலாவதியானது (%s)"

#: lib/ldap.php
#, php-format
msgid "Group DN could not be found to compare on Server (%s)"
msgstr "சேவையகத்தில் (%s) ஒப்பிடுவதற்குக் குழு DN ஐக் கண்டறிய முடியவில்லை"

#: lib/ldap.php
#, php-format
