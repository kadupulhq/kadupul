#: auth_changepassword.php:288
msgid "Must include at least 1 number"
msgstr "குறைந்தது 1 எண்ணை உள்ளடக்கியிருக்க வேண்டும்"

#: auth_changepassword.php:292
msgid "Must include at least 1 special character"
msgstr "குறைந்தது 1 சிறப்பு எழுத்தை உள்ளடக்கியிருக்க வேண்டும்"

#: auth_changepassword.php:296
#, php-format
msgid "Cannot be reused for %d password changes"
msgstr "%d கடவுச்சொல் மாற்றங்களுக்கு மீண்டும் பயன்படுத்த முடியாது"

