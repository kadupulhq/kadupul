#: auth_changepassword.php:280
#, php-format
msgid "Must be at least %d characters in length"
msgstr "குறைந்தது %d எழுத்துகள் நீளமாக இருக்க வேண்டும்"

#: auth_changepassword.php:284
msgid "Must include mixed case"
