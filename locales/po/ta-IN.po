msgstr "சேவையகத்திற்குப் போதுமான அணுகல் இல்லை (%s)"

#: lib/ldap.php
msgid "Invalid Password provided.  Login failed."
msgstr "தவறான கடவுச்சொல் வழங்கப்பட்டது. உள்நுழைவு தோல்வியடைந்தது."

#: lib/ldap.php
msgid "More than one matching user found"
msgstr "ஒன்றுக்கும் மேற்பட்ட பொருந்தும் பயனர்கள் கண்டறியப்பட்டனர்"

#: lib/ldap.php
msgid "No username defined"
msgstr "பயனர்பெயர் வரையறுக்கப்படவில்லை"

#: lib/ldap.php
msgid "PHP LDAP not enabled"
msgstr "PHP LDAP இயக்கப்படவில்லை"

#: lib/ldap.php
