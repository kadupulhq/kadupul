#: include/global_settings.php
msgid "Should RRDfile check be enabled for this Kadupul system?"
msgstr "Shin a kunna binciken RRDfile don wannan tsarin Kadupul?"

#: include/global_settings.php
msgid "Number of RRDfile Check Processes"
msgstr "Adadin Ayyukan Duba RRDfile"

#: include/global_settings.php
msgid "The number of concurrent RRDfile check processes to use to use to process all of rrd files."
msgstr "Adadin tsarukan binciken RRDfile na lokaci guda da za a yi amfani da su don sarrafa dukkan fayilolin rrd."

#: include/global_settings.php
msgid "Check Frequency"
msgstr "Yawan Bincike"

#: include/global_settings.php
msgid "How frequent should RRD be checked ?"
msgstr "Sau nawa ya kamata a duba RRD ?"

#: include/global_settings.php
msgid "Data Storage Settings"
