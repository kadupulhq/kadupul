msgstr "Adadin tsarukan DSStats na lokaci guda da za a yi amfani da su don sarrafa dukkan Tushen Bayanai."

#: include/global_settings.php
msgid "Daily Update Frequency"
msgstr "Yawan Sabuntawa na Kullum"

#: include/global_settings.php
msgid "How frequent should Daily Stats be updated?"
