msgstr "Wannan zai buƙaci sabbin kalmomin sirri su ƙunshi aƙalla lamba 1."

#: include/global_settings.php
msgid "Require Special Character"
msgstr "Buƙaci Harafi na Musamman"

#: include/global_settings.php
