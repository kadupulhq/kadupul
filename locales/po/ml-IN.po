#: include/global_settings.php:1668
msgid "Account Locking"
msgstr "അക്കൗണ്ട് ലോക്കിങ്"

#: include/global_settings.php:1673
msgid "Lock Accounts"
msgstr "അക്കൗണ്ടുകൾ ലോക്ക് ചെയ്യുക"

#: include/global_settings.php:1674
msgid "Lock an account after this many failed attempts in 1 hour."
msgstr "1 മണിക്കൂറിൽ ഇത്രയും പരാജയപ്പെട്ട ശ്രമങ്ങൾക്ക് ശേഷം ഒരു അക്കൗണ്ട് ലോക്ക് ചെയ്യുക."

#: include/global_settings.php:1679
msgid "1 Attempt"
msgstr "1 ശ്രമം"

