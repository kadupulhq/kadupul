#: include/global_settings.php
msgid "Enable code tweak for specific handling of Lotus Notes Mail Clients."
msgstr "Lotus Notes മെയിൽ ക്ലയന്റുകളുടെ പ്രത്യേക കൈകാര്യം ചെയ്യലിനായി കോഡ് ട്വീക്ക് പ്രവർത്തനക്ഷമമാക്കുക."

#: include/global_settings.php
