#: lib/html_reports.php
msgid "Select a Graph Template for the Device to be used to filter for or select Graphs in the case of a Device Type."
msgstr "ഉപകരണ തരത്തിന്റെ കാര്യത്തിൽ ഗ്രാഫുകൾ ഫിൽട്ടർ ചെയ്യാനോ തിരഞ്ഞെടുക്കാനോ ഉപയോഗിക്കേണ്ട ഉപകരണത്തിനായുള്ള ഒരു ഗ്രാഫ് ടെംപ്ലേറ്റ് തിരഞ്ഞെടുക്കുക."

#: lib/html_reports.php
