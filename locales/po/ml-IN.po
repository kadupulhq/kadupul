#: lib/installer.php
msgid "RRDfile Locations"
msgstr "RRDfile ലൊക്കേഷനുകൾ"

#: lib/installer.php
msgid "The Data Source paths could not be read, so RRDfile locations were not checked. Check them after the upgrade with the poller log."
msgstr "ഡാറ്റ സോഴ്സ് പാത്തുകൾ വായിക്കാൻ കഴിഞ്ഞില്ല, അതിനാൽ RRDfile ലൊക്കേഷനുകൾ പരിശോധിച്ചില്ല. അപ്ഗ്രേഡിന് ശേഷം പോളർ ലോഗ് ഉപയോഗിച്ച് അവ പരിശോധിക്കുക."

#: lib/installer.php
