msgstr "പ്രാഥമിക DNS IP വിലാസം"

#: include/global_settings.php
msgid "Enter the primary DNS IP Address to utilize for reverse lookups."
msgstr "റിവേഴ്സ് ലുക്കപ്പുകൾക്ക് ഉപയോഗിക്കേണ്ട പ്രാഥമിക DNS IP വിലാസം നൽകുക."

#: include/global_settings.php
