#: lib/installer.php
#, php-format
msgid "Also, if this is an upgrade, be sure to read the <a href=\"%s\">Upgrade</a> information file."
msgstr "ഇത് ഒരു അപ്ഗ്രേഡ് ആണെങ്കിൽ, <a href=\"%s\">അപ്ഗ്രേഡ്</a> വിവര ഫയലും വായിക്കുന്നത് ഉറപ്പാക്കുക."

#: lib/installer.php
msgid "It is NOT recommended to downgrade as the database structure may be inconsistent"
msgstr "ഡാറ്റാബേസ് ഘടന പൊരുത്തമില്ലാത്തതാകാൻ സാധ്യതയുള്ളതിനാൽ ഡൗൺഗ്രേഡ് ചെയ്യുന്നത് ശുപാർശ ചെയ്യുന്നില്ല"

