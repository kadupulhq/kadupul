#: lib/auth.php:5504
msgid "Authentication was previously not set.  Attempted to set to Local Authentication, but no Administrative account was found."
msgstr "പ്രാമാണീകരണം മുമ്പ് സജ്ജമാക്കിയിരുന്നില്ല.  ലോക്കൽ പ്രാമാണീകരണത്തിലേക്ക് സജ്ജമാക്കാൻ ശ്രമിച്ചു, എന്നാൽ അഡ്മിനിസ്ട്രേറ്റീവ് അക്കൗണ്ട് ഒന്നും കണ്ടെത്തിയില്ല."

