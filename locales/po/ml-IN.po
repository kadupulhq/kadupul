#: include/global_form.php
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "ഈ GPRINT പ്രീസെറ്റിന് ഒരു പേര് നൽകുക, നിങ്ങൾക്ക് തിരിച്ചറിയാൻ കഴിയുന്ന ഒന്നാണെന്ന് ഉറപ്പാക്കുക."

#: include/global_form.php
msgid "GPRINT Text"
msgstr "GPRINT ടെക്സ്റ്റ്"

#: include/global_form.php
msgid "Enter the custom GPRINT string here."
msgstr "ഇഷ്ടാനുസൃത GPRINT സ്ട്രിംഗ് ഇവിടെ നൽകുക."

#: include/global_form.php
msgid "Common Options"
msgstr "പൊതുവായ ഓപ്ഷനുകൾ"

#: include/global_form.php
msgid "Title (--title)"
msgstr "ശീർഷകം (--title)"

#: include/global_form.php
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "ഗ്രാഫിൽ പ്രിന്റ് ചെയ്യുന്ന പേര്.  ഇതിൽ |host_description| അല്ലെങ്കിൽ |query_fieldName| പോലുള്ള പകരം വയ്ക്കൽ വേരിയബിളുകൾ ഉൾപ്പെടുത്താം.  പിന്തുണയ്ക്കുന്ന എല്ലാ പകരം വയ്ക്കൽ ടാഗുകളുടെയും പൂർണ്ണ പട്ടികയ്ക്ക്, Kadupul ഡോക്യുമെന്റേഷൻ കാണുക."

#: include/global_form.php
msgid "Vertical Label (--vertical-label)"
msgstr "ലംബ ലേബൽ (--vertical-label)"

#: include/global_form.php
msgid "The label vertically printed to the left of the graph."
msgstr "ഗ്രാഫിന്റെ ഇടതുവശത്ത് ലംബമായി പ്രിന്റ് ചെയ്യുന്ന ലേബൽ."

#: include/global_form.php
msgid "Image Format (--imgformat)"
msgstr "ചിത്ര ഫോർമാറ്റ് (--imgformat)"

#: include/global_form.php
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "സൃഷ്ടിക്കുന്ന ഗ്രാഫിന്റെ തരം; PNG, GIF അല്ലെങ്കിൽ SVG.  ഗ്രാഫ് ചിത്ര തരം തിരഞ്ഞെടുക്കുന്നത് RRDtool-നെ വളരെയധികം ആശ്രയിച്ചിരിക്കുന്നു."

#: include/global_form.php
msgid "Height (--height)"
msgstr "ഉയരം (--height)"

#: include/global_form.php
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "ഗ്രാഫിനുള്ളിലെ ഗ്രാഫ് ഏരിയയുടെ ഉയരം (പിക്സലുകളിൽ). ഈ ഏരിയയിൽ ലെജൻഡ്, ആക്സിസ് ലെജൻഡുകൾ, അല്ലെങ്കിൽ ശീർഷകം ഉൾപ്പെടുന്നില്ല."

#: include/global_form.php
msgid "Width (--width)"
msgstr "വീതി (--width)"

#: include/global_form.php
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "ഗ്രാഫിനുള്ളിലെ ഗ്രാഫ് ഏരിയയുടെ വീതി (പിക്സലുകളിൽ). ഈ ഏരിയയിൽ ലെജൻഡ്, ആക്സിസ് ലെജൻഡുകൾ, അല്ലെങ്കിൽ ശീർഷകം ഉൾപ്പെടുന്നില്ല."

#: include/global_form.php
msgid "Base Value (--base)"
msgstr "അടിസ്ഥാന മൂല്യം (--base)"

#: include/global_form.php
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "മെമ്മറിക്ക് 1024 ഉം ട്രാഫിക് അളവുകൾക്ക് 1000 ഉം ആയി സജ്ജമാക്കണം."

#: include/global_form.php
msgid "Slope Mode (--slope-mode)"
msgstr "സ്ലോപ്പ് മോഡ് (--slope-mode)"

#: include/global_form.php
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "സ്ലോപ്പ് മോഡ് ഉപയോഗിക്കുന്നത് സ്ക്രീനിലെ ചില റെസല്യൂഷൻ നഷ്ടപ്പെടുത്തി ഗ്രാഫുകളുടെ ആകൃതി സമനിലയിലാക്കുന്നു."

#: include/global_form.php
msgid "Scaling Options"
msgstr "സ്കെയിലിംഗ് ഓപ്ഷനുകൾ"

#: include/global_form.php
msgid "Auto Scale"
msgstr "ഓട്ടോ സ്കെയിൽ"

#: include/global_form.php
msgid "When enabled, the selected Auto Scale Option determines which limits RRDtool uses: --alt-autoscale ignores both limits, --alt-autoscale-max keeps the lower limit, --alt-autoscale-min keeps the upper limit, and --alt-autoscale (accepting both limits) keeps both limits. When disabled, the configured lower and upper limits are used directly. Rigid Boundaries controls whether values outside those limits expand the graph range."
msgstr "പ്രവർത്തനക്ഷമമാക്കിയാൽ, തിരഞ്ഞെടുത്ത ഓട്ടോ സ്കെയിൽ ഓപ്ഷൻ RRDtool ഉപയോഗിക്കുന്ന പരിധികൾ നിർണ്ണയിക്കുന്നു: --alt-autoscale രണ്ട് പരിധികളും അവഗണിക്കുന്നു, --alt-autoscale-max താഴ്ന്ന പരിധി നിലനിർത്തുന്നു, --alt-autoscale-min ഉയർന്ന പരിധി നിലനിർത്തുന്നു, --alt-autoscale (രണ്ട് പരിധികളും സ്വീകരിച്ച്) രണ്ട് പരിധികളും നിലനിർത്തുന്നു. പ്രവർത്തനരഹിതമാക്കിയാൽ, ക്രമീകരിച്ച താഴ്ന്ന, ഉയർന്ന പരിധികൾ നേരിട്ട് ഉപയോഗിക്കുന്നു. ആ പരിധികൾക്ക് പുറത്തുള്ള മൂല്യങ്ങൾ ഗ്രാഫ് റേഞ്ച് വികസിപ്പിക്കുമോ എന്ന് റിജിഡ് ബൗണ്ടറീസ് നിയന്ത്രിക്കുന്നു."

#: include/global_form.php
msgid "Auto Scale Options"
msgstr "ഓട്ടോ സ്കെയിൽ ഓപ്ഷനുകൾ"

#: include/global_form.php
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "ഉപയോഗിക്കുക <br> കേവല ഏറ്റവും കുറഞ്ഞതും കൂടിയതുമായി സ്കെയിൽ ചെയ്യാൻ --alt-autoscale <br> നൽകിയിരിക്കുന്ന താഴ്ന്ന പരിധി ഉപയോഗിച്ച് ഏറ്റവും കൂടിയ മൂല്യത്തിലേക്ക് സ്കെയിൽ ചെയ്യാൻ --alt-autoscale-max <br> നൽകിയിരിക്കുന്ന ഉയർന്ന പരിധി ഉപയോഗിച്ച് ഏറ്റവും കുറഞ്ഞ മൂല്യത്തിലേക്ക് സ്കെയിൽ ചെയ്യാൻ --alt-autoscale-min <br> താഴ്ന്നതും ഉയർന്നതുമായ പരിധികൾ ഉപയോഗിച്ച് സ്കെയിൽ ചെയ്യാൻ --alt-autoscale (പരിധികളോടെ) (RRDtool സ്ഥിരസ്ഥിതി) <br>"

#: include/global_form.php
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "--alt-autoscale ഉപയോഗിക്കുക (നൽകിയ പരിധികൾ അവഗണിച്ച്)"

#: include/global_form.php
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "--alt-autoscale-max ഉപയോഗിക്കുക (താഴ്ന്ന പരിധി സ്വീകരിച്ച്)"

#: include/global_form.php
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "--alt-autoscale-min ഉപയോഗിക്കുക (ഉയർന്ന പരിധി സ്വീകരിച്ച്)"

#: include/global_form.php
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "--alt-autoscale ഉപയോഗിക്കുക (രണ്ട് പരിധികളും സ്വീകരിച്ച്, RRDtool സ്ഥിരസ്ഥിതി)"

#: include/global_form.php
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "ലോഗരിതമിക് സ്കെയിലിംഗ് (--logarithmic)"

#: include/global_form.php
msgid "Use Logarithmic y-axis scaling"
msgstr "ലോഗരിതമിക് y-ആക്സിസ് സ്കെയിലിംഗ് ഉപയോഗിക്കുക"

#: include/global_form.php
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "ലോഗരിതമിക് സ്കെയിലിംഗിനുള്ള SI യൂണിറ്റുകൾ (--units=si)"

#: include/global_form.php
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "ഘാതാങ്ക സൂചനയ്ക്ക് പകരം ലോഗരിതമിക് സ്കെയിലിങ്ങിന് SI യൂണിറ്റുകൾ ഉപയോഗിക്കുക.<br> കുറിപ്പ്: ലീനിയർ ഗ്രാഫുകൾ സ്വതവേ SI സൂചന ഉപയോഗിക്കുന്നു."

#: include/global_form.php
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "റിജിഡ് അതിർത്തി മോഡ് (--rigid)"

#: include/global_form.php
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "ഗ്രാഫിൽ സാധുവായ പരിധിക്ക് പുറത്തുള്ള മൂല്യം ഉണ്ടെങ്കിൽ താഴ്ന്ന, ഉയർന്ന പരിധികൾ വികസിപ്പിക്കരുത്."

#: include/global_form.php
msgid "Upper Limit (--upper-limit)"
msgstr "ഉയർന്ന പരിധി (--upper-limit)"

#: include/global_form.php
msgid "The maximum vertical value for the graph."
msgstr "ഗ്രാഫിലെ പരമാവധി ലംബ മൂല്യം."

#: include/global_form.php
msgid "Lower Limit (--lower-limit)"
msgstr "താഴ്ന്ന പരിധി (--lower-limit)"

#: include/global_form.php
msgid "The minimum vertical value for the graph."
msgstr "ഗ്രാഫിലെ കുറഞ്ഞ ലംബ മൂല്യം."

#: include/global_form.php
msgid "Grid Options"
msgstr "ഗ്രിഡ് ഓപ്ഷനുകൾ"

#: include/global_form.php
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "യൂണിറ്റ് ഗ്രിഡ് മൂല്യം (--unit/--y-grid)"

#: include/global_form.php
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "സംഖ്യകൾക്കായി Y-അക്ഷത്തിലെ ഘാതാങ്ക മൂല്യം സജ്ജമാക്കുന്നു. കുറിപ്പ്: ഈ ഓപ്ഷൻ ഒഴിവാക്കപ്പെട്ടതും --y-grid ഓപ്ഷൻ കൊണ്ട് മാറ്റിസ്ഥാപിച്ചതുമാണ്.  ഈ ഓപ്ഷനിൽ, ഓരോ ഗ്രിഡ് സ്റ്റെപ്പ് ഇടവേളയിലും Y-അക്ഷ ഗ്രിഡ് വരകൾ പ്രത്യക്ഷപ്പെടുന്നു.  ഓരോ ലേബൽ ഫാക്ടർ വരകളിലും ലേബലുകൾ സ്ഥാപിക്കുന്നു."

#: include/global_form.php
msgid "Unit Exponent Value (--units-exponent)"
msgstr "യൂണിറ്റ് ഘാതാങ്ക മൂല്യം (--units-exponent)"

#: include/global_form.php
msgid "What unit Kadupul should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Y-അക്ഷത്തിൽ Kadupul ഏത് യൂണിറ്റ് ഉപയോഗിക്കണം. എല്ലാം \"k\" ൽ പ്രദർശിപ്പിക്കാൻ 3 അല്ലെങ്കിൽ എല്ലാം \"u\" (മൈക്രോ) ൽ പ്രദർശിപ്പിക്കാൻ -6 ഉപയോഗിക്കുക."

#: include/global_form.php
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "യൂണിറ്റ് നീളം (--units-length &lt;length&gt;)"

#: include/global_form.php
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "y-അക്ഷ ലേബലുകൾക്ക് എത്ര അക്കങ്ങൾ ഉണ്ടെന്ന് RRDtool കണക്കാക്കണം? y-അക്ഷ ലേബലിങ്ങിൽ മാറ്റം വരുത്തിത്തുടങ്ങിയാൽ മതിയായ സ്ഥലം ഉണ്ടാക്കാൻ ഈ ഓപ്ഷൻ ഉപയോഗിക്കേണ്ടി വന്നേക്കാം."

#: include/global_form.php
msgid "No Gridfit (--no-gridfit)"
msgstr "ഗ്രിഡ്ഫിറ്റ് വേണ്ട (--no-gridfit)"

#: include/global_form.php
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "ആന്റി-അലിയാസിങ് മങ്ങൽ ഒഴിവാക്കാൻ RRDtool പോയിന്റുകളെ ഡിവൈസ് റെസല്യൂഷൻ പിക്സലുകളിലേക്ക് ഒതുക്കുന്നു, ഇത് കൂടുതൽ വ്യക്തമായ രൂപം നൽകുന്നു. ഇത് ഇഷ്ടമല്ലെങ്കിൽ, ഈ സ്വിച്ച് ഉപയോഗിച്ച് ഈ സ്വഭാവം ഓഫ് ചെയ്യാം.<br><strong>കുറിപ്പ്: </strong>PDF, EPS, SVG ഔട്ട്പുട്ടിന് ഗ്രിഡ്ഫിറ്റിങ് സ്വതവേ ഓഫ് ആണ്."

#: include/global_form.php
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "ബദൽ Y ഗ്രിഡ് (--alt-y-grid)"

#: include/global_form.php
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "എല്ലായ്പ്പോഴും ഒരു ഗ്രിഡ് ഉണ്ടെന്നും, ആവശ്യത്തിന് എന്നാൽ അധികമല്ലാത്ത ഗ്രിഡ് വരകൾ ഉണ്ടെന്നും, ഗ്രിഡ് മെട്രിക് ആണെന്നും ഈ അൽഗോരിതം ഉറപ്പാക്കുന്നു. നിങ്ങളുടെ ഗ്രാഫ് 69.998 മുതൽ 70.001 വരെയാണെങ്കിൽ പോലും ആവശ്യത്തിന് ദശാംശ സ്ഥാനങ്ങൾ പ്രദർശിപ്പിക്കുമെന്നും ഈ പാരാമീറ്റർ ഉറപ്പാക്കുന്നു.<br><strong>കുറിപ്പ്: </strong>ഈ പാരാമീറ്റർ --alt-autoscale ഓപ്ഷനുകളിൽ ഇടപെട്ടേക്കാം."

#: include/global_form.php
msgid "Axis Options"
msgstr "അക്ഷ ഓപ്ഷനുകൾ"

#: include/global_form.php
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "വലത് അക്ഷം (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "ഗ്രാഫിന്റെ വലതുവശത്ത് ഒരു രണ്ടാം അക്ഷം വരയ്ക്കും. സ്കെയിൽ, ഷിഫ്റ്റ് പാരാമീറ്ററുകൾ വഴി ഇത് ഇടത് അക്ഷവുമായി ബന്ധിപ്പിച്ചിരിക്കുന്നു."

#: include/global_form.php
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "വലത് അക്ഷ ലേബൽ (--right-axis-label &lt;string&gt;)"

#: include/global_form.php
msgid "The label for the right axis."
msgstr "വലത് അക്ഷത്തിനുള്ള ലേബൽ."

#: include/global_form.php
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "വലത് അക്ഷ ഫോർമാറ്റ് (--right-axis-format &lt;format&gt;)"

#: include/global_form.php
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "സ്വതവേ, അക്ഷ ലേബലുകളുടെ ഫോർമാറ്റ് സ്വയമേവ നിർണ്ണയിക്കപ്പെടുന്നു.  ഇത് സ്വയം ചെയ്യണമെങ്കിൽ, PRINT, GPRINT കമാൻഡുകളിൽ നിന്ന് നിങ്ങൾക്കറിയാവുന്ന അതേ %lf ആർഗ്യുമെന്റുകളോടെ ഈ ഓപ്ഷൻ ഉപയോഗിക്കുക."

#: include/global_form.php
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "വലത് അക്ഷ ഫോർമാറ്റർ (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you set up the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "വലത് അക്ഷ ലേബലിങ് സജ്ജമാക്കുമ്പോൾ, ഡാറ്റ ഫോർമാറ്റിന് ഒരു നിയമം പ്രയോഗിക്കുക.  പിന്തുണയ്ക്കുന്ന ഫോർമാറ്റുകളിൽ ഡാറ്റയെ സംഖ്യയായി കണക്കാക്കുന്ന \"numeric\", മൂല്യങ്ങളെ UNIX ടൈംസ്റ്റാമ്പുകളായി (1970 ജനുവരി മുതലുള്ള സെക്കൻഡുകളുടെ എണ്ണം) വ്യാഖ്യാനിച്ച് strftime ഫോർമാറ്റിൽ (സ്വതവേ \"%Y-%m-%d %H:%M:%S\") പ്രകടിപ്പിക്കുന്ന \"timestamp\" എന്നിവ ഉൾപ്പെടുന്നു.  --units-length, --right-axis-format എന്നിവയും കാണുക.  അവസാനമായി, മൂല്യങ്ങളെ മില്ലിസെക്കൻഡിലെ ദൈർഘ്യമായി വ്യാഖ്യാനിക്കുന്ന \"duration\".  ഫോർമാറ്റിങ് valstrfduration യോഗ്യതയുള്ള PRINT/GPRINT നിയമങ്ങൾ പാലിക്കുന്നു."

#: include/global_form.php
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "ഇടത് അക്ഷ ഫോർമാറ്റർ (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you set up the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "ഇടത് അക്ഷ ലേബലിങ് സജ്ജമാക്കുമ്പോൾ, ഡാറ്റ ഫോർമാറ്റിന് ഒരു നിയമം പ്രയോഗിക്കുക.  പിന്തുണയ്ക്കുന്ന ഫോർമാറ്റുകളിൽ ഡാറ്റയെ സംഖ്യയായി കണക്കാക്കുന്ന \"numeric\", മൂല്യങ്ങളെ UNIX ടൈംസ്റ്റാമ്പുകളായി (1970 ജനുവരി മുതലുള്ള സെക്കൻഡുകളുടെ എണ്ണം) വ്യാഖ്യാനിച്ച് strftime ഫോർമാറ്റിൽ (സ്വതവേ \"%Y-%m-%d %H:%M:%S\") പ്രകടിപ്പിക്കുന്ന \"timestamp\" എന്നിവ ഉൾപ്പെടുന്നു.  --units-length എന്നതും കാണുക.  അവസാനമായി, മൂല്യങ്ങളെ മില്ലിസെക്കൻഡിലെ ദൈർഘ്യമായി വ്യാഖ്യാനിക്കുന്ന \"duration\".  ഫോർമാറ്റിങ് valstrfduration യോഗ്യതയുള്ള PRINT/GPRINT നിയമങ്ങൾ പാലിക്കുന്നു."

#: include/global_form.php
msgid "Legend Options"
msgstr "ലെജൻഡ് ഓപ്ഷനുകൾ"

#: include/global_form.php
msgid "Auto Padding"
msgstr "ഓട്ടോ പാഡിങ്"

#: include/global_form.php
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "ലെജൻഡും ഗ്രാഫ് ഡാറ്റയും എല്ലായ്പ്പോഴും നിരയൊത്തു വരാൻ ടെക്സ്റ്റ് പാഡ് ചെയ്യുക. കുറിപ്പ്: ഇത് കൂടുതൽ ഓവർഹെഡ് കാരണം ഗ്രാഫുകൾ റെൻഡർ ചെയ്യാൻ കൂടുതൽ സമയം എടുക്കാൻ ഇടയാക്കിയേക്കാം. കൂടാതെ എല്ലാ തരം ഗ്രാഫുകളിലും ഓട്ടോ പാഡിങ് കൃത്യമായിരിക്കില്ല, സ്ഥിരതയുള്ള ലേബലിങ് സാധാരണയായി സഹായിക്കും."

#: include/global_form.php
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "ഡൈനാമിക് ലേബലുകൾ (--dynamic-labels)"

#: include/global_form.php
msgid "Draw line markers as a line."
msgstr "ലൈൻ മാർക്കറുകൾ ഒരു ലൈൻ ആയി വരയ്ക്കുക."

#: include/global_form.php
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "നിയമ ലെജൻഡ് നിർബന്ധമാക്കുക (--force-rules-legend)"

#: include/global_form.php
msgid "Force the generation of HRULE and VRULE legends."
msgstr "HRULE, VRULE ലെജൻഡുകളുടെ നിർമ്മാണം നിർബന്ധമാക്കുക."

#: include/global_form.php
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "ടാബ് വീതി (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "സ്വതവേ ടാബ് വീതി 40 പിക്സൽ ആണ്, ഇത് മാറ്റാൻ ഈ ഓപ്ഷൻ ഉപയോഗിക്കുക."

#: include/global_form.php
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "ലെജൻഡ് സ്ഥാനം (--legend-position=&lt;position&gt;)"

#: include/global_form.php
msgid "Place the legend at the given side of the graph."
msgstr "ഗ്രാഫിന്റെ നൽകിയ വശത്ത് ലെജൻഡ് സ്ഥാപിക്കുക."

#: include/global_form.php
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "ലെജൻഡ് ദിശ (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php
msgid "Place the legend items in the given vertical order."
msgstr "ലെജൻഡ് ഇനങ്ങൾ നൽകിയ ലംബ ക്രമത്തിൽ സ്ഥാപിക്കുക."

#: include/global_form.php lib/api_aggregate.php lib/html.php
msgid "Graph Item Type"
msgstr "ഗ്രാഫ് ഇനത്തിന്റെ തരം"

#: include/global_form.php
msgid "How data for this item is represented visually on the graph."
msgstr "ഈ ഇനത്തിന്റെ ഡാറ്റ ഗ്രാഫിൽ ദൃശ്യപരമായി എങ്ങനെ പ്രതിനിധീകരിക്കുന്നു."

#: include/global_form.php
msgid "The data source to use for this graph item."
msgstr "ഈ ഗ്രാഫ് ഇനത്തിന് ഉപയോഗിക്കേണ്ട ഡാറ്റ സോഴ്സ്."

#: include/global_form.php
msgid "The color to use for the legend."
msgstr "ലെജൻഡിന് ഉപയോഗിക്കേണ്ട നിറം."

#: include/global_form.php
msgid "Opacity/Alpha Channel"
msgstr "അതാര്യത/ആൽഫ ചാനൽ"

#: include/global_form.php
msgid "The opacity/alpha channel of the color."
msgstr "നിറത്തിന്റെ അതാര്യത/ആൽഫ ചാനൽ."

#: include/global_form.php lib/rrd.php
msgid "Consolidation Function"
msgstr "കൺസോളിഡേഷൻ ഫംഗ്ഷൻ"

#: include/global_form.php
msgid "How data for this item is represented statistically on the graph."
msgstr "ഈ ഇനത്തിന്റെ ഡാറ്റ ഗ്രാഫിൽ സ്ഥിതിവിവരപരമായി എങ്ങനെ പ്രതിനിധീകരിക്കുന്നു."

#: include/global_form.php
msgid "CDEF Function"
msgstr "CDEF ഫംഗ്ഷൻ"

#: include/global_form.php
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "ഗ്രാഫിലോ ലെജൻഡിലോ ഈ ഇനത്തിന് പ്രയോഗിക്കേണ്ട ഒരു CDEF (ഗണിത) ഫംഗ്ഷൻ."

#: include/global_form.php
msgid "VDEF Function"
msgstr "VDEF ഫംഗ്ഷൻ"

#: include/global_form.php
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "ഗ്രാഫ് ലെജൻഡിൽ ഈ ഇനത്തിന് പ്രയോഗിക്കേണ്ട ഒരു VDEF (ഗണിത) ഫംഗ്ഷൻ."

#: include/global_form.php
msgid "Shift Data"
msgstr "ഡാറ്റ ഷിഫ്റ്റ് ചെയ്യുക"

#: include/global_form.php
msgid "Offset your data on the time axis (x-axis) by the amount specified in the 'value' field."
msgstr "'value' ഫീൽഡിൽ വ്യക്തമാക്കിയ അളവിൽ സമയ അക്ഷത്തിൽ (x-അക്ഷം) നിങ്ങളുടെ ഡാറ്റ ഓഫ്സെറ്റ് ചെയ്യുക."

#: include/global_form.php
