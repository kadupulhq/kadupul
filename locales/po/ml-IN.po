#: lib/spikekill.php
msgid "FATAL: Standard Deviation must be a positive integer."
msgstr "ഗുരുതരം: സ്റ്റാൻഡേർഡ് ഡീവിയേഷൻ ഒരു ധന പൂർണ്ണസംഖ്യ ആയിരിക്കണം."

#: lib/spikekill.php
msgid "StdDev"
msgstr "StdDev"

#: lib/spikekill.php
msgid "Variance"
msgstr "വേരിയൻസ്"

#: lib/spikekill.php
msgid "Gap Fill"
msgstr "ഗ്യാപ് ഫിൽ"

#: lib/spikekill.php
msgid "FATAL: You must specify either 'stddev', 'variance', 'float', or 'fill' as methods."
msgstr "ഗുരുതരം: രീതികളായി നിങ്ങൾ 'stddev', 'variance', 'float', അല്ലെങ്കിൽ 'fill' എന്നിവയിലൊന്ന് നിർദ്ദേശിക്കണം."

#: lib/spikekill.php
msgid "FATAL: The outlier-start and outlier-end arguments must be in the format of YYYY-MM-DD HH:MM or a unix timestamp."
msgstr "ഗുരുതരം: outlier-start, outlier-end ആർഗ്യുമെന്റുകൾ YYYY-MM-DD HH:MM ഫോർമാറ്റിലോ unix ടൈംസ്റ്റാമ്പിലോ ആയിരിക്കണം."

#: lib/spikekill.php
msgid "FATAL: The number of outliers to exclude must be a positive integer."
msgstr "ഗുരുതരം: ഒഴിവാക്കേണ്ട ഔട്ട്‌ലയറുകളുടെ എണ്ണം ഒരു ധന പൂർണ്ണസംഖ്യ ആയിരിക്കണം."

#: lib/spikekill.php
msgid "FATAL: Percent deviation must be a positive floating point number."
msgstr "ഗുരുതരം: ശതമാന വ്യതിയാനം ഒരു ധന ഫ്ലോട്ടിംഗ് പോയിന്റ് സംഖ്യ ആയിരിക്കണം."

#: lib/spikekill.php
msgid "FATAL: Number of spikes to remove must be a positive integer"
msgstr "ഗുരുതരം: നീക്കം ചെയ്യേണ്ട സ്പൈക്കുകളുടെ എണ്ണം ഒരു ധന പൂർണ്ണസംഖ്യ ആയിരിക്കണം"

#: lib/spikekill.php
msgid "FATAL: Outlier time range requires outlier-start and outlier-end to be specified."
msgstr "ഗുരുതരം: ഔട്ട്‌ലയർ സമയ പരിധിക്ക് outlier-start, outlier-end എന്നിവ നിർദ്ദേശിക്കേണ്ടതുണ്ട്."

#: lib/spikekill.php
msgid "FATAL: Outlier time range requires outlier-start to be less than outlier-end."
msgstr "ഗുരുതരം: ഔട്ട്‌ലയർ സമയ പരിധിക്ക് outlier-start, outlier-end-നേക്കാൾ കുറവായിരിക്കണം."

#: lib/spikekill.php
msgid "FATAL: The 'float' removal method requires the specification of a start and end date."
msgstr "ഗുരുതരം: 'float' നീക്കം ചെയ്യൽ രീതിക്ക് ആരംഭ, അവസാന തീയതി നിർദ്ദേശിക്കേണ്ടതുണ്ട്."

#: lib/spikekill.php
msgid "FATAL: The 'gapfill' removal method requires the specification of a start and end date."
msgstr "ഗുരുതരം: 'gapfill' നീക്കം ചെയ്യൽ രീതിക്ക് ആരംഭ, അവസാന തീയതി നിർദ്ദേശിക്കേണ്ടതുണ്ട്."

#: lib/spikekill.php
msgid "FATAL: You must specify either 'last', 'avg' or 'nan' as a replacement method."
msgstr "ഗുരുതരം: പകരം വയ്ക്കൽ രീതിയായി നിങ്ങൾ 'last', 'avg' അല്ലെങ്കിൽ 'nan' എന്നിവയിലൊന്ന് നിർദ്ദേശിക്കണം."

