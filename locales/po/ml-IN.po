msgid "A Perl compatible regular expression (REGEXP) used to select Graphs to include from the Tree or Device."
msgstr "ട്രീയിൽ നിന്നോ ഉപകരണത്തിൽ നിന്നോ ഉൾപ്പെടുത്തേണ്ട ഗ്രാഫുകൾ തിരഞ്ഞെടുക്കാൻ ഉപയോഗിക്കുന്ന Perl അനുയോജ്യമായ റെഗുലർ എക്സ്പ്രഷൻ (REGEXP)."

#: lib/html_reports.php
msgid "The Graph to use for this report item."
msgstr "ഈ റിപ്പോർട്ട് ഇനത്തിന് ഉപയോഗിക്കേണ്ട ഗ്രാഫ്."

#: lib/html_reports.php
msgid "The Graph End time will be set to the scheduled report send time.  So, if you wish the end time on the various Graphs to be midnight, ensure you send the report at midnight.  The Graph Start time will be the End Time minus the Graph Timespan."
msgstr "ഗ്രാഫ് അവസാന സമയം ഷെഡ്യൂൾ ചെയ്ത റിപ്പോർട്ട് അയയ്ക്കൽ സമയമായി സജ്ജമാക്കും.  അതിനാൽ, വിവിധ ഗ്രാഫുകളുടെ അവസാന സമയം അർദ്ധരാത്രി ആകണമെങ്കിൽ, റിപ്പോർട്ട് അർദ്ധരാത്രിയിൽ അയയ്ക്കുക.  ഗ്രാഫ് ആരംഭ സമയം അവസാന സമയത്തിൽ നിന്ന് ഗ്രാഫ് സമയപരിധി കുറച്ചതായിരിക്കും."

#: lib/html_reports.php
msgid "Alignment"
msgstr "വിന്യാസം"

