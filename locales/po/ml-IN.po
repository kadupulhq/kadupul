#: include/global_settings.php
msgid "Minimum Refresh Interval"
msgstr "കുറഞ്ഞ റിഫ്രഷ് ഇടവേള"

#: include/global_settings.php
msgid "This is the minimal supported time between Graph updates.  This value is also used to set certain RRDfile attributes.  If you have a Device that caches data and does not provide realtime updates, you may have to increase the default Minimum Refresh Interval to prevent creating Graphs with gaps."
msgstr "ഗ്രാഫ് അപ്ഡേറ്റുകൾക്കിടയിൽ പിന്തുണയ്ക്കുന്ന കുറഞ്ഞ സമയമാണിത്.  ചില RRDfile ആട്രിബ്യൂട്ടുകൾ സജ്ജമാക്കാനും ഈ മൂല്യം ഉപയോഗിക്കുന്നു.  ഡാറ്റ കാഷെ ചെയ്യുകയും തത്സമയ അപ്ഡേറ്റുകൾ നൽകാതിരിക്കുകയും ചെയ്യുന്ന ഒരു ഉപകരണം നിങ്ങൾക്കുണ്ടെങ്കിൽ, വിടവുകളുള്ള ഗ്രാഫുകൾ സൃഷ്ടിക്കപ്പെടുന്നത് തടയാൻ സ്ഥിര കുറഞ്ഞ റിഫ്രഷ് ഇടവേള വർദ്ധിപ്പിക്കേണ്ടി വന്നേക്കാം."

#: include/global_settings.php
