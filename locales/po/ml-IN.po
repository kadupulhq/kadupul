#: include/global_settings.php
msgid "Enable Structured Paths"
msgstr "ഘടനാപരമായ പാത്തുകൾ പ്രവർത്തനക്ഷമമാക്കുക"

#: include/global_settings.php
msgid "Use a separate subfolder for each host's RRD files.  The naming of the RRDfiles will be one of the following:<br><ul><li>&lt;path_cacti&gt;/rra/host_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_id/data_query_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_hash/device_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_hash/device_id/data_query_id/local_data_id.rrd.</li></ul><br>You can make this change after install by running the CLI script <b>structure_rra_paths.php</b> after you make the change.  NOTE: If you change Max Directories value to decrease the number of directories, or if you change the Directory Pattern, empty directories will not be pruned after you rerun the <b>structure_rra_paths.php</b> script."
msgstr "ഓരോ ഹോസ്റ്റിന്റെയും RRD ഫയലുകൾക്ക് പ്രത്യേക സബ്ഫോൾഡർ ഉപയോഗിക്കുക.  RRDfiles ന്റെ പേരിടൽ ഇനിപ്പറയുന്നവയിൽ ഒന്നായിരിക്കും:<br><ul><li>&lt;path_cacti&gt;/rra/host_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_id/data_query_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_hash/device_id/local_data_id.rrd,</li><li>&lt;path_cacti&gt;/rra/device_hash/device_id/data_query_id/local_data_id.rrd.</li></ul><br>മാറ്റം വരുത്തിയ ശേഷം CLI സ്ക്രിപ്റ്റ് <b>structure_rra_paths.php</b> പ്രവർത്തിപ്പിച്ച് ഇൻസ്റ്റാളേഷന് ശേഷവും ഈ മാറ്റം വരുത്താം.  കുറിപ്പ്: ഡയറക്ടറികളുടെ എണ്ണം കുറയ്ക്കാൻ പരമാവധി ഡയറക്ടറി മൂല്യം മാറ്റിയാലോ ഡയറക്ടറി പാറ്റേൺ മാറ്റിയാലോ, <b>structure_rra_paths.php</b> സ്ക്രിപ്റ്റ് വീണ്ടും പ്രവർത്തിപ്പിച്ചാലും ശൂന്യമായ ഡയറക്ടറികൾ നീക്കം ചെയ്യപ്പെടില്ല."

#: include/global_settings.php
msgid "Directory Pattern"
msgstr "ഡയറക്ടറി പാറ്റേൺ"

#: include/global_settings.php
msgid "Which Directory Pattern do you wish to use for Structured RRD Paths?  'Device ID' is the default.  The setting 'Device ID/Data Query ID' should be used when you have Devices with thousands of Graphs.  After Changing the Directory Pattern, you must run the Structured Path CLI script again to modify the RRDfile paths to the new Pattern."
msgstr "ഘടനാപരമായ RRD പാത്തുകൾക്ക് ഏത് ഡയറക്ടറി പാറ്റേൺ ഉപയോഗിക്കണം?  'Device ID' ആണ് സ്ഥിരമൂല്യം.  ആയിരക്കണക്കിന് ഗ്രാഫുകളുള്ള ഉപകരണങ്ങൾ ഉള്ളപ്പോൾ 'Device ID/Data Query ID' ക്രമീകരണം ഉപയോഗിക്കണം.  ഡയറക്ടറി പാറ്റേൺ മാറ്റിയ ശേഷം, RRDfile പാത്തുകൾ പുതിയ പാറ്റേണിലേക്ക് മാറ്റാൻ സ്ട്രക്ചർഡ് പാത്ത് CLI സ്ക്രിപ്റ്റ് വീണ്ടും പ്രവർത്തിപ്പിക്കണം."

