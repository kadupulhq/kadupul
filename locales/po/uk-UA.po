msgstr "Розділи мініатюр"

#: include/global_settings.php
msgid "Thumbnail Width"
msgstr "Ширина мініатюри"

#: include/global_settings.php
msgid "Time Spanning/Shifting"
msgstr "Часовий діапазон і зсув"

#: include/global_settings.php
msgid "TimeZone Support"
msgstr "Підтримка"

