msgid "CSP Violation Report URI"
msgstr ""

#: include/global_settings.php:508
msgid "URL where browsers POST CSP violation reports in nonce-report and nonce modes. Leave empty to use <url_path>/csp_report.php. Must contain only safe URL characters."
msgstr ""

#: include/global_settings.php:514
msgid "Content-Security Alternate Sources"
