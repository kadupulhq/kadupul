msgstr "RSA-fingeravtrykk"

#: include/global_settings.php
msgid "The fingerprint of the current public RSA key the proxy is using. This is required to establish a trusted connection."
msgstr "Fingeravtrykket til den gjeldende offentlige RSA-nøkkelen proxyen bruker. Dette kreves for å opprette en pålitelig tilkobling."

#: include/global_settings.php
msgid "RRDtool Proxy Server - Backup"
msgstr "RRDtool-proxyserver - sikkerhetskopi"

#: include/global_settings.php
msgid "Load Balancing"
msgstr "Lastbalansering"

#: include/global_settings.php
msgid "If both main and backup proxy are receivable this option allows to spread all requests against RRDtool."
msgstr "Hvis både hoved- og sikkerhetskopiproxy kan nås, lar dette valget alle forespørsler mot RRDtool spres."

#: include/global_settings.php
msgid "The DNS hostname or IP address of the RRDtool backup proxy server if proxy is running in MSR mode."
msgstr "DNS-vertsnavnet eller IP-adressen til RRDtool-sikkerhetskopiproxyserveren hvis proxyen kjører i MSR-modus."

