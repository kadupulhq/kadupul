msgstr "DNS-vertsnavnet eller IP-adressen til RRDtool-proxyserveren."

#: include/global_settings.php
msgid "Proxy Port Number"
msgstr "Proxyportnummer"

#: include/global_settings.php
msgid "TCP port for encrypted communication."
msgstr "TCP-port for kryptert kommunikasjon."

