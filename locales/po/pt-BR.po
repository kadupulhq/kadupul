msgstr "Se o polidor de impulso exceder este tempo de execução, um aviso será colocado no registro de cactos,"

#: include/global_settings.php:2157
msgid "Enable direct population of poller_output_boost table"
msgstr "Habilitar a população direta da tabela poller_output_boost"

#: include/global_settings.php:2158
