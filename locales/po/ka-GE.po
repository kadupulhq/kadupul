msgstr "Distinguished Name LDAP დირექტორიაში კონკრეტული ძიების bind-ისთვის."

#: include/global_settings.php user_domains.php
msgid "Search Password"
msgstr "ძიების პაროლი"

#: include/global_settings.php user_domains.php
msgid "Password for Specific Searching binding to the LDAP directory."
msgstr "პაროლი LDAP დირექტორიაში კონკრეტული ძიების bind-ისთვის."

#: include/global_settings.php user_domains.php
