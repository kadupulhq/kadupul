#: include/global_settings.php
msgid "When using basic authentication, if there are issues mapping the username to a valid Kadupul account, the message included here will be displayed to users.  It can include both text and HTML."
msgstr "ძირითადი ავთენტიფიკაციის გამოყენებისას, თუ მომხმარებლის სახელის სწორ Kadupul ანგარიშთან შესატყვისობაში პრობლემებია, აქ მითითებული შეტყობინება გამოჩნდება მომხმარებლებისთვის.  ის შეიძლება შეიცავდეს როგორც ტექსტს, ისე HTML-ს."

#: include/global_settings.php
msgid "Basic Auth Mapfile"
msgstr "Basic Auth-ის შესაბამისობის ფაილი"

#: include/global_settings.php
msgid "When using basic authentication, if the basic account needs to be translated to a different login account, you can specify a CSV file here to map the basic account to the desired login account."
msgstr "ძირითადი ავთენტიფიკაციის გამოყენებისას, თუ ძირითადი ანგარიში სხვა შესვლის ანგარიშად უნდა ითარგმნოს, აქ შეგიძლიათ CSV ფაილის მითითება ძირითადი ანგარიშის სასურველ შესვლის ანგარიშთან დასაკავშირებლად."

#: include/global_settings.php
msgid "Local Account Complexity Requirements"
msgstr "ლოკალური ანგარიშის სირთულის მოთხოვნები"

#: include/global_settings.php
msgid "Minimum Length"
msgstr "მინიმალური სიგრძე"

#: include/global_settings.php
msgid "This is the minimal length of allowed passwords."
msgstr "ეს არის დასაშვები პაროლების მინიმალური სიგრძე."

#: include/global_settings.php
msgid "Require Mix Case"
msgstr "შერეული რეგისტრის მოთხოვნა"

#: include/global_settings.php
msgid "This will require new passwords to contain both lower and upper-case characters."
msgstr "ეს მოითხოვს, რომ ახალი პაროლები შეიცავდეს როგორც მცირე, ისე დიდი ასოებს."

#: include/global_settings.php
msgid "Require Number"
msgstr "რიცხვის მოთხოვნა"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 numerical character."
msgstr "ეს მოითხოვს, რომ ახალი პაროლები შეიცავდეს მინიმუმ 1 ციფრულ სიმბოლოს."

#: include/global_settings.php
msgid "Require Special Character"
msgstr "სპეციალური სიმბოლოს მოთხოვნა"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 special character."
msgstr "ეს მოითხოვს, რომ ახალი პაროლები შეიცავდეს მინიმუმ 1 სპეციალურ სიმბოლოს."

#: include/global_settings.php
msgid "Force Complexity Upon Old Passwords"
msgstr "სირთულის მოთხოვნის დაკისრება ძველ პაროლებზე"

#: include/global_settings.php
msgid "This will require all old passwords to also meet the new complexity requirements upon login.  If not met, it will force a password change."
msgstr "ეს მოითხოვს, რომ ყველა ძველი პაროლი შესვლისას ასევე აკმაყოფილებდეს ახალ სირთულის მოთხოვნებს.  თუ არ აკმაყოფილებს, პაროლის შეცვლა იძულებითი იქნება."

#: include/global_settings.php
msgid "Expire Inactive Accounts"
msgstr "უმოქმედო ანგარიშების ვადის გასვლა"

#: include/global_settings.php
msgid "This is the maximum number of days before inactive accounts are disabled.  The Admin account is excluded from this policy."
msgstr "ეს არის დღეთა მაქსიმალური რაოდენობა, რომლის შემდეგაც უმოქმედო ანგარიშები გამოირთვება.  ადმინისტრატორის ანგარიში ამ პოლიტიკიდან გამორიცხულია."

#: include/global_settings.php
msgid "Expire Password"
msgstr "პაროლის ვადის გასვლა"

#: include/global_settings.php
msgid "This is the maximum number of days before a password is set to expire."
msgstr "ეს არის დღეთა მაქსიმალური რაოდენობა, რომლის შემდეგაც პაროლს ვადა გაუვა."

#: include/global_settings.php
msgid "Password History"
msgstr "პაროლის ისტორია"

#: include/global_settings.php
msgid "Remember this number of old passwords and disallow reusing them."
msgstr "დაიმახსოვრეთ ძველი პაროლების ეს რაოდენობა და აკრძალეთ მათი ხელახლა გამოყენება."

#: include/global_settings.php
msgid "1 Change"
msgstr "1 ცვლილება"

#: include/global_settings.php
#, php-format
msgid "%d Changes"
msgstr "%d ცვლილება"

#: include/global_settings.php
msgid "Account Locking"
msgstr "ანგარიშის დაბლოკვა"

#: include/global_settings.php
msgid "Lock Accounts"
msgstr "ანგარიშების დაბლოკვა"

#: include/global_settings.php
msgid "Lock an account after this many failed attempts in 1 hour."
msgstr "დაბლოკეთ ანგარიში 1 საათში ამდენი წარუმატებელი მცდელობის შემდეგ."

#: include/global_settings.php
msgid "1 Attempt"
msgstr "1 მცდელობა"

#: include/global_settings.php
#, php-format
msgid "%d Attempts"
msgstr "%d მცდელობა"

#: include/global_settings.php
msgid "Auto Unlock"
msgstr "ავტომატური განბლოკვა"

#: include/global_settings.php
msgid "An account will automatically be unlocked after this many minutes.  Even if the correct password is entered, the account will not unlock until this time limit has been met.  Max of 1440 minutes (1 Day)"
msgstr "ანგარიში ავტომატურად განიბლოკება ამდენი წუთის შემდეგ.  სწორი პაროლის შეყვანის შემთხვევაშიც კი, ანგარიში არ განიბლოკება, სანამ ეს დროის ლიმიტი არ გავა.  მაქსიმუმ 1440 წუთი (1 დღე)"

#: include/global_settings.php
msgid "1 Day"
msgstr "1 დღე"

#: include/global_settings.php
msgid "LDAP General Settings"
msgstr "LDAP-ის ზოგადი პარამეტრები"

#: include/global_settings.php user_domains.php
msgid "Server(s)"
msgstr "სერვერი/სერვერები"

#: include/global_settings.php user_domains.php
msgid "A space delimited list of DNS hostnames or IP addresses for valid LDAP servers.  Kadupul will attempt to use the LDAP servers from left to right to authenticate a user."
msgstr "DNS ჰოსტის სახელების ან IP მისამართების ინტერვალით გამოყოფილი სია სწორი LDAP სერვერებისთვის.  Kadupul შეეცდება LDAP სერვერების გამოყენებას მარცხნიდან მარჯვნივ მომხმარებლის ავთენტიფიკაციისთვის."

#: include/global_settings.php user_domains.php
msgid "Port Standard"
msgstr "სტანდარტული პორტი"

#: include/global_settings.php
msgid "TCP port for Non-SSL communications including LDAP + TLS.  Default is 389."
msgstr "TCP პორტი არა-SSL კომუნიკაციისთვის, LDAP + TLS-ის ჩათვლით.  ნაგულისხმევია 389."

#: include/global_settings.php user_domains.php
msgid "Port SSL"
msgstr "SSL პორტი"

#: include/global_settings.php
msgid "TCP port for LDAPS for SSL communications.  Default is 636."
msgstr "TCP პორტი LDAPS-ისთვის SSL კომუნიკაციისთვის.  ნაგულისხმევია 636."

#: include/global_settings.php user_domains.php
msgid "Protocol Version"
msgstr "პროტოკოლის ვერსია"

#: include/global_settings.php
msgid "Protocol Version to connect to the server with."
msgstr "პროტოკოლის ვერსია სერვერთან დასაკავშირებლად."

#: include/global_settings.php
msgid "Connect Timeout"
msgstr "დაკავშირების ვადის გასვლა"

#: include/global_settings.php
msgid "The Network Connect Timeout in seconds."
msgstr "ქსელური დაკავშირების ვადის გასვლა წამებში."

#: include/global_settings.php
msgid "Bind Timeout"
msgstr "Bind-ის ვადის გასვლა"

#: include/global_settings.php
msgid "The Bind Timeout in seconds."
msgstr "Bind-ის ვადის გასვლა წამებში."

#: include/global_settings.php
msgid "LDAP Debug Mode"
msgstr "LDAP გამართვის რეჟიმი"

#: include/global_settings.php
msgid "If Checked Kadupul will log extra LDAP information to the Kadupul log during Binding and Searching activities."
msgstr "თუ მონიშნულია, Kadupul Bind-ისა და ძიების მოქმედებების დროს Kadupul-ის ჟურნალში დამატებით LDAP ინფორმაციას ჩაწერს."

#: include/global_settings.php user_domains.php
msgid "Encryption"
msgstr "დაშიფვრა"

#: include/global_settings.php
msgid "Encryption that the server supports. NOTE: When using LDAP + TLS you must use version 3."
msgstr "დაშიფვრა, რომელსაც სერვერი მხარს უჭერს. შენიშვნა: LDAP + TLS-ის გამოყენებისას უნდა გამოიყენოთ ვერსია 3."

#: include/global_settings.php
msgid "TLS Certificate Requirements"
msgstr "TLS სერტიფიკატის მოთხოვნები"

#: include/global_settings.php
msgid "Should LDAP verify TLS Certificates when received by the Client.  Demand and Hard refuse a server whose certificate does not verify.  Never and Allow skip that check, so anyone on the network path can pose as the directory and read the passwords sent to it."
msgstr "უნდა გადაამოწმოს თუ არა LDAP-მა TLS სერტიფიკატები, როცა კლიენტი მათ მიიღებს.  Demand და Hard უარყოფენ სერვერს, რომლის სერტიფიკატიც არ გადამოწმდება.  Never და Allow ამ შემოწმებას გამოტოვებენ, ამიტომ ქსელის გზაზე მყოფ ნებისმიერ პირს შეუძლია დირექტორიად მოგვევლინოს და წაიკითხოს მასზე გაგზავნილი პაროლები."

#: include/global_settings.php user_domains.php
msgid "Referrals"
msgstr "გადამისამართებები"

#: include/global_settings.php user_domains.php
msgid "Enable or Disable LDAP referrals.  If disabled, it may increase the speed of searches."
msgstr "LDAP-ის გადამისამართებების ჩართვა ან გამორთვა.  გამორთვის შემთხვევაში შეიძლება ძიების სიჩქარე გაიზარდოს."

#: include/global_settings.php user_domains.php
msgid "Mode"
msgstr "რეჟიმი"

#: include/global_settings.php user_domains.php
msgid "Mode which cacti will attempt to authenticate against the LDAP server.<blockquote><i>No Searching</i> - No Distinguished Name (DN) searching occurs, just attempt to bind with the provided Distinguished Name (DN) format.<br><br><i>Anonymous Searching</i> - Attempts to search for username against LDAP directory via anonymous binding to locate the user's Distinguished Name (DN).<br><br><i>Specific Searching</i> - Attempts to search for username against LDAP directory via Specific Distinguished Name (DN) and Specific Password for binding to locate the user's Distinguished Name (DN)."
msgstr "რეჟიმი, რომლითაც cacti შეეცდება ავთენტიფიკაციას LDAP სერვერის მიმართ.<blockquote><i>ძებნის გარეშე</i> - Distinguished Name (DN) ძიება არ ხდება, უბრალოდ ხდება მცდელობა მიწოდებული Distinguished Name (DN) ფორმატით bind-ისა.<br><br><i>ანონიმური ძებნა</i> - ცდილობს მომხმარებლის სახელის ძიებას LDAP დირექტორიაში ანონიმური bind-ით, მომხმარებლის Distinguished Name (DN)-ის მოსაძებნად.<br><br><i>კონკრეტული ძებნა</i> - ცდილობს მომხმარებლის სახელის ძიებას LDAP დირექტორიაში კონკრეტული Distinguished Name (DN)-ისა და კონკრეტული პაროლის bind-ით, მომხმარებლის Distinguished Name (DN)-ის მოსაძებნად."

#: include/global_settings.php user_domains.php
msgid "Distinguished Name (DN)"
msgstr "Distinguished Name (DN)"

#: include/global_settings.php user_domains.php
msgid "The \"Distinguished Name\" syntax, applicable for both OpenLDAP and Windows AD configurations, offers flexibility in defining user identity. For OpenLDAP, the format follows this structure: <i>\"uid=&lt;username&gt;,ou=people,dc=domain,dc=local\"</i>. Windows AD provides an alternative syntax: <i>\"&lt;username&gt;@win2kdomain.local\"</i>, commonly known as \"userPrincipalName (UPN)\". In this context, \"&lt;username&gt;\" represents the specific username provided during the login prompt. This is particularly pertinent when operating in \"No Searching\" mode, or \"Require Group Membership\" enabled."
msgstr "\"Distinguished Name\" სინტაქსი, რომელიც გამოიყენება როგორც OpenLDAP-ის, ისე Windows AD-ის კონფიგურაციებისთვის, მოქნილობას გვთავაზობს მომხმარებლის იდენტობის განსაზღვრაში. OpenLDAP-ისთვის ფორმატი ამ სტრუქტურას მისდევს: <i>\"uid=&lt;username&gt;,ou=people,dc=domain,dc=local\"</i>. Windows AD გვთავაზობს ალტერნატიულ სინტაქსს: <i>\"&lt;username&gt;@win2kdomain.local\"</i>, რომელიც ცნობილია როგორც \"userPrincipalName (UPN)\". ამ კონტექსტში \"&lt;username&gt;\" წარმოადგენს კონკრეტულ მომხმარებლის სახელს, რომელიც შესვლის მოთხოვნისას იქნა მითითებული. ეს განსაკუთრებით აქტუალურია \"ძებნის გარეშე\" რეჟიმში მუშაობისას ან როცა ჩართულია \"ჯგუფის წევრობის მოთხოვნა\"."

#: include/global_settings.php user_domains.php
msgid "Require Group Membership"
msgstr "ჯგუფის წევრობის მოთხოვნა"

#: include/global_settings.php user_domains.php
msgid "Require user to be member of group to authenticate. Group settings must be set for this to work, enabling without proper group settings will cause authentication failure."
msgstr "მოითხოვეთ, რომ მომხმარებელი იყოს ჯგუფის წევრი ავთენტიფიკაციისთვის. ამისთვის ჯგუფის პარამეტრები უნდა იყოს დაყენებული; სათანადო ჯგუფის პარამეტრების გარეშე ჩართვა ავთენტიფიკაციის წარუმატებლობას გამოიწვევს."

#: include/global_settings.php user_domains.php
msgid "LDAP Group Settings"
msgstr "LDAP ჯგუფის პარამეტრები"

#: include/global_settings.php user_domains.php
msgid "Group Distinguished Name (DN)"
msgstr "ჯგუფის Distinguished Name (DN)"

#: include/global_settings.php user_domains.php
msgid "Distinguished Name of the group that user must have membership."
msgstr "იმ ჯგუფის Distinguished Name, რომლის წევრიც უნდა იყოს მომხმარებელი."

#: include/global_settings.php user_domains.php
msgid "Group Member Attribute"
msgstr "ჯგუფის წევრის ატრიბუტი"

#: include/global_settings.php user_domains.php
msgid "This refers to the specific attribute within the LDAP directory that holds the usernames of group members. It is crucial to ensure that the attribute value aligns with the configuration specified in the \"Distinguished Name\" or that the actual attribute value is searchable using the settings outlined in the \"Distinguished Name\"."
msgstr "ეს ეხება LDAP დირექტორიაში იმ კონკრეტულ ატრიბუტს, რომელიც ჯგუფის წევრების მომხმარებლის სახელებს შეიცავს. მნიშვნელოვანია დარწმუნდეთ, რომ ატრიბუტის მნიშვნელობა შეესაბამება \"Distinguished Name\"-ში მითითებულ კონფიგურაციას, ან რომ ატრიბუტის რეალური მნიშვნელობა ძიებადია \"Distinguished Name\"-ში აღწერილი პარამეტრებით."

#: include/global_settings.php user_domains.php
msgid "Group Member Type"
msgstr "ჯგუფის წევრის ტიპი"

#: include/global_settings.php user_domains.php
msgid "Defines if users use full Distinguished Name or just Username in the defined Group Member Attribute."
msgstr "განსაზღვრავს, იყენებენ თუ არა მომხმარებლები სრულ Distinguished Name-ს ან მხოლოდ მომხმარებლის სახელს განსაზღვრულ ჯგუფის წევრის ატრიბუტში."

#: include/global_settings.php
msgid "Distinguished Name"
msgstr "Distinguished Name"

#: include/global_settings.php user_domains.php
msgid "LDAP Specific Search Settings"
msgstr "LDAP-ის კონკრეტული ძიების პარამეტრები"

#: include/global_settings.php user_domains.php
msgid "Search Base"
msgstr "ძიების ბაზა"

#: include/global_settings.php
msgid "Search base for searching the LDAP directory, such as <i>'dc=win2kdomain,dc=local'</i> or <i>'ou=people,dc=domain,dc=local'</i>."
msgstr "ძიების ბაზა LDAP დირექტორიაში საძიებლად, მაგალითად <i>'dc=win2kdomain,dc=local'</i> ან <i>'ou=people,dc=domain,dc=local'</i>."

#: include/global_settings.php user_domains.php
msgid "Search Filter"
msgstr "ძიების ფილტრი"

#: include/global_settings.php
msgid "Search filter to use to locate the user in the LDAP directory, such as for windows: <i>'(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))'</i> or for OpenLDAP: <i>'(&(objectClass=account)(uid=&lt;username&gt))'</i>.  '&lt;username&gt' is replaced with the username that was supplied at the login prompt. "
msgstr "ძიების ფილტრი მომხმარებლის LDAP დირექტორიაში მოსაძებნად, მაგალითად windows-ისთვის: <i>'(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))'</i> ან OpenLDAP-ისთვის: <i>'(&(objectClass=account)(uid=&lt;username&gt))'</i>.  '&lt;username&gt' იცვლება შესვლის მოთხოვნისას მიწოდებული მომხმარებლის სახელით. "

#: include/global_settings.php user_domains.php
