#: about.php:29 include/global_arrays.php:2655 lib/html.php:2901
msgid "About Cacti"
msgstr "Cacti-ის შესახებ"

#: about.php:42
msgid "Cacti is designed to be a complete graphing solution based on the RRDtool Time Series Database (TSDB) and Graphing solution. Its goal is to make the Network Administrator's job easier by taking care of all the important details necessary to create meaningful Graphs."
msgstr "Cacti შექმნილია, როგორც სრული გრაფიკული გადაწყვეტა, რომელიც ეფუძნება RRDtool-ის დროითი მწკრივების მონაცემთა ბაზასა (TSDB) და გრაფიკების აგების გადაწყვეტას. მისი მიზანია, ქსელის ადმინისტრატორის საქმე გაამარტივოს ყველა მნიშვნელოვანი დეტალის გათვალისწინებით, რომლებიც საჭიროა შინაარსიანი გრაფიკების შესაქმნელად."

#: about.php:44
#, php-format
msgid "Please see the official %sCacti website%s for information on how to use Cacti, get support, and updates."
msgstr "გაეცანით ოფიციალურ %sCacti-ის ვებსაიტს%s, რათა გაიგოთ, როგორ გამოიყენოთ Cacti, მიიღოთ მხარდაჭერა და განახლებები."

#: about.php:48
msgid "Active Developers"
msgstr "აქტიური დეველოპერები"

#: about.php:49
msgid "Developers working on Cacti, its Architecture, Documentation and Future Releases."
msgstr "დეველოპერები, რომლებიც მუშაობენ Cacti-ზე, მის არქიტექტურაზე, დოკუმენტაციასა და მომავალ გამოშვებებზე."

#: about.php:61
msgid "Honorable Mentions"
msgstr "საპატიო ხსენებები"

#: about.php:62
msgid "Contributors to Documentation, QA, Packaging, the Forums and our YouTube page."
msgstr "დოკუმენტაციის, ხარისხის უზრუნველყოფის, შეფუთვის, ფორუმებისა და ჩვენი YouTube-ის გვერდის კონტრიბუტორები."

#: about.php:70
msgid "Emeritus Members"
msgstr "საპატიო წევრები"

#: about.php:71
msgid "Members of the original Cacti Group that have since moved on in their careers.  We continue to wish them the best."
msgstr "ორიგინალური Cacti Group-ის წევრები, რომლებიც შემდგომ კარიერაში სხვა მიმართულებით წავიდნენ.  ჩვენ მათ წარმატებებს ვუსურვებთ."

#: about.php:84
msgid "Thanks"
msgstr "მადლობა"

#: about.php:87
#, php-format
msgid "A very special thanks to %sTobi Oetiker%s, the creator of %sRRDtool%s and the very popular %sMRTG%s."
msgstr "განსაკუთრებული მადლობა %sტობი ოეტიკერს%s, %sRRDtool-ის%s და ძალიან პოპულარული %sMRTG-ის%s შემქმნელს."

#: about.php:90
msgid "The users of Cacti"
msgstr "Cacti-ის მომხმარებლები"

#: about.php:91
msgid "Especially anyone who has taken the time to create an issue report, or otherwise help fix a Cacti related problems. Also to anyone who has contributed to supporting Cacti."
msgstr "განსაკუთრებით ყველას, ვინც დრო გამონახა პრობლემის შესახებ ანგარიშის შესაქმნელად ან სხვაგვარად დაგვეხმარა Cacti-სთან დაკავშირებული პრობლემების მოგვარებაში. ასევე ყველას, ვინც Cacti-ის მხარდაჭერაში შეიტანა წვლილი."

#: about.php:96
msgid "License"
msgstr "ლიცენზია"

#: about.php:98
msgid "Cacti is licensed under the GNU GPL:"
msgstr "Cacti ლიცენზირებულია GNU GPL-ით:"

#: about.php:102 lib/installer.php:1866
msgid "This program is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation; either version 2 of the License, or (at your option) any later version."
msgstr "ეს პროგრამა თავისუფალი პროგრამული უზრუნველყოფაა; შეგიძლიათ გაავრცელოთ და/ან შეცვალოთ იგი Free Software Foundation-ის მიერ გამოქვეყნებული GNU-ის ზოგადი საჯარო ლიცენზიის მე-2 ვერსიის ან (თქვენი არჩევით) ნებისმიერი უფრო გვიანდელი ვერსიის პირობებით."

#: about.php:110
msgid "This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details."
msgstr "ეს პროგრამა ვრცელდება იმ იმედით, რომ სასარგებლო იქნება, მაგრამ ყოველგვარი გარანტიის გარეშე; იმპლიციტური გარანტიის გარეშეც კი, რომ იგი გამოდგება გაყიდვისთვის ან კონკრეტული მიზნისთვის. დამატებითი დეტალებისთვის იხილეთ GNU-ის ზოგადი საჯარო ლიცენზია."

