#: include/global_settings.php
msgid "1 Process"
msgstr "1 प्रक्रिया"

#: include/global_settings.php
#, php-format
msgid "%d Processes"
msgstr "%d प्रक्रियाहरू"

#: include/global_settings.php
msgid "Maintenance Background Generation Timeout"
msgstr "मर्मतसम्भार पृष्ठभूमि सिर्जना टाइमआउट"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Maintenance script can run without generating a timeout error and being killed."
msgstr "Kadupul को मर्मतसम्भार स्क्रिप्ट टाइमआउट त्रुटि सिर्जना नगरी र मारिनुअघि चल्न सक्ने अधिकतम समय।"

#: include/global_settings.php
msgid "Spikekill Background Generation Timeout"
msgstr "Spikekill पृष्ठभूमि सिर्जना टाइमआउट"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Spikekill script can run without generating a timeout error and being killed."
msgstr "Kadupul को Spikekill स्क्रिप्ट टाइमआउट त्रुटि सिर्जना नगरी र मारिनुअघि चल्न सक्ने अधिकतम समय।"

#: include/global_settings.php
msgid "Data Collector Defaults"
msgstr "डेटा सङ्कलक पूर्वनिर्धारितहरू"

#: include/global_settings.php
msgid "These settings are maintained at the Data Collector level.  The values here are only defaults used when first creating a Data Collector."
msgstr "यी सेटिङहरू डेटा सङ्कलक स्तरमा कायम गरिन्छन्।  यहाँका मानहरू डेटा सङ्कलक पहिलो पटक सिर्जना गर्दा प्रयोग हुने पूर्वनिर्धारितहरू मात्र हुन्।"

#: include/global_settings.php
msgid "Data Collector Processes"
msgstr "डेटा सङ्कलक प्रक्रियाहरू"

#: include/global_settings.php
msgid "The default number of concurrent processes to execute per Data Collector.  NOTE: Starting from Kadupul 1.2, this setting is maintained in the Data Collector.  Moving forward, this value is only a preset for the Data Collector.  Using a higher number when using cmd.php will improve performance.  Performance improvements in Spine are best resolved with the threads parameter.  When using Spine, we recommend a lower number and leveraging threads instead.  When using cmd.php, use no more than 2x the number of CPU cores."
msgstr "प्रति डेटा सङ्कलक कार्यान्वयन गरिने समवर्ती प्रक्रियाहरूको पूर्वनिर्धारित सङ्ख्या।  नोट: Kadupul 1.2 देखि, यो सेटिङ डेटा सङ्कलकमा कायम गरिन्छ।  अब यो मान डेटा सङ्कलकका लागि प्रिसेट मात्र हो।  cmd.php प्रयोग गर्दा उच्च सङ्ख्या प्रयोग गर्नाले प्रदर्शन सुधार्छ।  Spine मा प्रदर्शन सुधारहरू threads प्यारामिटरले उत्कृष्ट रूपमा समाधान गर्छ।  Spine प्रयोग गर्दा, हामी कम सङ्ख्या र बरु थ्रेडहरू प्रयोग गर्न सिफारिस गर्छौँ।  cmd.php प्रयोग गर्दा, CPU कोरको सङ्ख्याको 2 गुणाभन्दा बढी प्रयोग नगर्नुहोस्।"

#: include/global_settings.php
msgid "Threads per Process"
msgstr "प्रति प्रक्रिया थ्रेडहरू"

#: include/global_settings.php
msgid "The Default Threads allowed per process.  NOTE: Starting in Kadupul 1.2+, this setting is maintained in the Data Collector, and this is simply the Preset.  Using a higher number when using Spine will improve performance.  However, ensure that you have enough MySQL/MariaDB connections to support the following equation: connections = data collectors * processes * (threads + script servers).  You must also ensure that you have enough spare connections for user login connections as well."
msgstr "प्रति प्रक्रिया अनुमत पूर्वनिर्धारित थ्रेडहरू।  नोट: Kadupul 1.2+ देखि, यो सेटिङ डेटा सङ्कलकमा कायम गरिन्छ, र यो केवल प्रिसेट हो।  Spine प्रयोग गर्दा उच्च सङ्ख्या प्रयोग गर्नाले प्रदर्शन सुधार्छ।  तर, तपाईँसँग निम्न समीकरणलाई समर्थन गर्न पर्याप्त MySQL/MariaDB जडानहरू छन् भन्ने सुनिश्चित गर्नुहोस्: connections = data collectors * processes * (threads + script servers)।  प्रयोगकर्ता लग इन जडानहरूका लागि पनि तपाईँसँग पर्याप्त अतिरिक्त जडानहरू छन् भन्ने सुनिश्चित गर्नुपर्छ।"

#: include/global_settings.php
msgid "Authentication Method"
msgstr "प्रमाणीकरण विधि"

#: include/global_settings.php
msgid "<blockquote><i>Built-in Authentication</i> - Kadupul handles user authentication, which allows you to create users and give them rights to different areas within Kadupul.<br><br><i>Web Basic Authentication</i> - Authentication is handled by the web server. Users can be added or created automatically on first login if the Template User is defined, otherwise the defined guest permissions will be used.<br><br><i>LDAP Authentication</i> - Allows for authentication against an LDAP server. Users will be created automatically on first login if the Template User is defined, otherwise the defined guest permissions will be used.  If PHP's LDAP module is not enabled, LDAP Authentication will not appear as a selectable option.<br><br><i>Multiple LDAP/AD Domain Authentication</i> - Allows administrators to support multiple disparate groups from different LDAP/AD directories to access Kadupul resources.  Just as LDAP Authentication, the PHP LDAP module is required to utilize this method.</blockquote>"
msgstr "<blockquote><i>बिल्ट-इन प्रमाणीकरण</i> - Kadupul ले प्रयोगकर्ता प्रमाणीकरण ह्यान्डल गर्छ, जसले तपाईँलाई प्रयोगकर्ताहरू सिर्जना गर्न र तिनलाई Kadupul भित्रका विभिन्न क्षेत्रहरूको अधिकार दिन अनुमति दिन्छ।<br><br><i>Web Basic प्रमाणीकरण</i> - प्रमाणीकरण वेब सर्भरले ह्यान्डल गर्छ। टेम्प्लेट प्रयोगकर्ता परिभाषित भएमा प्रयोगकर्ताहरू पहिलो लग इनमा स्वचालित रूपमा थप्न वा सिर्जना गर्न सकिन्छ, अन्यथा परिभाषित अतिथि अनुमतिहरू प्रयोग गरिनेछ।<br><br><i>LDAP प्रमाणीकरण</i> - LDAP सर्भरसँग प्रमाणीकरण गर्न अनुमति दिन्छ। टेम्प्लेट प्रयोगकर्ता परिभाषित भएमा प्रयोगकर्ताहरू पहिलो लग इनमा स्वचालित रूपमा सिर्जना हुनेछन्, अन्यथा परिभाषित अतिथि अनुमतिहरू प्रयोग गरिनेछ।  PHP को LDAP मोड्युल सक्षम छैन भने, LDAP प्रमाणीकरण चयनयोग्य विकल्पका रूपमा देखा पर्नेछैन।<br><br><i>बहु LDAP/AD डोमेन प्रमाणीकरण</i> - प्रशासकहरूलाई विभिन्न LDAP/AD डाइरेक्टरीहरूका विभिन्न समूहहरूलाई Kadupul स्रोतहरू पहुँच गर्न समर्थन गर्न अनुमति दिन्छ।  LDAP प्रमाणीकरणझैँ, यो विधि प्रयोग गर्न PHP LDAP मोड्युल आवश्यक छ।</blockquote>"

#: include/global_settings.php
msgid "Support Authentication Cookies"
msgstr "प्रमाणीकरण कुकीहरू समर्थन गर्नुहोस्"

#: include/global_settings.php
msgid "If a user authenticates and selects 'Keep me signed in', an authentication cookie will be created on the user's computer allowing that user to stay logged in.  The authentication cookie expires after 90 days of non-use."
msgstr "यदि प्रयोगकर्ताले प्रमाणीकरण गरी 'Keep me signed in' छान्छ भने, प्रयोगकर्ताको कम्प्युटरमा प्रमाणीकरण कुकी सिर्जना हुनेछ जसले उक्त प्रयोगकर्तालाई लग इन रहन दिन्छ।  प्रमाणीकरण कुकी 90 दिन प्रयोग नभएपछि समाप्त हुन्छ।"

#: include/global_settings.php
msgid "Special Users"
msgstr "विशेष प्रयोगकर्ताहरू"

#: include/global_settings.php
msgid "Primary Admin"
msgstr "प्राथमिक प्रशासक"

#: include/global_settings.php
msgid "The name of the primary administrative account that will automatically receive Emails when the Kadupul system experiences issues.  To receive these Emails, ensure that your mail settings are correct, and the administrative account has an Email address that is set."
msgstr "Kadupul प्रणालीमा समस्या आउँदा स्वचालित रूपमा इमेल प्राप्त गर्ने प्राथमिक प्रशासनिक खाताको नाम।  यी इमेलहरू प्राप्त गर्न, तपाईँका मेल सेटिङहरू सही छन् र प्रशासनिक खातामा इमेल ठेगाना सेट गरिएको छ भन्ने सुनिश्चित गर्नुहोस्।"

#: include/global_settings.php user_domains.php
msgid "No User"
msgstr "प्रयोगकर्ता छैन"

#: include/global_settings.php
msgid "Guest User"
msgstr "अतिथि प्रयोगकर्ता"

#: include/global_settings.php
msgid "The name of the guest user for viewing graphs; is 'No User' by default."
msgstr "ग्राफहरू हेर्नका लागि अतिथि प्रयोगकर्ताको नाम; पूर्वनिर्धारित रूपमा 'No User' हो।"

#: include/global_settings.php user_domains.php
msgid "User Template"
msgstr "प्रयोगकर्ता टेम्प्लेट"

#: include/global_settings.php
msgid "The name of the user that Kadupul will use as a template for new Web Basic and LDAP users; is 'guest' by default.  This user account will be disabled from logging in upon being selected."
msgstr "नयाँ Web Basic र LDAP प्रयोगकर्ताहरूका लागि Kadupul ले टेम्प्लेटको रूपमा प्रयोग गर्ने प्रयोगकर्ताको नाम; पूर्वनिर्धारित रूपमा 'guest' हो।  यो प्रयोगकर्ता खाता चयन गरिएपछि लग इन गर्नबाट अक्षम हुनेछ।"

#: include/global_settings.php
msgid "Basic Authentication Settings"
msgstr "आधारभूत प्रमाणीकरण सेटिङहरू"

#: include/global_settings.php
msgid "Basic Auth Login Failure Message"
msgstr "Basic Auth लग इन असफलता सन्देश"

#: include/global_settings.php
msgid "When using basic authentication, if there are issues mapping the username to a valid Kadupul account, the message included here will be displayed to users.  It can include both text and HTML."
msgstr "बेसिक प्रमाणीकरण प्रयोग गर्दा, प्रयोगकर्ता नामलाई मान्य Kadupul खातासँग म्याप गर्न समस्या भएमा, यहाँ समावेश गरिएको सन्देश प्रयोगकर्ताहरूलाई देखाइनेछ।  यसमा पाठ र HTML दुवै समावेश हुन सक्छन्।"

#: include/global_settings.php
msgid "Basic Auth Mapfile"
msgstr "Basic Auth म्यापफाइल"

#: include/global_settings.php
msgid "When using basic authentication, if the basic account needs to be translated to a different login account, you can specify a CSV file here to map the basic account to the desired login account."
msgstr "बेसिक प्रमाणीकरण प्रयोग गर्दा, बेसिक खातालाई फरक लग इन खातामा अनुवाद गर्नुपर्ने भए, बेसिक खातालाई इच्छित लग इन खातासँग म्याप गर्न तपाईँ यहाँ CSV फाइल तोक्न सक्नुहुन्छ।"

#: include/global_settings.php
msgid "Local Account Complexity Requirements"
msgstr "स्थानीय खाता जटिलता आवश्यकताहरू"

#: include/global_settings.php
msgid "Minimum Length"
msgstr "न्यूनतम लम्बाइ"

#: include/global_settings.php
msgid "This is the minimal length of allowed passwords."
msgstr "अनुमत पासवर्डहरूको न्यूनतम लम्बाइ।"

#: include/global_settings.php
msgid "Require Mix Case"
msgstr "मिश्रित केस आवश्यक"

#: include/global_settings.php
msgid "This will require new passwords to contain both lower and upper-case characters."
msgstr "यसले नयाँ पासवर्डहरूमा साना र ठूला दुवै अक्षरहरू हुनु आवश्यक बनाउँछ।"

#: include/global_settings.php
msgid "Require Number"
msgstr "सङ्ख्या आवश्यक"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 numerical character."
msgstr "यसले नयाँ पासवर्डहरूमा कम्तीमा 1 सङ्ख्यात्मक अक्षर हुनु आवश्यक बनाउँछ।"

#: include/global_settings.php
msgid "Require Special Character"
msgstr "विशेष क्यारेक्टर आवश्यक"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 special character."
msgstr "यसले नयाँ पासवर्डहरूमा कम्तीमा 1 विशेष क्यारेक्टर हुनु आवश्यक बनाउँछ।"

#: include/global_settings.php
msgid "Force Complexity Upon Old Passwords"
msgstr "पुराना पासवर्डहरूमा जटिलता बाध्य गर्नुहोस्"

#: include/global_settings.php
msgid "This will require all old passwords to also meet the new complexity requirements upon login.  If not met, it will force a password change."
msgstr "यसले सबै पुराना पासवर्डहरूले पनि लग इन गर्दा नयाँ जटिलता आवश्यकताहरू पूरा गर्नुपर्ने बनाउँछ।  पूरा नभएमा, यसले पासवर्ड परिवर्तन बाध्य गर्नेछ।"

#: include/global_settings.php
msgid "Expire Inactive Accounts"
msgstr "निष्क्रिय खाताहरूको म्याद सक्नुहोस्"

#: include/global_settings.php
msgid "This is the maximum number of days before inactive accounts are disabled.  The Admin account is excluded from this policy."
msgstr "निष्क्रिय खाताहरू अक्षम हुनुअघिको अधिकतम दिनहरूको सङ्ख्या।  Admin खाता यस नीतिबाट बहिष्कृत छ।"

#: include/global_settings.php
msgid "Expire Password"
msgstr "पासवर्डको म्याद सक्नुहोस्"

#: include/global_settings.php
msgid "This is the maximum number of days before a password is set to expire."
msgstr "पासवर्डको म्याद सकिने गरी सेट हुनुअघिको अधिकतम दिनहरूको सङ्ख्या।"

#: include/global_settings.php
msgid "Password History"
msgstr "पासवर्ड इतिहास"

#: include/global_settings.php
msgid "Remember this number of old passwords and disallow reusing them."
msgstr "यति सङ्ख्याका पुराना पासवर्डहरू सम्झनुहोस् र तिनको पुनःप्रयोग निषेध गर्नुहोस्।"

#: include/global_settings.php
msgid "1 Change"
msgstr "1 परिवर्तन"

#: include/global_settings.php
#, php-format
msgid "%d Changes"
msgstr "%d परिवर्तनहरू"

#: include/global_settings.php
msgid "Account Locking"
msgstr "खाता लकिङ"

#: include/global_settings.php
msgid "Lock Accounts"
msgstr "खाताहरू लक गर्नुहोस्"

#: include/global_settings.php
msgid "Lock an account after this many failed attempts in 1 hour."
msgstr "1 घण्टामा यति धेरै असफल प्रयासपछि खाता लक गर्नुहोस्।"

#: include/global_settings.php
msgid "1 Attempt"
msgstr "1 प्रयास"

#: include/global_settings.php
#, php-format
msgid "%d Attempts"
msgstr "%d प्रयासहरू"

#: include/global_settings.php
msgid "Auto Unlock"
msgstr "स्वतः अनलक"

#: include/global_settings.php
msgid "An account will automatically be unlocked after this many minutes.  Even if the correct password is entered, the account will not unlock until this time limit has been met.  Max of 1440 minutes (1 Day)"
msgstr "यति मिनेटपछि खाता स्वचालित रूपमा अनलक हुनेछ।  सही पासवर्ड प्रविष्ट गरे पनि, यो समय सीमा पूरा नभएसम्म खाता अनलक हुनेछैन।  अधिकतम 1440 मिनेट (1 दिन)"

#: include/global_settings.php
msgid "1 Day"
msgstr "1 दिन"

#: include/global_settings.php
msgid "LDAP General Settings"
msgstr "LDAP सामान्य सेटिङहरू"

#: include/global_settings.php user_domains.php
msgid "Server(s)"
msgstr "सर्भर(हरू)"

#: include/global_settings.php user_domains.php
msgid "A space delimited list of DNS hostnames or IP addresses for valid LDAP servers.  Kadupul will attempt to use the LDAP servers from left to right to authenticate a user."
msgstr "मान्य LDAP सर्भरहरूका DNS होस्टनाम वा IP ठेगानाहरूको खाली ठाउँले छुट्याइएको सूची।  प्रयोगकर्ता प्रमाणित गर्न Kadupul ले बायाँबाट दायाँतिर LDAP सर्भरहरू प्रयोग गर्ने प्रयास गर्नेछ।"

