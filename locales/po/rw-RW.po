msgstr "Andika izina ry'uyu mwanya wa %s. Icyitonderwa: Niba ukoresha izina n'agaciro mu buryo bwa NAME:VALUE muri script yawe, ni ngombwa ko izina rihura neza n'izina ry'umwanya w'ibisohoka cyangwa amazina asohoka muri script."

#: include/global_form.php:473
msgid "Update RRDfile"
msgstr "Vugurura RRDfile"

#: include/global_form.php:474
msgid "Whether data from this output field is to be entered into the RRDfile."
msgstr "Niba amakuru avuye muri uyu mwanya w'ibisohoka agomba gushyirwa muri RRDfile."

#: include/global_form.php:481
msgid "Regular Expression Match"
msgstr "Guhuza na Regular Expression"

#: include/global_form.php:482
msgid "If you want to require a certain regular expression to be matched against input data, enter it here (preg_match format)."
msgstr "Niba ushaka gusaba ko regular expression runaka ruhuzwa n'amakuru yinjijwe, rwandike hano (imiterere ya preg_match)."

#: include/global_form.php:489
msgid "Allow Empty Input"
msgstr "Emera ibinjizwa birimo ubusa"

#: include/global_form.php:490
msgid "Check here if you want to allow NULL input in this field from the user."
msgstr "Kanda hano niba ushaka kwemerera umukoresha kwinjiza NULL muri uyu mwanya."

#: include/global_form.php:497
msgid "Special Type Code"
msgstr "Kode y'ubwoko bwihariye"

#: include/global_form.php:498
#, php-format
msgid "If this field should be treated specially by host templates, indicate so here. Valid keywords for this field are %s"
msgstr "Niba uyu mwanya ugomba gufatwa mu buryo bwihariye n'inyandikorugero za host, byerekane hano. Amagambo yemewe kuri uyu mwanya ni %s"

#: include/global_form.php:530
msgid "The name given to this data template."
msgstr "Izina ryahawe iyi nyandikorugero y'amakuru."

#: include/global_form.php:571
msgid "Choose a name for this data source.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Cacti documentation."
msgstr "Hitamo izina ry'iyi nkomoko y'amakuru. Rishobora kubamo ibihinduka bisimbura nka |host_description| cyangwa |query_fieldName|. Kugira ngo ubone urutonde rwuzuye rw'ibirango bisimbura byemewe, reba inyandiko zisobanura Cacti."

#: include/global_form.php:575
msgid "Data Source Path"
msgstr "Inzira y'inkomoko y'amakuru"

#: include/global_form.php:580
msgid "The full path to the RRDfile."
msgstr "Inzira yuzuye igana kuri RRDfile."

#: include/global_form.php:589
msgid "The script/source used to gather data for this data source."
msgstr "Script/inkomoko ikoreshwa mu gukusanya amakuru y'iyi nkomoko y'amakuru."

#: include/global_form.php:595 include/global_form.php:1702
#: package_import.php:899
msgid "Select the Data Source Profile.  The Data Source Profile controls polling interval, the data aggregation, and retention policy for the resulting Data Sources."
msgstr "Hitamo Porofayili y'inkomoko y'amakuru. Porofayili y'inkomoko y'amakuru igenzura intera y'ikusanyamakuru, ihuriza hamwe ry'amakuru, na politiki yo kubika ku nkomoko z'amakuru zibonetse."

#: include/global_form.php:606
msgid "The amount of time in seconds between expected updates."
msgstr "Ingano y'igihe mu masegonda hagati y'ivugurura ryitezwe."

#: include/global_form.php:610
msgid "Data Source Active"
msgstr "Inkomoko y'amakuru irakora"

#: include/global_form.php:614
msgid "Whether Cacti should gather data for this data source or not."
msgstr "Niba Cacti igomba gukusanya amakuru y'iyi nkomoko y'amakuru cyangwa itagomba."

#: include/global_form.php:622
msgid "Internal Data Source Name"
msgstr "Izina ry'imbere ry'inkomoko y'amakuru"

#: include/global_form.php:627
msgid "Choose unique name to represent this piece of data inside of the RRDfile."
msgstr "Hitamo izina ryihariye rihagarariye iki gice cy'amakuru imbere muri RRDfile."

#: include/global_form.php:630
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "Agaciro gato gashoboka (\"U\" ku kutagira agaciro gato ntarengwa)"

#: include/global_form.php:635
msgid "The minimum value of data that is allowed to be collected."
msgstr "Agaciro gato gashoboka k'amakuru yemerewe gukusanywa."

#: include/global_form.php:638
msgid "Maximum Value (\"U\" for No Maximum)"
msgstr "Agaciro kanini gashoboka (\"U\" ku kutagira agaciro kanini ntarengwa)"

#: include/global_form.php:643
msgid "The maximum value of data that is allowed to be collected."
msgstr "Agaciro kanini gashoboka k'amakuru yemerewe gukusanywa."

#: include/global_form.php:646
msgid "Data Source Type"
msgstr "Ubwoko bw'inkomoko y'amakuru"

#: include/global_form.php:650
msgid "How data is represented in the RRA."
msgstr "Uburyo amakuru ahagarariwe muri RRA."

#: include/global_form.php:658
msgid "The maximum amount of time that can pass before data is entered as 'unknown'. (Usually 2x300=600)"
msgstr "Igihe ntarengwa gishobora gushira mbere y'uko amakuru yandikwa nka 'atazwi'. (Ubusanzwe 2x300=600)"

#: include/global_form.php:664 lib/html_utility.php:341
msgid "Not Selected"
msgstr "Ntabwo byahiswemo"

#: include/global_form.php:665
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "Iyo amakuru akusanyijwe, amakuru y'uyu mwanya azashyirwa muri iyi nkomoko y'amakuru."

#: include/global_form.php:674
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "Andika izina ry'iyi GPRINT preset, ugenzure ko ari ikintu umenyereye."

#: include/global_form.php:681
msgid "GPRINT Text"
msgstr "Umwandiko wa GPRINT"

#: include/global_form.php:682
msgid "Enter the custom GPRINT string here."
msgstr "Andika hano interuro yihariye ya GPRINT."

#: include/global_form.php:700
msgid "Common Options"
msgstr "Amahitamo rusange"

#: include/global_form.php:705
msgid "Title (--title)"
msgstr "Umutwe (--title)"

#: include/global_form.php:709
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Cacti documentation."
msgstr "Izina ryandikwa ku gishushanyo. Rishobora kuba ririmo ibimenyetso bisimbuza nk'ibi |host_description| cyangwa |query_fieldName|. Kugira ngo ubone urutonde rwuzuye rw'ibimenyetso bisimbuza byemewe, nyamuneka reba inyandiko za Cacti."

#: include/global_form.php:713
msgid "Vertical Label (--vertical-label)"
msgstr "Inyandiko ihagaritse (--vertical-label)"

#: include/global_form.php:717
msgid "The label vertically printed to the left of the graph."
msgstr "Inyandiko yandikwa ihagaritse ibumoso bw'igishushanyo."

#: include/global_form.php:721
msgid "Image Format (--imgformat)"
msgstr "Imiterere y'ishusho (--imgformat)"

#: include/global_form.php:725
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "Ubwoko bw'igishushanyo gikorwa; PNG, GIF cyangwa SVG. Guhitamo ubwoko bw'ishusho y'igishushanyo biterwa cyane na RRDtool."

#: include/global_form.php:728
msgid "Height (--height)"
msgstr "Ubuhagarike (--height)"

#: include/global_form.php:732
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Ubuhagarike (mu mapikiseli) bw'akarere k'igishushanyo imbere mu gishushanyo. Aka karere ntikarimo ibisobanuro by'igishushanyo, ibisobanuro by'imirongo fatizo, cyangwa umutwe."

#: include/global_form.php:736
msgid "Width (--width)"
msgstr "Ubugari (--width)"

#: include/global_form.php:740
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Ubugari (mu mapikiseli) bw'akarere k'igishushanyo imbere mu gishushanyo. Aka karere ntikarimo ibisobanuro by'igishushanyo, ibisobanuro by'imirongo fatizo, cyangwa umutwe."

#: include/global_form.php:744
msgid "Base Value (--base)"
msgstr "Agaciro shingiro (--base)"

#: include/global_form.php:748
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "Kagomba gushyirwa kuri 1024 ku bubiko no kuri 1000 ku bipimo by'urujya n'uruza."

#: include/global_form.php:752
msgid "Slope Mode (--slope-mode)"
msgstr "Uburyo bw'ubuhaname (--slope-mode)"

#: include/global_form.php:756
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Gukoresha Uburyo bw'ubuhaname biringaniza imiterere y'ibishushanyo ariko bikagabanya gato ubwiza bw'igaragara kuri mugaragaza."

#: include/global_form.php:759
msgid "Scaling Options"
msgstr "Amahitamo y'ikigero"

#: include/global_form.php:764
msgid "Auto Scale"
msgstr "Ikigero cyikora"

#: include/global_form.php:768
msgid "Auto scale the y-axis instead of defining an upper and lower limit. Note: if this is check both the Upper and Lower limit will be ignored."
msgstr "Gena ikigero cy'umurongo fatizo wa y mu buryo bwikora aho gushyiraho igipimo cyo hejuru n'icyo hasi. Icyitonderwa: niba ibi bihiswemo, igipimo cyo hejuru n'icyo hasi byombi bizirengagizwa."

#: include/global_form.php:772
msgid "Auto Scale Options"
msgstr "Amahitamo y'ikigero cyikora"

#: include/global_form.php:775
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "Koresha <br> --alt-autoscale kugira ngo ugere ku gipimo gito cyane n'ikinini cyane nyakuri <br> --alt-autoscale-max kugira ngo ugere ku gipimo kinini cyane, ukoresheje igipimo cyo hasi cyatanzwe <br> --alt-autoscale-min kugira ngo ugere ku gipimo gito cyane, ukoresheje igipimo cyo hejuru cyatanzwe <br> --alt-autoscale (hamwe n'ibipimo ntarengwa) kugira ngo ugene ikigero ukoresheje igipimo cyo hasi n'icyo hejuru byombi (ibisanzwe bya RRDtool) <br>"

#: include/global_form.php:779
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "Koresha --alt-autoscale (wirengagiza ibipimo ntarengwa byatanzwe)"

#: include/global_form.php:783
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "Koresha --alt-autoscale-max (wemera igipimo cyo hasi)"

#: include/global_form.php:787
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "Koresha --alt-autoscale-min (wemera igipimo cyo hejuru)"

#: include/global_form.php:791
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "Koresha --alt-autoscale (wemera ibipimo byombi, ibisanzwe bya RRDtool)"

#: include/global_form.php:796
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Ikigero cya logaritimi (--logarithmic)"

#: include/global_form.php:800
msgid "Use Logarithmic y-axis scaling"
msgstr "Koresha ikigero cya logaritimi ku murongo fatizo wa y"

#: include/global_form.php:803
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "Ibipimo bya SI ku kigero cya logaritimi (--units=si)"

#: include/global_form.php:806
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "Koresha Ibipimo bya SI ku kigero cya logaritimi aho gukoresha imyandikire y'ibyikubye.<br> Icyitonderwa: Ibishushanyo bigororotse bikoresha imyandikire ya SI mu buryo busanzwe."

#: include/global_form.php:809
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "Uburyo bw'imipaka idahinduka (--rigid)"

#: include/global_form.php:812
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "Ntiwagure igipimo cyo hasi n'icyo hejuru niba igishushanyo kirimo agaciro kari hanze y'urugero rwemewe."

#: include/global_form.php:815
msgid "Upper Limit (--upper-limit)"
msgstr "Igipimo cyo hejuru (--upper-limit)"

#: include/global_form.php:819
msgid "The maximum vertical value for the graph."
msgstr "Agaciro kanini cyane gahagaritse k'igishushanyo."

#: include/global_form.php:823
msgid "Lower Limit (--lower-limit)"
msgstr "Igipimo cyo hasi (--lower-limit)"

#: include/global_form.php:827
msgid "The minimum vertical value for the graph."
msgstr "Agaciro gato cyane gahagaritse k'igishushanyo."

#: include/global_form.php:831
msgid "Grid Options"
msgstr "Amahitamo y'urusobe rw'imirongo"

#: include/global_form.php:836
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "Agaciro k'igipimo cy'urusobe rw'imirongo (--unit/--y-grid)"

#: include/global_form.php:840
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "Gishyiraho agaciro k'umubare wikuba ku murongo fatizo wa Y ku mibare. Icyitonderwa: Iri hitamo ntirigikoreshwa kandi ryasimbujwe ihitamo --y-grid. Muri iri hitamo, imirongo y'urusobe rwa Y igaragara kuri buri ntera y'urusobe. Inyandiko zishyirwa kuri buri mirongo y'umubare fatizo w'inyandiko."

#: include/global_form.php:844
msgid "Unit Exponent Value (--units-exponent)"
msgstr "Agaciro k'umubare wikuba w'igipimo (--units-exponent)"

#: include/global_form.php:848
msgid "What unit Cacti should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Igipimo Cacti igomba gukoresha ku murongo fatizo wa Y. Koresha 3 kugira ngo werekane byose muri \"k\" cyangwa -6 kugira ngo werekane byose muri \"u\" (mikoro)."

#: include/global_form.php:852
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "Uburebure bw'igipimo (--units-length &lt;length&gt;)"

#: include/global_form.php:857
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "Ni imibare ingahe RRDtool igomba gutekereza ko inyandiko z'umurongo fatizo wa y zifite? Ushobora gukenera gukoresha iri hitamo kugira ngo ukore umwanya uhagije igihe utangiye guhindura inyandiko z'umurongo fatizo wa y."

#: include/global_form.php:860
msgid "No Gridfit (--no-gridfit)"
msgstr "Nta guhuza n'urusobe (--no-gridfit)"

#: include/global_form.php:863
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "Kugira ngo hirindwe igaragara ryijimye riterwa no kunoza impande, RRDtool ifatanya utudomo n'amapikiseli y'ubwiza bw'igikoresho, ibi bituma bigaragara neza cyane. Niba ibi bitakunyuze, ushobora gukoresha iri hitamo kugira ngo uhagarike iyi mikorere.<br><strong>Icyitonderwa: </strong>Guhuza n'urusobe birahagarikwa ku bisohoka muri PDF, EPS, SVG mu buryo busanzwe."

#: include/global_form.php:866
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "Urusobe rundi rwa Y (--alt-y-grid)"

#: include/global_form.php:869
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "Uburyo bwo kubara bwemeza ko uhorana urusobe rw'imirongo, ko hari imirongo ihagije ariko itari myinshi cyane, kandi ko urusobe ruri mu bipimo bya metero. Iki gipimo kizanemeza ko ubona imibare ihagije nyuma y'akitso yerekanywe nubwo igishushanyo cyawe cyava kuri 69.998 kikagera kuri 70.001.<br><strong>Icyitonderwa: </strong>Iki gipimo gishobora kubangamira amahitamo ya --alt-autoscale."

#: include/global_form.php:872
msgid "Axis Options"
msgstr "Amahitamo y'imirongo fatizo"

#: include/global_form.php:877
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "Umurongo fatizo w'iburyo (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php:882
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "Umurongo fatizo wa kabiri uzashushanywa iburyo bw'igishushanyo. Ufatanije n'umurongo fatizo w'ibumoso binyuze mu bipimo by'ikigero n'iyimurwa."

#: include/global_form.php:885
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "Inyandiko y'umurongo fatizo w'iburyo (--right-axis-label &lt;string&gt;)"

#: include/global_form.php:890
msgid "The label for the right axis."
msgstr "Inyandiko y'umurongo fatizo w'iburyo."

#: include/global_form.php:893
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "Imiterere y'umurongo fatizo w'iburyo (--right-axis-format &lt;format&gt;)"

#: include/global_form.php:898
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "Mu buryo busanzwe, imiterere y'inyandiko z'imirongo fatizo igengwa mu buryo bwikora. Niba ushaka kubikora ku giti cyawe, koresha iri hitamo hamwe n'ibisabwa bya %lf bimwe uzi mu mabwiriza ya PRINT na GPRINT."

#: include/global_form.php:901
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "Igeno ry'imiterere y'umurongo fatizo w'iburyo (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php:906
msgid "When you setup the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Igihe ushyiraho inyandiko z'umurongo fatizo w'iburyo, shyira itegeko ku miterere y'amakuru. Imiterere yemewe irimo \"numeric\" aho amakuru afatwa nk'imibare, \"timestamp\" aho uduciro dusobanurwa nk'ibimenyetso by'igihe bya UNIX (umubare w'amasegonda kuva muri Mutarama 1970) kandi tukagaragazwa hakoreshejwe imiterere ya strftime (ibisanzwe ni \"%Y-%m-%d %H:%M:%S\"). Reba kandi --units-length na --right-axis-format. Hanyuma \"duration\" aho uduciro dusobanurwa nk'igihe cyamaze muri milisegonda. Igeno ry'imiterere rikurikiza amategeko ya PRINT/GPRINT yemejwe na valstrfduration."

#: include/global_form.php:909
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "Igeno ry'imiterere y'umurongo fatizo w'ibumoso (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php:914
msgid "When you setup the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Igihe ushyiraho inyandiko z'umurongo fatizo w'ibumoso, shyira itegeko ku miterere y'amakuru. Imiterere yemewe irimo \"numeric\" aho amakuru afatwa nk'imibare, \"timestamp\" aho uduciro dusobanurwa nk'ibimenyetso by'igihe bya UNIX (umubare w'amasegonda kuva muri Mutarama 1970) kandi tukagaragazwa hakoreshejwe imiterere ya strftime (ibisanzwe ni \"%Y-%m-%d %H:%M:%S\"). Reba kandi --units-length. Hanyuma \"duration\" aho uduciro dusobanurwa nk'igihe cyamaze muri milisegonda. Igeno ry'imiterere rikurikiza amategeko ya PRINT/GPRINT yemejwe na valstrfduration."

#: include/global_form.php:917
msgid "Legend Options"
msgstr "Amahitamo y'ibisobanuro by'igishushanyo"

#: include/global_form.php:922
msgid "Auto Padding"
msgstr "Kuringaniza umwanya mu buryo bwikora"

#: include/global_form.php:926
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "Ongeramo umwanya mu mwandiko kugira ngo ibisobanuro n'amakuru y'igishushanyo bihorane umurongo umwe. Icyitonderwa: ibi bishobora gutuma ibishushanyo bitwara igihe kirekire mu kubikora kubera umutwaro munini. Nanone kandi Kuringaniza umwanya mu buryo bwikora bishobora kutaba ukuri ku bwoko bwose bw'ibishushanyo, gushyiraho inyandiko zihuye ubusanzwe birafasha."

#: include/global_form.php:929
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "Inyandiko zihindagurika (--dynamic-labels)"

#: include/global_form.php:932
msgid "Draw line markers as a line."
msgstr "Shushanya ibimenyetso by'umurongo nk'umurongo."

#: include/global_form.php:935
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "Hatira ibisobanuro by'amategeko (--force-rules-legend)"

#: include/global_form.php:938
msgid "Force the generation of HRULE and VRULE legends."
msgstr "Hatira ikorwa ry'ibisobanuro bya HRULE na VRULE."

#: include/global_form.php:941
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "Ubugari bw'itabu (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php:946
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "Mu buryo busanzwe ubugari bw'itabu ni amapikiseli 40, koresha iri hitamo kugira ngo ubuhindure."

#: include/global_form.php:949
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "Umwanya w'ibisobanuro (--legend-position=&lt;position&gt;)"

#: include/global_form.php:953
msgid "Place the legend at the given side of the graph."
msgstr "Shyira ibisobanuro ku ruhande rwatanzwe rw'igishushanyo."

#: include/global_form.php:956
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Icyerekezo cy'ibisobanuro (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php:960
msgid "Place the legend items in the given vertical order."
msgstr "Shyira ibigize ibisobanuro ku murongo uhagaritse watanzwe."

#: include/global_form.php:967 lib/api_aggregate.php:1902 lib/html.php:1534
msgid "Graph Item Type"
msgstr "Ubwoko bw'ikintu cy'igishushanyo"

#: include/global_form.php:971
msgid "How data for this item is represented visually on the graph."
msgstr "Uburyo amakuru y'iki kintu agaragarizwa mu mashusho ku gishushanyo."

#: include/global_form.php:986
msgid "The data source to use for this graph item."
