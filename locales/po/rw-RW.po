msgstr "Ibi bizasaba ko amagambobanga mashya aba arimo nibura umubare 1."

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 special character."
msgstr "Ibi bizasaba ko amagambobanga mashya aba arimo nibura ikimenyetso cyihariye 1."

#: include/global_settings.php
msgid "This will require new passwords to contain both lower and upper-case characters."
msgstr "Ibi bizasaba ko amagambobanga mashya aba arimo inyuguti ntoya n'inyuguti nkuru zombi."

