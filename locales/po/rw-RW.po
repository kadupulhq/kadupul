msgstr "Ijambobanga ryo kwemeza umwirondoro igihe wohereza ukoresheje SMTP. (Hasige ubusa niba udakeneye kwemeza umwirondoro.)"

#: include/global_settings.php:2037
msgid "SMTP Security"
msgstr "Umutekano wa SMTP"

