msgstr "Jeśli ustawione na Proste, wykresy i źródła danych mogą być tworzone tylko z nowych wykresów.  Jeśli zaawansowane, obsługiwane jest tworzenie starszych wykresów i źródeł danych."

#: include/global_settings.php:453
msgid "Simple"
msgstr "Prosty"

#: include/global_settings.php:454 lib/html.php:2949
msgid "Advanced"
msgstr "Zaawansowane"

#: include/global_settings.php:458
