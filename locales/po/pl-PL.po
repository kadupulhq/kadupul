#: include/global_settings.php:2005
msgid "SMTP Options"
msgstr "Opcje SMTP"

#: include/global_settings.php:2010
msgid "SMTP Hostname"
msgstr "SMTP Hostname"

#: include/global_settings.php:2011
msgid "This is the hostname/IP of the SMTP Server you will send the Email to. For failover, separate your hosts using a semi-colon."
msgstr "Jest to nazwa hosta/IP serwera SMTP, na który zostanie wysłana wiadomość e-mail. W przypadku awarii należy oddzielić gospodarzy za pomocą średnika."

#: include/global_settings.php:2017
