msgstr "ملے جلے حروف (بڑے/چھوٹے) درکار ہیں"

#: include/global_settings.php:1598
msgid "This will require new passwords to contains both lower and upper-case characters."
msgstr "اس سے نئے پاس ورڈز میں چھوٹے اور بڑے دونوں حروف شامل ہونا ضروری ہوگا۔"

#: include/global_settings.php:1603
msgid "Require Number"
msgstr "عدد درکار ہے"

#: include/global_settings.php:1604
msgid "This will require new passwords to contain at least 1 numerical character."
msgstr "اس سے نئے پاس ورڈز میں کم از کم 1 عددی حرف شامل ہونا ضروری ہوگا۔"

#: include/global_settings.php:1609
msgid "Require Special Character"
msgstr "خصوصی حرف درکار ہے"

#: include/global_settings.php:1610
msgid "This will require new passwords to contain at least 1 special character."
msgstr "اس سے نئے پاس ورڈز میں کم از کم 1 خصوصی حرف شامل ہونا ضروری ہوگا۔"

#: include/global_settings.php:1615
msgid "Force Complexity Upon Old Passwords"
msgstr "پرانے پاس ورڈز پر پیچیدگی نافذ کریں"

#: include/global_settings.php:1616
msgid "This will require all old passwords to also meet the new complexity requirements upon login.  If not met, it will force a password change."
msgstr "اس سے تمام پرانے پاس ورڈز کے لیے بھی لاگ ان کے وقت پیچیدگی کے نئے تقاضوں کو پورا کرنا ضروری ہوگا۔ اگر پورے نہ ہوں، تو یہ پاس ورڈ تبدیل کرنے پر مجبور کرے گا۔"

#: include/global_settings.php:1621
msgid "Expire Inactive Accounts"
msgstr "غیر فعال اکاؤنٹس کی میعاد ختم کریں"

#: include/global_settings.php:1622
msgid "This is maximum number of days before inactive accounts are disabled.  The Admin account is excluded from this policy."
msgstr "غیر فعال اکاؤنٹس کو معطل کرنے سے پہلے دنوں کی زیادہ سے زیادہ تعداد یہ ہے۔ Admin اکاؤنٹ اس پالیسی سے مستثنیٰ ہے۔"

#: include/global_settings.php:1635
msgid "Expire Password"
msgstr "پاس ورڈ کی میعاد ختم کریں"

#: include/global_settings.php:1636
msgid "This is maximum number of days before a password is set to expire."
msgstr "پاس ورڈ کی میعاد ختم ہونے سے پہلے دنوں کی زیادہ سے زیادہ تعداد یہ ہے۔"

#: include/global_settings.php:1648
msgid "Password History"
msgstr "پاس ورڈ ہسٹری"

#: include/global_settings.php:1649
msgid "Remember this number of old passwords and disallow reusing them."
msgstr "اتنی تعداد میں پرانے پاس ورڈز یاد رکھیں اور ان کے دوبارہ استعمال کی اجازت نہ دیں۔"

