#: user_admin.php user_group_admin.php
msgid "<b>Note:</b> System Graph Policy is 'Graph Template' meaning the User must have access to the Graph or Graph Template to gain access to the Graph"
msgstr "<b>نوٹ:</b> سسٹم گراف پالیسی 'Graph Template' ہے جس کا مطلب ہے کہ گراف تک رسائی حاصل کرنے کے لیے صارف کے پاس گراف یا گراف ٹیمپلیٹ تک رسائی ہونی چاہیے"

#: user_admin.php user_group_admin.php
msgid "<b>Note:</b> System Graph Policy is 'Permissive' meaning the User must have access to at least one of Graph, Device, or Graph Template to gain access to the Graph"
msgstr "<b>نوٹ:</b> سسٹم گراف پالیسی 'Permissive' ہے جس کا مطلب ہے کہ گراف تک رسائی حاصل کرنے کے لیے صارف کے پاس گراف، ڈیوائس، یا گراف ٹیمپلیٹ میں سے کم از کم کسی ایک تک رسائی ہونی چاہیے"

#: user_admin.php user_group_admin.php
msgid "<b>Note:</b> System Graph Policy is 'Restrictive' meaning the User must have access to either the Graph or the Device and Graph Template to gain access to the Graph"
msgstr "<b>نوٹ:</b> سسٹم گراف پالیسی 'Restrictive' ہے جس کا مطلب ہے کہ گراف تک رسائی حاصل کرنے کے لیے صارف کے پاس یا تو گراف یا پھر ڈیوائس اور گراف ٹیمپلیٹ دونوں تک رسائی ہونی چاہیے"

