msgstr "اگر اس فیلڈ کے ساتھ میزبان ٹیمپلیٹس کے ذریعے خاص سلوک کیا جانا چاہیے، تو یہاں اس کی نشاندہی کریں۔ اس فیلڈ کے لیے درست مطلوبہ الفاظ %s ہیں"

#: include/global_form.php:530
msgid "The name given to this data template."
msgstr "اس ڈیٹا ٹیمپلیٹ کو دیا گیا نام۔"

#: include/global_form.php:571
msgid "Choose a name for this data source.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Cacti documentation."
msgstr "اس ڈیٹا سورس کے لیے ایک نام منتخب کریں۔ اس میں تبدیلی کے متغیرات جیسے |host_description| یا |query_fieldName| شامل ہو سکتے ہیں۔ معاونت یافتہ تبدیلی ٹیگز کی مکمل فہرست کے لیے براہ کرم Cacti دستاویزات دیکھیں۔"

#: include/global_form.php:575
msgid "Data Source Path"
msgstr "ڈیٹا سورس پاتھ"

#: include/global_form.php:580
msgid "The full path to the RRDfile."
msgstr "RRDfile کا مکمل پاتھ۔"

#: include/global_form.php:589
msgid "The script/source used to gather data for this data source."
msgstr "اس ڈیٹا سورس کے لیے ڈیٹا جمع کرنے کے لیے استعمال ہونے والا اسکرپٹ/ماخذ۔"

#: include/global_form.php:595 include/global_form.php:1702
#: package_import.php:899
msgid "Select the Data Source Profile.  The Data Source Profile controls polling interval, the data aggregation, and retention policy for the resulting Data Sources."
msgstr "Data Source Profile منتخب کریں۔ Data Source Profile نتیجے میں بننے والے Data Sources کے لیے پولنگ کا وقفہ، ڈیٹا ایگریگیشن اور برقراری کی پالیسی کو کنٹرول کرتا ہے۔"

#: include/global_form.php:606
msgid "The amount of time in seconds between expected updates."
msgstr "متوقع اپ ڈیٹس کے درمیان سیکنڈز میں وقت کی مقدار۔"

#: include/global_form.php:610
msgid "Data Source Active"
msgstr "ڈیٹا سورس فعال ہے"

#: include/global_form.php:614
msgid "Whether Cacti should gather data for this data source or not."
msgstr "آیا Cacti کو اس ڈیٹا سورس کے لیے ڈیٹا جمع کرنا چاہیے یا نہیں۔"

#: include/global_form.php:622
msgid "Internal Data Source Name"
msgstr "اندرونی ڈیٹا سورس کا نام"

#: include/global_form.php:627
msgid "Choose unique name to represent this piece of data inside of the RRDfile."
msgstr "RRDfile کے اندر ڈیٹا کے اس حصے کی نمائندگی کے لیے منفرد نام منتخب کریں۔"

#: include/global_form.php:630
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "کم از کم قدر (بغیر کم از کم کے لیے \"U\")"

#: include/global_form.php:635
msgid "The minimum value of data that is allowed to be collected."
msgstr "ڈیٹا کی کم از کم قدر جسے جمع کرنے کی اجازت ہے۔"

#: include/global_form.php:638
msgid "Maximum Value (\"U\" for No Maximum)"
msgstr "زیادہ سے زیادہ قدر (بغیر زیادہ سے زیادہ کے لیے \"U\")"

#: include/global_form.php:643
msgid "The maximum value of data that is allowed to be collected."
msgstr "ڈیٹا کی زیادہ سے زیادہ قدر جسے جمع کرنے کی اجازت ہے۔"

#: include/global_form.php:646
msgid "Data Source Type"
msgstr "ڈیٹا سورس کی قسم"

#: include/global_form.php:650
msgid "How data is represented in the RRA."
msgstr "RRA میں ڈیٹا کی نمائندگی کیسے کی جاتی ہے۔"

#: include/global_form.php:658
msgid "The maximum amount of time that can pass before data is entered as 'unknown'. (Usually 2x300=600)"
msgstr "زیادہ سے زیادہ وقت جو گزر سکتا ہے قبل اس کے کہ ڈیٹا کو 'unknown' کے طور پر درج کیا جائے۔ (عام طور پر 2x300=600)"

#: include/global_form.php:664 lib/html_utility.php:341
msgid "Not Selected"
msgstr "منتخب نہیں"

#: include/global_form.php:665
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "جب ڈیٹا جمع کیا جائے گا، تو اس فیلڈ کا ڈیٹا اس ڈیٹا سورس میں ڈالا جائے گا۔"

#: include/global_form.php:674
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "اس GPRINT پری سیٹ کے لیے ایک نام درج کریں، یقینی بنائیں کہ یہ کوئی ایسی چیز ہو جسے آپ پہچان سکیں۔"

#: include/global_form.php:681
msgid "GPRINT Text"
msgstr "GPRINT متن"

#: include/global_form.php:682
msgid "Enter the custom GPRINT string here."
msgstr "یہاں حسب ضرورت GPRINT اسٹرنگ درج کریں۔"

#: include/global_form.php:700
msgid "Common Options"
msgstr "عام اختیارات"

#: include/global_form.php:705
msgid "Title (--title)"
msgstr "عنوان (--title)"

#: include/global_form.php:709
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Cacti documentation."
msgstr "وہ نام جو گراف پر پرنٹ ہوتا ہے۔ اس میں |host_description| یا |query_fieldName| جیسے متبادل متغیرات شامل ہو سکتے ہیں۔ معاون متبادل ٹیگز کی مکمل فہرست کے لیے، براہ کرم Cacti دستاویزات دیکھیں۔"

#: include/global_form.php:713
msgid "Vertical Label (--vertical-label)"
msgstr "عمودی لیبل (--vertical-label)"

#: include/global_form.php:717
msgid "The label vertically printed to the left of the graph."
msgstr "گراف کے بائیں جانب عمودی طور پر پرنٹ کیا گیا لیبل۔"

#: include/global_form.php:721
msgid "Image Format (--imgformat)"
msgstr "امیج فارمیٹ (--imgformat)"

#: include/global_form.php:725
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "تیار کیے جانے والے گراف کی قسم؛ PNG، GIF یا SVG۔ گراف تصویری قسم کا انتخاب بہت حد تک RRDtool پر منحصر ہے۔"

#: include/global_form.php:728
msgid "Height (--height)"
msgstr "اونچائی (--height)"

#: include/global_form.php:732
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "گراف کے اندر گراف کے علاقے کی اونچائی (پکسلز میں)۔ اس علاقے میں لیجنڈ، محور کے لیبلز، یا عنوان شامل نہیں ہیں۔"

#: include/global_form.php:736
msgid "Width (--width)"
msgstr "چوڑائی (--width)"

#: include/global_form.php:740
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "گراف کے اندر گراف کے علاقے کی چوڑائی (پکسلز میں)۔ اس علاقے میں لیجنڈ، محور کے لیبلز، یا عنوان شامل نہیں ہیں۔"

#: include/global_form.php:744
msgid "Base Value (--base)"
msgstr "بنیادی قدر (--base)"

#: include/global_form.php:748
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "میموری کے لیے 1024 اور ٹریفک کی پیمائش کے لیے 1000 پر سیٹ کیا جانا چاہیے۔"

#: include/global_form.php:752
msgid "Slope Mode (--slope-mode)"
msgstr "اسلوپ موڈ (--slope-mode)"

#: include/global_form.php:756
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Slope Mode استعمال کرنے سے اسکرین پر کچھ ریزولوشن کی قیمت پر گرافس کی شکل ہموار ہو جاتی ہے۔"

#: include/global_form.php:759
msgid "Scaling Options"
msgstr "اسکیلنگ کے اختیارات"

#: include/global_form.php:764
msgid "Auto Scale"
msgstr "خودکار پیمانہ"

#: include/global_form.php:768
msgid "Auto scale the y-axis instead of defining an upper and lower limit. Note: if this is check both the Upper and Lower limit will be ignored."
msgstr "اوپری اور نچلی حد متعین کرنے کے بجائے y-axis کو خودکار طور پر اسکیل کریں۔ نوٹ: اگر یہ چیک ہو تو اوپری اور نچلی دونوں حدود کو نظر انداز کر دیا جائے گا۔"

#: include/global_form.php:772
msgid "Auto Scale Options"
msgstr "خودکار پیمانے کے اختیارات"

#: include/global_form.php:775
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "مطلق کم از کم اور زیادہ سے زیادہ پر اسکیل کرنے کے لیے <br> --alt-autoscale استعمال کریں <br> دی گئی نچلی حد کا استعمال کرتے ہوئے زیادہ سے زیادہ قدر پر اسکیل کرنے کے لیے --alt-autoscale-max استعمال کریں <br> دی گئی بالائی حد کا استعمال کرتے ہوئے کم از کم قدر پر اسکیل کرنے کے لیے --alt-autoscale-min استعمال کریں <br> نچلی اور بالائی دونوں حدود کا استعمال کرتے ہوئے اسکیل کرنے کے لیے --alt-autoscale (with limits) استعمال کریں (RRDtool ڈیفالٹ) <br>"

#: include/global_form.php:779
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "--alt-autoscale استعمال کریں (دی گئی حدود کو نظرانداز کرتے ہوئے)"

#: include/global_form.php:783
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "--alt-autoscale-max استعمال کریں (نچلی حد قبول کرتے ہوئے)"

#: include/global_form.php:787
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "--alt-autoscale-min استعمال کریں (بالائی حد قبول کرتے ہوئے)"

#: include/global_form.php:791
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "--alt-autoscale استعمال کریں (دونوں حدود قبول کرتے ہوئے، RRDtool ڈیفالٹ)"

#: include/global_form.php:796
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "لوگارتھمک اسکیلنگ (--logarithmic)"

#: include/global_form.php:800
msgid "Use Logarithmic y-axis scaling"
msgstr "لوگارتھمک y-axis اسکیلنگ استعمال کریں"

#: include/global_form.php:803
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "لوگارتھمک اسکیلنگ کے لیے SI اکائیاں (--units=si)"

#: include/global_form.php:806
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "قوت نما علامت (exponential notation) استعمال کرنے کے بجائے لوگارتھمک اسکیلنگ کے لیے SI اکائیاں استعمال کریں۔<br> نوٹ: لکیری گرافس ڈیفالٹ طور پر SI علامت استعمال کرتے ہیں۔"

#: include/global_form.php:809
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "سخت حدود موڈ (--rigid)"

#: include/global_form.php:812
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "اگر گراف میں درست رینج سے باہر کی قدر شامل ہو تو نچلی اور اوپری حد کو نہ پھیلائیں۔"

#: include/global_form.php:815
msgid "Upper Limit (--upper-limit)"
msgstr "بالائی حد (--upper-limit)"

#: include/global_form.php:819
msgid "The maximum vertical value for the graph."
msgstr "گراف کے لیے زیادہ سے زیادہ عمودی قدر۔"

#: include/global_form.php:823
msgid "Lower Limit (--lower-limit)"
msgstr "نچلی حد (--lower-limit)"

#: include/global_form.php:827
msgid "The minimum vertical value for the graph."
msgstr "گراف کے لیے کم از کم عمودی قدر۔"

#: include/global_form.php:831
msgid "Grid Options"
msgstr "گرڈ کے اختیارات"

#: include/global_form.php:836
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "اکائی گرڈ قدر (--unit/--y-grid)"

#: include/global_form.php:840
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "اعداد کے لیے Y-axis پر قوت نما (exponent) کی قدر مقرر کرتا ہے۔ نوٹ: یہ آپشن متروک ہو چکا ہے اور اس کی جگہ --y-grid آپشن نے لے لی ہے۔ اس آپشن میں، Y-axis گرڈ لائنیں ہر گرڈ اسٹیپ کے وقفے پر ظاہر ہوتی ہیں۔ لیبل ہر لیبل فیکٹر لائنز پر رکھے جاتے ہیں۔"

#: include/global_form.php:844
msgid "Unit Exponent Value (--units-exponent)"
msgstr "اکائی قوت نما قدر (--units-exponent)"

#: include/global_form.php:848
msgid "What unit Cacti should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Cacti کو Y-axis پر کون سی اکائی استعمال کرنی چاہیے۔ ہر چیز کو \"k\" میں دکھانے کے لیے 3 یا ہر چیز کو \"u\" (مائیکرو) میں دکھانے کے لیے -6 استعمال کریں۔"

#: include/global_form.php:852
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "اکائی کی لمبائی (--units-length &lt;length&gt;)"

#: include/global_form.php:857
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "RRDtool کو y-axis لیبلز کتنے ہندسوں کا فرض کرنا چاہیے؟ ایک بار جب آپ y-axis لیبلنگ میں ردوبدل شروع کر دیں تو کافی جگہ بنانے کے لیے آپ کو یہ آپشن استعمال کرنا پڑ سکتا ہے۔"

#: include/global_form.php:860
msgid "No Gridfit (--no-gridfit)"
msgstr "گرڈ فٹ نہیں (--no-gridfit)"

#: include/global_form.php:863
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "اینٹی ایلائزنگ کے دھندلاپن کے اثرات سے بچنے کے لیے RRDtool پوائنٹس کو ڈیوائس ریزولوشن پکسلز پر اسنیپ کرتا ہے، جس کے نتیجے میں زیادہ واضح ظاہری شکل ملتی ہے۔ اگر یہ آپ کی پسند کے مطابق نہیں ہے، تو آپ اس سوئچ کو استعمال کر کے اس رویے کو بند کر سکتے ہیں۔<br><strong>نوٹ: </strong>PDF، EPS، SVG آؤٹ پٹ کے لیے Gridfitting ڈیفالٹ طور پر بند ہوتا ہے۔"

#: include/global_form.php:866
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "متبادل Y گرڈ (--alt-y-grid)"

#: include/global_form.php:869
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "یہ الگورتھم یقینی بناتا ہے کہ آپ کے پاس ہمیشہ ایک گرڈ موجود ہو، گرڈ لائنز نہ زیادہ کم ہوں اور نہ بہت زیادہ، اور گرڈ میٹرک ہو۔ یہ پیرامیٹر یہ بھی یقینی بنائے گا کہ آپ کو کافی اعشاریے دکھائی دیں چاہے آپ کا گراف 69.998 سے 70.001 تک ہی کیوں نہ جائے۔<br><strong>نوٹ: </strong>یہ پیرامیٹر --alt-autoscale اختیارات میں مداخلت کر سکتا ہے۔"

#: include/global_form.php:872
msgid "Axis Options"
msgstr "محور کے اختیارات"

#: include/global_form.php:877
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "دایاں محور (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php:882
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "گراف کے دائیں جانب ایک دوسرا محور کھینچا جائے گا۔ یہ اسکیل اور شفٹ پیرامیٹرز کے ذریعے بائیں محور سے منسلک ہوتا ہے۔"

#: include/global_form.php:885
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "دائیں محور کا لیبل (--right-axis-label &lt;string&gt;)"

#: include/global_form.php:890
msgid "The label for the right axis."
msgstr "دائیں محور کے لیے لیبل۔"

#: include/global_form.php:893
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "دائیں محور کا فارمیٹ (--right-axis-format &lt;format&gt;)"

#: include/global_form.php:898
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "ڈیفالٹ طور پر، محور لیبلز کا فارمیٹ خودکار طور پر طے ہوتا ہے۔ اگر آپ یہ خود کرنا چاہتے ہیں، تو یہ آپشن انہی %lf دلائل کے ساتھ استعمال کریں جو آپ PRINT اور GPRINT کمانڈز سے جانتے ہیں۔"

#: include/global_form.php:901
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "دائیں محور کا فارمیٹر (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php:906
msgid "When you setup the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "جب آپ دائیں محور کی لیبلنگ ترتیب دیں، تو ڈیٹا فارمیٹ پر ایک قانون لاگو کریں۔ معاون فارمیٹس میں \"numeric\" شامل ہے جہاں ڈیٹا کو عددی سمجھا جاتا ہے، \"timestamp\" جہاں اقدار کو UNIX ٹائم اسٹیمپس (جنوری 1970 سے سیکنڈز کی تعداد) کے طور پر تشریح کیا جاتا ہے اور strftime فارمیٹ (ڈیفالٹ \"%Y-%m-%d %H:%M:%S\" ہے) استعمال کر کے ظاہر کیا جاتا ہے۔ --units-length اور --right-axis-format بھی دیکھیں۔ آخر میں \"duration\" جہاں اقدار کو ملی سیکنڈز میں دورانیے کے طور پر سمجھا جاتا ہے۔ فارمیٹنگ valstrfduration کوالیفائیڈ PRINT/GPRINT کے قواعد کی پیروی کرتی ہے۔"

#: include/global_form.php:909
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "بائیں محور فارمیٹر (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php:914
msgid "When you setup the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "جب آپ بائیں محور کی لیبلنگ ترتیب دیں، تو ڈیٹا فارمیٹ پر ایک قانون لاگو کریں۔ معاون فارمیٹس میں \"numeric\" شامل ہے جہاں ڈیٹا کو عددی سمجھا جاتا ہے، \"timestamp\" جہاں اقدار کو UNIX ٹائم اسٹیمپس (جنوری 1970 سے سیکنڈز کی تعداد) کے طور پر تشریح کیا جاتا ہے اور strftime فارمیٹ (ڈیفالٹ \"%Y-%m-%d %H:%M:%S\" ہے) استعمال کر کے ظاہر کیا جاتا ہے۔ --units-length بھی دیکھیں۔ آخر میں \"duration\" جہاں اقدار کو ملی سیکنڈز میں دورانیے کے طور پر سمجھا جاتا ہے۔ فارمیٹنگ valstrfduration کوالیفائیڈ PRINT/GPRINT کے قواعد کی پیروی کرتی ہے۔"

#: include/global_form.php:917
msgid "Legend Options"
msgstr "لیجنڈ کے اختیارات"

#: include/global_form.php:922
msgid "Auto Padding"
msgstr "خودکار پیڈنگ"

#: include/global_form.php:926
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "متن کو پیڈ کریں تاکہ لیجنڈ اور گراف کا ڈیٹا ہمیشہ سیدھ میں رہے۔ نوٹ: زیادہ اوور ہیڈ کی وجہ سے اس سے گرافس کے رینڈر ہونے میں زیادہ وقت لگ سکتا ہے۔ نیز آٹو پیڈنگ ہر قسم کے گرافس پر درست نہیں ہو سکتی، مستقل لیبلنگ عام طور پر مددگار ہوتی ہے۔"

#: include/global_form.php:929
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "متحرک لیبلز (--dynamic-labels)"

#: include/global_form.php:932
msgid "Draw line markers as a line."
msgstr "لائن مارکرز کو ایک لائن کے طور پر کھینچیں۔"

#: include/global_form.php:935
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "اصول لیجنڈ لازمی کریں (--force-rules-legend)"

#: include/global_form.php:938
msgid "Force the generation of HRULE and VRULE legends."
msgstr "HRULE اور VRULE لیجنڈز کی تخلیق لازمی کریں۔"

#: include/global_form.php:941
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "ٹیب کی چوڑائی (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php:946
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "ڈیفالٹ طور پر ٹیب کی چوڑائی 40 پکسلز ہوتی ہے، اسے تبدیل کرنے کے لیے یہ آپشن استعمال کریں۔"

#: include/global_form.php:949
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "لیجنڈ کی پوزیشن (--legend-position=&lt;position&gt;)"

#: include/global_form.php:953
msgid "Place the legend at the given side of the graph."
msgstr "لیجنڈ کو گراف کی دی گئی جانب رکھیں۔"

#: include/global_form.php:956
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "لیجنڈ کی سمت (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php:960
msgid "Place the legend items in the given vertical order."
msgstr "لیجنڈ آئٹمز کو دی گئی عمودی ترتیب میں رکھیں۔"

#: include/global_form.php:967 lib/api_aggregate.php:1902 lib/html.php:1534
msgid "Graph Item Type"
msgstr "گراف آئٹم کی قسم"

#: include/global_form.php:971
msgid "How data for this item is represented visually on the graph."
msgstr "اس آئٹم کے لیے ڈیٹا کو گراف پر بصری طور پر کیسے پیش کیا جاتا ہے۔"

#: include/global_form.php:986
msgid "The data source to use for this graph item."
msgstr "اس گراف آئٹم کے لیے استعمال ہونے والا ڈیٹا سورس۔"

#: include/global_form.php:993
msgid "The color to use for the legend."
msgstr "لیجنڈ کے لیے استعمال ہونے والا رنگ۔"

#: include/global_form.php:996
msgid "Opacity/Alpha Channel"
msgstr "شفافیت / الفا چینل"

#: include/global_form.php:1000
msgid "The opacity/alpha channel of the color."
msgstr "رنگ کی شفافیت/الفا چینل۔"

#: include/global_form.php:1003 lib/rrd.php:4775
msgid "Consolidation Function"
msgstr "کنسولیڈیشن فنکشن"

#: include/global_form.php:1007
msgid "How data for this item is represented statistically on the graph."
msgstr "اس آئٹم کے لیے ڈیٹا کو گراف پر شماریاتی طور پر کیسے پیش کیا جاتا ہے۔"

#: include/global_form.php:1010
msgid "CDEF Function"
msgstr "CDEF فنکشن"

#: include/global_form.php:1015
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "گراف یا لیجنڈ پر اس آئٹم پر لاگو کرنے کے لیے ایک CDEF (ریاضی) فنکشن۔"

#: include/global_form.php:1018
msgid "VDEF Function"
msgstr "VDEF فنکشن"

#: include/global_form.php:1023
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "گراف لیجنڈ پر اس آئٹم پر لاگو کرنے کے لیے ایک VDEF (ریاضی) فنکشن۔"

#: include/global_form.php:1026
msgid "Shift Data"
msgstr "ڈیٹا شفٹ کریں"

#: include/global_form.php:1029
msgid "Offset your data on the time axis (x-axis) by the amount specified in the 'value' field."
msgstr "'value' فیلڈ میں بیان کردہ مقدار کے مطابق اپنے ڈیٹا کو ٹائم محور (x-axis) پر آف سیٹ کریں۔"

#: include/global_form.php:1037
msgid "[HRULE|VRULE]: The value of the graph item.<br/> [TICK]: The fraction for the tick line.<br/> [SHIFT]: The time offset in seconds."
msgstr "[HRULE|VRULE]: گراف آئٹم کی قدر۔<br/> [TICK]: ٹک لائن کے لیے کسر (fraction)۔<br/> [SHIFT]: سیکنڈز میں وقت کا آف سیٹ۔"

#: include/global_form.php:1040
msgid "GPRINT Type"
msgstr "GPRINT کی قسم"

#: include/global_form.php:1044
msgid "If this graph item is a GPRINT, you can optionally choose another format here. You can define additional types under \"GPRINT Presets\"."
msgstr "اگر یہ گراف آئٹم ایک GPRINT ہے، تو آپ اختیاری طور پر یہاں کوئی اور فارمیٹ منتخب کر سکتے ہیں۔ آپ \"GPRINT Presets\" کے تحت اضافی اقسام متعین کر سکتے ہیں۔"

#: include/global_form.php:1047
msgid "Text Alignment (TEXTALIGN)"
msgstr "متن کی سیدھ (TEXTALIGN)"

#: include/global_form.php:1052
msgid "All subsequent legend line(s) will be aligned as given here.  You may use this command multiple times in a single graph.  This command does not produce tabular layout.<br/><strong>Note: </strong>You may want to insert a &lt;HR&gt; on the preceding graph item.<br/> <strong>Note: </strong>A &lt;HR&gt; on this legend line will obsolete this setting!"
msgstr "بعد کی تمام لیجنڈ لائنیں یہاں دی گئی ترتیب کے مطابق سیدھ میں ہوں گی۔ آپ یہ کمانڈ ایک ہی گراف میں کئی بار استعمال کر سکتے ہیں۔ یہ کمانڈ ٹیبلر لے آؤٹ نہیں بناتی۔<br/><strong>نوٹ: </strong>آپ پچھلے گراف آئٹم پر &lt;HR&gt; داخل کرنا چاہیں گے۔<br/> <strong>نوٹ: </strong>اس لیجنڈ لائن پر &lt;HR&gt; اس ترتیب کو متروک کر دے گا!"

#: include/global_form.php:1055
msgid "Text Format"
msgstr "متن کا فارمیٹ"

#: include/global_form.php:1060
msgid "Text that will be displayed on the legend for this graph item."
msgstr "وہ متن جو اس گراف آئٹم کے لیے لیجنڈ پر دکھایا جائے گا۔"

#: include/global_form.php:1063
msgid "Insert Hard Return"
msgstr "ہارڈ ریٹرن داخل کریں"

#: include/global_form.php:1066
msgid "Forces the legend to the next line after this item."
msgstr "اس آئٹم کے بعد لیجنڈ کو اگلی لائن پر لے جانے پر مجبور کرتا ہے۔"

#: include/global_form.php:1069
msgid "Line Width"
msgstr "لائن کی چوڑائی"

#: include/global_form.php:1074
msgid "LINE1, LINE2 and LINE3 use fixed widths. For LINE:STACK, enter a width in pixels; integers or decimal values are supported."
msgstr "LINE1، LINE2 اور LINE3 مقررہ چوڑائی استعمال کرتے ہیں۔ LINE:STACK کے لیے، پکسلز میں ایک چوڑائی درج کریں؛ صحیح اعداد یا اعشاریہ قدریں معاونت یافتہ ہیں۔"

#: include/global_form.php:1077
msgid "Dashes (dashes[=on_s[,off_s[,on_s,off_s]...]])"
msgstr "ڈیشز (dashes[=on_s[,off_s[,on_s,off_s]...]])"

#: include/global_form.php:1082
msgid "The dashes modifier enables dashed line style."
msgstr "dashes موڈیفائر ڈیشڈ لائن اسٹائل کو فعال کرتا ہے۔"

#: include/global_form.php:1085
msgid "Dash Offset (dash-offset=offset)"
msgstr "ڈیش آفسیٹ (dash-offset=offset)"

#: include/global_form.php:1090 include/global_form.php:1098
msgid "The dash-offset parameter specifies an offset into the pattern at which the stroke begins."
msgstr "dash-offset پیرامیٹر پیٹرن میں اس آف سیٹ کی وضاحت کرتا ہے جہاں سے اسٹروک شروع ہوتا ہے۔"

#: include/global_form.php:1107
msgid "The name given to this graph template."
msgstr "اس گراف ٹیمپلیٹ کو دیا گیا نام۔"

#: include/global_form.php:1114
msgid "Multiple Instances"
msgstr "متعدد مثالیں"

#: include/global_form.php:1115
msgid "Check this checkbox if there can be more than one Graph of this type per Device."
msgstr "اگر فی ڈیوائس اس قسم کا ایک سے زیادہ گراف ہو سکتا ہے تو اس چیک باکس کو چیک کریں۔"

#: include/global_form.php:1122
msgid "Test Data Sources"
msgstr "Data Sources ٹیسٹ کریں"

#: include/global_form.php:1123
msgid "Check this checkbox if you wish to test the Data Sources prior to their creation.  With Test Data Sources enabled, if the Data Source does not return valid data, the Graph will not be created.  This setting is important if you wish to have a more generic Device Template that can include more Graph Templates that can be selectively applied depending on the characteristics of the Device itself.  Note: If you have a long running script as a Data Source, the time to create Graphs will be increased."
msgstr "اگر آپ ڈیٹا سورسز بنانے سے پہلے ان کی جانچ کرنا چاہتے ہیں تو اس چیک باکس کو چیک کریں۔ Test Data Sources فعال ہونے پر، اگر ڈیٹا سورس درست ڈیٹا واپس نہیں کرتا، تو گراف نہیں بنایا جائے گا۔ یہ ترتیب اہم ہے اگر آپ ایک زیادہ عمومی ڈیوائس ٹیمپلیٹ رکھنا چاہتے ہیں جس میں مزید گراف ٹیمپلیٹس شامل ہو سکیں جو خود ڈیوائس کی خصوصیات کے لحاظ سے منتخب طور پر لاگو کیے جا سکیں۔ نوٹ: اگر آپ کے پاس ڈیٹا سورس کے طور پر طویل وقت تک چلنے والا اسکرپٹ ہے، تو گرافس بنانے کا وقت بڑھ جائے گا۔"

#: include/global_form.php:1147
msgid "Enter a name for this graph item input, make sure it is something you recognize."
msgstr "اس گراف آئٹم ان پٹ کے لیے ایک نام درج کریں، یقینی بنائیں کہ یہ کوئی ایسی چیز ہو جسے آپ پہچان سکیں۔"

#: include/global_form.php:1155
msgid "Enter a description for this graph item input to describe what this input is used for."
msgstr "یہ بتانے کے لیے کہ یہ ان پٹ کس لیے استعمال ہوتا ہے، اس گراف آئٹم ان پٹ کی تفصیل درج کریں۔"

#: include/global_form.php:1162
msgid "Field Type"
msgstr "فیلڈ کی قسم"

#: include/global_form.php:1163
msgid "How data is to be represented on the graph."
msgstr "گراف پر ڈیٹا کی نمائندگی کیسے کی جانی ہے۔"

#: include/global_form.php:1186
msgid "General Device Options"
msgstr "ڈیوائس کے عمومی اختیارات"

#: include/global_form.php:1191
msgid "Give this host a meaningful description."
msgstr "اس میزبان کو ایک بامعنی تفصیل دیں۔"

#: include/global_form.php:1198 include/global_form.php:1769
msgid "Fully qualified hostname or IP address for this device."
msgstr "اس ڈیوائس کے لیے مکمل اہل میزبان نام یا IP پتہ۔"

#: include/global_form.php:1206
msgid "The physical location of the Device.  This free form text can be a room, rack location, etc."
msgstr "ڈیوائس کا طبعی مقام۔ یہ آزاد شکل متن کوئی کمرہ، ریک مقام وغیرہ ہو سکتا ہے۔"

#: include/global_form.php:1215
msgid "Poller Association"
msgstr "پولر کی وابستگی"

#: include/global_form.php:1223
msgid "Device Site Association"
msgstr "ڈیوائس سائٹ ایسوسی ایشن"

#: include/global_form.php:1224
msgid "What Site is this Device associated with."
msgstr "یہ ڈیوائس کس سائٹ سے منسلک ہے۔"

#: include/global_form.php:1233
msgid "Choose the Device Template to use to define the default Graph Templates and Data Queries associated with this Device."
msgstr "اس ڈیوائس سے منسلک ڈیفالٹ گراف ٹیمپلیٹس اور ڈیٹا کوئریز کی تعریف کرنے کے لیے ڈیوائس ٹیمپلیٹ منتخب کریں۔"

#: include/global_form.php:1241
msgid "Number of Collection Threads"
msgstr "کلیکشن تھریڈز کی تعداد"

#: include/global_form.php:1242
msgid "The number of concurrent threads to use for polling this device.  This applies to the Spine poller only."
msgstr "اس ڈیوائس کو پول کرنے کے لیے استعمال ہونے والے ہم وقت تھریڈز کی تعداد۔ یہ صرف Spine پولر پر لاگو ہوتا ہے۔"

#: include/global_form.php:1249
msgid "Disable Device"
msgstr "ڈیوائس غیر فعال کریں"

#: include/global_form.php:1250
msgid "Check this box to disable all checks for this host."
msgstr "اس میزبان کے لیے تمام جانچیں غیر فعال کرنے کے لیے اس باکس کو چیک کریں۔"

#: include/global_form.php:1263
msgid "Availability/Reachability Options"
msgstr "دستیابی/رسائی کے اختیارات"

#: include/global_form.php:1267 include/global_settings.php:811
msgid "Downed Device Detection"
msgstr "ڈاؤن ڈیوائس کی شناخت"

#: include/global_form.php:1268
msgid "The method Cacti will use to determine if a host is available for polling.  <br><i>NOTE: It is recommended that, at a minimum, SNMP always be selected.</i>"
msgstr "وہ طریقہ جو Cacti یہ تعین کرنے کے لیے استعمال کرے گا کہ آیا کوئی ہوسٹ پولنگ کے لیے دستیاب ہے یا نہیں۔ <br><i>نوٹ: یہ تجویز کیا جاتا ہے کہ کم از کم، SNMP کو ہمیشہ منتخب کیا جائے۔</i>"

