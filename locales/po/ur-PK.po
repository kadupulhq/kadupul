msgstr "Data Source پاتھس پڑھے نہیں جا سکے، اس لیے RRDfile مقامات کی جانچ نہیں کی گئی۔ اپ گریڈ کے بعد پولر لاگ کے ساتھ ان کی جانچ کریں۔"

#: lib/installer.php
msgid "The Installer automatically assigns a $poller_id and adds it to the config.php file."
msgstr "انسٹالر خودکار طور پر ایک $poller_id تفویض کرتا ہے اور اسے config.php فائل میں شامل کر دیتا ہے۔"

#: lib/installer.php
msgid "The Installer could not proceed due to an unexpected error."
msgstr "ایک غیر متوقع خرابی کی وجہ سے انسٹالر آگے نہیں بڑھ سکا۔"

#: lib/installer.php
msgid "The PHP binary location is not valid and must be updated."
msgstr "PHP بائنری کا مقام درست نہیں ہے اور اسے اپ ڈیٹ کرنا ضروری ہے۔"

#: lib/installer.php
msgid "The following PHP extensions are mandatory, and MUST be installed before continuing your Kadupul install."
msgstr "درج ذیل PHP ایکسٹینشنز لازمی ہیں، اور آپ کی Kadupul انسٹالیشن جاری رکھنے سے پہلے انسٹال ہونا ضروری ہیں۔"

#: lib/installer.php
msgid "The following PHP extensions are recommended, and should be installed before continuing your Kadupul install.  NOTE: If you are planning on supporting SNMPv3 with IPv6, you should not install the php-snmp module at this time."
msgstr "درج ذیل PHP ایکسٹینشنز تجویز کردہ ہیں، اور آپ کی Kadupul انسٹالیشن جاری رکھنے سے پہلے انسٹال کی جانی چاہئیں۔ نوٹ: اگر آپ IPv6 کے ساتھ SNMPv3 کو سپورٹ کرنے کا ارادہ رکھتے ہیں، تو آپ کو اس وقت php-snmp ماڈیول انسٹال نہیں کرنا چاہیے۔"

#: lib/installer.php
msgid "The following information has been determined from Kadupul's configuration file. If it is not correct, please edit \"include/config.php\" before continuing."
msgstr "درج ذیل معلومات Kadupul کی کنفیگریشن فائل سے اخذ کی گئی ہیں۔ اگر یہ درست نہیں ہے، تو آگے بڑھنے سے پہلے براہ کرم \"include/config.php\" میں ترمیم کریں۔"

#: lib/installer.php
msgid "The following tables should be converted to UTF8 and InnoDB with a Dynamic row format.  Please select the tables that you wish to convert during the installation process."
msgstr "درج ذیل ٹیبلز کو Dynamic قطار فارمیٹ کے ساتھ UTF8 اور InnoDB میں تبدیل کیا جانا چاہیے۔ براہ کرم وہ ٹیبلز منتخب کریں جنہیں آپ انسٹالیشن کے عمل کے دوران تبدیل کرنا چاہتے ہیں۔"

#: lib/installer.php
msgid "The installation cannot continue because no profiles could be found."
msgstr "انسٹالیشن جاری نہیں رہ سکتی کیونکہ کوئی پروفائلز نہیں مل سکے۔"

#: lib/installer.php
msgid "The installed database could not be checked because its table list could not be read."
msgstr "انسٹال شدہ ڈیٹابیس کی جانچ نہیں کی جا سکی کیونکہ اس کے ٹیبلز کی فہرست پڑھی نہیں جا سکی۔"

#: lib/installer.php
msgid "The installed database could not be checked because the core table list could not be read from cacti.sql."
msgstr "انسٹال شدہ ڈیٹابیس کی جانچ نہیں کی جا سکی کیونکہ بنیادی ٹیبلز کی فہرست cacti.sql سے پڑھی نہیں جا سکی۔"

#: lib/installer.php
msgid "The installed database version could not be confirmed. Review the installer errors before retrying."
msgstr "انسٹال شدہ ڈیٹابیس ورژن کی تصدیق نہیں ہو سکی۔ دوبارہ کوشش کرنے سے پہلے انسٹالر کی خرابیوں کا جائزہ لیں۔"

#: lib/installer.php
msgid "The installer CLI interpreter is unavailable for refreshing the Symfony production cache."
msgstr "Symfony پروڈکشن کیش کو ریفریش کرنے کے لیے انسٹالر CLI انٹرپریٹر دستیاب نہیں ہے۔"

#: lib/installer.php
msgid "The primary CDEF reference contract could not be installed. Review the schema and installer privileges before retrying."
msgstr "بنیادی CDEF حوالہ معاہدہ انسٹال نہیں کیا جا سکا۔ دوبارہ کوشش کرنے سے پہلے اسکیما اور انسٹالر کے اختیارات کا جائزہ لیں۔"

#: lib/installer.php
msgid "The specified value appears to be different in the running config versus the INI file."
msgstr "متعین کردہ قدر INI فائل کے مقابلے میں چلنے والی کنفیگریشن میں مختلف معلوم ہوتی ہے۔"

#: lib/installer.php
#, php-format
msgid "The user '%s' should have MODIFY permission to enable read/write."
msgstr "پڑھنے/لکھنے کو فعال کرنے کے لیے صارف '%s' کے پاس MODIFY اجازت ہونی چاہیے۔"

#: lib/installer.php
msgid "The variables that must be set in the config.php file include the following:"
msgstr "config.php فائل میں سیٹ کیے جانے والے متغیرات میں درج ذیل شامل ہیں:"

#: lib/installer.php
msgid "The way that the Whitelisting works is that when you first import a Data Input Method, or you re-import a Data Input Method, and the script and or arguments change in any way, the Data Input Method, and all the corresponding Data Sources will be immediately disabled until the administrator validates that the Data Input Method is valid."
msgstr "Whitelisting کے کام کرنے کا طریقہ یہ ہے کہ جب آپ پہلی بار کوئی Data Input Method درآمد کرتے ہیں، یا آپ کسی Data Input Method کو دوبارہ درآمد کرتے ہیں، اور اسکرپٹ اور یا دلائل (arguments) کسی بھی طرح تبدیل ہوتے ہیں، تو Data Input Method اور تمام متعلقہ Data Sources فوری طور پر اس وقت تک غیر فعال کر دیے جائیں گے جب تک کہ ایڈمنسٹریٹر یہ تصدیق نہ کر دے کہ Data Input Method درست ہے۔"

#: lib/installer.php
msgid "Then run the following within MySQL as an administrator:"
msgstr "پھر بطور ایڈمنسٹریٹر MySQL کے اندر درج ذیل چلائیں:"

#: lib/installer.php
msgid "Therefore, several versions ago, Kadupul was enhanced to provide Whitelist capabilities on the these types of Data Input Methods.  Though this does secure Kadupul more thoroughly, it does increase the amount of work required by the Kadupul administrator to import and manage Templates and Packages."
msgstr "لہٰذا، کئی ورژن پہلے، Kadupul کو ان اقسام کے Data Input Methods پر Whitelist صلاحیتیں فراہم کرنے کے لیے بہتر بنایا گیا تھا۔ اگرچہ اس سے Kadupul زیادہ مکمل طور پر محفوظ ہوتا ہے، لیکن یہ ٹیمپلیٹس اور پیکیجز کو درآمد اور منظم کرنے کے لیے Kadupul ایڈمنسٹریٹر کے کام کی مقدار کو بڑھا دیتا ہے۔"

#: lib/installer.php
msgid "These MySQL performance tuning settings will help your Kadupul system perform better without issues for a longer time."
msgstr "یہ MySQL کارکردگی ٹیوننگ ترتیبات آپ کے Kadupul سسٹم کو طویل عرصے تک بغیر مسائل کے بہتر کارکردگی دکھانے میں مدد کریں گی۔"

#: lib/installer.php
msgid "These directories will be required to stay read writable after the install so that the Kadupul remote synchronization process can update them as the Main Kadupul Web Site changes"
msgstr "انسٹال کے بعد ان ڈائریکٹریز کا پڑھنے اور لکھنے کے قابل رہنا ضروری ہوگا تاکہ Kadupul کا ریموٹ مطابقت پذیری کا عمل مرکزی Kadupul ویب سائٹ میں تبدیلیوں کے ساتھ انہیں اپ ڈیٹ کر سکے"

#: lib/installer.php
msgid "This error may also be generated if the cacti database user does not have correct permissions on the Kadupul database. Please ensure that the Kadupul database user has the ability to SELECT, INSERT, DELETE, UPDATE, CREATE, ALTER, DROP, INDEX on the Kadupul database."
msgstr "یہ خرابی اس صورت میں بھی پیدا ہو سکتی ہے اگر cacti ڈیٹابیس صارف کے پاس Kadupul ڈیٹابیس پر درست اجازتیں نہ ہوں۔ براہ کرم یقینی بنائیں کہ Kadupul ڈیٹابیس صارف کے پاس Kadupul ڈیٹابیس پر SELECT, INSERT, DELETE, UPDATE, CREATE, ALTER, DROP, INDEX کی صلاحیت موجود ہے۔"

#: lib/installer.php
msgid "This may occur if you have a blank database and have not yet imported the cacti.sql file"
msgstr "یہ اس وقت ہو سکتا ہے جب آپ کے پاس خالی ڈیٹابیس ہو اور آپ نے ابھی تک cacti.sql فائل درآمد نہ کی ہو"

