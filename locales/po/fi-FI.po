msgstr "Kadupulissa käytettävä järjestelmän oletuspäivämäärän erotin."

#: include/global_settings.php
msgid "Other Settings"
msgstr "Muut asetukset"

#: include/global_settings.php
msgid "Show only site specific locations"
msgstr "Näytä vain toimipaikkakohtaiset sijainnit"

#: include/global_settings.php
msgid "Show only locations that are available at a device's selected site."
msgstr "Näytä vain ne sijainnit, jotka ovat käytettävissä laitteen valitussa toimipaikassa."

#: include/global_settings.php
msgid "Has Graphs/Data Sources Checked"
msgstr "Kaaviot/tietolähteet tarkistettu"

#: include/global_settings.php
msgid "Should the Has Graphs and Has Data Sources be Checked by Default?"
msgstr "Pitäisikö Sisältää kaavioita ja Sisältää tietolähteitä olla oletuksena valittuina?"

#: include/global_settings.php utilities.php
msgid "RRDtool Version"
msgstr "RRDtoolin versio"

#: include/global_settings.php
