#: include/global_form.php
msgid "Choose a name for this data source.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "Vyberte názov pre tento zdroj dát.  Môže obsahovať náhradné premenné, napríklad |host_description| alebo |query_fieldName|.  Úplný zoznam podporovaných náhradných značiek nájdete v dokumentácii Kadupul."

#: include/global_form.php
msgid "Data Source Path"
msgstr "Cesta zdroja dát"

#: include/global_form.php
msgid "The full path to the RRDfile."
msgstr "Úplná cesta k RRDfile."

#: include/global_form.php
msgid "The script/source used to gather data for this data source."
msgstr "Skript/zdroj použitý na zber dát pre tento zdroj dát."

#: include/global_form.php package_import.php
msgid "Select the Data Source Profile.  The Data Source Profile controls polling interval, the data aggregation, and retention policy for the resulting Data Sources."
msgstr "Vyberte profil zdroja dát.  Profil zdroja dát riadi interval pollingu, agregáciu dát a politiku uchovávania pre výsledné zdroje dát."

#: include/global_form.php
msgid "The amount of time in seconds between expected updates."
msgstr "Čas v sekundách medzi očakávanými aktualizáciami."

#: include/global_form.php
msgid "Data Source Active"
msgstr "Zdroj dát aktívny"

#: include/global_form.php
msgid "Whether Kadupul should gather data for this data source or not."
msgstr "Určuje, či má Kadupul pre tento zdroj dát zbierať dáta."

#: include/global_form.php
msgid "Internal Data Source Name"
msgstr "Interný názov zdroja dát"

#: include/global_form.php
msgid "Choose a unique name to represent this piece of data inside of the RRDfile."
msgstr "Vyberte jedinečný názov, ktorý bude reprezentovať tento údaj v RRDfile."

#: include/global_form.php
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "Minimálna hodnota („U“ pre bez minima)"

#: include/global_form.php
msgid "The minimum value of data that is allowed to be collected."
msgstr "Minimálna hodnota dát, ktorú je povolené zbierať."

#: include/global_form.php
msgid "Maximum Value (\"U\" for No Maximum)"
msgstr "Maximálna hodnota („U“ pre bez maxima)"

#: include/global_form.php
msgid "The maximum value of data that is allowed to be collected."
msgstr "Maximálna hodnota dát, ktorú je povolené zbierať."

#: include/global_form.php
msgid "Data Source Type"
msgstr "Typ zdroja dát"

#: include/global_form.php
msgid "How data is represented in the RRA."
msgstr "Ako sú dáta reprezentované v RRA."

#: include/global_form.php
msgid "The maximum amount of time that can pass before data is entered as 'unknown'. (Usually 2x300=600)"
msgstr "Maximálny čas, ktorý môže uplynúť, kým sa dáta zapíšu ako „neznáme“. (Zvyčajne 2x300=600)"

#: include/global_form.php
msgid "Output Field"
msgstr "Výstupné pole"

#: include/global_form.php lib/html_utility.php
msgid "Not Selected"
msgstr "Nevybrané"

#: include/global_form.php
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "Pri zbere dát sa dáta tohto poľa vložia do tohto zdroja dát."

#: include/global_form.php
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "Zadajte názov pre túto predvoľbu GPRINT, použite niečo, čo spoznáte."

#: include/global_form.php
msgid "GPRINT Text"
msgstr "Text GPRINT"

#: include/global_form.php
msgid "Enter the custom GPRINT string here."
msgstr "Sem zadajte vlastný reťazec GPRINT."

#: include/global_form.php
msgid "Common Options"
msgstr "Bežné možnosti"

#: include/global_form.php
msgid "Title (--title)"
msgstr "Titulok (--title)"

#: include/global_form.php
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "Názov vytlačený na grafe.  Môže obsahovať náhradné premenné, napríklad |host_description| alebo |query_fieldName|.  Úplný zoznam podporovaných náhradných značiek nájdete v dokumentácii Kadupul."

#: include/global_form.php
msgid "Vertical Label (--vertical-label)"
msgstr "Zvislý popis (--vertical-label)"

#: include/global_form.php
msgid "The label vertically printed to the left of the graph."
msgstr "Popis vytlačený zvisle vľavo od grafu."

#: include/global_form.php
msgid "Image Format (--imgformat)"
msgstr "Formát obrázka (--imgformat)"

#: include/global_form.php
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "Typ generovaného grafu; PNG, GIF alebo SVG.  Výber typu obrázka grafu veľmi závisí od RRDtool."

#: include/global_form.php
msgid "Height (--height)"
msgstr "Výška (--height)"

#: include/global_form.php
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Výška (v pixeloch) oblasti grafu v rámci grafu. Táto oblasť nezahŕňa legendu, legendy osí ani titulok."

#: include/global_form.php
msgid "Width (--width)"
msgstr "Šírka (--width)"

#: include/global_form.php
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "Šírka (v pixeloch) oblasti grafu v rámci grafu. Táto oblasť nezahŕňa legendu, legendy osí ani titulok."

#: include/global_form.php
msgid "Base Value (--base)"
msgstr "Základná hodnota (--base)"

#: include/global_form.php
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "Pre pamäť by mala byť nastavená na 1024 a pre meranie prenosu na 1000."

#: include/global_form.php
msgid "Slope Mode (--slope-mode)"
msgstr "Režim sklonu (--slope-mode)"

#: include/global_form.php
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "Režim sklonu vyhladí tvar grafov na úkor určitého rozlíšenia na obrazovke."

#: include/global_form.php
msgid "Scaling Options"
msgstr "Možnosti škálovania"

#: include/global_form.php
msgid "Auto Scale"
msgstr "Automatická škála"

#: include/global_form.php
msgid "When enabled, the selected Auto Scale Option determines which limits RRDtool uses: --alt-autoscale ignores both limits, --alt-autoscale-max keeps the lower limit, --alt-autoscale-min keeps the upper limit, and --alt-autoscale (accepting both limits) keeps both limits. When disabled, the configured lower and upper limits are used directly. Rigid Boundaries controls whether values outside those limits expand the graph range."
msgstr "Keď je povolená, vybraná možnosť automatickej škály určuje, aké limity RRDtool použije: --alt-autoscale ignoruje oba limity, --alt-autoscale-max zachová dolný limit, --alt-autoscale-min zachová horný limit a --alt-autoscale (akceptujúci oba limity) zachová oba limity. Keď je zakázaná, použijú sa priamo nakonfigurované dolný a horný limit. Pevné hranice určujú, či hodnoty mimo týchto limitov rozšíria rozsah grafu."

#: include/global_form.php
msgid "Auto Scale Options"
msgstr "Možnosti automatickej škály"

#: include/global_form.php
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "Použite <br> --alt-autoscale na škálovanie podľa absolútneho minima a maxima <br> --alt-autoscale-max na škálovanie podľa maximálnej hodnoty s daným dolným limitom <br> --alt-autoscale-min na škálovanie podľa minimálnej hodnoty s daným horným limitom <br> --alt-autoscale (s limitmi) na škálovanie podľa dolného aj horného limitu (predvolené v RRDtool) <br>"

#: include/global_form.php
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "Použiť --alt-autoscale (ignorovať dané limity)"

#: include/global_form.php
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "Použiť --alt-autoscale-max (akceptovať dolný limit)"

#: include/global_form.php
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "Použiť --alt-autoscale-min (akceptovať horný limit)"

#: include/global_form.php
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "Použiť --alt-autoscale (akceptovať oba limity, predvolené v RRDtool)"

#: include/global_form.php
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Logaritmická škála (--logarithmic)"

#: include/global_form.php
msgid "Use Logarithmic y-axis scaling"
msgstr "Použiť logaritmickú škálu osi y"

#: include/global_form.php
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "Jednotky SI pre logaritmickú škálu (--units=si)"

#: include/global_form.php
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "Použite jednotky SI pre logaritmické škálovanie namiesto exponenciálneho zápisu.<br> Poznámka: Lineárne grafy používajú štandardne zápis SI."

#: include/global_form.php
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "Režim pevných hraníc (--rigid)"

#: include/global_form.php
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "Nerozširovať dolný a horný limit, ak graf obsahuje hodnotu mimo platného rozsahu."

#: include/global_form.php
msgid "Upper Limit (--upper-limit)"
msgstr "Horný limit (--upper-limit)"

#: include/global_form.php
msgid "The maximum vertical value for the graph."
msgstr "Maximálna zvislá hodnota grafu."

#: include/global_form.php
msgid "Lower Limit (--lower-limit)"
msgstr "Dolný limit (--lower-limit)"

#: include/global_form.php
msgid "The minimum vertical value for the graph."
msgstr "Minimálna zvislá hodnota grafu."

#: include/global_form.php
msgid "Grid Options"
msgstr "Možnosti mriežky"

#: include/global_form.php
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "Hodnota jednotkovej mriežky (--unit/--y-grid)"

#: include/global_form.php
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "Nastaví hodnotu exponentu na osi Y pre čísla. Poznámka: Táto možnosť je zastaraná a nahradená možnosťou --y-grid.  Pri tejto možnosti sa čiary mriežky osi Y zobrazujú v každom intervale kroku mriežky.  Popisky sa umiestňujú každých niekoľko čiar podľa faktora popisku."

#: include/global_form.php
msgid "Unit Exponent Value (--units-exponent)"
msgstr "Hodnota exponentu jednotky (--units-exponent)"

#: include/global_form.php
msgid "What unit Kadupul should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Akú jednotku má Kadupul použiť na osi Y. Použite 3 na zobrazenie všetkého v \"k\" alebo -6 na zobrazenie všetkého v \"u\" (mikro)."

#: include/global_form.php
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "Dĺžka jednotky (--units-length &lt;length&gt;)"

#: include/global_form.php
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "Koľko číslic má RRDtool predpokladať pre popisky osi Y? Túto možnosť možno budete musieť použiť na zabezpečenie dostatku miesta, keď začnete upravovať popisky osi Y."

#: include/global_form.php
msgid "No Gridfit (--no-gridfit)"
msgstr "Bez prispôsobenia mriežke (--no-gridfit)"

#: include/global_form.php
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "Aby sa predišlo efektom rozmazania pri vyhladzovaní, RRDtool prichytáva body na pixely rozlíšenia zariadenia, čo vedie k ostrejšiemu vzhľadu. Ak vám to nevyhovuje, môžete toto správanie vypnúť týmto prepínačom.<br><strong>Poznámka: </strong>Prispôsobenie mriežke je pre výstup PDF, EPS, SVG štandardne vypnuté."

#: include/global_form.php
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "Alternatívna mriežka Y (--alt-y-grid)"

#: include/global_form.php
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "Algoritmus zaisťuje, že mriežka je vždy prítomná, že čiar mriežky je dostatok, ale nie priveľa, a že mriežka je metrická. Tento parameter tiež zaistí zobrazenie dostatočného počtu desatinných miest, aj keď sa graf pohybuje od 69,998 do 70,001.<br><strong>Poznámka: </strong>Tento parameter môže zasahovať do možností --alt-autoscale."

#: include/global_form.php
msgid "Axis Options"
msgstr "Možnosti osí"

#: include/global_form.php
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "Pravá os (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "Napravo od grafu sa vykreslí druhá os. Je viazaná na ľavú os pomocou parametrov mierky a posunu."

#: include/global_form.php
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "Popisok pravej osi (--right-axis-label &lt;string&gt;)"

#: include/global_form.php
msgid "The label for the right axis."
msgstr "Popisok pravej osi."

#: include/global_form.php
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "Formát pravej osi (--right-axis-format &lt;format&gt;)"

#: include/global_form.php
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "Štandardne sa formát popiskov osi určuje automaticky.  Ak to chcete urobiť sami, použite túto možnosť s rovnakými argumentmi %lf, aké poznáte z príkazov PRINT a GPRINT."

#: include/global_form.php
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "Formátovač pravej osi (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you set up the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Pri nastavovaní popiskov pravej osi použite pravidlo na formát údajov.  Podporované formáty zahŕňajú \"numeric\", kde sa údaje považujú za číselné, \"timestamp\", kde sa hodnoty interpretujú ako časové pečiatky UNIX (počet sekúnd od januára 1970) a vyjadrujú sa pomocou formátu strftime (štandardne \"%Y-%m-%d %H:%M:%S\").  Pozri tiež --units-length a --right-axis-format.  Nakoniec \"duration\", kde sa hodnoty interpretujú ako trvanie v milisekundách.  Formátovanie sa riadi pravidlami kvalifikovaného PRINT/GPRINT valstrfduration."

#: include/global_form.php
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "Formátovač ľavej osi (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you set up the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "Pri nastavovaní popiskov ľavej osi použite pravidlo na formát údajov.  Podporované formáty zahŕňajú \"numeric\", kde sa údaje považujú za číselné, \"timestamp\", kde sa hodnoty interpretujú ako časové pečiatky UNIX (počet sekúnd od januára 1970) a vyjadrujú sa pomocou formátu strftime (štandardne \"%Y-%m-%d %H:%M:%S\").  Pozri tiež --units-length.  Nakoniec \"duration\", kde sa hodnoty interpretujú ako trvanie v milisekundách.  Formátovanie sa riadi pravidlami kvalifikovaného PRINT/GPRINT valstrfduration."

#: include/global_form.php
msgid "Legend Options"
msgstr "Možnosti legendy"

#: include/global_form.php
msgid "Auto Padding"
msgstr "Automatické odsadenie"

#: include/global_form.php
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "Doplní text tak, aby legenda a údaje grafu boli vždy zarovnané. Poznámka: Môže to spôsobiť dlhšie vykresľovanie grafov kvôli väčšej réžii. Automatické odsadenie tiež nemusí byť presné pri všetkých typoch grafov, zvyčajne pomáha jednotné označovanie."

#: include/global_form.php
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "Dynamické popisky (--dynamic-labels)"

#: include/global_form.php
msgid "Draw line markers as a line."
msgstr "Vykreslí značky čiar ako čiaru."

#: include/global_form.php
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "Vynútiť legendu pravidiel (--force-rules-legend)"

#: include/global_form.php
msgid "Force the generation of HRULE and VRULE legends."
msgstr "Vynúti generovanie legiend HRULE a VRULE."

#: include/global_form.php
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "Šírka tabulátora (--tabwidth &lt;pixels&gt;)"

#: include/global_form.php
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "Štandardne je šírka tabulátora 40 pixelov, túto možnosť použite na jej zmenu."

#: include/global_form.php
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "Poloha legendy (--legend-position=&lt;position&gt;)"

#: include/global_form.php
msgid "Place the legend at the given side of the graph."
msgstr "Umiestni legendu na zadanú stranu grafu."

#: include/global_form.php
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "Smer legendy (--legend-direction=&lt;direction&gt;)"

#: include/global_form.php
msgid "Place the legend items in the given vertical order."
msgstr "Umiestni položky legendy v zadanom zvislom poradí."

#: include/global_form.php lib/api_aggregate.php lib/html.php
msgid "Graph Item Type"
msgstr "Typ položky grafu"

#: include/global_form.php
msgid "How data for this item is represented visually on the graph."
msgstr "Ako sa údaje tejto položky vizuálne zobrazujú v grafe."

#: include/global_form.php
msgid "The data source to use for this graph item."
msgstr "Zdroj dát použitý pre túto položku grafu."

#: include/global_form.php
msgid "The color to use for the legend."
msgstr "Farba použitá pre legendu."

#: include/global_form.php
msgid "Opacity/Alpha Channel"
msgstr "Priehľadnosť/alfa kanál"

#: include/global_form.php
msgid "The opacity/alpha channel of the color."
msgstr "Priehľadnosť/alfa kanál farby."

#: include/global_form.php lib/rrd.php
msgid "Consolidation Function"
msgstr "Konsolidačná funkcia"

#: include/global_form.php
msgid "How data for this item is represented statistically on the graph."
msgstr "Ako sa údaje tejto položky štatisticky zobrazujú v grafe."

#: include/global_form.php
msgid "CDEF Function"
msgstr "Funkcia CDEF"

#: include/global_form.php
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "Funkcia CDEF (matematická) použitá na túto položku v grafe alebo legende."

#: include/global_form.php
msgid "VDEF Function"
msgstr "Funkcia VDEF"

#: include/global_form.php
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "Funkcia VDEF (matematická) použitá na túto položku v legende grafu."

#: include/global_form.php
msgid "Shift Data"
msgstr "Posun údajov"

#: include/global_form.php
msgid "Offset your data on the time axis (x-axis) by the amount specified in the 'value' field."
msgstr "Posunie vaše údaje na časovej osi (osi x) o hodnotu zadanú v poli 'value'."

#: include/global_form.php
msgid "[HRULE|VRULE]: The value of the graph item.<br/> [TICK]: The fraction for the tick line.<br/> [SHIFT]: The time offset in seconds."
msgstr "[HRULE|VRULE]: Hodnota položky grafu.<br/> [TICK]: Zlomok pre čiarku značky.<br/> [SHIFT]: Časový posun v sekundách."

#: include/global_form.php
msgid "GPRINT Type"
msgstr "Typ GPRINT"

#: include/global_form.php
msgid "If this graph item is a GPRINT, you can optionally choose another format here. You can define additional types under \"GPRINT Presets\"."
msgstr "Ak je táto položka grafu GPRINT, môžete tu voliteľne vybrať iný formát. Ďalšie typy môžete definovať v časti \"Predvoľby GPRINT\"."

#: include/global_form.php
msgid "Text Alignment (TEXTALIGN)"
msgstr "Zarovnanie textu (TEXTALIGN)"

#: include/global_form.php
msgid "All subsequent legend line(s) will be aligned as given here.  You may use this command multiple times in a single graph.  This command does not produce tabular layout.<br/><strong>Note: </strong>You may want to insert a &lt;HR&gt; on the preceding graph item.<br/> <strong>Note: </strong>A &lt;HR&gt; on this legend line will obsolete this setting!"
msgstr "Všetky nasledujúce riadky legendy budú zarovnané tak, ako je tu zadané.  Tento príkaz môžete v jednom grafe použiť viackrát.  Tento príkaz nevytvára tabuľkové rozloženie.<br/><strong>Poznámka: </strong>Možno budete chcieť vložiť &lt;HR&gt; do predchádzajúcej položky grafu.<br/> <strong>Poznámka: </strong>&lt;HR&gt; v tomto riadku legendy toto nastavenie zruší!"

#: include/global_form.php
msgid "Text Format"
msgstr "Formát textu"

#: include/global_form.php
msgid "Text that will be displayed on the legend for this graph item."
msgstr "Text, ktorý sa zobrazí v legende pre túto položku grafu."

#: include/global_form.php
msgid "Insert Hard Return"
msgstr "Vložiť pevný koniec riadka"

#: include/global_form.php
msgid "Forces the legend to the next line after this item."
msgstr "Vynúti presun legendy na nasledujúci riadok po tejto položke."

#: include/global_form.php
msgid "Dashes (dashes[=on_s[,off_s[,on_s,off_s]...]])"
