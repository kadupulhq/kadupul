msgstr "Predvolený počet riadkov súboru logu Kadupul, ktoré sa zobrazia od konca."

#: include/global_settings.php
msgid "Maximum number of rows per page"
msgstr "Maximálny počet riadkov na stranu"

#: include/global_settings.php
msgid "User defined number of lines for the CLOG to tail when selecting 'All lines'."
msgstr "Používateľom definovaný počet riadkov CLOG zobrazených od konca pri výbere 'All lines'."

#: include/global_settings.php
msgid "Log Tail Refresh"
msgstr "Obnovenie konca logu"

#: include/global_settings.php
msgid "How often do you want the Kadupul log display to update?"
msgstr "Ako často chcete aktualizovať zobrazenie logu Kadupul?"

#: include/global_settings.php
msgid "Log Viewer Settings"
msgstr "Nastavenia zobrazenia logu"

#: include/global_settings.php
msgid "Exclusion Regex"
msgstr "Regex vylúčenia"

#: include/global_settings.php
msgid "Any strings that match this regex will be excluded from the user display.  <strong>For example, if you want to exclude all log lines that include the words 'Admin' or 'Login' you would type '(Admin || Login)'</strong>"
msgstr "Všetky reťazce zodpovedajúce tomuto regexu budú vylúčené zo zobrazenia používateľa.  <strong>Napríklad, ak chcete vylúčiť všetky riadky logu obsahujúce slová 'Admin' alebo 'Login', zadajte '(Admin || Login)'</strong>"

#: include/global_settings.php
msgid "Real-time Graphs"
msgstr "Grafy v reálnom čase"

#: include/global_settings.php
msgid "Enable Real-time Graphing"
msgstr "Povoliť grafy v reálnom čase"

#: include/global_settings.php
msgid "When an option is checked, users will be able to put Kadupul into Real-time mode."
msgstr "Ak je možnosť zaškrtnutá, používatelia budú môcť prepnúť Kadupul do režimu reálneho času."

#: include/global_settings.php lib/html_reports.php
msgid "Graph Timespan"
msgstr "Časové rozpätie grafu"

#: include/global_settings.php
msgid "The timespan you wish to see on the default graph."
msgstr "Časové rozpätie, ktoré chcete vidieť v predvolenom grafe."

#: include/global_settings.php
msgid "Minimum Refresh Interval"
msgstr "Minimálny interval obnovenia"

#: include/global_settings.php
msgid "This is the minimal supported time between Graph updates.  This value is also used to set certain RRDfile attributes.  If you have a Device that caches data and does not provide realtime updates, you may have to increase the default Minimum Refresh Interval to prevent creating Graphs with gaps."
msgstr "Toto je minimálny podporovaný čas medzi aktualizáciami grafov.  Táto hodnota sa používa aj na nastavenie určitých atribútov RRDfile.  Ak máte zariadenie, ktoré ukladá údaje do vyrovnávacej pamäte a neposkytuje aktualizácie v reálnom čase, možno budete musieť zvýšiť predvolený minimálny interval obnovenia, aby ste predišli vytváraniu grafov s medzerami."

#: include/global_settings.php
msgid "Cache Directory"
msgstr "Adresár vyrovnávacej pamäte"

#: include/global_settings.php
msgid "This is the location, on the web server where the RRDfiles and PNG files will be cached.  This cache will be managed by the poller.  Make sure you have the correct read and write permissions on this folder"
msgstr "Toto je umiestnenie na webovom serveri, kde sa budú ukladať do vyrovnávacej pamäte súbory RRDfile a PNG.  Túto vyrovnávaciu pamäť bude spravovať poller.  Uistite sa, že máte v tomto priečinku správne oprávnenia na čítanie a zápis"

#: include/global_settings.php
msgid "RRDtool Graph Options"
msgstr "Možnosti grafov RRDtool"

#: include/global_settings.php
msgid "Custom Watermark"
msgstr "Vlastný vodoznak"

#: include/global_settings.php
msgid "Text placed at the bottom center of every Graph."
msgstr "Text umiestnený v dolnej časti v strede každého grafu."

#: include/global_settings.php
msgid "Custom Date Format"
msgstr "Vlastný formát dátumu"

#: include/global_settings.php
msgid "To be used when formatting |date_time| on a graph"
msgstr "Použije sa pri formátovaní |date_time| v grafe"

#: include/global_settings.php
msgid "Disable RRDtool Watermark"
msgstr "Zakázať vodoznak RRDtool"

#: include/global_settings.php
msgid "Provided your RRDtool version supports it, you may disable RRDtool advertisement on your Graphs by checking this option."
msgstr "Ak vaša verzia RRDtool túto možnosť podporuje, zaškrtnutím môžete vypnúť reklamu RRDtool vo vašich grafoch."

#: include/global_settings.php
msgid "Font Selection Method"
msgstr "Metóda výberu písma"

#: include/global_settings.php
msgid "How do you wish fonts to be handled by default?"
msgstr "Ako chcete, aby sa písma štandardne spracúvali?"

#: include/global_settings.php lib/api_device.php
msgid "System"
msgstr "Systém"

#: include/global_settings.php
msgid "Default Font"
msgstr "Predvolené písmo"

#: include/global_settings.php
msgid "When not using Theme based font control, the Pango font description to use for all Graphs, such as DejaVu Sans. Optionally, you may leave blank and control font settings on a per object basis."
msgstr "Ak sa nepoužíva ovládanie písma založené na téme, popis písma Pango použitý pre všetky grafy, napríklad DejaVu Sans. Voliteľne môžete pole ponechať prázdne a ovládať nastavenia písma pre jednotlivé objekty."

#: include/global_settings.php
msgid "Business Hours Settings"
msgstr "Nastavenia pracovnej doby"

#: include/global_settings.php
msgid "Start of Business Day"
msgstr "Začiatok pracovného dňa"

#: include/global_settings.php
msgid "The time your business hours start. Format: hh:mm"
msgstr "Čas, kedy začína vaša pracovná doba. Formát: hh:mm"

#: include/global_settings.php
msgid "End of Business Day"
msgstr "Koniec pracovného dňa"

#: include/global_settings.php
msgid "The time your business hours end. Format: hh:mm"
msgstr "Čas, kedy končí vaša pracovná doba. Formát: hh:mm"

#: include/global_settings.php
msgid "Hide Weekends"
msgstr "Skryť víkendy"

#: include/global_settings.php
msgid "Only show business hours during weekdays."
msgstr "Zobraziť pracovnú dobu iba počas pracovných dní."

#: include/global_settings.php
msgid "Show business hours"
msgstr "Zobraziť pracovnú dobu"

#: include/global_settings.php
msgid "Display business hours on rrd graphs."
msgstr "Zobraziť pracovnú dobu v grafoch RRD."

#: include/global_settings.php
msgid "Color to use for business hours"
msgstr "Farba pracovnej doby"

#: include/global_settings.php
msgid "The color to be shown for business hours"
msgstr "Farba zobrazená pre pracovnú dobu"

#: include/global_settings.php
msgid "Maximum number of days to show business hours"
msgstr "Maximálny počet dní na zobrazenie pracovnej doby"

#: include/global_settings.php
msgid "After this number of days, the business hours will not be added to the graph. <br/>Recommended: 62 days"
msgstr "Po tomto počte dní sa pracovná doba do grafu nepridá. <br/>Odporúčané: 62 dní"

#: include/global_settings.php
msgid "Data Collection Enabled"
msgstr "Zber údajov povolený"

#: include/global_settings.php
msgid "If you wish to stop the polling process completely, uncheck this box."
msgstr "Ak chcete proces pollingu úplne zastaviť, zrušte zaškrtnutie tohto políčka."

#: include/global_settings.php
msgid "SNMP Agent Support Enabled"
msgstr "Podpora agenta SNMP povolená"

#: include/global_settings.php
msgid "If this option is checked, Kadupul will populate SNMP Agent tables with Kadupul device and system information.  It does not enable the SNMP Agent itself."
msgstr "Ak je táto možnosť zaškrtnutá, Kadupul naplní tabuľky agenta SNMP informáciami o zariadeniach a systéme Kadupul.  Nepovoľuje samotného agenta SNMP."

#: include/global_settings.php
msgid "Poller Type"
msgstr "Typ pollera"

#: include/global_settings.php
msgid "The poller type to use.  This setting will take effect at next polling interval."
msgstr "Typ pollera, ktorý sa má použiť.  Toto nastavenie sa prejaví pri nasledujúcom intervale pollingu."

#: include/global_settings.php
msgid "Poller Sync Interval"
msgstr "Interval synchronizácie pollera"

#: include/global_settings.php
msgid "The default polling sync interval to use when creating a poller.  This setting will affect how often remote pollers are checked and updated."
msgstr "Predvolený interval synchronizácie pollingu použitý pri vytváraní pollera.  Toto nastavenie ovplyvní, ako často sa vzdialené pollery kontrolujú a aktualizujú."

#: include/global_settings.php
msgid "The polling interval in use.  This setting will affect how often RRDfiles are checked and updated.  <strong><u>NOTE: If you change this value, you must re-populate the poller cache.  Failure to do so, may result in lost data.</u></strong>"
msgstr "Používaný interval pollingu.  Toto nastavenie ovplyvní, ako často sa súbory RRDfile kontrolujú a aktualizujú.  <strong><u>POZNÁMKA: Ak túto hodnotu zmeníte, musíte znova naplniť vyrovnávaciu pamäť pollera.  Ak tak neurobíte, môže dôjsť k strate údajov.</u></strong>"

#: include/global_settings.php
msgid "Cron/Daemon Interval"
msgstr "Interval cron/démona"

#: include/global_settings.php
msgid "The frequency that the Kadupul data collector will be started.  You can use either crontab, a scheduled task (for windows), or the cactid systemd service to control launching the Kadupul data collector.  For instructions on using the cactid daemon, review the README.md file in the service directory."
msgstr "Frekvencia, s akou sa spustí zberač dát Kadupul.  Na riadenie spúšťania zberača dát Kadupul môžete použiť buď crontab, naplánovanú úlohu (vo Windows), alebo službu systemd cactid.  Pokyny na použitie démona cactid nájdete v súbore README.md v adresári service."

#: include/global_settings.php
msgid "Balance Process Load"
msgstr "Vyvážiť zaťaženie procesov"

#: include/global_settings.php
msgid "If you choose this option, Kadupul will attempt to balance the load of each poller process by equally distributing poller items per process."
msgstr "Ak vyberiete túto možnosť, Kadupul sa pokúsi vyvážiť zaťaženie každého procesu pollera rovnomerným rozdelením položiek pollera na jeden proces."

#: include/global_settings.php
msgid "Debug Output Width"
msgstr "Šírka ladiaceho výstupu"

#: include/global_settings.php
msgid "If you choose this option, Kadupul will check for output that exceeds Kadupul's ability to store it and issue a warning when it finds it."
msgstr "Ak vyberiete túto možnosť, Kadupul skontroluje výstup, ktorý presahuje schopnosť Kadupul ho uložiť, a po jeho nájdení vydá upozornenie."

#: include/global_settings.php
msgid "Disable increasing OID Check"
msgstr "Zakázať kontrolu rastúcich OID"

#: include/global_settings.php
msgid "Controls disabling check for increasing OID while walking OID tree."
msgstr "Riadi zakázanie kontroly rastúcich OID pri prechádzaní stromu OID."

#: include/global_settings.php
msgid "Remote Agent Timeout"
msgstr "Časový limit vzdialeného agenta"

#: include/global_settings.php
msgid "The amount of time, in seconds, that the Central Kadupul web server will wait for a response from the Remote Data Collector to obtain various Device information before abandoning the request.  On Devices that are associated with Data Collectors other than the Central Kadupul Data Collector, the Remote Agent must be used to gather Device information."
msgstr "Čas v sekundách, ktorý bude centrálny webový server Kadupul čakať na odpoveď od vzdialeného zberača dát na získanie rôznych informácií o zariadení, kým požiadavku opustí.  Pri zariadeniach priradených k iným zberačom dát ako centrálnemu zberaču dát Kadupul sa na zhromažďovanie informácií o zariadení musí použiť vzdialený agent."

#: include/global_settings.php
msgid "SNMP Bulkwalk Fetch Size"
msgstr "Veľkosť načítania SNMP Bulkwalk"

#: include/global_settings.php
msgid "How many OIDs should be returned per snmpbulkwalk request?  For Devices with large SNMP trees, increasing this size will increase re-index performance over a WAN."
msgstr "Koľko OID sa má vrátiť na jednu požiadavku snmpbulkwalk?  Pri zariadeniach s veľkými stromami SNMP zvýšenie tejto veľkosti zvýši výkon opätovného indexovania cez WAN."

#: include/global_settings.php
msgid "SNMP Get OID Limit"
msgstr "Limit OID pre SNMP Get"

#: include/global_settings.php
msgid "The default maximum number of SNMP Get OIDs to issue per snmpget request.  For Devices, this setting is controlled at the Device level.  You should only use this setting when using Kadupul's SNMP API natively in your scripts or plugins."
msgstr "Predvolený maximálny počet OID SNMP Get na vydanie v jednej požiadavke snmpget.  Pri zariadeniach sa toto nastavenie riadi na úrovni zariadenia.  Toto nastavenie by ste mali použiť iba pri natívnom používaní rozhrania SNMP API Kadupul vo vašich skriptoch alebo doplnkoch."

#: include/global_settings.php
msgid "Rejected Sample Retention"
msgstr "Uchovávanie odmietnutých vzoriek"

#: include/global_settings.php
msgid "Hours that samples refused by RRDtool, for example after a data source schema change, stay queued for retry before they are moved to the poller_output_rejected table.  Repair the RRDfile, then run cli/replay_rejected_samples.php to process them."
msgstr "Počet hodín, počas ktorých vzorky odmietnuté RRDtool, napríklad po zmene schémy zdroja dát, zostávajú vo fronte na opakovanie, kým sa presunú do tabuľky poller_output_rejected.  Opravte súbor RRDfile a potom spustite cli/replay_rejected_samples.php na ich spracovanie."

#: include/global_settings.php
msgid "Rejected Sample Limit"
msgstr "Limit odmietnutých vzoriek"

#: include/global_settings.php
msgid "The most refused samples one data source may keep queued.  The oldest samples beyond this limit are moved to the poller_output_rejected table immediately."
msgstr "Najvyšší počet odmietnutých vzoriek, ktoré môže jeden zdroj dát držať vo fronte.  Najstaršie vzorky nad týmto limitom sa okamžite presunú do tabuľky poller_output_rejected."

#: include/global_settings.php
msgid "Disable Resource Cache Replication"
msgstr "Zakázať replikáciu vyrovnávacej pamäte zdrojov"

#: include/global_settings.php
msgid "By default, the main Kadupul Data Collector will cache the entire web site and plugins into a Resource Cache.  Then, periodically the Remote Data Collectors will update themselves with any updates from the main Kadupul Data Collector.  This Resource Cache essentially allows Remote Data Collectors to self upgrade.  If you do not wish to use this option, you can disable it using this setting."
msgstr "Štandardne hlavný zberač dát Kadupul uloží celú webovú lokalitu a doplnky do vyrovnávacej pamäte zdrojov.  Potom sa vzdialené zberače dát pravidelne aktualizujú všetkými aktualizáciami z hlavného zberača dát Kadupul.  Táto vyrovnávacia pamäť zdrojov v podstate umožňuje vzdialeným zberačom dát samostatne sa inovovať.  Ak túto možnosť nechcete používať, môžete ju týmto nastavením zakázať."

#: include/global_settings.php
msgid "Additional Data Collector Settings"
msgstr "Ďalšie nastavenia zberača dát"

#: include/global_settings.php
msgid "Invalid Data Logging"
msgstr "Logovanie neplatných údajov"

#: include/global_settings.php
msgid "How would you like the Data Collector output errors logged?  Options include: 'Detailed' which details every error, 'Summary' which provides the number of output errors per Device, and 'None', which does not provide error counts."
msgstr "Ako chcete logovať chyby výstupu zberača dát?  Možnosti zahŕňajú: 'Podrobne', ktorá uvádza každú chybu, 'Súhrn', ktorá poskytuje počet chýb výstupu na zariadenie, a 'Žiadne', ktorá neposkytuje počty chýb."

#: include/global_settings.php utilities.php
msgid "Summary"
msgstr "Súhrn"

#: include/global_settings.php
msgid "Detailed"
msgstr "Podrobne"

#: include/global_settings.php
msgid "Number of PHP Script Servers"
msgstr "Počet serverov skriptov PHP"

#: include/global_settings.php
msgid "The number of concurrent script server processes to run per spine process.  Settings between 1 and 15 are accepted.  This parameter will help if you are running several threads and script server scripts and is only valid for the spine Data Collector."
msgstr "Počet súbežných procesov servera skriptov spustených na jeden proces spine.  Akceptujú sa nastavenia od 1 do 15.  Tento parameter pomôže, ak spúšťate niekoľko vlákien a skriptov servera skriptov, a platí iba pre zberač dát spine."

#: include/global_settings.php
msgid "Script and Script Server Timeout Value"
msgstr "Hodnota časového limitu skriptu a servera skriptov"

#: include/global_settings.php
msgid "The maximum time that spine will wait on a script to complete.  This timeout value is in seconds and is only valid for the spine Data Collector."
msgstr "Maximálny čas, počas ktorého spine čaká na dokončenie skriptu.  Táto hodnota časového limitu je v sekundách a platí iba pre zberač dát spine."

#: include/global_settings.php
msgid "Periodic All Device Re-Index"
msgstr "Pravidelné opätovné indexovanie všetkých zariadení"

#: include/global_settings.php
msgid "Re-Index All Device Schedule"
msgstr "Plán opätovného indexovania všetkých zariadení"

#: include/global_settings.php
msgid "At what frequency do you wish to Re-Index all Devices.  This Re-Index will occur at midnight at the frequency that you select."
msgstr "Ako často chcete opätovne indexovať všetky zariadenia.  Toto opätovné indexovanie sa vykoná o polnoci s vami zvolenou frekvenciou."

#: include/global_settings.php
msgid "Weekly on Sunday"
msgstr "Týždenne v nedeľu"

#: include/global_settings.php
msgid "Monthly on Sunday"
msgstr "Mesačne v nedeľu"

#: include/global_settings.php
msgid "Background Timeout and Concurrent Process Settings"
msgstr "Nastavenia časových limitov na pozadí a súbežných procesov"

#: include/global_settings.php
msgid "Report Generation Timeout"
msgstr "Časový limit generovania reportov"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Reports Generation script can run without generating a timeout error and being killed."
msgstr "Maximálny čas, počas ktorého môže bežať skript generovania reportov Kadupul bez vygenerovania chyby časového limitu a ukončenia."

#: include/global_settings.php
#, php-format
msgid "%s Minute"
msgstr "%s minúta"

#: include/global_settings.php
msgid "Data Source Statistics Timeout"
msgstr "Časový limit štatistík zdroja dát"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Data Source Statistics script can run without generating a timeout error and being killed."
msgstr "Maximálny čas, počas ktorého môže bežať skript štatistík zdrojov dát Kadupul bez vygenerovania chyby časového limitu a ukončenia."

#: include/global_settings.php
msgid "RRDChecker Timeout"
msgstr "Časový limit RRDChecker"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's RRDfile check script can run without generating a timeout error and being killed."
msgstr "Maximálny čas, počas ktorého môže bežať skript kontroly RRDfile Kadupul bez vygenerovania chyby časového limitu a ukončenia."

#: include/global_settings.php
#, php-format
msgid "%s Hour"
msgstr "%s hodina"

#: include/global_settings.php
msgid "Poller Commands Timeout"
msgstr "Časový limit príkazov pollera"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Background Commands script can run without generating a timeout error and being killed.  This script will perform tasks such as re-indexing Devices and pruning devices from Remote Data Collectors."
msgstr "Maximálny čas, počas ktorého môže bežať skript príkazov na pozadí Kadupul bez vygenerovania chyby časového limitu a ukončenia.  Tento skript vykonáva úlohy, ako je opätovné indexovanie zariadení a odstraňovanie zariadení zo vzdialených zberačov dát."

#: include/global_settings.php
msgid "Poller Command Concurrent Processes"
msgstr "Súbežné procesy príkazov pollera"

#: include/global_settings.php
msgid "The number of concurrent Poller Command processes.  There will be at most one concurrent command per host within the Poller Command pool."
msgstr "Počet súbežných procesov príkazov pollera.  V rámci fondu príkazov pollera bude najviac jeden súbežný príkaz na hostiteľa."

#: include/global_settings.php
msgid "1 Process"
msgstr "1 proces"

#: include/global_settings.php
#, php-format
msgid "%d Processes"
msgstr "%d procesov"

#: include/global_settings.php
msgid "Maintenance Background Generation Timeout"
msgstr "Časový limit generovania údržby na pozadí"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Maintenance script can run without generating a timeout error and being killed."
msgstr "Maximálny čas, počas ktorého môže bežať skript údržby Kadupul bez vygenerovania chyby časového limitu a ukončenia."

#: include/global_settings.php
msgid "Spikekill Background Generation Timeout"
msgstr "Časový limit generovania Spikekill na pozadí"

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Spikekill script can run without generating a timeout error and being killed."
msgstr "Maximálny čas, počas ktorého môže bežať skript Spikekill Kadupul bez vygenerovania chyby časového limitu a ukončenia."

#: include/global_settings.php
msgid "Data Collector Defaults"
msgstr "Predvolené hodnoty zberača dát"

#: include/global_settings.php
msgid "These settings are maintained at the Data Collector level.  The values here are only defaults used when first creating a Data Collector."
msgstr "Tieto nastavenia sa spravujú na úrovni zberača dát.  Tu uvedené hodnoty sú iba predvolené hodnoty použité pri prvom vytvorení zberača dát."

#: include/global_settings.php
msgid "Data Collector Processes"
msgstr "Procesy zberača dát"

#: include/global_settings.php
msgid "The default number of concurrent processes to execute per Data Collector.  NOTE: Starting from Kadupul 1.2, this setting is maintained in the Data Collector.  Moving forward, this value is only a preset for the Data Collector.  Using a higher number when using cmd.php will improve performance.  Performance improvements in Spine are best resolved with the threads parameter.  When using Spine, we recommend a lower number and leveraging threads instead.  When using cmd.php, use no more than 2x the number of CPU cores."
msgstr "Predvolený počet súbežných procesov spúšťaných na jeden zberač dát.  POZNÁMKA: Od Kadupul 1.2 sa toto nastavenie spravuje v zberači dát.  Odteraz je táto hodnota iba predvoľbou pre zberač dát.  Použitie vyššieho čísla pri cmd.php zlepší výkon.  Zlepšenia výkonu v Spine sa najlepšie dosahujú parametrom threads.  Pri použití Spine odporúčame nižšie číslo a využitie vlákien.  Pri cmd.php nepoužívajte viac ako 2-násobok počtu jadier CPU."

#: include/global_settings.php
msgid "Threads per Process"
msgstr "Vlákna na proces"

#: include/global_settings.php
msgid "The Default Threads allowed per process.  NOTE: Starting in Kadupul 1.2+, this setting is maintained in the Data Collector, and this is simply the Preset.  Using a higher number when using Spine will improve performance.  However, ensure that you have enough MySQL/MariaDB connections to support the following equation: connections = data collectors * processes * (threads + script servers).  You must also ensure that you have enough spare connections for user login connections as well."
msgstr "Predvolený počet vlákien povolených na proces.  POZNÁMKA: Od Kadupul 1.2+ sa toto nastavenie spravuje v zberači dát a toto je iba predvoľba.  Použitie vyššieho čísla pri Spine zlepší výkon.  Uistite sa však, že máte dostatok pripojení MySQL/MariaDB na podporu nasledujúceho vzorca: pripojenia = zberače dát * procesy * (vlákna + servery skriptov).  Musíte tiež zabezpečiť dostatok rezervných pripojení pre pripojenia pri prihlásení používateľov."

#: include/global_settings.php
msgid "Authentication Method"
msgstr "Metóda overovania"

#: include/global_settings.php
msgid "<blockquote><i>Built-in Authentication</i> - Kadupul handles user authentication, which allows you to create users and give them rights to different areas within Kadupul.<br><br><i>Web Basic Authentication</i> - Authentication is handled by the web server. Users can be added or created automatically on first login if the Template User is defined, otherwise the defined guest permissions will be used.<br><br><i>LDAP Authentication</i> - Allows for authentication against an LDAP server. Users will be created automatically on first login if the Template User is defined, otherwise the defined guest permissions will be used.  If PHP's LDAP module is not enabled, LDAP Authentication will not appear as a selectable option.<br><br><i>Multiple LDAP/AD Domain Authentication</i> - Allows administrators to support multiple disparate groups from different LDAP/AD directories to access Kadupul resources.  Just as LDAP Authentication, the PHP LDAP module is required to utilize this method.</blockquote>"
msgstr "<blockquote><i>Vstavané overovanie</i> - Kadupul spracúva overovanie používateľov, čo vám umožňuje vytvárať používateľov a udeľovať im práva na rôzne oblasti v Kadupul.<br><br><i>Overovanie Web Basic</i> - Overovanie spracúva webový server. Používatelia môžu byť pridaní alebo automaticky vytvorení pri prvom prihlásení, ak je definovaný šablónový používateľ, inak sa použijú definované oprávnenia hosťa.<br><br><i>Overovanie LDAP</i> - Umožňuje overovanie voči serveru LDAP. Používatelia sa automaticky vytvoria pri prvom prihlásení, ak je definovaný šablónový používateľ, inak sa použijú definované oprávnenia hosťa.  Ak modul LDAP pre PHP nie je povolený, overovanie LDAP sa nezobrazí ako voliteľná možnosť.<br><br><i>Overovanie viacerých domén LDAP/AD</i> - Umožňuje správcom podporovať prístup viacerých rôznorodých skupín z rôznych adresárov LDAP/AD k zdrojom Kadupul.  Rovnako ako pri overovaní LDAP je na použitie tejto metódy potrebný modul LDAP pre PHP.</blockquote>"

#: include/global_settings.php
msgid "Support Authentication Cookies"
msgstr "Podpora overovacích cookies"

#: include/global_settings.php
msgid "If a user authenticates and selects 'Keep me signed in', an authentication cookie will be created on the user's computer allowing that user to stay logged in.  The authentication cookie expires after 90 days of non-use."
msgstr "Ak sa používateľ overí a vyberie 'Zostať prihlásený', na počítači používateľa sa vytvorí overovací súbor cookie, ktorý používateľovi umožní zostať prihlásený.  Overovací súbor cookie vyprší po 90 dňoch nepoužívania."

#: include/global_settings.php
msgid "Special Users"
msgstr "Špeciálni používatelia"

#: include/global_settings.php
msgid "Primary Admin"
msgstr "Primárny správca"

#: include/global_settings.php
msgid "The name of the primary administrative account that will automatically receive Emails when the Kadupul system experiences issues.  To receive these Emails, ensure that your mail settings are correct, and the administrative account has an Email address that is set."
msgstr "Názov primárneho správcovského účtu, ktorý bude automaticky dostávať e-maily, keď sa v systéme Kadupul vyskytnú problémy.  Ak chcete tieto e-maily dostávať, uistite sa, že vaše nastavenia pošty sú správne a správcovský účet má nastavenú e-mailovú adresu."

#: include/global_settings.php user_domains.php
msgid "No User"
msgstr "Žiadny používateľ"

#: include/global_settings.php
msgid "Guest User"
msgstr "Používateľ hosť"

#: include/global_settings.php
msgid "The name of the guest user for viewing graphs; is 'No User' by default."
msgstr "Názov používateľa hosťa na zobrazovanie grafov; štandardne je 'Žiadny používateľ'."

#: include/global_settings.php user_domains.php
msgid "User Template"
msgstr "Šablóna používateľa"

#: include/global_settings.php
msgid "The name of the user that Kadupul will use as a template for new Web Basic and LDAP users; is 'guest' by default.  This user account will be disabled from logging in upon being selected."
msgstr "Názov používateľa, ktorého Kadupul použije ako šablónu pre nových používateľov Web Basic a LDAP; štandardne je 'guest'.  Po výbere bude tomuto používateľskému účtu zakázané prihlásenie."

#: include/global_settings.php
msgid "Basic Authentication Settings"
msgstr "Nastavenia overovania Basic"

#: include/global_settings.php
msgid "Basic Auth Login Failure Message"
msgstr "Chybové hlásenie zlyhania prihlásenia Basic Auth"

#: include/global_settings.php
msgid "When using basic authentication, if there are issues mapping the username to a valid Kadupul account, the message included here will be displayed to users.  It can include both text and HTML."
msgstr "Pri použití overovania Basic sa používateľom zobrazí tu uvedená správa, ak sa vyskytnú problémy s priradením používateľského mena k platnému účtu Kadupul.  Môže obsahovať text aj HTML."

#: include/global_settings.php
msgid "Basic Auth Mapfile"
msgstr "Mapovací súbor Basic Auth"

#: include/global_settings.php
msgid "When using basic authentication, if the basic account needs to be translated to a different login account, you can specify a CSV file here to map the basic account to the desired login account."
msgstr "Pri použití overovania Basic, ak je potrebné preložiť účet Basic na iný prihlasovací účet, môžete tu zadať súbor CSV na priradenie účtu Basic k požadovanému prihlasovaciemu účtu."

#: include/global_settings.php
msgid "Local Account Complexity Requirements"
msgstr "Požiadavky na zložitosť lokálnych účtov"

#: include/global_settings.php
msgid "Minimum Length"
msgstr "Minimálna dĺžka"

#: include/global_settings.php
msgid "This is the minimal length of allowed passwords."
msgstr "Toto je minimálna dĺžka povolených hesiel."

#: include/global_settings.php
msgid "Require Mix Case"
msgstr "Vyžadovať malé aj veľké písmená"

#: include/global_settings.php
msgid "This will require new passwords to contain both lower and upper-case characters."
msgstr "Nové heslá budú musieť obsahovať malé aj veľké písmená."

#: include/global_settings.php
msgid "Require Number"
msgstr "Vyžadovať číslo"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 numerical character."
msgstr "Nové heslá budú musieť obsahovať aspoň 1 číselný znak."

#: include/global_settings.php
msgid "Require Special Character"
msgstr "Vyžadovať špeciálny znak"

#: include/global_settings.php
msgid "This will require new passwords to contain at least 1 special character."
msgstr "Nové heslá budú musieť obsahovať aspoň 1 špeciálny znak."

#: include/global_settings.php
msgid "Force Complexity Upon Old Passwords"
msgstr "Vynútiť zložitosť pre staré heslá"

#: include/global_settings.php
msgid "This will require all old passwords to also meet the new complexity requirements upon login.  If not met, it will force a password change."
msgstr "Pri prihlásení budú musieť aj všetky staré heslá spĺňať nové požiadavky na zložitosť.  Ak ich nespĺňajú, bude vynútená zmena hesla."

#: include/global_settings.php
msgid "Expire Inactive Accounts"
msgstr "Vypršanie platnosti neaktívnych účtov"

#: include/global_settings.php
msgid "This is the maximum number of days before inactive accounts are disabled.  The Admin account is excluded from this policy."
msgstr "Toto je maximálny počet dní, po ktorých sa neaktívne účty zakážu.  Účet správcu je z tejto politiky vylúčený."

#: include/global_settings.php
msgid "Expire Password"
msgstr "Vypršanie platnosti hesla"

#: include/global_settings.php
msgid "This is the maximum number of days before a password is set to expire."
msgstr "Toto je maximálny počet dní, po ktorých platnosť hesla vyprší."

#: include/global_settings.php
msgid "Password History"
msgstr "História hesiel"

#: include/global_settings.php
msgid "Remember this number of old passwords and disallow reusing them."
msgstr "Zapamätať si tento počet starých hesiel a zakázať ich opätovné použitie."

#: include/global_settings.php
msgid "1 Change"
msgstr "1 zmena"

#: include/global_settings.php
#, php-format
msgid "%d Changes"
msgstr "%d zmien"

#: include/global_settings.php
msgid "Account Locking"
msgstr "Uzamykanie účtov"

#: include/global_settings.php
msgid "Lock Accounts"
msgstr "Uzamykať účty"

#: include/global_settings.php
msgid "Lock an account after this many failed attempts in 1 hour."
msgstr "Uzamknúť účet po tomto počte neúspešných pokusov za 1 hodinu."

#: include/global_settings.php
msgid "1 Attempt"
msgstr "1 pokus"

#: include/global_settings.php
#, php-format
msgid "%d Attempts"
msgstr "%d pokusov"

#: include/global_settings.php
msgid "Auto Unlock"
msgstr "Automatické odomknutie"

#: include/global_settings.php
msgid "An account will automatically be unlocked after this many minutes.  Even if the correct password is entered, the account will not unlock until this time limit has been met.  Max of 1440 minutes (1 Day)"
msgstr "Účet sa automaticky odomkne po tomto počte minút.  Aj keď sa zadá správne heslo, účet sa neodomkne, kým sa nedosiahne tento časový limit.  Maximum 1440 minút (1 deň)"

#: include/global_settings.php
msgid "1 Day"
msgstr "1 deň"

#: include/global_settings.php
msgid "LDAP General Settings"
msgstr "Všeobecné nastavenia LDAP"

#: include/global_settings.php user_domains.php
msgid "Server(s)"
msgstr "Server(y)"

#: include/global_settings.php user_domains.php
msgid "A space delimited list of DNS hostnames or IP addresses for valid LDAP servers.  Kadupul will attempt to use the LDAP servers from left to right to authenticate a user."
msgstr "Zoznam názvov hostiteľov DNS alebo adries IP platných serverov LDAP oddelený medzerami.  Kadupul sa pokúsi použiť servery LDAP zľava doprava na overenie používateľa."

#: include/global_settings.php user_domains.php
msgid "Port Standard"
msgstr "Štandardný port"

#: include/global_settings.php
msgid "TCP port for Non-SSL communications including LDAP + TLS.  Default is 389."
msgstr "Port TCP pre komunikáciu bez SSL vrátane LDAP + TLS.  Predvolený je 389."

#: include/global_settings.php user_domains.php
msgid "Port SSL"
msgstr "Port SSL"

#: include/global_settings.php
msgid "TCP port for LDAPS for SSL communications.  Default is 636."
msgstr "Port TCP pre LDAPS na komunikáciu SSL.  Predvolený je 636."

#: include/global_settings.php user_domains.php
msgid "Protocol Version"
msgstr "Verzia protokolu"

#: include/global_settings.php
msgid "Protocol Version to connect to the server with."
msgstr "Verzia protokolu, ktorou sa pripája k serveru."

#: include/global_settings.php
msgid "Connect Timeout"
msgstr "Časový limit pripojenia"

#: include/global_settings.php
msgid "The Network Connect Timeout in seconds."
msgstr "Časový limit sieťového pripojenia v sekundách."

#: include/global_settings.php
msgid "Bind Timeout"
msgstr "Časový limit väzby"

#: include/global_settings.php
msgid "The Bind Timeout in seconds."
msgstr "Časový limit väzby (bind) v sekundách."

#: include/global_settings.php
msgid "LDAP Debug Mode"
msgstr "Režim ladenia LDAP"

#: include/global_settings.php
msgid "If Checked Kadupul will log extra LDAP information to the Kadupul log during Binding and Searching activities."
msgstr "Ak je zaškrtnuté, Kadupul bude počas činností väzby (bind) a vyhľadávania zapisovať do logu Kadupul dodatočné informácie o LDAP."

#: include/global_settings.php user_domains.php
msgid "Encryption"
msgstr "Šifrovanie"

#: include/global_settings.php
msgid "Encryption that the server supports. NOTE: When using LDAP + TLS you must use version 3."
msgstr "Šifrovanie, ktoré server podporuje. POZNÁMKA: Pri použití LDAP + TLS musíte použiť verziu 3."

#: include/global_settings.php
msgid "TLS Certificate Requirements"
msgstr "Požiadavky na certifikát TLS"

#: include/global_settings.php
msgid "Should LDAP verify TLS Certificates when received by the Client.  Demand and Hard refuse a server whose certificate does not verify.  Never and Allow skip that check, so anyone on the network path can pose as the directory and read the passwords sent to it."
msgstr "Má LDAP overovať certifikáty TLS prijaté klientom.  Vyžadovať a Prísne odmietnu server, ktorého certifikát sa nepodarí overiť.  Nikdy a Povoliť túto kontrolu preskočia, takže ktokoľvek na sieťovej ceste sa môže vydávať za adresár a čítať odosielané heslá."

#: include/global_settings.php user_domains.php
msgid "Referrals"
msgstr "Odkazy (referrals)"

#: include/global_settings.php user_domains.php
msgid "Enable or Disable LDAP referrals.  If disabled, it may increase the speed of searches."
msgstr "Povoliť alebo zakázať odkazy LDAP.  Ak sú zakázané, môže sa zvýšiť rýchlosť vyhľadávania."

#: include/global_settings.php user_domains.php
msgid "Mode"
msgstr "Režim"

#: include/global_settings.php user_domains.php
msgid "Mode which cacti will attempt to authenticate against the LDAP server.<blockquote><i>No Searching</i> - No Distinguished Name (DN) searching occurs, just attempt to bind with the provided Distinguished Name (DN) format.<br><br><i>Anonymous Searching</i> - Attempts to search for username against LDAP directory via anonymous binding to locate the user's Distinguished Name (DN).<br><br><i>Specific Searching</i> - Attempts to search for username against LDAP directory via Specific Distinguished Name (DN) and Specific Password for binding to locate the user's Distinguished Name (DN)."
msgstr "Režim, ktorým sa cacti pokúsi overiť voči serveru LDAP.<blockquote><i>Bez vyhľadávania</i> - Nevykonáva sa vyhľadávanie rozlišovacieho mena (DN), iba sa pokúsi o väzbu so zadaným formátom rozlišovacieho mena (DN).<br><br><i>Anonymné vyhľadávanie</i> - Pokúsi sa vyhľadať používateľské meno v adresári LDAP pomocou anonymnej väzby, aby našiel rozlišovacie meno (DN) používateľa.<br><br><i>Konkrétne vyhľadávanie</i> - Pokúsi sa vyhľadať používateľské meno v adresári LDAP pomocou konkrétneho rozlišovacieho mena (DN) a konkrétneho hesla na väzbu, aby našiel rozlišovacie meno (DN) používateľa."

#: include/global_settings.php user_domains.php
msgid "Distinguished Name (DN)"
msgstr "Rozlišovacie meno (DN)"

#: include/global_settings.php user_domains.php
msgid "The \"Distinguished Name\" syntax, applicable for both OpenLDAP and Windows AD configurations, offers flexibility in defining user identity. For OpenLDAP, the format follows this structure: <i>\"uid=&lt;username&gt;,ou=people,dc=domain,dc=local\"</i>. Windows AD provides an alternative syntax: <i>\"&lt;username&gt;@win2kdomain.local\"</i>, commonly known as \"userPrincipalName (UPN)\". In this context, \"&lt;username&gt;\" represents the specific username provided during the login prompt. This is particularly pertinent when operating in \"No Searching\" mode, or \"Require Group Membership\" enabled."
msgstr "Syntax \"Rozlišovacie meno\", použiteľná pre konfigurácie OpenLDAP aj Windows AD, ponúka flexibilitu pri definovaní identity používateľa. Pre OpenLDAP má formát túto štruktúru: <i>\"uid=&lt;username&gt;,ou=people,dc=domain,dc=local\"</i>. Windows AD poskytuje alternatívnu syntax: <i>\"&lt;username&gt;@win2kdomain.local\"</i>, bežne známu ako \"userPrincipalName (UPN)\". V tomto kontexte \"&lt;username&gt;\" predstavuje konkrétne používateľské meno zadané pri výzve na prihlásenie. Je to obzvlášť dôležité pri prevádzke v režime \"Bez vyhľadávania\" alebo s povolenou možnosťou \"Vyžadovať členstvo v skupine\"."

#: include/global_settings.php user_domains.php
msgid "Require Group Membership"
msgstr "Vyžadovať členstvo v skupine"

#: include/global_settings.php user_domains.php
msgid "Require user to be member of group to authenticate. Group settings must be set for this to work, enabling without proper group settings will cause authentication failure."
msgstr "Vyžadovať, aby bol používateľ na overenie členom skupiny. Aby to fungovalo, musia byť nastavené skupinové nastavenia; povolenie bez správnych skupinových nastavení spôsobí zlyhanie overenia."

#: include/global_settings.php user_domains.php
msgid "LDAP Group Settings"
msgstr "Nastavenia skupiny LDAP"

#: include/global_settings.php user_domains.php
msgid "Group Distinguished Name (DN)"
msgstr "Rozlišovacie meno skupiny (DN)"

#: include/global_settings.php user_domains.php
msgid "Distinguished Name of the group that user must have membership."
msgstr "Rozlišovacie meno skupiny, v ktorej musí byť používateľ členom."

#: include/global_settings.php user_domains.php
msgid "Group Member Attribute"
msgstr "Atribút člena skupiny"

#: include/global_settings.php user_domains.php
msgid "This refers to the specific attribute within the LDAP directory that holds the usernames of group members. It is crucial to ensure that the attribute value aligns with the configuration specified in the \"Distinguished Name\" or that the actual attribute value is searchable using the settings outlined in the \"Distinguished Name\"."
msgstr "Odkazuje na konkrétny atribút v adresári LDAP, ktorý obsahuje používateľské mená členov skupiny. Je dôležité zabezpečiť, aby hodnota atribútu zodpovedala konfigurácii zadanej v \"Rozlišovacie meno\" alebo aby sa skutočná hodnota atribútu dala vyhľadať pomocou nastavení uvedených v \"Rozlišovacie meno\"."

#: include/global_settings.php user_domains.php
msgid "Group Member Type"
msgstr "Typ člena skupiny"

#: include/global_settings.php user_domains.php
msgid "Defines if users use full Distinguished Name or just Username in the defined Group Member Attribute."
msgstr "Určuje, či používatelia v definovanom atribúte člena skupiny používajú úplné rozlišovacie meno alebo iba používateľské meno."

#: include/global_settings.php
msgid "Distinguished Name"
msgstr "Rozlišovacie meno"

#: include/global_settings.php user_domains.php
msgid "LDAP Specific Search Settings"
msgstr "Nastavenia špecifického vyhľadávania LDAP"

#: include/global_settings.php user_domains.php
msgid "Search Base"
msgstr "Základ vyhľadávania"

#: include/global_settings.php
msgid "Search base for searching the LDAP directory, such as <i>'dc=win2kdomain,dc=local'</i> or <i>'ou=people,dc=domain,dc=local'</i>."
msgstr "Základ vyhľadávania v adresári LDAP, napríklad <i>'dc=win2kdomain,dc=local'</i> alebo <i>'ou=people,dc=domain,dc=local'</i>."

#: include/global_settings.php user_domains.php
msgid "Search Filter"
msgstr "Filter vyhľadávania"

#: include/global_settings.php
msgid "Search filter to use to locate the user in the LDAP directory, such as for windows: <i>'(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))'</i> or for OpenLDAP: <i>'(&(objectClass=account)(uid=&lt;username&gt))'</i>.  '&lt;username&gt' is replaced with the username that was supplied at the login prompt. "
msgstr "Filter vyhľadávania použitý na nájdenie používateľa v adresári LDAP, napríklad pre Windows: <i>'(&amp;(objectclass=user)(objectcategory=user)(userPrincipalName=&lt;username&gt;*))'</i> alebo pre OpenLDAP: <i>'(&(objectClass=account)(uid=&lt;username&gt))'</i>.  '&lt;username&gt' sa nahradí používateľským menom zadaným pri výzve na prihlásenie. "

#: include/global_settings.php user_domains.php
msgid "Search Distinguished Name (DN)"
msgstr "Rozlišovacie meno vyhľadávania (DN)"

#: include/global_settings.php user_domains.php
msgid "Distinguished Name for Specific Searching binding to the LDAP directory."
msgstr "Rozlišovacie meno na väzbu špecifického vyhľadávania s adresárom LDAP."

#: include/global_settings.php user_domains.php
msgid "Search Password"
msgstr "Heslo vyhľadávania"

#: include/global_settings.php user_domains.php
msgid "Password for Specific Searching binding to the LDAP directory."
msgstr "Heslo na väzbu špecifického vyhľadávania s adresárom LDAP."

#: include/global_settings.php user_domains.php
msgid "LDAP CN Settings"
msgstr "Nastavenia LDAP CN"

#: include/global_settings.php user_domains.php
msgid "Field that will replace the Full Name when creating a new user, taken from LDAP. (on windows: displayname) "
msgstr "Pole, ktoré nahradí celé meno pri vytváraní nového používateľa, prevzaté z LDAP. (vo Windows: displayname) "

#: include/global_settings.php package_import.php
msgid "Email"
msgstr "E-mail"

#: include/global_settings.php
msgid "Field that will replace the Email taken from LDAP. (on windows: mail)"
msgstr "Pole, ktoré nahradí e-mail prevzatý z LDAP. (vo Windows: mail)"

#: include/global_settings.php
msgid "URL Linking"
msgstr "Prepojenie URL"

#: include/global_settings.php
msgid "Server Base URL"
msgstr "Základná URL servera"

#: include/global_settings.php
msgid "This is the server location that will be used for links to the Kadupul site. This should include the subdirectory if Kadupul does not run from root folder."
msgstr "Toto je umiestnenie servera použité pre odkazy na lokalitu Kadupul. Malo by obsahovať podadresár, ak Kadupul nebeží z koreňového priečinka."

#: include/global_settings.php
msgid "Emailing Options"
msgstr "Možnosti e-mailov"

#: include/global_settings.php
msgid "Notify Primary Admin of Issues"
msgstr "Upozorniť primárneho správcu na problémy"

#: include/global_settings.php
msgid "In cases where the Kadupul server is experiencing problems, should the Primary Administrator be notified by Email?  The Primary Administrator's Kadupul user account is specified under the Authentication tab on Kadupul's settings page. It defaults to the 'admin' account."
msgstr "Ak má server Kadupul problémy, má byť primárny správca upozornený e-mailom?  Používateľský účet primárneho správcu Kadupul sa určuje na karte Overovanie na stránke nastavení Kadupul. Štandardne je to účet 'admin'."

#: include/global_settings.php
msgid "Test Email"
msgstr "Testovací e-mail"

#: include/global_settings.php
msgid "This is an Email account used for sending a test message to ensure everything is working properly."
msgstr "Toto je e-mailový účet použitý na odoslanie testovacej správy, aby sa zaistilo, že všetko funguje správne."

#: include/global_settings.php
msgid "Mail Services"
msgstr "Poštové služby"

#: include/global_settings.php
msgid "Which mail service to use in order to send mail"
msgstr "Ktorá poštová služba sa má použiť na odosielanie pošty"

#: include/global_settings.php
msgid "Ping Mail Server"
msgstr "Ping poštového servera"

#: include/global_settings.php
msgid "Ping the Mail Server before sending test Email?"
msgstr "Má sa pred odoslaním testovacieho e-mailu vykonať ping poštového servera?"

#: include/global_settings.php lib/html_reports.php
msgid "From Email Address"
msgstr "E-mailová adresa odosielateľa"

#: include/global_settings.php
msgid "This is the Email address that the Email will appear from."
msgstr "Toto je e-mailová adresa, z ktorej sa e-mail zobrazí."

#: include/global_settings.php lib/html_reports.php
msgid "From Name"
msgstr "Meno odosielateľa"

#: include/global_settings.php
msgid "This is the actual name that the Email will appear from."
msgstr "Toto je skutočné meno, z ktorého sa e-mail zobrazí."

#: include/global_settings.php
msgid "Word Wrap"
msgstr "Zalamovanie riadkov"

#: include/global_settings.php
msgid "This is how many characters will be allowed before a line in the Email is automatically word wrapped. (0 = Disabled)"
msgstr "Toto určuje, koľko znakov je povolených, kým sa riadok v e-maile automaticky zalomí. (0 = zakázané)"

#: include/global_settings.php
msgid "Sendmail Options"
msgstr "Možnosti Sendmail"

#: include/global_settings.php lib/functions.php
msgid "Sendmail Path"
msgstr "Cesta k Sendmail"

#: include/global_settings.php
msgid "This is the path to sendmail on your server. (Only used if Sendmail is selected as the Mail Service)"
msgstr "Toto je cesta k sendmail na vašom serveri. (Používa sa iba vtedy, ak je ako poštová služba vybraný Sendmail)"

#: include/global_settings.php
msgid "SMTP Options"
msgstr "Možnosti SMTP"

#: include/global_settings.php
msgid "SMTP Hostname"
msgstr "Názov hostiteľa SMTP"

#: include/global_settings.php
