msgstr "FATAL: Argumenty outlier-start a outlier-end musia byť vo formáte YYYY-MM-DD HH:MM alebo unixová časová pečiatka."

#: lib/spikekill.php
msgid "FATAL: The number of outliers to exclude must be a positive integer."
msgstr "FATAL: Počet vylúčených odľahlých hodnôt musí byť kladné celé číslo."

#: lib/spikekill.php
msgid "FATAL: Percent deviation must be a positive floating point number."
msgstr "FATAL: Percentuálna odchýlka musí byť kladné desatinné číslo."

#: lib/spikekill.php
msgid "FATAL: Number of spikes to remove must be a positive integer"
msgstr "FATAL: Počet odstraňovaných špičiek musí byť kladné celé číslo"

#: lib/spikekill.php
msgid "FATAL: Outlier time range requires outlier-start and outlier-end to be specified."
msgstr "FATAL: Časový rozsah odľahlých hodnôt vyžaduje zadanie outlier-start a outlier-end."

#: lib/spikekill.php
msgid "FATAL: Outlier time range requires outlier-start to be less than outlier-end."
msgstr "FATAL: Časový rozsah odľahlých hodnôt vyžaduje, aby outlier-start bol menší ako outlier-end."

#: lib/spikekill.php
msgid "FATAL: The 'float' removal method requires the specification of a start and end date."
msgstr "FATAL: Metóda odstránenia 'float' vyžaduje zadanie dátumu začiatku a konca."

#: lib/spikekill.php
msgid "FATAL: The 'gapfill' removal method requires the specification of a start and end date."
msgstr "FATAL: Metóda odstránenia 'gapfill' vyžaduje zadanie dátumu začiatku a konca."

#: lib/spikekill.php
msgid "FATAL: You must specify either 'last', 'avg' or 'nan' as a replacement method."
msgstr "FATAL: Ako metódu nahradenia musíte zadať 'last', 'avg' alebo 'nan'."

