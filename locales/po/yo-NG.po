msgid "<b>Note:</b> System Graph Policy is 'Device' meaning the User must have access to the Graph or Device to gain access to the Graph"
msgstr "<b>Àkíyèsí:</b> Ìlànà Àwòrán ìtọ́ka Ètò jẹ́ 'Ẹ̀rọ', tó túmọ̀ sí pé Olùlò gbọ́dọ̀ ní àǹfààní sí Àwòrán ìtọ́ka tàbí Ẹ̀rọ láti rí Àwòrán ìtọ́ka náà"

#: user_admin.php user_group_admin.php
msgid "<b>Note:</b> System Graph Policy is 'Graph Template' meaning the User must have access to the Graph or Graph Template to gain access to the Graph"
msgstr "<b>Àkíyèsí:</b> Ìlànà Àwòrán ìtọ́ka Ètò jẹ́ 'Àdàkọ Àwòrán ìtọ́ka', tó túmọ̀ sí pé Olùlò gbọ́dọ̀ ní àǹfààní sí Àwòrán ìtọ́ka tàbí Àdàkọ Àwòrán ìtọ́ka láti rí Àwòrán ìtọ́ka náà"

#: user_admin.php user_group_admin.php
msgid "<b>Note:</b> System Graph Policy is 'Permissive' meaning the User must have access to at least one of Graph, Device, or Graph Template to gain access to the Graph"
msgstr "<b>Àkíyèsí:</b> Ìlànà Àwòrán ìtọ́ka Ètò jẹ́ 'Gbígbààyè', tó túmọ̀ sí pé Olùlò gbọ́dọ̀ ní àǹfààní sí o kéré jù ọ̀kan nínú Àwòrán ìtọ́ka, Ẹ̀rọ, tàbí Àdàkọ Àwòrán ìtọ́ka láti rí Àwòrán ìtọ́ka náà"

#: user_admin.php user_group_admin.php
msgid "<b>Note:</b> System Graph Policy is 'Restrictive' meaning the User must have access to either the Graph or the Device and Graph Template to gain access to the Graph"
msgstr "<b>Àkíyèsí:</b> Ìlànà Àwòrán ìtọ́ka Ètò jẹ́ 'Ìdíwọ́', tó túmọ̀ sí pé Olùlò gbọ́dọ̀ ní àǹfààní sí yálà Àwòrán ìtọ́ka tàbí Ẹ̀rọ àti Àdàkọ Àwòrán ìtọ́ka láti rí Àwòrán ìtọ́ka náà"

