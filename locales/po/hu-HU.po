#: include/global_settings.php:854
msgid "Failure Count"
msgstr "Hibaszám"

#: include/global_settings.php:855
msgid "The number of polling intervals a Device must be down before logging an error and reporting Device as down."
msgstr "Hány lekérdezési időközön át kell leállva lennie egy eszköznek, mielőtt hibát naplóz és az eszközt leállként jelenti."

