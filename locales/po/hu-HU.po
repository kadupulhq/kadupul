msgstr "Válasszon egyedi nevet, amely ezt az adatot jelöli az RRDfile-on belül."

#: include/global_form.php
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "Minimális érték („U” = nincs minimum)"

#: include/global_form.php
