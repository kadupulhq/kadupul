msgstr "Munkaidő-beállítások"

#: include/global_settings.php
msgid "Start of Business Day"
msgstr "Munkanap kezdete"

#: include/global_settings.php
msgid "The time your business hours start. Format: hh:mm"
msgstr "A munkaidő kezdete. Formátum: hh:mm"

#: include/global_settings.php
msgid "End of Business Day"
msgstr "Munkanap vége"

#: include/global_settings.php
msgid "The time your business hours end. Format: hh:mm"
msgstr "A munkaidő vége. Formátum: hh:mm"

#: include/global_settings.php
msgid "Hide Weekends"
msgstr "Hétvégék elrejtése"

#: include/global_settings.php
msgid "Only show business hours during weekdays."
msgstr "A munkaidő megjelenítése csak hétköznapokon."

#: include/global_settings.php
msgid "Show business hours"
msgstr "Munkaidő megjelenítése"

#: include/global_settings.php
msgid "Display business hours on rrd graphs."
msgstr "A munkaidő megjelenítése az rrd grafikonokon."

#: include/global_settings.php
msgid "Color to use for business hours"
msgstr "A munkaidőhöz használandó szín"

