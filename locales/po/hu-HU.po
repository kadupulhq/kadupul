msgstr "Ha be van jelölve, a Cacti további LDAP-információkat naplóz a Cacti naplóba a csatlakozás és a keresés során."

#: include/global_settings.php:1807 user_domains.php:490
msgid "Encryption"
msgstr "Titkosítás"

#: include/global_settings.php:1808
