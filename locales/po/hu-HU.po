#, php-format
msgid "%s Thread"
msgstr "%s szál"

#: include/global_settings.php
#, php-format
msgid "%s Threads"
msgstr "%s szál"

#: include/global_settings.php
msgid "Re-index Method for Data Queries"
msgstr "Adatlekérdezések újraindexelési módszere"

