msgstr "Az RRDfile teljes útvonala."

#: include/global_form.php
msgid "The script/source used to gather data for this data source."
msgstr "Az adatforrás adatainak gyűjtésére használt szkript/forrás."

#: include/global_form.php package_import.php
msgid "Select the Data Source Profile.  The Data Source Profile controls polling interval, the data aggregation, and retention policy for the resulting Data Sources."
msgstr "Válassza ki az adatforrásprofilt.  Az adatforrásprofil szabályozza a lekérdezési intervallumot, az adataggregációt és a megőrzési szabályzatot a létrejövő adatforrásokhoz."

#: include/global_form.php
msgid "The amount of time in seconds between expected updates."
msgstr "A várt frissítések közötti idő másodpercben."

#: include/global_form.php
msgid "Data Source Active"
msgstr "Adatforrás aktív"

#: include/global_form.php
msgid "Whether Kadupul should gather data for this data source or not."
msgstr "Gyűjtsön-e a Kadupul adatokat ehhez az adatforráshoz."

#: include/global_form.php
msgid "Internal Data Source Name"
msgstr "Belső adatforrásnév"

#: include/global_form.php
