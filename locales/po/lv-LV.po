msgstr "Maksimālais laiks, cik ilgi Kadupul datu avota statistikas skripts var darboties, neradot taimauta kļūdu un netiekot nogalināts."

#: include/global_settings.php:1381
msgid "RRDChecker Timeout"
msgstr "DNS noildze"

#: include/global_settings.php:1382
