#: automation_networks.php:574
msgid "Enable this Network Range."
msgstr "ಈ ನೆಟ್‌ವರ್ಕ್ ವ್ಯಾಪ್ತಿಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."

#: automation_networks.php:579
msgid "Enable NetBIOS"
msgstr "NetBIOS ಸಕ್ರಿಯಗೊಳಿಸಿ"

#: automation_networks.php:580
msgid "Use NetBIOS to attempt to resolve the hostname of up hosts."
msgstr "ಸಕ್ರಿಯವಾಗಿರುವ ಹೋಸ್ಟ್‌ಗಳ ಹೋಸ್ಟ್‌ಹೆಸರನ್ನು ಪರಿಹರಿಸಲು NetBIOS ಅನ್ನು ಬಳಸಿ."

#: automation_networks.php:586
msgid "Automatically Add to Cacti"
msgstr "Cacti ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸೇರಿಸಿ"

#: automation_networks.php:587
msgid "For any newly discovered Devices that are reachable using SNMP and who match a Device Rule, add them to Cacti."
msgstr "SNMP ಬಳಸಿ ತಲುಪಬಹುದಾದ ಮತ್ತು ಸಾಧನ ನಿಯಮಕ್ಕೆ ಹೊಂದುವ ಯಾವುದೇ ಹೊಸದಾಗಿ ಪತ್ತೆಯಾದ ಸಾಧನಗಳನ್ನು Cacti ಗೆ ಸೇರಿಸಿ."

#: automation_networks.php:592
msgid "Allow same sysName on different hosts"
msgstr "ವಿಭಿನ್ನ ಹೋಸ್ಟ್‌ಗಳಲ್ಲಿ ಒಂದೇ sysName ಅನ್ನು ಅನುಮತಿಸಿ"

#: automation_networks.php:593
msgid "When discovering devices, allow duplicate sysnames to be added on different hosts"
msgstr "ಸಾಧನಗಳನ್ನು ಪತ್ತೆಹಚ್ಚುವಾಗ, ವಿಭಿನ್ನ ಹೋಸ್ಟ್‌ಗಳಲ್ಲಿ ನಕಲು sysName ಗಳನ್ನು ಸೇರಿಸಲು ಅನುಮತಿಸಿ"

#: automation_networks.php:598
msgid "Rerun Data Queries"
msgstr "ಡೇಟಾ ಕ್ವೆರಿಗಳನ್ನು ಮರುಚಾಲನೆ ಮಾಡಿ"

#: automation_networks.php:599
msgid "If a device previously added to Cacti is found, rerun its data queries."
msgstr "ಈ ಹಿಂದೆ Cacti ಗೆ ಸೇರಿಸಲಾದ ಸಾಧನ ಕಂಡುಬಂದರೆ, ಅದರ ಡೇಟಾ ಕ್ವೆರಿಗಳನ್ನು ಮರುಚಾಲನೆ ಮಾಡಿ."

#: automation_networks.php:604
msgid "Notification Settings"
msgstr "ಅಧಿಸೂಚನೆ ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

#: automation_networks.php:609
msgid "Notification Enabled"
msgstr "ಅಧಿಸೂಚನೆ ಸಕ್ರಿಯವಾಗಿದೆ"

#: automation_networks.php:610
msgid "If checked, when the Automation Network is scanned, a report will be sent to the Notification Email account.."
msgstr "ಪರಿಶೀಲಿಸಿದರೆ, ಸ್ವಯಂಚಾಲನ ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿದಾಗ, ಅಧಿಸೂಚನೆ ಇಮೇಲ್ ಖಾತೆಗೆ ವರದಿಯನ್ನು ಕಳುಹಿಸಲಾಗುತ್ತದೆ.."

#: automation_networks.php:616
msgid "Notification Email"
msgstr "ಅಧಿಸೂಚನೆ ಇಮೇಲ್"

#: automation_networks.php:617
msgid "The Email account to be used to send the Notification Email to."
msgstr "ಅಧಿಸೂಚನೆ ಇಮೇಲ್ ಅನ್ನು ಕಳುಹಿಸಬೇಕಾದ ಇಮೇಲ್ ಖಾತೆ."

#: automation_networks.php:624
msgid "Notification From Name"
msgstr "ಅಧಿಸೂಚನೆ ಕಳುಹಿಸುವವರ ಹೆಸರು"

#: automation_networks.php:625
msgid "The Email account name to be used as the senders name for the Notification Email.  If left blank, Cacti will use the default Automation Notification Name if specified, otherwise, it will use the Cacti system default Email name"
msgstr "ಅಧಿಸೂಚನೆ ಇಮೇಲ್‌ಗೆ ಕಳುಹಿಸುವವರ ಹೆಸರಾಗಿ ಬಳಸಬೇಕಾದ ಇಮೇಲ್ ಖಾತೆಯ ಹೆಸರು.  ಖಾಲಿ ಬಿಟ್ಟರೆ, ನಿರ್ದಿಷ್ಟಪಡಿಸಿದ್ದರೆ Cacti ಡೀಫಾಲ್ಟ್ ಸ್ವಯಂಚಾಲನ ಅಧಿಸೂಚನೆ ಹೆಸರನ್ನು ಬಳಸುತ್ತದೆ, ಇಲ್ಲದಿದ್ದರೆ Cacti ಸಿಸ್ಟಮ್ ಡೀಫಾಲ್ಟ್ ಇಮೇಲ್ ಹೆಸರನ್ನು ಬಳಸುತ್ತದೆ"

#: automation_networks.php:633
msgid "Notification From Email Address"
msgstr "ಅಧಿಸೂಚನೆ ಕಳುಹಿಸುವವರ ಇಮೇಲ್ ವಿಳಾಸ"

#: automation_networks.php:634
msgid "The Email Address to be used as the senders Email for the Notification Email.  If left blank, Cacti will use the default Automation Notification Email Address if specified, otherwise, it will use the Cacti system default Email Address"
msgstr "ಅಧಿಸೂಚನೆ ಇಮೇಲ್‌ಗೆ ಕಳುಹಿಸುವವರ ಇಮೇಲ್ ಆಗಿ ಬಳಸಬೇಕಾದ ಇಮೇಲ್ ವಿಳಾಸ.  ಖಾಲಿ ಬಿಟ್ಟರೆ, ನಿರ್ದಿಷ್ಟಪಡಿಸಿದ್ದರೆ Cacti ಡೀಫಾಲ್ಟ್ ಸ್ವಯಂಚಾಲನ ಅಧಿಸೂಚನೆ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ಬಳಸುತ್ತದೆ, ಇಲ್ಲದಿದ್ದರೆ Cacti ಸಿಸ್ಟಮ್ ಡೀಫಾಲ್ಟ್ ಇಮೇಲ್ ವಿಳಾಸವನ್ನು ಬಳಸುತ್ತದೆ"

