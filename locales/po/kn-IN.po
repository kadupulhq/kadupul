msgstr "ಈ ಐಟಂನ ಡೇಟಾವನ್ನು ಗ್ರಾಫ್‌ನಲ್ಲಿ ದೃಶ್ಯವಾಗಿ ಹೇಗೆ ಪ್ರತಿನಿಧಿಸಲಾಗುತ್ತದೆ."

#: include/global_form.php:986
msgid "The data source to use for this graph item."
msgstr "ಈ ಗ್ರಾಫ್ ಐಟಂಗೆ ಬಳಸಬೇಕಾದ ಡೇಟಾ ಮೂಲ."

#: include/global_form.php:993
