msgstr "ಗ್ರಾಫ್ ಅಥವಾ ಲೆಜೆಂಡ್‌ನಲ್ಲಿ ಈ ಐಟಂಗೆ ಅನ್ವಯಿಸಬೇಕಾದ CDEF (ಗಣಿತ) ಫಂಕ್ಷನ್."

#: include/global_form.php:1018
msgid "VDEF Function"
msgstr "VDEF ಫಂಕ್ಷನ್"

