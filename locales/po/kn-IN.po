msgstr "Kadupul ಸರ್ವರ್ ಸಮಯವಲಯ"

#: include/global_settings.php
msgid "My Browser's Timezone"
msgstr "ನನ್ನ ಬ್ರೌಸರ್‌ನ ಸಮಯವಲಯ"

