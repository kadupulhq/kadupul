msgstr "ಕನ್ಸಾಲಿಡೇಶನ್ ಫಂಕ್ಷನ್"

#: include/global_form.php:1007
msgid "How data for this item is represented statistically on the graph."
msgstr "ಈ ಐಟಂನ ಡೇಟಾವನ್ನು ಗ್ರಾಫ್‌ನಲ್ಲಿ ಅಂಕಿಅಂಶವಾಗಿ ಹೇಗೆ ಪ್ರತಿನಿಧಿಸಲಾಗುತ್ತದೆ."

