#: lib/spikekill.php
msgid "FATAL: Standard Deviation must be a positive integer."
msgstr "ಮಾರಕ: ಪ್ರಮಾಣಿತ ವಿಚಲನೆ ಧನಾತ್ಮಕ ಪೂರ್ಣಾಂಕವಾಗಿರಬೇಕು."

#: lib/spikekill.php
