msgstr "Nếu trường này phải được xử lý đặc biệt bởi các mẫu máy chủ, hãy chỉ ra ở đây. Từ khóa hợp lệ cho trường này là %s"

#: include/global_form.php:516
msgid "The name given to this data template."
msgstr "Tên được đặt cho mẫu dữ liệu này."

#: include/global_form.php:557
msgid "Choose a name for this data source.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "Chọn tên cho nguồn dữ liệu này. Nó có thể bao gồm các biến thay thế, chẳng hạn như | host_description | hoặc | query_fieldName |. Để biết danh sách đầy đủ các thẻ thay thế được hỗ trợ, vui lòng xem tài liệu Kadupul."

#: include/global_form.php:561
msgid "Data Source Path"
msgstr "Đường dẫn nguồn dữ liệu"

#: include/global_form.php:566
msgid "The full path to the RRDfile."
msgstr "Đường dẫn đầy đủ đến RRDfile."

#: include/global_form.php:575
