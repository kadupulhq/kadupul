msgstr "Cung cấp cho chủ nhà này một mô tả có ý nghĩa."

#: include/global_form.php:1177 include/global_form.php:1748
msgid "Fully qualified hostname or IP address for this device."
msgstr "Tên máy chủ hoặc địa chỉ IP đủ điều kiện cho thiết bị này."

#: include/global_form.php:1185
msgid "The physical location of the Device.  This free form text can be a room, rack location, etc."
msgstr "Vị trí vật lý của Thiết bị. Văn bản mẫu miễn phí này có thể là một căn phòng, vị trí giá, vv"

#: include/global_form.php:1194
msgid "Poller Association"
msgstr "Hiệp hội xe đẩy"

