msgstr "KUFANELE USHINTSHE NGESANDLA ISIZINDALWAZI SAKWA-KADUPUL UKUZE UBUYISELE NOMA YILUPHI USHINTSHO LOKUTHUTHUKISA OLWENZIWE.<br/>ISIFAKI ASINAYO INDLELA YOKWENZA LOKHU NGOKUZENZAKALELAYO NGAWE"

#: lib/installer.php
msgid "You <b>MUST</b> also import MySQL TimeZone information into MySQL and grant the Kadupul user SELECT access to the mysql.time_zone_name table"
msgstr "<b>KUFANELE</b> futhi ungenise ulwazi lwe-MySQL TimeZone ku-MySQL futhi unikeze umsebenzisi we-Kadupul ukufinyelela kwe-SELECT kuthebula le-mysql.time_zone_name"

#: lib/installer.php
msgid "You <b>MUST</b> then update \"include/config.php\" to point to the new database."
msgstr "Khona-ke <b>KUFANELE</b> ubuyekeze i-\"include/config.php\" ukuze ikhombe kusizindalwazi esisha."

#: lib/installer.php
msgid "You appear to be downgrading to a previous version.  Database changes made for the newer version will not be reversed and <i>could</i> cause issues."
msgstr "Ubonakala wehlisela enguqulweni yangaphambilini.  Izinguquko zesizindalwazi ezenzelwe inguqulo entsha ngeke zibuyiselwe emuva futhi <i>zingadala</i> izinkinga."

#: lib/installer.php
#, php-format
msgid "You are attempting to install Kadupul %s onto a 0.6.x database. Unfortunately, this can not be performed."
msgstr "Uzama ukufaka i-Kadupul %s kusizindalwazi se-0.6.x. Ngeshwa, lokhu akukwazi ukwenziwa."

#: lib/installer.php
msgid "You have created a new database, but have not yet imported the 'cacti.sql' file. At the command line, execute the following to continue:"
