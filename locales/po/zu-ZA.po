#: lib/installer.php
#, php-format
msgid "You have more tables than your PHP configuration will allow us to display/convert.  Please modify the max_input_vars setting in php.ini to a value above %s"
msgstr "Unamathebula amaningi kunalokho ukulungiselelwa kwakho kwe-PHP okungasivumela ukuthi sikubonise/sikuguqule.  Sicela uguqule isilungiselelo se-max_input_vars ku-php.ini sibe inani elingaphezu kuka-%s"

#: lib/installer.php
msgid "Your Kadupul Server is almost ready.  Please check that you are happy to proceed."
