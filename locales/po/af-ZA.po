msgid "User Template"
msgstr "Gebruikersjabloon"

#: include/global_settings.php
msgid "User defined number of lines for the CLOG to tail when selecting 'All lines'."
msgstr "Gebruikergedefinieerde aantal lyne vir die CLOG om te lees wanneer 'Alle lyne' gekies word."

#: include/global_settings.php
