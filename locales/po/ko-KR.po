msgstr "이  %s 필드의 이름을 입력하십시오. 주 : 스크립트에서 이름 값 쌍 (예 : NAME : VALUE)을 사용하는 경우, 이름이 스크립트 출력 이름과 동일하게 출력 필드 이름과 일치해야합니다."

#: include/global_form.php:456
msgid "Update RRDfile"
msgstr "RRDfile 업데이트"

#: include/global_form.php:457
msgid "Whether data from this output field is to be entered into the RRDfile."
msgstr "이 출력 필드의 데이터를 RRD 파일에 입력할지 여부."

#: include/global_form.php:464
msgid "Regular Expression Match"
msgstr "정규식 일치"

#: include/global_form.php:465
msgid "If you want to require a certain regular expression to be matched against input data, enter it here (preg_match format)."
msgstr "특정 정규식이 입력 데이터와 일치하도록 요구하려면 여기에 입력하십시오 (preg_match 형식)."

#: include/global_form.php:472
msgid "Allow Empty Input"
msgstr "빈 입력 허용"

#: include/global_form.php:473
msgid "Check here if you want to allow NULL input in this field from the user."
msgstr "사용자가이 필드에 NULL 입력을 허용하려면 여기를 선택하십시오."

#: include/global_form.php:480
msgid "Special Type Code"
msgstr "특수 유형 코드"

#: include/global_form.php:481
#, php-format
msgid "If this field should be treated specially by host templates, indicate so here. Valid keywords for this field are %s"
msgstr "이 입력란을 호스트 템플릿별로 특별히 처리해야하는 경우 여기에서 지정하십시오. 이 입력란에 사용할 수있는 키워드는  %s입니다."

#: include/global_form.php:513
msgid "The name given to this data template."
msgstr "이 데이터 템플릿에 주어진 이름입니다."

#: include/global_form.php:554
msgid "Choose a name for this data source.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "이 데이터 소스의 이름을 선택하십시오. | host_description |과 같은 대체 변수를 포함 할 수 있습니다. 또는 | query_fieldName |. 지원되는 대체 태그의 전체 목록을 보려면 Kadupul 설명서를 참조하십시오."

#: include/global_form.php:558
msgid "Data Source Path"
msgstr "데이터 소스 경로"

#: include/global_form.php:563
msgid "The full path to the RRDfile."
msgstr "RRDfile에 대한 전체 경로입니다."

#: include/global_form.php:572
msgid "The script/source used to gather data for this data source."
msgstr "이 데이터 소스에 대한 데이터를 수집하는 데 사용 된 스크립트 / 소스."

#: include/global_form.php:578 include/global_form.php:1685
#: package_import.php:872
msgid "Select the Data Source Profile.  The Data Source Profile controls polling interval, the data aggregation, and retention policy for the resulting Data Sources."
msgstr "데이터 원본 프로필을 선택하십시오. 데이터 원본 프로필은 결과 데이터 원본에 대한 폴링 간격, 데이터 집계 및 보유 정책을 제어합니다."

#: include/global_form.php:589
msgid "The amount of time in seconds between expected updates."
msgstr "예상 업데이트 간격을 초 단위로 지정합니다."

#: include/global_form.php:593
msgid "Data Source Active"
msgstr "데이터 소스 활성"

#: include/global_form.php:597
msgid "Whether Kadupul should gather data for this data source or not."
msgstr "Kadupul가이 데이터 소스에 대한 데이터를 수집해야하는지 여부."

#: include/global_form.php:605
msgid "Internal Data Source Name"
msgstr "내부 데이터 소스 이름"

#: include/global_form.php:610
msgid "Choose unique name to represent this piece of data inside of the RRDfile."
msgstr "고유 한 이름을 선택하여 RRD 파일 내부에서이 데이터 부분을 나타냅니다."

#: include/global_form.php:613
msgid "Minimum Value (\"U\" for No Minimum)"
msgstr "최소값 (최소값은 &quot;U&quot;)"

#: include/global_form.php:618
msgid "The minimum value of data that is allowed to be collected."
msgstr "수집 할 수있는 데이터의 최소값."

#: include/global_form.php:621
msgid "Maximum Value (\"U\" for No Maximum)"
msgstr "최대 값 (최대 값이없는 경우 &quot;U&quot;)"

#: include/global_form.php:626
msgid "The maximum value of data that is allowed to be collected."
msgstr "수집 할 수있는 데이터의 최대 값."

#: include/global_form.php:629
msgid "Data Source Type"
msgstr "데이터 소스 유형"

#: include/global_form.php:633
msgid "How data is represented in the RRA."
msgstr "RRA에서 데이터가 표현되는 방식."

#: include/global_form.php:641
msgid "The maximum amount of time that can pass before data is entered as 'unknown'. (Usually 2x300=600)"
msgstr "데이터가 &#39;알 수 없음&#39;으로 입력되기 전에 통과 할 수있는 최대 시간. (보통 2x300 = 600)"

#: include/global_form.php:647 lib/html_utility.php:280
msgid "Not Selected"
msgstr "선택되지 않은"

#: include/global_form.php:648
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "데이터가 수집되면이 필드의 데이터가이 데이터 소스에 저장됩니다."

#: include/global_form.php:657
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "이 GPRINT 사전 설정의 이름을 입력하고 사용자가 인식 할 수있는 값인지 확인하십시오."

#: include/global_form.php:664
msgid "GPRINT Text"
msgstr "GPRINT 텍스트"

#: include/global_form.php:665
msgid "Enter the custom GPRINT string here."
msgstr "여기에 사용자 정의 GPRINT 문자열을 입력하십시오."

#: include/global_form.php:683
msgid "Common Options"
msgstr "공통 옵션"

#: include/global_form.php:688
msgid "Title (--title)"
msgstr "제목 (- 제목)"

#: include/global_form.php:692
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "그래프에 인쇄 된 이름입니다. | host_description |과 같은 대체 변수를 포함 할 수 있습니다. 또는 | query_fieldName |. 지원되는 대체 태그의 전체 목록을 보려면 Kadupul 설명서를 참조하십시오."

#: include/global_form.php:696
msgid "Vertical Label (--vertical-label)"
msgstr "세로 레이블 (- 수직 레이블)"

#: include/global_form.php:700
msgid "The label vertically printed to the left of the graph."
msgstr "그래프 왼쪽에 수직으로 인쇄 된 라벨입니다."

#: include/global_form.php:704
msgid "Image Format (--imgformat)"
msgstr "이미지 형식 (--imgformat)"

#: include/global_form.php:708
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "생성 된 그래프의 유형. PNG, GIF 또는 SVG. 그래프 이미지 유형의 선택은 매우 RRDtool에 의존합니다."

#: include/global_form.php:711
msgid "Height (--height)"
msgstr "높이 (- 높이)"

#: include/global_form.php:715
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "그래프 내의 그래프 영역의 높이 (픽셀 단위)입니다. 이 영역에는 범례, 축 범례 또는 제목이 포함되지 않습니다."

#: include/global_form.php:719
msgid "Width (--width)"
msgstr "너비 (- 폭)"

#: include/global_form.php:723
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "그래프 내의 그래프 영역의 폭 (픽셀 단위)입니다. 이 영역에는 범례, 축 범례 또는 제목이 포함되지 않습니다."

#: include/global_form.php:727
msgid "Base Value (--base)"
msgstr "기본 값 (--base)"

#: include/global_form.php:731
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "메모리는 1024, 트래픽 측정은 1000으로 설정해야합니다."

#: include/global_form.php:735
msgid "Slope Mode (--slope-mode)"
msgstr "슬로프 모드 (- 슬로프 - 모드)"

#: include/global_form.php:739
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "기울기 모드를 사용하면 그래프의 모양이 균일 해지고 화면 해상도가 저하됩니다."

#: include/global_form.php:742
msgid "Scaling Options"
msgstr "크기 조정 옵션"

#: include/global_form.php:747
msgid "Auto Scale"
msgstr "자동 크기"

#: include/global_form.php:751
msgid "Auto scale the y-axis instead of defining an upper and lower limit. Note: if this is check both the Upper and Lower limit will be ignored."
msgstr "상한과 하한을 정의하는 대신 y 축을 자동으로 조절합니다. 참고 : 이것이 확인되면 상한과 하한 모두 무시됩니다."

#: include/global_form.php:755
msgid "Auto Scale Options"
msgstr "자동 스케일 옵션"

#: include/global_form.php:758
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "용도 <br> --alt-autoscale을 절대 최소값과 최대 값으로 확장합니다. <br> --alt-autoscale-max : 주어진 하한을 사용하여 최대 값으로 스케일합니다. <br> 주어진 상한을 사용하여 --alt-autoscale-min을 최소값으로 조정합니다. <br> --alt-autoscale (제한 있음) - 상한 및 하한 모두를 사용하여 축척 (RRDtool 기본값) <br>"

#: include/global_form.php:762
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "--alt-autoscale을 사용하십시오 (주어진 제한 무시)."

#: include/global_form.php:766
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "--alt-autoscale-max (하한 허용)를 사용하십시오."

#: include/global_form.php:770
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "--alt-autoscale-min을 사용하십시오 (상한값 허용)."

#: include/global_form.php:774
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "--alt-autoscale을 사용하십시오 (RRDtool 기본값 두 가지 모두 허용)."

#: include/global_form.php:779
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "로그 스케일링 (- 로그)"

#: include/global_form.php:783
msgid "Use Logarithmic y-axis scaling"
msgstr "로그 y 축 스케일링 사용"

#: include/global_form.php:786
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "대수 스케일링을위한 SI 단위 (--units = si)"

#: include/global_form.php:789
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "지수 표기법 대신에 로그 스케일링에 SI 단위를 사용하십시오. <br> 참고 : 선형 그래프는 기본적으로 SI 표기법을 사용합니다."

#: include/global_form.php:792
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "경직된 경계 모드 (-rigid)"

#: include/global_form.php:795
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "그래프에 유효한 범위를 벗어나는 값이 포함 된 경우 상한 및 하한을 확장하지 마십시오."

#: include/global_form.php:798
msgid "Upper Limit (--upper-limit)"
msgstr "상한 (- 상한)"

#: include/global_form.php:802
msgid "The maximum vertical value for the graph."
msgstr "그래프의 수직 최대치입니다."

#: include/global_form.php:806
msgid "Lower Limit (--lower-limit)"
msgstr "하한선 (- 하한선)"

#: include/global_form.php:810
msgid "The minimum vertical value for the graph."
msgstr "그래프의 최소 수직 치"

#: include/global_form.php:814
msgid "Grid Options"
msgstr "그리드 옵션"

#: include/global_form.php:819
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "단위 그리드 값 (--unit / - y-grid)"

#: include/global_form.php:823
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "숫자에 대한 Y 축의 지수 값을 설정합니다. 참고 :이 옵션은 더 이상 사용되지 않으며 --y-grid 옵션으로 대체됩니다. 이 옵션에서는 Y 축 모눈 선이 각 모눈 간격 간격으로 나타납니다. 레이블은 모든 레이블 요소 행에 배치됩니다."

#: include/global_form.php:827
msgid "Unit Exponent Value (--units-exponent)"
msgstr "단위 지수 값 (--units-exponent)"

#: include/global_form.php:831
msgid "What unit Kadupul should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Kadupul가 Y 축에서 사용해야하는 단위. 모든 것을 &quot;k&quot;또는 -6으로 표시하려면 3을 사용하여 &quot;u&quot;(마이크로)로 모든 것을 표시하십시오."

#: include/global_form.php:835
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "단위 길이 (--units-length &lt;length&gt;)"

#: include/global_form.php:840
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "RRDtool에서 y 축 레이블을 몇 자리로 가정해야합니까? y 축 레이블링을 시작한 후에 충분한 공간을 확보하려면이 옵션을 사용해야 할 수도 있습니다."

#: include/global_form.php:843
msgid "No Gridfit (--no-gridfit)"
msgstr "Gridfit 없음 (--no-gridfit)"

#: include/global_form.php:846
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "에일 리어 징 제거 (anti-aliasing) 흐림 효과를 피하기 위해 RRDtool은 장치 해상도 픽셀을 가리키고 스냅 샷을보다 선명하게 만듭니다. 원하는대로 설정하지 않으면이 스위치를 사용하여이 동작을 끌 수 있습니다. <br> <strong>참고 :</strong> PDF, EPS, SVG 출력의 경우 기본적으로 격자 맞춤이 해제되어 있습니다."

#: include/global_form.php:849
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "대체 Y 그리드 (-alt-y- 그리드)"

#: include/global_form.php:852
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "알고리즘을 사용하면 항상 그리드가 있고, 그리드 선이 충분하고 그리 많지는 않지만 그리드가 미터법이라는 것을 보장합니다. 이 매개 변수는 그래프가 69.998에서 70.001로 변할지라도 충분한 십진수가 표시되도록합니다. <br> <strong>참고 :</strong> 이 매개 변수는 --alt-autoscale 옵션을 방해 할 수 있습니다."

#: include/global_form.php:855
msgid "Axis Options"
msgstr "축 옵션"

#: include/global_form.php:860
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "오른쪽 축 (- 오른쪽 축 &lt;scale : shift&gt;)"

#: include/global_form.php:865
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "두 번째 축은 그래프 오른쪽에 그려집니다. 축척 및 이동 매개 변수를 통해 왼쪽 축에 연결됩니다."

#: include/global_form.php:868
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "오른쪽 축 레이블 (--right-axis-label &lt;string&gt;)"

#: include/global_form.php:873
msgid "The label for the right axis."
msgstr "오른쪽 축의 레이블입니다."

#: include/global_form.php:876
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "오른쪽 축 형식 (--right-axis-format &lt;format&gt;)"

#: include/global_form.php:881
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "기본적으로 축 레이블의 형식은 자동으로 결정됩니다. 직접하고 싶다면이 옵션을 PRINT와 GPRINT 명령에서 알 수있는 것과 같은 % lf 인수와 함께 사용하십시오."

#: include/global_form.php:884
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "오른쪽 축 포매터 (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php:889
msgid "When you setup the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "오른쪽 축 레이블을 설정할 때 데이터 형식에 규칙을 적용하십시오. 지원되는 형식은 데이터가 숫자로 처리되는 &quot;숫자&quot;, 값이 UNIX 시간 소인 (1970 년 1 월 이후의 초 수로 해석 됨) 및 strftime 형식으로 표시되는 &quot;시간 소인&quot;을 포함합니다 (기본값은 &quot;% Y- % m- % d % H : % M :  %s &quot;). --units-length 및 --right-axis-format도 참조하십시오. 마지막으로 &quot;duration&quot;값은 밀리 초 단위의 지속 기간으로 해석됩니다. 형식 지정은 valstrfduration 인증 된 PRINT / GPRINT의 규칙을 따릅니다."

#: include/global_form.php:892
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "왼쪽 축 포매터 (- 축 축 형식 지정자 &lt;형식 이름&gt;)"

#: include/global_form.php:897
msgid "When you setup the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "왼쪽 축 레이블을 설정할 때 데이터 형식에 규칙을 적용하십시오. 지원되는 형식은 데이터가 숫자로 처리되는 &quot;숫자&quot;, 값이 UNIX 시간 소인 (1970 년 1 월 이후의 초 수로 해석 됨) 및 strftime 형식으로 표시되는 &quot;시간 소인&quot;을 포함합니다 (기본값은 &quot;% Y- % m- % d % H : % M :  %s &quot;). --units-length도 참조하십시오. 마지막으로 &quot;duration&quot;값은 밀리 초 단위의 지속 기간으로 해석됩니다. 형식 지정은 valstrfduration 인증 된 PRINT / GPRINT의 규칙을 따릅니다."

