#: lib/installer.php utilities.php
msgid "WARNING:"
msgstr "ማስጠንቀቂያ:"

#: lib/installer.php
msgid "WARNING: Device Template for your Operating System Not Found.  You will need to import Device Templates or Kadupul Packages to monitor your Kadupul server."
msgstr "ማስጠንቀቂያ: ለሥርዓተ ክወናዎ የመሣሪያ አብነት አልተገኘም። የKadupul አገልጋይዎን ለመከታተል የመሣሪያ አብነቶችን ወይም የKadupul ጥቅሎችን ማስመጣት ያስፈልግዎታል።"

#: lib/installer.php
msgid "Web"
msgstr "ድር"

#: lib/installer.php
msgid "YOU MUST MANUALLY CHANGE THE KADUPUL DATABASE TO REVERT ANY UPGRADE CHANGES THAT HAVE BEEN MADE.<br/>THE INSTALLER HAS NO METHOD TO DO THIS AUTOMATICALLY FOR YOU"
msgstr "የተደረጉትን ማንኛውንም የማሻሻያ ለውጦች ለመመለስ የKADUPUL ውሂብ ጎታን በእጅ መለወጥ አለብዎት።<br/>መጫኛው ይህን በራስ-ሰር ለእርስዎ የሚያደርግበት ምንም ዘዴ የለውም"

#: lib/installer.php
msgid "You <b>MUST</b> also import MySQL TimeZone information into MySQL and grant the Kadupul user SELECT access to the mysql.time_zone_name table"
msgstr "እንዲሁም የMySQL TimeZone መረጃን ወደ MySQL ማስመጣት እና ለKadupul ተጠቃሚው ለmysql.time_zone_name ሠንጠረዥ የSELECT መዳረሻ መስጠት <b>አለብዎት</b>"

#: lib/installer.php
msgid "You <b>MUST</b> then update \"include/config.php\" to point to the new database."
msgstr "ከዚያም ወደ አዲሱ የውሂብ ጎታ ለመጠቆም \"include/config.php\" ን ማዘመን <b>አለብዎት</b>።"

#: lib/installer.php
msgid "You appear to be downgrading to a previous version.  Database changes made for the newer version will not be reversed and <i>could</i> cause issues."
msgstr "ወደ ቀዳሚው ስሪት ዝቅ እያደረጉ ያሉ ይመስላል። ለአዲሱ ስሪት የተደረጉ የውሂብ ጎታ ለውጦች አይመለሱም እና <i>ችግሮችን</i> ሊያስከትሉ ይችላሉ።"

#: lib/installer.php
#, php-format
msgid "You are attempting to install Kadupul %s onto a 0.6.x database. Unfortunately, this can not be performed."
msgstr "Kadupul %s ን በ0.6.x የውሂብ ጎታ ላይ ለመጫን እየሞከሩ ነው። እንደ አለመታደል ሆኖ፣ ይህ ሊከናወን አይችልም።"

#: lib/installer.php
msgid "You have created a new database, but have not yet imported the 'cacti.sql' file. At the command line, execute the following to continue:"
msgstr "አዲስ የውሂብ ጎታ ፈጥረዋል፣ ነገር ግን የ'cacti.sql' ፋይሉን ገና አላስመጡም። ለመቀጠል በትዕዛዝ መስመሩ ላይ የሚከተለውን ያስፈጽሙ:"

#: lib/installer.php
#, php-format
msgid "You have more tables than your PHP configuration will allow us to display/convert.  Please modify the max_input_vars setting in php.ini to a value above %s"
msgstr "የPHP ውቅርዎ እንድናሳይ/እንድንለውጥ ከሚፈቅደው በላይ ሠንጠረዦች አሉዎት። እባክዎ በphp.ini ውስጥ ያለውን max_input_vars ቅንብር ከ%s በላይ ወዳለ እሴት ይቀይሩት"

#: lib/installer.php
msgid "Your Kadupul Server is almost ready.  Please check that you are happy to proceed."
msgstr "የKadupul አገልጋይዎ ከሞላ ጎደል ዝግጁ ነው። እባክዎ ለመቀጠል ደስተኛ መሆንዎን ያረጋግጡ።"

#: lib/installer.php
msgid "Your Kadupul Server is now installing"
msgstr "የKadupul አገልጋይዎ አሁን እየተጫነ ነው"

#: lib/installer.php
#, php-format
msgid "Your Kadupul Server v%s has been installed/updated with errors"
msgstr "የKadupul አገልጋይዎ v%s ከስህተቶች ጋር ተጭኗል/ዘምኗል"

#: lib/installer.php
#, php-format
msgid "Your Kadupul Server v%s has been installed/updated.  You may now start using the software."
msgstr "የKadupul አገልጋይዎ v%s ተጭኗል/ዘምኗል። አሁን ሶፍትዌሩን መጠቀም መጀመር ይችላሉ።"

#: lib/installer.php
msgid "Your Kadupul configuration has the relative correct path (url_path) in config.php."
msgstr "የKadupul ውቅርዎ በconfig.php ውስጥ ትክክለኛው አንጻራዊ ዱካ (url_path) አለው።"

#: lib/installer.php
msgid "Your Kadupul database account has access to the MySQL TimeZone database and that database is populated with global TimeZone information."
msgstr "የKadupul የውሂብ ጎታ መለያዎ የMySQL TimeZone የውሂብ ጎታ መዳረሻ አለው እና ያ የውሂብ ጎታ በዓለም አቀፍ TimeZone መረጃ ተሞልቷል።"

#: lib/installer.php
msgid "Your Kadupul database login account does not have access to the MySQL TimeZone database.  Please provide the Kadupul database account \"select\" access to the \"time_zone_name\" table in the \"mysql\" database, and populate MySQL's TimeZone information before proceeding."
msgstr "የKadupul የውሂብ ጎታ መግቢያ መለያዎ የMySQL TimeZone የውሂብ ጎታ መዳረሻ የለውም። እባክዎ ለKadupul የውሂብ ጎታ መለያው በ\"mysql\" የውሂብ ጎታ ውስጥ ላለው \"time_zone_name\" ሠንጠረዥ \"select\" መዳረሻ ይስጡ እና ከመቀጠልዎ በፊት የMySQL TimeZone መረጃን ይሙሉ።"

#: lib/installer.php
msgid "Your MySQL TimeZone database is not populated.  Please populate this database before proceeding."
msgstr "የMySQL TimeZone የውሂብ ጎታዎ አልተሞላም። እባክዎ ከመቀጠልዎ በፊት ይህን የውሂብ ጎታ ይሙሉ።"

#: lib/installer.php
msgid "Your Remote Kadupul Poller information has not been included in your config.php file.  Please review the config.php.dist, and set the variables: <i>$rdatabase_default, $rdatabase_username</i>, etc.  These variables must be set and point back to your Primary Kadupul database server.  Correct this and try again."
msgstr "የርቀት Kadupul ሰብሳቢ መረጃዎ በconfig.php ፋይልዎ ውስጥ አልተካተተም። እባክዎ config.php.dist ን ይገምግሙ እና ተለዋዋጮቹን ያዘጋጁ: <i>$rdatabase_default, $rdatabase_username</i>፣ ወዘተ። እነዚህ ተለዋዋጮች መቀናበር እና ወደ ዋናው የKadupul የውሂብ ጎታ አገልጋይዎ መመለስ አለባቸው። ይህን ያስተካክሉ እና እንደገና ይሞክሩ።"

#: lib/installer.php
msgid "Your config.php file must be writable by the web server during install in order to configure the Remote poller.  Once installation is complete, you must set this file to Read Only to prevent possible security issues."
msgstr "የርቀት ሰብሳቢውን ለማዋቀር በመጫን ጊዜ config.php ፋይልዎ በድር አገልጋዩ ሊጻፍበት የሚችል መሆን አለበት። መጫኑ ከተጠናቀቀ በኋላ፣ ሊሆኑ የሚችሉ የደህንነት ችግሮችን ለመከላከል ይህን ፋይል ወደ ተነባቢ-ብቻ ማቀናበር አለብዎት።"

