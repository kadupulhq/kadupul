msgstr "Cacti በትክክል እንዲሰራ በርካታ የ PHP ሞጁሎች እንዲጫኑ ይፈልጋል። ከእነዚህ ውስጥ አንዱ ካልተጫነ፣ እስኪስተካከል ድረስ መጫኑን መቀጠል አይችሉም። በተጨማሪም፣ ለተመቻቸ የስርዓት አፈጻጸም Cacti የተወሰኑ የ MySQL ስርዓት ተለዋዋጮች ተዘጋጅተው መሄድ አለበት። እባክዎ የ MySQL ምክሮችን በራስዎ ፍላጎት ይከተሉ። ማንኛውም ጥያቄ ካለዎት ሁልጊዜ የ MySQL ሰነድን ይፈልጉ።"

#: lib/installer.php:2048
msgid "The following PHP extensions are mandatory, and MUST be installed before continuing your Cacti install."
msgstr "የሚከተሉት የPHP ቅጥያዎች አስገዳጅ ናቸው፣ እና የCacti መጫንዎን ከመቀጠልዎ በፊት መጫን አለባቸው።"

#: lib/installer.php:2052
msgid "Required PHP Modules"
msgstr "የሚያስፈልጉ የPHP ሞጁሎች"

#: lib/installer.php:2053 lib/installer.php:2083 plugins.php:43 plugins.php:499
msgid "Installed"
msgstr "ተጭኗል"

#: lib/installer.php:2053
msgid "Required"
msgstr "አስፈላጊ"

#: lib/installer.php:2076
