#: include/global_settings.php:2558
msgid "Max Kills Per RRA"
msgstr "Največ odstranitev na RRA"

#: include/global_settings.php:2559
msgid "This value represents the maximum number of spikes to remove from a Graph RRA."
msgstr "Ta vrednost predstavlja največje število konic, ki se odstranijo iz RRA grafa."

#: include/global_settings.php:2563 include/global_settings.php:2564
#: include/global_settings.php:2565 include/global_settings.php:2566
#: include/global_settings.php:2567 include/global_settings.php:2568
#: include/global_settings.php:2569 include/global_settings.php:2570
#: include/global_settings.php:2571 include/global_settings.php:2572
#: include/global_settings.php:2573 include/global_settings.php:2574
#, php-format
msgid "%d Spikes"
msgstr "%d konic"

#: include/global_settings.php:2578
msgid "RRDfile Backup Directory"
msgstr "Imenik varnostnih kopij RRDfile"

#: include/global_settings.php:2579
msgid "If this directory is not empty, then your original RRDfiles will be backed up to this location."
msgstr "Če ta imenik ni prazen, bodo vaše izvirne datoteke RRDfile varnostno kopirane na to mesto."

#: include/global_settings.php:2586
msgid "Batch Spike Kill Settings"
msgstr "Nastavitve paketnega Spike Kill"

#: include/global_settings.php:2591
msgid "Removal Schedule"
msgstr "Razpored odstranjevanja"

#: include/global_settings.php:2592
msgid "Do you wish to periodically remove spikes from your graphs?  If so, select the frequency below."
msgstr "Ali želite občasno odstranjevati konice z vaših grafov?  Če da, spodaj izberite pogostost."

#: include/global_settings.php:2599
msgid "Once a Day"
msgstr "Enkrat na dan"

#: include/global_settings.php:2600
msgid "Every Other Day"
msgstr "Vsak drugi dan"

#: include/global_settings.php:2604
msgid "Base Time"
msgstr "Osnovni čas"

#: include/global_settings.php:2605
