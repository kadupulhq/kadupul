msgstr "Pot do konfiguracijske datoteke Spine.  Privzeto v trenutnem delovnem imeniku Spine ali v /etc, če ni določena."

#: include/global_settings.php
msgid "RRDfile Auto Clean"
msgstr "Samodejno čiščenje RRDfile"

#: include/global_settings.php
