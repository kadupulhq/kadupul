msgstr "Omogoči preverjanje RRDfile"

#: include/global_settings.php
msgid "Should RRDfile check be enabled for this Kadupul system?"
msgstr "Ali naj bo preverjanje RRDfile omogočeno za ta sistem Kadupul?"

#: include/global_settings.php
msgid "Number of RRDfile Check Processes"
msgstr "Število procesov preverjanja RRDfile"

#: include/global_settings.php
