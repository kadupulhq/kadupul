msgstr "Revenire de la <strong>%s</strong> la <strong>%s</strong>"

#: lib/installer.php:2178
msgid "You appear to be downgrading to a previous version.  Database changes made for the newer version will not be reversed and <i>could</i> cause issues."
msgstr "Se pare că reveniți la o versiune anterioară.  Modificările bazei de date efectuate pentru versiunea mai nouă nu vor fi anulate și <i>pot</i> cauza probleme."

#: lib/installer.php:2183
msgid "Please select the type of installation"
msgstr "Selectați tipul de instalare"

