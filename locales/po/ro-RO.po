msgstr "Parola pentru bind-ul căutării specifice la directorul LDAP."

#: include/global_settings.php user_domains.php
msgid "LDAP CN Settings"
msgstr "Setări LDAP CN"

#: include/global_settings.php user_domains.php
msgid "Field that will replace the Full Name when creating a new user, taken from LDAP. (on windows: displayname) "
msgstr "Câmpul care va înlocui numele complet la crearea unui utilizator nou, preluat din LDAP. (în Windows: displayname) "

