#: include/global_settings.php
msgid "Enable Lotus Notes (R) tweak"
msgstr "Activare ajustare Lotus Notes (R)"

#: include/global_settings.php
msgid "Enable code tweak for specific handling of Lotus Notes Mail Clients."
msgstr "Activează o ajustare de cod pentru gestionarea specifică a clienților de e-mail Lotus Notes."

#: include/global_settings.php
msgid "DNS Options"
msgstr "Opțiuni DNS"

#: include/global_settings.php
msgid "Primary DNS IP Address"
msgstr "Adresa IP DNS primară"

#: include/global_settings.php
