msgstr "Acesta este numele real de la care va apărea e-mailul."

#: include/global_settings.php:1983
msgid "Word Wrap"
msgstr "Împărțire rânduri"

#: include/global_settings.php:1984
msgid "This is how many characters will be allowed before a line in the Email is automatically word wrapped. (0 = Disabled)"
msgstr "Acesta este numărul de caractere permise înainte ca o linie din e-mail să fie împărțită automat. (0 = dezactivat)"

#: include/global_settings.php:1991
msgid "Sendmail Options"
msgstr "Opțiuni Sendmail"

