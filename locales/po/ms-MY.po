msgstr "Port UDP Lalai untuk semua Peranti baharu.  Lazimnya 161."

#: include/global_settings.php
msgid "Timeout"
msgstr "Tamat Masa"

#: include/global_settings.php
msgid "Default SNMP timeout in milli-seconds for all new Devices."
msgstr "Tamat masa SNMP lalai dalam milisaat untuk semua Peranti baharu."

#: include/global_settings.php
msgid "Retries"
msgstr "Cuba Semula"

#: include/global_settings.php
