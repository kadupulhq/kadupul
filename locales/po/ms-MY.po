msgstr "Lebar Maksimum Pokok untuk mengembang, selepas itu, cabang Pokok akan tergulung pada halaman."

#: include/global_settings.php
msgid "Filter Settings"
msgstr "Tetapan Penapis"

#: include/global_settings.php
msgid "Strip Domains from Device Dropdowns"
msgstr "Buang Domain daripada Senarai Juntai Peranti"

#: include/global_settings.php
msgid "When viewing Device name filter dropdowns, checking this option will strip the domain from the hostname."
msgstr "Apabila melihat senarai juntai penapis nama Peranti, menandakan pilihan ini akan membuang domain daripada nama hos."

#: include/global_settings.php
msgid "Graph/Data Source/Data Query Settings"
msgstr "Tetapan Graf/Sumber Data/Pertanyaan Data"

#: include/global_settings.php
msgid "Maximum Title Length"
msgstr "Panjang Tajuk Maksimum"

#: include/global_settings.php
msgid "The maximum allowable Graph or Data Source titles."
msgstr "Tajuk Graf atau Sumber Data maksimum yang dibenarkan."

#: include/global_settings.php
msgid "Data Source Field Length"
msgstr "Panjang Medan Sumber Data"

#: include/global_settings.php
