msgid "Reporting Presets"
msgstr "Pratetap Pelaporan"

#: include/global_settings.php
msgid "Default Graph Image Format"
msgstr "Format Imej Graf Lalai"

#: include/global_settings.php
msgid "When creating a new report, what image type should be used for the inline graphs?"
msgstr "Apabila mencipta laporan baharu, jenis imej apakah yang patut digunakan untuk graf sebaris?"

#: include/global_settings.php
