msgstr "Se questa directory non è vuota, i vostri file RRD originali saranno salvati in questa posizione."

#: include/global_settings.php:2511
msgid "Batch Spike Kill Settings"
msgstr "Impostazioni di Batch Spike Kill"

#: include/global_settings.php:2516
msgid "Removal Schedule"
msgstr "Programma di rimozione"

