#: lib/installer.php:2046
msgid "Cacti requires several PHP Modules to be installed to work properly. If any of these are not installed, you will be unable to continue the installation until corrected. In addition, for optimal system performance Cacti should be run with certain MySQL system variables set.  Please follow the MySQL recommendations at your discretion.  Always seek the MySQL documentation if you have any questions."
msgstr "Cacti ને યોગ્ય રીતે કામ કરવા માટે ઘણા PHP મોડ્યુલ ઇન્સ્ટોલ થયેલા હોવા જરૂરી છે. જો આમાંથી કોઈ ઇન્સ્ટોલ ન હોય, તો તે સુધારાય ત્યાં સુધી તમે ઇન્સ્ટોલેશન ચાલુ રાખી શકશો નહીં. વધુમાં, શ્રેષ્ઠ સિસ્ટમ કામગીરી માટે Cacti અમુક MySQL સિસ્ટમ વેરિયેબલ સેટ કરીને ચલાવવું જોઈએ.  કૃપા કરીને તમારા વિવેક મુજબ MySQL ભલામણોને અનુસરો.  કોઈ પ્રશ્ન હોય તો હંમેશા MySQL દસ્તાવેજીકરણ જુઓ."

#: lib/installer.php:2048
msgid "The following PHP extensions are mandatory, and MUST be installed before continuing your Cacti install."
msgstr "નીચેના PHP એક્સ્ટેન્શન ફરજિયાત છે, અને તમારું Cacti ઇન્સ્ટોલ ચાલુ રાખતાં પહેલાં ઇન્સ્ટોલ થયેલા હોવા આવશ્યક છે."

#: lib/installer.php:2052
msgid "Required PHP Modules"
msgstr "જરૂરી PHP મોડ્યુલ"

#: lib/installer.php:2053 lib/installer.php:2083 plugins.php:43 plugins.php:499
msgid "Installed"
msgstr "ઇન્સ્ટોલ કરેલ"

#: lib/installer.php:2053
msgid "Required"
msgstr "જરૂરી"

#: lib/installer.php:2076
msgid "PHP - Module Support (Optional)"
msgstr "PHP - મોડ્યુલ સપોર્ટ (વૈકલ્પિક)"

#: lib/installer.php:2078
msgid "The following PHP extensions are recommended, and should be installed before continuing your Cacti install.  NOTE: If you are planning on supporting SNMPv3 with IPv6, you should not install the php-snmp module at this time."
msgstr "નીચેના PHP એક્સ્ટેન્શનની ભલામણ કરવામાં આવે છે, અને તમારું Cacti ઇન્સ્ટોલ ચાલુ રાખતાં પહેલાં ઇન્સ્ટોલ થયેલા હોવા જોઈએ.  નોંધ: જો તમે IPv6 સાથે SNMPv3 સપોર્ટ કરવાની યોજના બનાવી રહ્યા હો, તો તમારે આ સમયે php-snmp મોડ્યુલ ઇન્સ્ટોલ ન કરવું જોઈએ."

#: lib/installer.php:2082
msgid "Optional Modules"
msgstr "વૈકલ્પિક મોડ્યુલ"

#: lib/installer.php:2083
msgid "Optional"
msgstr "વૈકલ્પિક"

#: lib/installer.php:2104
msgid "MySQL - TimeZone Support"
msgstr "MySQL - ટાઇમઝોન સપોર્ટ"

#: lib/installer.php:2115
msgid "Your MySQL TimeZone database is not populated.  Please populate this database before proceeding."
msgstr "તમારો MySQL TimeZone ડેટાબેઝ ભરેલો નથી.  કૃપા કરીને આગળ વધતા પહેલાં આ ડેટાબેઝ ભરો."

#: lib/installer.php:2119
msgid "Your Cacti database login account does not have access to the MySQL TimeZone database.  Please provide the Cacti database account \"select\" access to the \"time_zone_name\" table in the \"mysql\" database, and populate MySQL's TimeZone information before proceeding."
msgstr "તમારા Cacti ડેટાબેઝ લૉગિન ખાતાને MySQL TimeZone ડેટાબેઝની ઍક્સેસ નથી.  કૃપા કરીને આગળ વધતાં પહેલાં Cacti ડેટાબેઝ ખાતાને \"mysql\" ડેટાબેઝમાં \"time_zone_name\" કોષ્ટકની \"select\" ઍક્સેસ આપો, અને MySQL ની TimeZone માહિતી ભરો."

#: lib/installer.php:2124
msgid "Your Cacti database account has access to the MySQL TimeZone database and that database is populated with global TimeZone information."
msgstr "તમારા Cacti ડેટાબેઝ ખાતાને MySQL TimeZone ડેટાબેઝની ઍક્સેસ છે અને તે ડેટાબેઝ વૈશ્વિક TimeZone માહિતીથી ભરેલો છે."

#: lib/installer.php:2129
msgid "MySQL - Settings"
msgstr "MySQL - સેટિંગ્સ"

#: lib/installer.php:2130
msgid "These MySQL performance tuning settings will help your Cacti system perform better without issues for a longer time."
msgstr "આ MySQL કામગીરી ટ્યુનિંગ સેટિંગ્સ તમારી Cacti સિસ્ટમને લાંબા સમય સુધી સમસ્યાઓ વિના વધુ સારી રીતે કામ કરવામાં મદદ કરશે."

#: lib/installer.php:2132
msgid "Recommended MySQL System Variable Settings"
msgstr "ભલામણ કરેલ MySQL સિસ્ટમ ચલ સેટિંગ્સ"

#: lib/installer.php:2161
msgid "Installation Type"
msgstr "ઇન્સ્ટોલેશન પ્રકાર"

#: lib/installer.php:2167
#, php-format
msgid "Upgrade from <strong>%s</strong> to <strong>%s</strong>"
msgstr "<strong>%s</strong> માંથી <strong>%s</strong> પર અપગ્રેડ"

#: lib/installer.php:2169
msgid "In the event of issues, It is highly recommended that you clear your browser cache, closing then reopening your browser (not just the tab Cacti is on) and retrying, before raising an issue with The Cacti Group"
msgstr "સમસ્યાઓના કિસ્સામાં, Cacti ગ્રુપ સમક્ષ સમસ્યા ઉઠાવતાં પહેલાં તમારા બ્રાઉઝરની કેશ સાફ કરવી, તમારું બ્રાઉઝર (ફક્ત Cacti ખુલ્લું હોય તે ટૅબ નહીં) બંધ કરીને ફરી ખોલવું અને ફરી પ્રયાસ કરવો તેવી ભારપૂર્વક ભલામણ કરવામાં આવે છે"

#: lib/installer.php:2170
msgid "On rare occasions, we have had reports from users who experience some minor issues due to changes in the code.  These issues are caused by the browser retaining pre-upgrade code and whilst we have taken steps to minimise the chances of this, it may still occur.  If you need instructions on how to clear your browser cache, <a href='https://www.refreshyourcache.com' target='_blank'>https://www.refreshyourcache.com/</a> is a good starting point."
msgstr "ક્યારેક, કોડમાં થયેલા ફેરફારોને કારણે કેટલાક નાની સમસ્યાઓ અનુભવતા વપરાશકર્તાઓ તરફથી અમને અહેવાલ મળ્યા છે.  આ સમસ્યાઓ બ્રાઉઝર અપગ્રેડ પહેલાંનો કોડ જાળવી રાખવાને કારણે થાય છે અને તેની શક્યતા ઘટાડવા માટે અમે પગલાં લીધાં હોવા છતાં, તે હજી પણ થઈ શકે છે.  જો તમને તમારા બ્રાઉઝરની કેશ કેવી રીતે સાફ કરવી તેની સૂચનાઓ જોઈતી હોય, તો <a href='https://www.refreshyourcache.com' target='_blank'>https://www.refreshyourcache.com/</a> સારું શરૂઆતનું સ્થાન છે."

#: lib/installer.php:2171
msgid "If after clearing your cache and restarting your browser, you still experience issues, please raise the issue with us and we will try to identify the cause of it."
msgstr "જો તમારી કેશ સાફ કર્યા અને બ્રાઉઝર પુનઃપ્રારંભ કર્યા પછી પણ તમને સમસ્યાઓ આવે, તો કૃપા કરીને અમને સમસ્યાની જાણ કરો અને અમે તેનું કારણ ઓળખવાનો પ્રયાસ કરીશું."

#: lib/installer.php:2177
#, php-format
msgid "Downgrade from <strong>%s</strong> to <strong>%s</strong>"
msgstr "<strong>%s</strong> માંથી <strong>%s</strong> પર ડાઉનગ્રેડ"

#: lib/installer.php:2178
msgid "You appear to be downgrading to a previous version.  Database changes made for the newer version will not be reversed and <i>could</i> cause issues."
msgstr "તમે અગાઉના સંસ્કરણ પર ડાઉનગ્રેડ કરી રહ્યા હો તેવું લાગે છે.  નવા સંસ્કરણ માટે કરવામાં આવેલા ડેટાબેઝ ફેરફારો પાછા ફેરવવામાં આવશે નહીં અને તે સમસ્યાઓ <i>ઊભી કરી શકે</i> છે."

