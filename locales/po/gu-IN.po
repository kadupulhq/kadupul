msgstr "ગ્રાફની અંદરના ગ્રાફ વિસ્તારની ઊંચાઈ (પિક્સેલમાં). આ વિસ્તારમાં લેજન્ડ, ધરી લેજન્ડ અથવા શીર્ષકનો સમાવેશ થતો નથી."

#: include/global_form.php
msgid "Width (--width)"
msgstr "પહોળાઈ (--width)"

#: include/global_form.php
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "ગ્રાફની અંદરના ગ્રાફ વિસ્તારની પહોળાઈ (પિક્સેલમાં). આ વિસ્તારમાં લેજન્ડ, ધરી લેજન્ડ અથવા શીર્ષકનો સમાવેશ થતો નથી."

#: include/global_form.php
msgid "Base Value (--base)"
msgstr "આધાર મૂલ્ય (--base)"

#: include/global_form.php
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "મેમરી માટે 1024 અને ટ્રાફિક માપન માટે 1000 સેટ કરવું જોઈએ."

#: include/global_form.php
msgid "Slope Mode (--slope-mode)"
msgstr "સ્લોપ મોડ (--slope-mode)"

#: include/global_form.php
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "સ્લોપ મોડનો ઉપયોગ કરવાથી સ્ક્રીન પરના કેટલાક રિઝોલ્યુશનના ભોગે ગ્રાફનો આકાર સરળ બને છે."

#: include/global_form.php
msgid "Scaling Options"
msgstr "સ્કેલિંગ વિકલ્પો"

#: include/global_form.php
msgid "Auto Scale"
msgstr "ઑટો સ્કેલ"

#: include/global_form.php
msgid "When enabled, the selected Auto Scale Option determines which limits RRDtool uses: --alt-autoscale ignores both limits, --alt-autoscale-max keeps the lower limit, --alt-autoscale-min keeps the upper limit, and --alt-autoscale (accepting both limits) keeps both limits. When disabled, the configured lower and upper limits are used directly. Rigid Boundaries controls whether values outside those limits expand the graph range."
msgstr "જ્યારે સક્ષમ હોય, ત્યારે પસંદ કરેલો ઑટો સ્કેલ વિકલ્પ નક્કી કરે છે કે RRDtool કઈ મર્યાદાઓનો ઉપયોગ કરે છે: --alt-autoscale બંને મર્યાદાઓને અવગણે છે, --alt-autoscale-max નીચલી મર્યાદા જાળવે છે, --alt-autoscale-min ઉપરની મર્યાદા જાળવે છે, અને --alt-autoscale (બંને મર્યાદાઓ સ્વીકારતું) બંને મર્યાદાઓ જાળવે છે. જ્યારે અક્ષમ હોય, ત્યારે રૂપરેખાંકિત નીચલી અને ઉપરની મર્યાદાઓનો સીધો ઉપયોગ થાય છે. રિજિડ બાઉન્ડરીઝ નક્કી કરે છે કે તે મર્યાદાઓની બહારના મૂલ્યો ગ્રાફ શ્રેણી વિસ્તારશે કે નહીં."

#: include/global_form.php
msgid "Auto Scale Options"
msgstr "ઑટો સ્કેલ વિકલ્પો"

#: include/global_form.php
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "ઉપયોગ કરો <br> સંપૂર્ણ ન્યૂનતમ અને મહત્તમ સુધી સ્કેલ કરવા માટે --alt-autoscale <br> આપેલી નીચલી મર્યાદાનો ઉપયોગ કરીને મહત્તમ મૂલ્ય સુધી સ્કેલ કરવા માટે --alt-autoscale-max <br> આપેલી ઉપરની મર્યાદાનો ઉપયોગ કરીને ન્યૂનતમ મૂલ્ય સુધી સ્કેલ કરવા માટે --alt-autoscale-min <br> નીચલી અને ઉપરની બંને મર્યાદાઓનો ઉપયોગ કરીને સ્કેલ કરવા માટે --alt-autoscale (મર્યાદાઓ સાથે) (RRDtool મૂળભૂત) <br>"

#: include/global_form.php
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "--alt-autoscale નો ઉપયોગ કરો (આપેલી મર્યાદાઓને અવગણીને)"

#: include/global_form.php
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "--alt-autoscale-max નો ઉપયોગ કરો (નીચલી મર્યાદા સ્વીકારીને)"

#: include/global_form.php
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "--alt-autoscale-min નો ઉપયોગ કરો (ઉપરની મર્યાદા સ્વીકારીને)"

#: include/global_form.php
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "--alt-autoscale નો ઉપયોગ કરો (બંને મર્યાદાઓ સ્વીકારીને, RRDtool મૂળભૂત)"

#: include/global_form.php
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "લઘુગણકીય સ્કેલિંગ (--logarithmic)"

#: include/global_form.php
msgid "Use Logarithmic y-axis scaling"
msgstr "લઘુગણકીય y-ધરી સ્કેલિંગનો ઉપયોગ કરો"

#: include/global_form.php
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "લઘુગણકીય સ્કેલિંગ માટે SI એકમો (--units=si)"

#: include/global_form.php
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "ઘાતાંકીય સંકેતલિપિને બદલે લોગરિધમિક સ્કેલિંગ માટે SI એકમોનો ઉપયોગ કરો.<br> નોંધ: રેખીય ગ્રાફ મૂળભૂત રીતે SI સંકેતલિપિનો ઉપયોગ કરે છે."

#: include/global_form.php
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "કડક સીમા મોડ (--rigid)"

#: include/global_form.php
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "જો ગ્રાફમાં માન્ય શ્રેણીની બહારનું મૂલ્ય હોય તો નીચલી અને ઉપલી મર્યાદા વિસ્તારશો નહીં."

#: include/global_form.php
msgid "Upper Limit (--upper-limit)"
msgstr "ઉપલી મર્યાદા (--upper-limit)"

#: include/global_form.php
msgid "The maximum vertical value for the graph."
msgstr "ગ્રાફ માટે મહત્તમ ઊભું મૂલ્ય."

#: include/global_form.php
msgid "Lower Limit (--lower-limit)"
msgstr "નીચલી મર્યાદા (--lower-limit)"

#: include/global_form.php
msgid "The minimum vertical value for the graph."
msgstr "ગ્રાફ માટે ન્યૂનતમ ઊભું મૂલ્ય."

#: include/global_form.php
msgid "Grid Options"
msgstr "ગ્રીડ વિકલ્પો"

#: include/global_form.php
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "એકમ ગ્રીડ મૂલ્ય (--unit/--y-grid)"

#: include/global_form.php
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "સંખ્યાઓ માટે Y-અક્ષ પર ઘાતાંક મૂલ્ય સેટ કરે છે. નોંધ: આ વિકલ્પ અપ્રચલિત છે અને --y-grid વિકલ્પ દ્વારા બદલવામાં આવ્યો છે.  આ વિકલ્પમાં, Y-અક્ષની ગ્રીડ રેખાઓ દરેક ગ્રીડ પગલાના અંતરાલે દેખાય છે.  લેબલ દર લેબલ ફેક્ટર રેખાઓએ મૂકવામાં આવે છે."

#: include/global_form.php
msgid "Unit Exponent Value (--units-exponent)"
msgstr "એકમ ઘાતાંક મૂલ્ય (--units-exponent)"

#: include/global_form.php
msgid "What unit Kadupul should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "Kadupul એ Y-અક્ષ પર કયા એકમનો ઉપયોગ કરવો. બધું \"k\" માં બતાવવા માટે 3 અથવા બધું \"u\" (માઇક્રો) માં બતાવવા માટે -6 વાપરો."

#: include/global_form.php
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "એકમ લંબાઈ (--units-length &lt;length&gt;)"

#: include/global_form.php
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "RRDtool એ y-અક્ષના લેબલ કેટલા અંકોના ધારવા? y-અક્ષના લેબલિંગ સાથે ફેરફાર કરવાનું શરૂ કરો ત્યારે પૂરતી જગ્યા બનાવવા માટે તમારે આ વિકલ્પનો ઉપયોગ કરવો પડી શકે છે."

#: include/global_form.php
msgid "No Gridfit (--no-gridfit)"
msgstr "ગ્રીડફિટ નહીં (--no-gridfit)"

#: include/global_form.php
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "એન્ટી-એલિયાસિંગ ઝાંખપની અસરો ટાળવા માટે RRDtool બિંદુઓને ઉપકરણ રિઝોલ્યુશન પિક્સેલ પર ગોઠવે છે, જેનાથી વધુ તીક્ષ્ણ દેખાવ મળે છે. જો આ તમને ગમતું ન હોય, તો આ વર્તન બંધ કરવા માટે તમે આ સ્વિચનો ઉપયોગ કરી શકો છો.<br><strong>નોંધ: </strong>PDF, EPS, SVG આઉટપુટ માટે ગ્રીડફિટિંગ મૂળભૂત રીતે બંધ હોય છે."

#: include/global_form.php
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "વૈકલ્પિક Y ગ્રીડ (--alt-y-grid)"

#: include/global_form.php
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "આ અલ્ગોરિધમ ખાતરી કરે છે કે તમારી પાસે હંમેશા ગ્રીડ હોય, પૂરતી પણ વધુ પડતી નહીં એટલી ગ્રીડ રેખાઓ હોય, અને ગ્રીડ મેટ્રિક હોય. તમારો ગ્રાફ 69.998 થી 70.001 સુધીનો હોય તો પણ આ પેરામીટર પૂરતા દશાંશ દર્શાવાય તેની ખાતરી કરશે.<br><strong>નોંધ: </strong>આ પેરામીટર --alt-autoscale વિકલ્પો સાથે દખલ કરી શકે છે."

#: include/global_form.php
msgid "Axis Options"
msgstr "અક્ષ વિકલ્પો"

#: include/global_form.php
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "જમણી અક્ષ (--right-axis &lt;scale:shift&gt;)"

#: include/global_form.php
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "ગ્રાફની જમણી બાજુએ બીજી અક્ષ દોરવામાં આવશે. તે સ્કેલ અને શિફ્ટ પેરામીટર દ્વારા ડાબી અક્ષ સાથે જોડાયેલી છે."

#: include/global_form.php
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "જમણી અક્ષનું લેબલ (--right-axis-label &lt;string&gt;)"

#: include/global_form.php
msgid "The label for the right axis."
msgstr "જમણી અક્ષ માટેનું લેબલ."

#: include/global_form.php
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "જમણી અક્ષનું ફોર્મેટ (--right-axis-format &lt;format&gt;)"

#: include/global_form.php
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "મૂળભૂત રીતે, અક્ષના લેબલનું ફોર્મેટ આપમેળે નક્કી થાય છે.  જો તમે આ જાતે કરવા માંગતા હો, તો PRINT અને GPRINT આદેશોથી તમે જાણો છો તે જ %lf દલીલો સાથે આ વિકલ્પનો ઉપયોગ કરો."

#: include/global_form.php
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "જમણી અક્ષ ફોર્મેટર (--right-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you set up the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "જમણી અક્ષનું લેબલિંગ સેટ કરતી વખતે, ડેટા ફોર્મેટ પર એક નિયમ લાગુ કરો.  સમર્થિત ફોર્મેટમાં \"numeric\" નો સમાવેશ થાય છે જ્યાં ડેટા સંખ્યાત્મક ગણાય છે, \"timestamp\" જ્યાં મૂલ્યો UNIX ટાઇમસ્ટેમ્પ (જાન્યુઆરી 1970 પછીના સેકન્ડની સંખ્યા) તરીકે અર્થઘટિત થાય છે અને strftime ફોર્મેટમાં વ્યક્ત થાય છે (મૂળભૂત \"%Y-%m-%d %H:%M:%S\" છે).  --units-length અને --right-axis-format પણ જુઓ.  છેલ્લે \"duration\" જ્યાં મૂલ્યો મિલિસેકન્ડમાં સમયગાળા તરીકે અર્થઘટિત થાય છે.  ફોર્મેટિંગ valstrfduration લાયક PRINT/GPRINT ના નિયમોને અનુસરે છે."

#: include/global_form.php
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "ડાબી અક્ષ ફોર્મેટર (--left-axis-formatter &lt;formatname&gt;)"

#: include/global_form.php
msgid "When you set up the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "ડાબી અક્ષનું લેબલિંગ સેટ કરતી વખતે, ડેટા ફોર્મેટ પર એક નિયમ લાગુ કરો.  સમર્થિત ફોર્મેટમાં \"numeric\" નો સમાવેશ થાય છે જ્યાં ડેટા સંખ્યાત્મક ગણાય છે, \"timestamp\" જ્યાં મૂલ્યો UNIX ટાઇમસ્ટેમ્પ (જાન્યુઆરી 1970 પછીના સેકન્ડની સંખ્યા) તરીકે અર્થઘટિત થાય છે અને strftime ફોર્મેટમાં વ્યક્ત થાય છે (મૂળભૂત \"%Y-%m-%d %H:%M:%S\" છે).  --units-length પણ જુઓ.  છેલ્લે \"duration\" જ્યાં મૂલ્યો મિલિસેકન્ડમાં સમયગાળા તરીકે અર્થઘટિત થાય છે.  ફોર્મેટિંગ valstrfduration લાયક PRINT/GPRINT ના નિયમોને અનુસરે છે."

