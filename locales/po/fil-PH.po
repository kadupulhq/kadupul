#: include/global_settings.php
msgid "Graph/Data Source/Data Query Settings"
msgstr "Mga Setting ng Graph/Data Source/Data Query"

#: include/global_settings.php
msgid "Maximum Title Length"
msgstr "Maximum na Haba ng Pamagat"

#: include/global_settings.php
msgid "The maximum allowable Graph or Data Source titles."
msgstr "Ang maximum na pinapayagang haba ng mga title ng Graph o Data Source."

#: include/global_settings.php
msgid "Data Source Field Length"
msgstr "Haba ng Field ng Data Source"

#: include/global_settings.php
