msgstr "Trieu 'enabled' per permetre la localització de Kadupul. El mode estricte requereix que l'idioma sol·licitat també estigui admès per tots els connectors instal·lats al sistema. Si no és així, tot es mostrarà en anglès."

#: include/global_settings.php
msgid "Language"
msgstr "Idioma"

#: include/global_settings.php
