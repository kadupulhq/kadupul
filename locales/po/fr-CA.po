#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Data Source Statistics script can run without generating a timeout error and being killed."
msgstr "La durée maximale pendant laquelle le script des statistiques de sources de données de Kadupul peut s'exécuter sans générer d'erreur de délai d'attente ni être arrêté."

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's RRDfile check script can run without generating a timeout error and being killed."
msgstr "La durée maximale pendant laquelle le script de vérification des fichiers RRD de Kadupul peut s'exécuter sans générer d'erreur de délai d'attente ni être arrêté."

#: include/global_settings.php
msgid "The maximum amount of time Kadupul's Reports Generation script can run without generating a timeout error and being killed."
msgstr "La durée maximale pendant laquelle le script de génération de rapports de Kadupul peut s'exécuter sans générer d'erreur de délai d'attente ni être arrêté."

#: include/global_settings.php
msgid "The maximum amount of time a Kadupul's Maintenance script can run without generating a timeout error and being killed."
msgstr "La durée maximale pendant laquelle le script de maintenance de Kadupul peut s'exécuter sans générer d'erreur de délai d'attente ni être arrêté."

#: include/global_settings.php
