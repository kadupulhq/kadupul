#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MariaDB less than 10.5.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max of the number of CPU cores or 64."
msgstr "سيقسم %s منطقة innodb_buffer_pool إلى مناطق ذاكرة لتحسين الأداء لإصدارات MariaDB الأقل من 10.5. القيمة القصوى هي 64، ولكن يجب ألا تتجاوز عدد نوى/مسارات وحدة المعالجة المركزية. عندما يكون innodb_buffer_pool أقل من 1 غيغابايت، يجب استخدام حجم التجمع مقسومًا على 128 ميغابايت، ومواصلة استخدام هذه المعادلة حتى الحد الأقصى لعدد نوى وحدة المعالجة المركزية أو 64."

#: lib/utility.php
#, php-format
msgid "%s will divide the innodb_buffer_pool into memory regions to improve performance for versions of MySQL up to and including MySQL 8.0.  The max value is 64, but should not exceed more than the number of CPU cores/threads.  When your innodb_buffer_pool is less than 1GB, you should use the pool size divided by 128MB.  Continue to use this equation up to the max of the number of CPU cores or 64."
msgstr "سيقسم %s منطقة innodb_buffer_pool إلى مناطق ذاكرة لتحسين الأداء لإصدارات MySQL حتى MySQL 8.0 شاملة. القيمة القصوى هي 64، ولكن يجب ألا تتجاوز عدد نوى/مسارات وحدة المعالجة المركزية. عندما يكون innodb_buffer_pool أقل من 1 غيغابايت، يجب استخدام حجم التجمع مقسومًا على 128 ميغابايت، ومواصلة استخدام هذه المعادلة حتى الحد الأقصى لعدد نوى وحدة المعالجة المركزية أو 64."

