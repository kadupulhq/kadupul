msgstr "כיצד הנתונים מיוצגים ב- RRA."

#: include/global_form.php:644
msgid "The maximum amount of time that can pass before data is entered as 'unknown'. (Usually 2x300=600)"
msgstr "משך הזמן המרבי שיכול לעבור לפני שהנתונים מוזנים כ- &#39;לא ידוע&#39;. (בדרך כלל 2x300 = 600)"

#: include/global_form.php:647
msgid "Output Field"
msgstr "שדה פלט"

#: include/global_form.php:650 lib/html_utility.php:291
msgid "Not Selected"
msgstr "הסר חשבונות נבחרים"

#: include/global_form.php:651
msgid "When data is gathered, the data for this field will be put into this data source."
msgstr "כאשר הנתונים נאספים, הנתונים עבור שדה זה יוכנסו למקור נתונים זה."

#: include/global_form.php:660
msgid "Enter a name for this GPRINT preset, make sure it is something you recognize."
msgstr "הזן שם עבור זה מראש GPRINT, לוודא שזה משהו שאתה מזהה."

#: include/global_form.php:667
msgid "GPRINT Text"
msgstr "טקסט GPRINT"

#: include/global_form.php:668
msgid "Enter the custom GPRINT string here."
msgstr "הזן כאן את מחרוזת GPRINT המותאמת אישית."

#: include/global_form.php:686
msgid "Common Options"
msgstr "אפשרויות נפוצות"

#: include/global_form.php:691
msgid "Title (--title)"
msgstr "כותרת (- כותרת)"

#: include/global_form.php:695
msgid "The name that is printed on the graph.  It can include replacement variables such as |host_description| or |query_fieldName|.  For a complete list of supported replacement tags, please see the Kadupul documentation."
msgstr "השם המודפס על התרשים. הוא יכול לכלול משתנים חלופיים כגון | host_description או | שאילתה | לקבלת רשימה מלאה של תגי החלפה נתמכים, עיין בתיעוד של Kadupul."

#: include/global_form.php:699
msgid "Vertical Label (--vertical-label)"
msgstr "תווית אנכית (- תווית)"

#: include/global_form.php:703
msgid "The label vertically printed to the left of the graph."
msgstr "התווית מודפסת אנכית בצד שמאל של התרשים."

#: include/global_form.php:707
msgid "Image Format (--imgformat)"
msgstr "פורמט תמונה (--imgformat)"

#: include/global_form.php:711
msgid "The type of graph that is generated; PNG, GIF or SVG.  The selection of graph image type is very RRDtool dependent."
msgstr "סוג הגרף שנוצר; PNG, GIF או SVG. הבחירה של סוג התמונה הגרפית תלויה מאוד ב- RRDtool."

#: include/global_form.php:714
msgid "Height (--height)"
msgstr "גובה (- גובה)"

#: include/global_form.php:718
msgid "The height (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "הגובה (בפיקסלים) של אזור התרשים שבתרשים. אזור זה אינו כולל את האגדה, אגדות ציר או כותרת."

#: include/global_form.php:722
msgid "Width (--width)"
msgstr "רוחב (- רוחב)"

#: include/global_form.php:726
msgid "The width (in pixels) of the graph area within the graph. This area does not include the legend, axis legends, or title."
msgstr "הרוחב (בפיקסלים) של אזור התרשים שבתרשים. אזור זה אינו כולל את האגדה, אגדות ציר או כותרת."

#: include/global_form.php:730
msgid "Base Value (--base)"
msgstr "ערך בסיס (- בסיס)"

#: include/global_form.php:734
msgid "Should be set to 1024 for memory and 1000 for traffic measurements."
msgstr "צריך להיות מוגדר 1024 עבור זיכרון ו 1000 עבור מדידות התנועה."

#: include/global_form.php:738
msgid "Slope Mode (--slope-mode)"
msgstr "מצב המדרון (- slop-mode)"

#: include/global_form.php:742
msgid "Using Slope Mode evens out the shape of the graphs at the expense of some on screen resolution."
msgstr "שימוש במצב Slope מעיד על צורת הגרפים על חשבון חלק מהפתרונות של המסך."

#: include/global_form.php:745
msgid "Scaling Options"
msgstr "סובב & 90"

#: include/global_form.php:750
msgid "Auto Scale"
msgstr "סולם אוטומטי"

#: include/global_form.php:754
msgid "When enabled, the selected Auto Scale Option determines which limits RRDtool uses: --alt-autoscale ignores both limits, --alt-autoscale-max keeps the lower limit, --alt-autoscale-min keeps the upper limit, and --alt-autoscale (accepting both limits) keeps both limits. When disabled, the configured lower and upper limits are used directly. Rigid Boundaries controls whether values outside those limits expand the graph range."
msgstr ""

#: include/global_form.php:758
msgid "Auto Scale Options"
msgstr "אפשרויות סולם אוטומטי"

#: include/global_form.php:761
msgid "Use <br> --alt-autoscale to scale to the absolute minimum and maximum <br> --alt-autoscale-max to scale to the maximum value, using a given lower limit <br> --alt-autoscale-min to scale to the minimum value, using a given upper limit <br> --alt-autoscale (with limits) to scale using both lower and upper limits (RRDtool default) <br>"
msgstr "להשתמש <br> - alt-autoscale כדי להגביל את המינימום המוחלט ואת המקסימום <br> - alt-autoscale-max כדי להגדילה לערך המקסימלי, באמצעות גבול נמוך נתון <br> - alt-autoscale-min כדי להגדילה לערך המינימלי, באמצעות גבול עליון <br> - alt-autoscale (עם גבולות) לגודל המשתמש הן במגבלות התחתונות והן בגבולות העליונים (ברירת המחדל של RRDtool) <br>"

#: include/global_form.php:765
msgid "Use --alt-autoscale (ignoring given limits)"
msgstr "השתמש - alt-autoscale (התעלמות גבולות נתון)"

#: include/global_form.php:769
msgid "Use --alt-autoscale-max (accepting a lower limit)"
msgstr "השתמש - alt-autoscale-max (קבלת גבול נמוך)"

#: include/global_form.php:773
msgid "Use --alt-autoscale-min (accepting an upper limit)"
msgstr "השתמש - alt-autoscale-min (קבלת גבול עליון)"

#: include/global_form.php:777
msgid "Use --alt-autoscale (accepting both limits, RRDtool default)"
msgstr "השתמש - alt-autoscale (קבלת שני הגבולות, ברירת המחדל RRDtool)"

#: include/global_form.php:782
msgid "Logarithmic Scaling (--logarithmic)"
msgstr "Logarithmic קנה מידה (--logarithmic)"

#: include/global_form.php:786
msgid "Use Logarithmic y-axis scaling"
msgstr "השתמש לוגריתמית y- ציר קנה המידה"

#: include/global_form.php:789
msgid "SI Units for Logarithmic Scaling (--units=si)"
msgstr "יחידות SI עבור דרוג לוגריתמי (- יחידות = si)"

#: include/global_form.php:792
msgid "Use SI Units for Logarithmic Scaling instead of using exponential notation.<br> Note: Linear graphs use SI notation by default."
msgstr "השתמש ביחידות SI עבור קנה המידה הלוגריתמי במקום להשתמש בסימון מעריכי. <br> הערה: גרפים לינאריים משתמשים בסימון SI כברירת מחדל."

#: include/global_form.php:795
msgid "Rigid Boundaries Mode (--rigid)"
msgstr "מצב קשיח גבולות (--rigid)"

#: include/global_form.php:798
msgid "Do not expand the lower and upper limit if the graph contains a value outside the valid range."
msgstr "אל תרחיב את הגבול התחתון והתחתון אם התרשים מכיל ערך מחוץ לטווח חוקי."

#: include/global_form.php:801
msgid "Upper Limit (--upper-limit)"
msgstr "גבול עליון (גבול עליון)"

#: include/global_form.php:805
msgid "The maximum vertical value for the graph."
msgstr "הערך האנכי המרבי עבור התרשים."

#: include/global_form.php:809
msgid "Lower Limit (--lower-limit)"
msgstr "גבול תחתון (- להגביל את הגבול)"

#: include/global_form.php:813
msgid "The minimum vertical value for the graph."
msgstr "הערך האנכי המינימלי עבור התרשים."

#: include/global_form.php:817
msgid "Grid Options"
msgstr "אפשרויות רשת"

#: include/global_form.php:822
msgid "Unit Grid Value (--unit/--y-grid)"
msgstr "יחידה Grid Unit (--unit / - y-grid)"

#: include/global_form.php:826
msgid "Sets the exponent value on the Y-axis for numbers. Note: This option is deprecated and replaced by the --y-grid option.  In this option, Y-axis grid lines appear at each grid step interval.  Labels are placed every label factor lines."
msgstr "מגדיר את ערך המעריך על ציר Y למספרים. הערה: אפשרות זו הוציאה משימוש והוחלפה באפשרות --y-grid. באפשרות זו, קווי ציר Y מופיעים בכל מרווח שלב. תוויות ממוקמות כל קווים גורם תווית."

#: include/global_form.php:830
msgid "Unit Exponent Value (--units-exponent)"
msgstr "ערך יחידת הערך (יחידות - מעריך)"

#: include/global_form.php:834
msgid "What unit Kadupul should use on the Y-axis. Use 3 to display everything in \"k\" or -6 to display everything in \"u\" (micro)."
msgstr "מה Kadupul יחידה צריך להשתמש על ציר Y. השתמש ב 3 כדי להציג את הכל ב &quot;k&quot; או -6 כדי להציג את הכל ב &quot;u&quot; (מיקרו)."

#: include/global_form.php:838
msgid "Unit Length (--units-length &lt;length&gt;)"
msgstr "אורך יחידה (- אורך יחידה &lt;אורך&gt;&gt;)"

#: include/global_form.php:843
msgid "How many digits should RRDtool assume the y-axis labels to be? You may have to use this option to make enough space once you start fiddling with the y-axis labeling."
msgstr "כמה ספרות צריך RRDtool להניח תוויות ציר y להיות? ייתכן שיהיה עליך להשתמש באפשרות זו כדי ליצור מספיק מקום ברגע שאתה מתחיל להתעסק עם תיוג ציר y."

#: include/global_form.php:846
msgid "No Gridfit (--no-gridfit)"
msgstr "לא Gridfit (- לא gridfit)"

#: include/global_form.php:849
msgid "In order to avoid anti-aliasing blurring effects RRDtool snaps points to device resolution pixels, this results in a crisper appearance. If this is not to your liking, you can use this switch to turn this behavior off.<br><strong>Note: </strong>Gridfitting is turned off for PDF, EPS, SVG output by default."
msgstr "על מנת למנוע אפקטים נגד טשטוש נגד RRDtool מצמיד נקודות לפיקסלים של רזולוציית המכשיר, התוצאה היא מראה קל יותר. אם זה לא לטעמך, תוכל להשתמש במתג זה כדי לכבות את ההתנהגות הזו. <br> <strong>הערה:</strong> Gridfitting כבוי עבור PDF, EPS, SVG פלט כברירת מחדל."

#: include/global_form.php:852
msgid "Alternative Y Grid (--alt-y-grid)"
msgstr "אלטרנטיבי Y Grid (- alt-y-grid)"

#: include/global_form.php:855
msgid "The algorithm ensures that you always have a grid, that there are enough but not too many grid lines, and that the grid is metric. This parameter will also ensure that you get enough decimals displayed even if your graph goes from 69.998 to 70.001.<br><strong>Note: </strong>This parameter may interfere with --alt-autoscale options."
msgstr "האלגוריתם מבטיח שתמיד יש לך רשת, כי יש מספיק אבל לא יותר מדי קווי רשת, וכי הרשת הוא מטרי. פרמטר זה גם יבטיח כי תקבל מספיק עשרוני מוצג גם אם הגרף שלך הולך מ 69.998 עד 70.001. <br> <strong>הערה:</strong> פרמטר זה עלול להפריע לאפשרויות aut-aut."

#: include/global_form.php:858
msgid "Axis Options"
msgstr "אפשרויות ציר"

#: include/global_form.php:863
msgid "Right Axis (--right-axis &lt;scale:shift&gt;)"
msgstr "ציר ימני (- ציר ימני &lt;scale: shift&gt;)"

#: include/global_form.php:868
msgid "A second axis will be drawn to the right of the graph. It is tied to the left axis via the scale and shift parameters."
msgstr "ציר שני ימשוך מימין לגרף. היא קשורה לציר השמאלי באמצעות הפרמטרים של הסולם והמשמרת."

#: include/global_form.php:871
msgid "Right Axis Label (--right-axis-label &lt;string&gt;)"
msgstr "ימינה ציר תווית (- ימני ציר תווית &lt;string&gt;)"

#: include/global_form.php:876
msgid "The label for the right axis."
msgstr "התווית של הציר הימני."

#: include/global_form.php:879
msgid "Right Axis Format (--right-axis-format &lt;format&gt;)"
msgstr "פורמט ימין של ציר (- פורמט ימני - פורמט&gt;&gt;)"

#: include/global_form.php:884
#, php-format
msgid "By default, the format of the axis labels gets determined automatically.  If you want to do this yourself, use this option with the same %lf arguments you know from the PRINT and GPRINT commands."
msgstr "כברירת מחדל, הפורמט של תוויות הצירים נקבע באופן אוטומטי. אם אתה רוצה לעשות זאת בעצמך, השתמש באפשרות זו עם אותם% lf ארגומנטים שאתה מכיר מהפקודות PRINT ו- GPRINT."

#: include/global_form.php:887
msgid "Right Axis Formatter (--right-axis-formatter &lt;formatname&gt;)"
msgstr "תבנית ציר ימין (- תבנית ציר ימין &lt;פורמט&gt;&gt;)"

#: include/global_form.php:892
msgid "When you setup the right axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length and --right-axis-format.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "כאשר אתה מגדיר את תיוג ציר הנכון, להחיל כלל על פורמט הנתונים. הפורמטים הנתמכים כוללים &quot;numeric&quot; כאשר הנתונים מטופלים כמספריים, &quot;חותמת זמן&quot; שבה ערכים מתפרשים כחותמות זמן של UNIX (מספר שניות מאז ינואר 1970) והמוצגות באמצעות תבנית strftime (ברירת המחדל היא% Y-% m-% d% H :%גברת&quot;). ראה גם - אורך - ו - ציר ציר בפורמט. לבסוף &quot;משך&quot; שבו ערכים מפורשים כמו משך אלפיות השנייה. עיצוב עוקב אחר הכללים של valstrfduration מוסמך הדפסה / GPRINT."

#: include/global_form.php:895
msgid "Left Axis Formatter (--left-axis-formatter &lt;formatname&gt;)"
msgstr "שמאל ציר מעצב (- ציר ציר, פורמט&gt;&gt;)"

#: include/global_form.php:900
msgid "When you setup the left axis labeling, apply a rule to the data format.  Supported formats include \"numeric\" where data is treated as numeric, \"timestamp\" where values are interpreted as UNIX timestamps (number of seconds since January 1970) and expressed using strftime format (default is \"%Y-%m-%d %H:%M:%S\").  See also --units-length.  Finally \"duration\" where values are interpreted as duration in milliseconds.  Formatting follows the rules of valstrfduration qualified PRINT/GPRINT."
msgstr "כאשר אתה מגדיר את תיוג ציר שמאל, להחיל כלל על פורמט הנתונים. הפורמטים הנתמכים כוללים &quot;numeric&quot; כאשר הנתונים מטופלים כמספריים, &quot;חותמת זמן&quot; שבה ערכים מתפרשים כחותמות זמן של UNIX (מספר שניות מאז ינואר 1970) והמוצגות באמצעות תבנית strftime (ברירת המחדל היא% Y-% m-% d% H :%גברת&quot;). ראה גם - אורך. לבסוף &quot;משך&quot; שבו ערכים מפורשים כמו משך אלפיות השנייה. עיצוב עוקב אחר הכללים של valstrfduration מוסמך הדפסה / GPRINT."

#: include/global_form.php:903
msgid "Legend Options"
msgstr "אפשרויות מקרא"

#: include/global_form.php:908
msgid "Auto Padding"
msgstr "ריפוד אוטומטי"

#: include/global_form.php:912
msgid "Pad text so that legend and graph data always line up. Note: this could cause graphs to take longer to render because of the larger overhead. Also Auto Padding may not be accurate on all types of graphs, consistent labeling usually helps."
msgstr "טקסט פד כך אגדה ונתונים גרף תמיד בשורה. הערה: פעולה זו עלולה לגרום לגרפים להימשך זמן רב יותר בגלל התקרה הגדולה יותר. גם ריפוד אוטומטי לא יכול להיות מדויק על כל סוגי הגרפים, תיוג עקביות בדרך כלל עוזר."

#: include/global_form.php:915
msgid "Dynamic Labels (--dynamic-labels)"
msgstr "תוויות דינמיות (תוויות דינמיות)"

#: include/global_form.php:918
msgid "Draw line markers as a line."
msgstr "צייר סמני קו כשורה."

#: include/global_form.php:921
msgid "Force Rules Legend (--force-rules-legend)"
msgstr "חוקי כללים מקרא (- Force-rules-legend)"

#: include/global_form.php:924
msgid "Force the generation of HRULE and VRULE legends."
msgstr "כוח דור של HRULE ו VRULE אגדות."

#: include/global_form.php:927
msgid "Tab Width (--tabwidth &lt;pixels&gt;)"
msgstr "רוחב לשונית (- רוחב פס &lt;פיקסלים&gt;)"

#: include/global_form.php:932
msgid "By default the tab-width is 40 pixels, use this option to change it."
msgstr "כברירת מחדל, רוחב הכרטיסיות הוא 40 פיקסלים, השתמש באפשרות זו כדי לשנות זאת."

#: include/global_form.php:935
msgid "Legend Position (--legend-position=&lt;position&gt;)"
msgstr "מקרא מיקום (--legend-position = &lt;position&gt;)"

#: include/global_form.php:939
msgid "Place the legend at the given side of the graph."
msgstr "מקם את האגדה בצד הנתון של התרשים."

#: include/global_form.php:942
msgid "Legend Direction (--legend-direction=&lt;direction&gt;)"
msgstr "מקרא כיוון (- ליגת כיוון = &lt;כיוון&gt;)"

#: include/global_form.php:946
msgid "Place the legend items in the given vertical order."
msgstr "הצב את פריטי האגדה בסדר האנכי הנתון."

#: include/global_form.php:953 lib/api_aggregate.php:2339 lib/html.php:1364
msgid "Graph Item Type"
msgstr "סוג פריט גרף"

#: include/global_form.php:957
msgid "How data for this item is represented visually on the graph."
msgstr "כיצד הנתונים עבור פריט זה מיוצגים באופן חזותי על הגרף."

#: include/global_form.php:972
msgid "The data source to use for this graph item."
msgstr "מקור הנתונים שישמש לפריט גרף זה."

#: include/global_form.php:979
msgid "The color to use for the legend."
msgstr "הצבע לשימוש עבור האגדה."

#: include/global_form.php:982
msgid "Opacity/Alpha Channel"
msgstr "אטימות / ערוץ אלפא"

#: include/global_form.php:986
msgid "The opacity/alpha channel of the color."
msgstr "ערוץ אטימות / אלפא של הצבע."

#: include/global_form.php:989 lib/rrd.php:4217
msgid "Consolidation Function"
msgstr "פונקציית איחוד"

#: include/global_form.php:993
msgid "How data for this item is represented statistically on the graph."
msgstr "כיצד הנתונים עבור פריט זה מיוצגים באופן סטטיסטי בתרשים."

#: include/global_form.php:996
msgid "CDEF Function"
msgstr "פונקציית CDEF"

#: include/global_form.php:1001
msgid "A CDEF (math) function to apply to this item on the graph or legend."
msgstr "פונקציה CDEF (מתמטיקה) כדי להחיל על פריט זה על הגרף או האגדה."

#: include/global_form.php:1004
msgid "VDEF Function"
msgstr "פונקציה VDEF"

#: include/global_form.php:1009
msgid "A VDEF (math) function to apply to this item on the graph legend."
msgstr "פונקצית VDEF (מתמטיקה) כדי להחיל על פריט זה על מקרא הגרף."

#: include/global_form.php:1012
msgid "Shift Data"
msgstr "Shift Data"

#: include/global_form.php:1015
