msgstr "Максимальное количество каталогов устройств, которое будет создано на основе хешированных идентификаторов устройств."

#: include/global_settings.php:2346 include/global_settings.php:2378
msgid "Proxy Server"
msgstr "Прокси Сервер"

#: include/global_settings.php:2347
msgid "The DNS hostname or IP address of the RRDtool proxy server."
msgstr "Имя узла DNS или IP-адрес прокси-сервера RRDtool."

#: include/global_settings.php:2352 include/global_settings.php:2384
