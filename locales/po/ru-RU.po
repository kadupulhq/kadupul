msgstr "Ограничение памяти для Boost и Poller"

#: include/global_settings.php:2135
msgid "The maximum amount of memory for the Kadupul Poller and Boosts Poller"
msgstr "Максимальный объем памяти для Kadupul Poller и Boosts Poller"

#: include/global_settings.php:2141
msgid "Maximum RRD Update Script Run Time"
msgstr "Максимальное время выполнения скрипта для обновления RRD"

#: include/global_settings.php:2142
