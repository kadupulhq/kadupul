msgstr "Η μέγιστη ποσότητα μνήμης για το Kadupul Poller και το Data Poller Statistics Poller"

#: include/global_settings.php:2239
msgid "RRDfile Check"
msgstr "RRDfile Cleaner"

#: include/global_settings.php:2244
msgid "Enable RRDfile Check"
