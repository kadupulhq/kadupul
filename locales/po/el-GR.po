msgstr "Τοπικές πληροφορίες σύνδεσης βάσης δεδομένων"

#: lib/installer.php:2251 lib/installer.php:2263
#, php-format
msgid "Database: <b>%s</b>"
msgstr "Βάση δεδομένων: <b> %s</b>"

#: lib/installer.php:2252 lib/installer.php:2264
#, php-format
msgid "Database User: <b>%s</b>"
msgstr "Χρήστης βάσης δεδομένων: <b> %s</b>"

#: lib/installer.php:2253 lib/installer.php:2265
#, php-format
msgid "Database Hostname: <b>%s</b>"
