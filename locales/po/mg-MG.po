msgstr "Azafady safidio ny karazam-pametrahana"

#: lib/installer.php:2184
msgid "Installation options:"
msgstr "Safidy fametrahana:"

#: lib/installer.php:2188
msgid "Choose this for the Primary site."
msgstr "Safidio ity ho an'ny toerana voalohany (Primary)."

