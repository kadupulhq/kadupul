msgstr "Idadi ya saa mfululizo zinazowakilisha wastani wa kila saa.  Kumbuka kuwa mpangilio ulio juu mno unaweza kusababisha majedwali makubwa sana ya kumbukumbu"

#: include/global_settings.php:2293
msgid "Maintenance Time"
msgstr "Muda wa Matengenezo"

#: include/global_settings.php:2294
msgid "What time of day should Weekly, Monthly, and Yearly Data be updated?  Format is HH:MM [am/pm]"
msgstr "Saa ngapi ya siku ambapo Data ya Kila Wiki, Kila Mwezi, na Kila Mwaka inapaswa kusasishwa?  Umbizo ni HH:MM [am/pm]"

#: include/global_settings.php:2301
msgid "Memory Limit for Data Source Statistics Data Collector"
