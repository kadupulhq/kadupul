msgstr "Hii ni idadi ya herufi zitakazoruhusiwa kabla mstari katika Barua pepe haujakunjwa kiotomatiki. (0 = Imezimwa)"

#: include/global_settings.php
msgid "This is the Email address that the Email will appear from."
msgstr "Hii ni anwani ya Barua pepe ambayo Barua pepe itaonekana imetoka."

#: include/global_settings.php
msgid "This is the actual name that the Email will appear from."
msgstr "Hili ni jina halisi ambalo Barua pepe itaonekana imetoka."

