msgstr "Broj istodobnih DSStats procesa koji se koriste za obradu svih izvora podataka."

#: include/global_settings.php:2279
msgid "Daily Update Frequency"
msgstr "Učestalost dnevnog ažuriranja"

#: include/global_settings.php:2280
