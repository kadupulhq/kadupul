{
  "schema_version": 1,
  "name": "openconfig-interfaces",
  "version": "1.0.0",
  "description": "Interface traffic, error and operational state counters from openconfig-interfaces, with an IF-MIB fallback.",
  "capabilities": {
    "any": ["openconfig-interfaces", "snmp:if-mib"]
  },
  "model_families": ["openconfig", "snmp-mib"],
  "discovery": {
    "resource": "interface",
    "identity": { "key": "name", "description": "Interface name as reported by the device." },
    "mappings": {
      "snmp": { "identity_oid": "1.3.6.1.2.1.31.1.1.1.1" },
      "gnmi": { "path": "/interfaces/interface/state/name", "origin": "openconfig" }
    }
  },
  "metrics": [
    {
      "id": "interface.in_octets",
      "type": "counter",
      "unit": "octets",
      "counter_bits": 64,
      "labels": ["name"],
      "mappings": {
        "snmp": { "oid": "1.3.6.1.2.1.31.1.1.1.6", "mib": "IF-MIB", "object": "ifHCInOctets" },
        "gnmi": { "path": "/interfaces/interface[name=*]/state/counters/in-octets", "origin": "openconfig" }
      }
    },
    {
      "id": "interface.out_octets",
      "type": "counter",
      "unit": "octets",
      "counter_bits": 64,
      "labels": ["name"],
      "mappings": {
        "snmp": { "oid": "1.3.6.1.2.1.31.1.1.1.10", "mib": "IF-MIB", "object": "ifHCOutOctets" },
        "gnmi": { "path": "/interfaces/interface[name=*]/state/counters/out-octets", "origin": "openconfig" }
      }
    },
    {
      "id": "interface.in_errors",
      "type": "counter",
      "unit": "packets",
      "counter_bits": 32,
      "labels": ["name"],
      "mappings": {
        "snmp": { "oid": "1.3.6.1.2.1.2.2.1.14", "mib": "IF-MIB", "object": "ifInErrors" },
        "gnmi": { "path": "/interfaces/interface[name=*]/state/counters/in-errors", "origin": "openconfig" }
      }
    },
    {
      "id": "interface.oper_status",
      "type": "gauge",
      "unit": "state",
      "labels": ["name"],
      "description": "1 up, 2 down, 3 testing, 4 unknown, 5 dormant, 6 not present, 7 lower layer down (IF-MIB ifOperStatus values).",
      "mappings": {
        "snmp": { "oid": "1.3.6.1.2.1.2.2.1.8", "mib": "IF-MIB", "object": "ifOperStatus" },
        "gnmi": {
          "path": "/interfaces/interface[name=*]/state/oper-status",
          "origin": "openconfig",
          "value_map": { "UP": 1, "DOWN": 2, "TESTING": 3, "UNKNOWN": 4, "DORMANT": 5, "NOT_PRESENT": 6, "LOWER_LAYER_DOWN": 7 }
        }
      }
    }
  ],
  "collection": {
    "protocol_preference": ["gnmi", "snmp"],
    "interval_seconds": { "min": 10, "default": 60 }
  },
  "graphs": [
    { "name": "Interface traffic", "metrics": ["interface.in_octets", "interface.out_octets"], "unit": "octets" },
    { "name": "Interface errors", "metrics": ["interface.in_errors"], "unit": "packets" }
  ],
  "alerts": [
    {
      "name": "Interface down",
      "metric": "interface.oper_status",
      "condition": { "operator": "eq", "threshold": 2, "for_seconds": 120 },
      "severity": "warning"
    }
  ],
  "compatibility": {
    "kadupul": ">=1.0 <2.0",
    "legacy_templates": {
      "graph_templates": ["Interface - Traffic (bits/sec)", "Interface - Errors/Discards"],
      "data_queries": ["SNMP - Interface Statistics"]
    }
  }
}
