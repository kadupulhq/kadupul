# Local documentation, when an operator installs it here, is linked from the
# help pages and served by docs/index.php, so those stay readable along with
# the HTML and its assets. Everything else is denied. main denies all of
# docs/; the 1.2 series keeps these served so 1.2.31 help links still work.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
</IfModule>

<FilesMatch "\.(html?|css|js|png|jpe?g|gif|svg|webp|ico)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Allow from all
    </IfModule>
</FilesMatch>

# Only the top-level index is the documentation landing page, so a PHP file
# named index.php deeper in docs/ must not run. The match is case-sensitive
# because on a case-insensitive filesystem INDEX.PHP would be served as source.
<IfModule mod_authz_core.c>
    <If "%{REQUEST_URI} =~ m#/docs/(index\.php)?$#">
        Require all granted
    </If>
</IfModule>

# Apache 2.2 has no <If>; FilesMatch cannot tell depth, so mod_rewrite
# refuses the nested index files where it is loaded.
<IfModule !mod_authz_core.c>
    <FilesMatch "^(index\.php)?$">
        Order Allow,Deny
        Allow from all
    </FilesMatch>
    <IfModule mod_rewrite.c>
        RewriteEngine On
        RewriteOptions Inherit
        RewriteRule ^.+/index\.php$ - [F,NC]
    </IfModule>
</IfModule>
