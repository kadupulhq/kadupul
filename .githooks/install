#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 The Kadupul project and contributors
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

# core.hooksPath holds one value. Pointing it here silently replaces whatever
# the contributor already had, which for anyone running a global hooks
# directory means losing those checks for this repository without being told.
#
# Ask whether it is set rather than whether it is non-empty. Git reads an
# empty value as "run no hooks at all", so treating that as unset would
# overwrite a deliberate choice, which is the case this guard exists for.
if existing=$(git config --get core.hooksPath) && [ "$existing" != '.githooks' ]; then
	if [ -z "$existing" ]; then
		printf 'core.hooksPath is set to an empty value, which turns hooks off here.\n'
		printf '\n'
		printf 'Setting it to .githooks turns them back on for this repository.\n'
	else
		printf 'core.hooksPath is already set to %s\n' "$existing"
		printf '\n'
		printf 'Setting it to .githooks replaces those hooks for this repository.\n'
		printf 'If they already run %s/.githooks/pre-commit, nothing is needed here.\n' "$root"
		printf 'Look for that in %s/pre-commit.\n' "$existing"
	fi

	printf '\n'
	printf 'To replace them anyway:\n'
	printf '  git config --local core.hooksPath .githooks\n'
	exit 1
fi

git config --local core.hooksPath .githooks

printf 'Kadupul Git hooks enabled for %s\n' "$root"
printf 'Disable them with: git config --local --unset core.hooksPath\n'
