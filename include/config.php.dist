//$php_snmp_support = false;

/**
 * By default, the installer stores the CSRF secret in the Cacti settings
 * table. Packagers may instead define an external secret file. The file must
 * be outside the Cacti document root and its parent directory must already
 * exist. It must contain between 32 and 4096 bytes. Runtime web requests never
 * create this file.
 */

//$path_csrf_secret = '/usr/share/cacti/resource/csrf-secret.php';

/**
 * Optional host names, besides the web server's own name, that the forced
 * HTTPS redirect may send a browser to. Without an entry, a Host header that
 * differs from the server name is replaced by the server name, unless the
 * server name is empty, "_" or a wildcard. List the external name here when
 * Cacti is reached through a name other than its internal ServerName. When
 * the web server sets no server name, validate_redirect_url() also needs the
 * name listed here to accept a same-host return URL.
 */

//$trusted_hosts = array('cacti.example.com');

/**
 * The following are optional variables for debugging low level system
 * functions that are generally only used by Cacti Developers to help
 * identify potential issues in commonly used functions
 *
 * To use them, uncomment and the equivalent field will be set in the
 * $config variable allowing for instant on but still allowing the
 * ability to fine turn and turn them off.
 */

/**
 * Debug the read_config_option program flow
 */
#if (!defined('DEBUG_READ_CONFIG_OPTION')) {
#	define('DEBUG_READ_CONFIG_OPTION', true);
#}

/**
 * Automatically suppress the DEBUG_READ_CONFIG_OPTION
 */
#if (!defined('DEBUG_READ_CONFIG_OPTION_DB_OPEN')) {
#	define('DEBUG_READ_CONFIG_OPTION_DB_OPEN', true);
#}

/**
 * Always write the SQL command to the cacti log file
 */
#if (!defined('DEBUG_SQL_CMD')) {
#	define('DEBUG_SQL_CMD', true);
#}

/**
 * Debug the flow of calls to the db_xxx functions that
 * are defined in lib/database.php
 */
#if (!defined('DEBUG_SQL_FLOW')) {
#	define('DEBUG_SQL_FLOW', true);
#}

/**
 * Debug the connect and disconnect activity
 * and the first execute from each connection
 * to the PHP error_log.
 */
#if (!defined('DEBUG_SQL_CONNECT')) {
#	define('DEBUG_SQL_CONNECT', true);
#}

/**
 * Allow the use of Proxy IPs when searching for client
 * IP to be used
 *
 * This can be set to one of the following:
 *   - false: to use only REMOTE_ADDR
 *   - true: to use all allowed headers (not advised)
 *   - array of one or more the following:
 *		'X-Forwarded-For',
 *		'X-Client-IP',
 *		'X-Real-IP',
 *		'X-ProxyUser-Ip',
 *		'CF-Connecting-IP',
 *		'True-Client-IP',
 *		'HTTP_X_FORWARDED',
 *		'HTTP_X_FORWARDED_FOR',
 *		'HTTP_X_CLUSTER_CLIENT_IP',
 *		'HTTP_FORWARDED_FOR',
 *		'HTTP_FORWARDED',
 *		'HTTP_CLIENT_IP',
 *
 * NOTE: The following will always be checked:
 *		'REMOTE_ADDR',
 *
 * NOTE: Without $trusted_proxies below, any client can set these
 * headers, and Remote Data Collector authorization uses the
 * resulting address.  Dash-style names only take effect when
 * $trusted_proxies is set; otherwise use the HTTP_* names.
 */
$proxy_headers = null;

/**
 * Optional, and recommended when $proxy_headers is used: the
 * addresses or CIDR ranges of the reverse proxies allowed to
 * supply those headers, for example:
 *
 *   $trusted_proxies = array('127.0.0.1', '10.1.0.0/24', '2001:db8::/64');
 *
 * When set, the headers, including X-Forwarded-Proto for the
 * session cookie, are only honoured from a listed proxy, and the
 * right-most address that is not a listed proxy is used.  When
 * unset, the headers are handled as in earlier releases.
 */
$trusted_proxies = null;

/*
 * Set this to define the default i18n handler if not set
 * in the database.  For valid values, see CACTI_LANGUAGE_HANDLER
 * constants but only use the value not the constant name
 * here because we have not included global_constants.php
 * yet
 */
$i18n_handler = null;

/*
 * Set this to define ignore everything else and force a
 * specific language.  Should be in the format of a string
 * such as 'es-ES'
 */
$i18n_force_language = null;

/**
 * Define the location to log general i18n function calls
 * to for debugging purposes.  Note that if you use /tmp
 * some systemd systems will remap that folder to special
 * locations under /tmp/systemd<uniqueid>/tmp
 */
$i18n_log = null;

/**
 * Define the location to log translation i18n function calls
 * to for debugging purposes.  Note that if you use /tmp
 * some systemd systems will remap that folder to special
 * locations under /tmp/systemd<uniqueid>/tmp
 */
$i18n_text_log = null;

/**
 * RRD storage shared by separate web and poller Unix accounts requires an
 * explicit trust list, identical in every process that accesses the store.
 * Use numeric Unix IDs, for example array(33, 1001), after checking local IDs.
 * Trusted accounts may replace storage paths; quiesce all writers before doing
 * so. Only list a group when ALL its members are trusted storage administrators.
 * World-writable storage is always rejected. Empty lists trust root/current UID.
 */
$config['rrd_maintenance_trusted_uids'] = array();
$config['rrd_maintenance_trusted_gids'] = array();

// Maximum time for one acknowledged RRDtool command, including large dumps.
// Default: 60 seconds. Accepted range: 1 through 3600 seconds. Timeouts retain
// queued samples and invalidate the failed pipe; a new operation opens a new one.
// A command can hold the writer lease for this entire period. Keep this below
// the poller interval/runtime budget; larger values can delay other writers.
// $config['rrd_command_timeout'] = 60;
