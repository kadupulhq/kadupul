# include/ serves the interface's scripts, styles and images, so only the
# bootstrap files and include/vendor are denied. The name match also covers
# config.php.dist, suffixed backups such as config.php.bak and config.php~,
# and the hidden or hash-wrapped copies editors write beside the file
# (.config.php.swp, #config.php#, .#config.php).
<FilesMatch "(?i)^[.#]*(config|global|plugins)\.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# include/vendor is rebuilt by Composer, so its deny lives here. Only the
# static types the interface loads (flag-icons CSS and images, csrf-magic.js)
# stay served, and not under a name such as x.php.css, which a server that
# maps handlers with AddHandler runs as PHP. The test runs on the mapped file,
# not the request URI, which keeps repeated slashes from reaching vendor PHP
# when MergeSlashes is off.
<IfModule mod_authz_core.c>
    <If "%{REQUEST_FILENAME} =~ m#/include/+vendor(/|$)#i && ! %{REQUEST_FILENAME} =~ m#\.(css|js|svg|png|gif|jpe?g|webp|ico|woff2?|ttf|eot|otf)$#i || %{REQUEST_FILENAME} =~ m#/include/+vendor/.*\.ph(p|tml|ar)\.[^/]*$#i">
        Require all denied
    </If>
</IfModule>

# Apache 2.2 has no <If>. This file is always active, so the rule is guarded:
# an unguarded RewriteEngine would answer 500 for all of include/ on a 2.2
# server without mod_rewrite. Inherit keeps any root rewrite rules in force
# below this directory.
<IfModule !mod_authz_core.c>
    <IfModule mod_rewrite.c>
        RewriteEngine On
        RewriteOptions Inherit
        RewriteCond %{REQUEST_FILENAME} !\.(css|js|svg|png|gif|jpe?g|webp|ico|woff2?|ttf|eot|otf)$ [NC,OR]
        RewriteCond %{REQUEST_FILENAME} \.ph(p|tml|ar)\.[^/]*$ [NC]
        RewriteRule ^/*vendor(/|$) - [F,NC]
    </IfModule>
</IfModule>
