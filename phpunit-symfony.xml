<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="include/vendor/autoload.php"
         cacheDirectory="var/phpunit"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Symfony modules">
            <directory>tests/Symfony</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
            <file>bin/legacy-device-edit.php</file>
            <file>bin/legacy-device-create.php</file>
            <file>bin/legacy-device-template.php</file>
            <file>bin/legacy-device-collector.php</file>
            <file>include/admin_notifications.php</file>
            <file>sites.php</file>
            <file>lib/database.php</file>
        </include>
    </source>
</phpunit>
