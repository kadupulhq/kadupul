{
  "function": "cacti_log",
  "cases": [
    {"id": "line_shape_in_file", "args": ["hello"], "ambient": {"settings": {"path_cactilog": "log/fnclog_cl.log"}}, "prelude": [{"fn": "behavior_fixture_write", "args": ["log/fnclog_cl.log", ""]}], "between": [{"fn": "behavior_fixture_read", "args": ["log/fnclog_cl.log"]}], "note": "the file itself: timestamp format, one LF per record; a second identical call appends a second line"},
    {"id": "basic_line", "args": ["hello"], "note": "file line: <date> - <environ> <message>; a second identical call appends a second line"},
    {"id": "environ_custom", "args": ["x", false, "FOO"]},
    {"id": "environ_empty", "args": ["x", false, ""], "note": "empty environ leaves two spaces after the dash"},
    {"id": "environ_null", "args": ["x", false, null]},
    {"id": "environ_poller", "args": ["x", false, "POLLER"], "ambient": {"config": {"poller_id": 1}}, "note": "POLLER adds Poller[id] PID[pid]; the PID is replaced"},
    {"id": "output_cli_plain", "args": ["x", true], "note": "CLI: the line, with the date prefix, is printed as well as logged"},
    {"id": "output_cli_poller", "args": ["x", true, "POLLER"], "ambient": {"config": {"poller_id": 1}}, "note": "POLLER prints Total[elapsed] instead of the date prefix"},
    {"id": "output_web_no_argv", "args": ["x", true], "prelude": [{"fn": "behavior_fixture_server", "args": ["argv", null]}], "note": "no $_SERVER[argv]: web request, nothing printed", "isolated": true},
    {"id": "output_cli_verbosity_none", "args": ["x", true], "ambient": {"settings": {"log_verbosity": "1"}}, "note": "verbosity NONE: nothing in the file, but the CLI still prints"},
    {"id": "empty_string", "args": [""], "note": "returns false, no line"},
    {"id": "null_message", "args": [null]},
    {"id": "array_message", "args": [["a"]], "note": "trim() rejects an array"},
    {"id": "invalid_utf8", "args": [{"$": "bytes", "hex": "666f6ffffe626172"}], "note": "bytes are written as they are"},
    {"id": "lf_embedded", "args": ["first\nsecond"], "note": "SECURITY: clean_up_lines turns LF into a space, so an LF in the message cannot start a record"},
    {"id": "nul_byte", "args": ["a\u0000b"], "note": "SECURITY: NUL is written as the visible text \\x00, not the byte (#870)"},
    {"id": "esc_sequence", "args": ["a\u001b[31mred\u001b[0mb"], "note": "SECURITY: ESC is written as the visible text \\x1b, so the escape sequence is inert (#870)"},
    {"id": "environ_lf_injection", "args": ["msg", false, "X\n2026-01-01 00:00:00 - FORGED"], "note": "SECURITY: an LF in $environ becomes a space, so it cannot start a second record (#870)"},
    {"id": "environ_cr_injection", "args": ["msg", false, "X\r2026-01-01 00:00:00 - FORGED"], "note": "SECURITY: a CR in $environ becomes a space (#870)"},
    {"id": "environ_crlf_injection", "args": ["msg", false, "X\r\n2026-01-01 00:00:00 - FORGED"], "note": "SECURITY: CR and LF in $environ each become one space (#870)"},
    {"id": "environ_controls", "args": ["msg", false, "E\u0000N\u001b[2JV\u007f"], "note": "SECURITY: other control bytes in $environ are escaped as in the message (#870)"},
    {"id": "environ_bidi", "args": ["msg", false, "E\u202eV"], "note": "SECURITY: a bidirectional override in $environ is escaped (#870)"},
    {"id": "c0_controls", "args": ["a\u0001\u0007\u000b\f\u001fb"], "note": "SECURITY: C0 controls other than tab, CR and LF are written as \\xNN (#870)"},
    {"id": "del_byte", "args": ["a\u007fb"], "note": "SECURITY: DEL is written as \\x7f (#870)"},
    {"id": "tab_kept", "args": ["a\tb", false, "E\tV"], "note": "a tab is kept in the message and in $environ"},
    {"id": "c1_controls", "args": ["a\u0080\u0085\u009b\u009fb"], "note": "SECURITY: C1 controls are written as \\uNNNN (#870)"},
    {"id": "bidi_controls", "args": ["a\u200e\u200f\u061c\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069b"], "note": "SECURITY: bidirectional and isolate controls are written as \\uNNNN (#870)"},
    {"id": "multibyte_unchanged", "args": ["caf\u00e9 \u65e5\u672c\u8a9e \ud83d\ude00 \ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67 \u2028\u00a0\u061b"], "note": "valid UTF-8 outside the escaped set, including ZWJ and U+2028, is written byte for byte"},
    {"id": "invalid_utf8_controls", "args": [{"$": "bytes", "hex": "61fffe1b62"}], "note": "invalid UTF-8 is kept and a control byte beside it is still escaped (#870)"},
    {"id": "output_cli_controls", "args": ["a\u001b[31mb", true, "E\nV"], "note": "SECURITY: the printed line is neutralized the same way as the file line (#870)"},
    {"id": "gate_low_level_empty", "args": ["m", false, "CMDPHP", ""], "ambient": {"settings": {"log_verbosity": "2"}}},
    {"id": "gate_low_level_low", "args": ["m", false, "CMDPHP", 2], "ambient": {"settings": {"log_verbosity": "2"}}},
    {"id": "gate_low_level_debug", "args": ["m", false, "CMDPHP", 5], "ambient": {"settings": {"log_verbosity": "2"}}},
    {"id": "gate_none_level_low", "args": ["m", false, "CMDPHP", 2], "ambient": {"settings": {"log_verbosity": "1"}}},
    {"id": "gate_medium_level_medium", "args": ["m", false, "CMDPHP", 3], "ambient": {"settings": {"log_verbosity": "3"}}},
    {"id": "gate_debug_level_debug", "args": ["m", false, "CMDPHP", 5], "ambient": {"settings": {"log_verbosity": "5"}}},
    {"id": "gate_devdbg_level_low", "args": ["m", false, "CMDPHP", 2], "ambient": {"settings": {"log_verbosity": "6"}}},
    {"id": "gate_devdbg_level_medium", "args": ["m", false, "CMDPHP", 3], "ambient": {"settings": {"log_verbosity": "6"}}},
    {"id": "gate_devdbg_level_devdbg", "args": ["m", false, "CMDPHP", 6], "ambient": {"settings": {"log_verbosity": "6"}}},
    {"id": "selective_file_forces_debug", "args": ["m", false, "CMDPHP", 5], "ambient": {"settings": {"log_verbosity": "2", "selective_debug": "probe.php"}}, "note": "the running script is listed: its level is forced to DEBUG, so a DEBUG message is logged under LOW", "isolated": true},
    {"id": "selective_plugin_forces_debug", "args": ["m", false, "CMDPHP", 5], "ambient": {"settings": {"selective_plugin_debug": "myplug"}}, "prelude": [{"fn": "behavior_fixture_server", "args": ["PHP_SELF", "/var/www/html/plugins/myplug/x.php"]}], "isolated": true},
    {"id": "dest_file", "args": ["ERROR: e"], "ambient": {"settings": {"log_destination": "1"}}},
    {"id": "dest_both", "args": ["ERROR: e"], "ambient": {"settings": {"log_destination": "2"}}},
    {"id": "dest_syslog_only", "args": ["ERROR: e"], "ambient": {"settings": {"log_destination": "3"}}, "note": "nothing in the file; the syslog write is not observable from PHP"},
    {"id": "syslog_d2_error_1--", "args": ["ERROR: e"], "ambient": {"settings": {"log_destination": "2", "log_perror": "1", "log_pwarn": "", "log_pstats": ""}}, "note": "syslog() is not observable from PHP; this reaches the branch, the file shows the part that is"},
    {"id": "syslog_d2_error_---", "args": ["ERROR: e"], "ambient": {"settings": {"log_destination": "2", "log_perror": "", "log_pwarn": "", "log_pstats": ""}}},
    {"id": "syslog_d2_warning_-1-", "args": ["WARNING: w"], "ambient": {"settings": {"log_destination": "2", "log_perror": "", "log_pwarn": "1", "log_pstats": ""}}},
    {"id": "syslog_d2_warning_---", "args": ["WARNING: w"], "ambient": {"settings": {"log_destination": "2", "log_perror": "", "log_pwarn": "", "log_pstats": ""}}},
    {"id": "syslog_d2_stats_--1", "args": ["STATS: s"], "ambient": {"settings": {"log_destination": "2", "log_perror": "", "log_pwarn": "", "log_pstats": "1"}}},
    {"id": "syslog_d2_notice_--1", "args": ["NOTICE: n"], "ambient": {"settings": {"log_destination": "2", "log_perror": "", "log_pwarn": "", "log_pstats": "1"}}},
    {"id": "syslog_d2_notice_---", "args": ["NOTICE: n"], "ambient": {"settings": {"log_destination": "2", "log_perror": "", "log_pwarn": "", "log_pstats": ""}}},
    {"id": "syslog_d2_plain_111", "args": ["plain"], "ambient": {"settings": {"log_destination": "2", "log_perror": "1", "log_pwarn": "1", "log_pstats": "1"}}},
    {"id": "syslog_d3_error_1--", "args": ["ERROR: e"], "ambient": {"settings": {"log_destination": "3", "log_perror": "1", "log_pwarn": "", "log_pstats": ""}}},
    {"id": "syslog_d3_plain_111", "args": ["plain"], "ambient": {"settings": {"log_destination": "3", "log_perror": "1", "log_pwarn": "1", "log_pstats": "1"}}},
    {"id": "syslog_win32_openlog", "args": ["ERROR: e"], "ambient": {"settings": {"log_destination": "3", "log_perror": "1"}, "config": {"cacti_server_os": "win32"}}},
    {"id": "path_empty_uses_default", "args": ["x"], "ambient": {"settings": {"path_cactilog": ""}}, "note": "falls back to log/cacti.log, which result.log reads"},
    {"id": "path_missing_directory", "args": ["x"], "ambient": {"settings": {"path_cactilog": "log/fnclog_nodir/cacti.log"}}, "note": "fopen fails silently; the function still returns null"},
    {"id": "path_is_directory", "args": ["x"], "ambient": {"settings": {"path_cactilog": "log"}}},
    {"id": "path_read_only_file", "args": ["x"], "ambient": {"settings": {"path_cactilog": "log/fnclog_cl.log"}}, "prelude": [{"fn": "behavior_fixture_write", "args": ["log/fnclog_cl.log", "", 292]}], "between": [{"fn": "behavior_fixture_read", "args": ["log/fnclog_cl.log"]}], "note": "mode 0444: the append fails, nothing is written, no diagnostic"},
    {"id": "database_log_unset", "args": ["x"], "prelude": [{"fn": "behavior_fixture_peek", "args": ["database_log", true]}], "between": [{"fn": "behavior_fixture_peek", "args": ["database_log"]}], "note": "an unset $database_log is initialised to false and restored to the previous value afterwards"},
    {"id": "dbcall_redacted", "args": ["SELECT secret", false, "DBCALL"], "prelude": [{"fn": "behavior_fixture_define", "args": ["KADUPUL_REDACT_DATABASE_LOGS"]}], "note": "with KADUPUL_REDACT_DATABASE_LOGS defined, DBCALL text is replaced", "isolated": true}
  ]
}
