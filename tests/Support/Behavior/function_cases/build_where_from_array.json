{
  "function": "build_where_from_array",
  "cases": [
    {"id": "empty_array", "args": [[], []]},
    {"id": "null_filters", "args": [null, []], "note": "empty() is true for null"},
    {"id": "zero_filters", "args": [0, []]},
    {"id": "zero_string_filters", "args": ["0", []], "note": "empty(\"0\") is true"},
    {"id": "false_filters", "args": [false, []]},
    {"id": "empty_string_filters", "args": ["", []]},
    {"id": "single", "args": [{"$": "array", "pairs": [["id", 5]]}, []]},
    {"id": "multiple_preserves_order", "args": [{"$": "array", "pairs": [["host_id", 1], ["status", 2], ["name", "x"]]}, []]},
    {"id": "value_types_kept", "args": [{"$": "array", "pairs": [["a", null], ["b", ""], ["c", "0"], ["d", 1.5], ["e", true], ["f", ["x"]]]}, []], "note": "values go into params untouched"},
    {"id": "params_already_populated", "args": [{"$": "array", "pairs": [["id", 5]]}, ["keep"]], "note": "appends to the caller array"},
    {"id": "params_null", "args": [{"$": "array", "pairs": [["id", 5]]}, null], "note": "by-reference null becomes an array"},
    {"id": "params_string", "args": [{"$": "array", "pairs": [["id", 5]]}, "abc"], "note": "[] on a string is an Error"},
    {"id": "invalid_field_skipped", "args": [{"$": "array", "pairs": [["id; DROP TABLE x", 1]]}, []], "note": "logs a SECURITY line, then returns 1=0"},
    {"id": "mixed_valid_invalid", "args": [{"$": "array", "pairs": [["id", 1], ["bad field", 2], ["name", 3]]}, []]},
    {"id": "field_leading_digit", "args": [{"$": "array", "pairs": [["1a", 1]]}, []]},
    {"id": "field_dash", "args": [{"$": "array", "pairs": [["a-b", 1]]}, []]},
    {"id": "field_backtick", "args": [{"$": "array", "pairs": [["a`b", 1]]}, []]},
    {"id": "field_empty_name", "args": [{"$": "array", "pairs": [["", 1]]}, []]},
    {"id": "field_underscore_start", "args": [{"$": "array", "pairs": [["_x", 1]]}, []]},
    {"id": "field_trailing_newline", "args": [{"$": "array", "pairs": [["id\n", 1]]}, []], "note": "a single trailing newline is rejected like any other invalid name; $ alone would accept it"},
    {"id": "field_trailing_two_newlines", "args": [{"$": "array", "pairs": [["id\n\n", 1]]}, []]},
    {"id": "field_embedded_newline", "args": [{"$": "array", "pairs": [["i\nd", 1]]}, []]},
    {"id": "field_unicode", "args": [{"$": "array", "pairs": [["é", 1]]}, []]},
    {"id": "field_int_key", "args": [["a", "b"], []], "note": "a list has integer keys 0 and 1, which fail the pattern"},
    {"id": "field_numeric_string_key", "args": [{"$": "array", "pairs": [["123", 1]]}, []]},
    {"id": "field_long_valid", "args": [{"$": "array", "pairs": [["", 1]]}, []]},
    {"id": "filters_string", "args": ["x", []], "note": "foreach over a string warns; nothing is added"},
    {"id": "filters_int", "args": [5, []]},
    {"id": "filters_true", "args": [true, []]},
    {"id": "missing_params", "args": [{"$": "array", "pairs": [["id", 1]]}], "note": "by-reference parameter has no default"}
  ]
}
