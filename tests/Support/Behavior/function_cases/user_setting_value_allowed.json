{
  "function": "user_setting_value_allowed",
  "cases": [
    {"id": "non_scalar_array", "args": [{"$": "array", "pairs": [["method", "checkbox"]]}, ["on"]], "note": "arrays are refused before anything else"},
    {"id": "scalar_int_cast", "args": [{"$": "array", "pairs": [["method", "checkbox"]]}, 0], "note": "ints are cast to strings: \"0\" is neither on nor empty"},
    {"id": "scalar_false_is_empty_string", "args": [{"$": "array", "pairs": [["method", "checkbox"]]}, false], "note": "false casts to \"\" and passes as an unchecked box"},
    {"id": "equals_default_short_circuit", "args": [{"$": "array", "pairs": [["method", "nonsense"], ["default", "x"]]}, "x"], "note": "the default always passes, whatever the method"},
    {"id": "default_null_is_not_a_default", "args": [{"$": "array", "pairs": [["method", "nonsense"], ["default", null]]}, ""], "note": "isset() is false for null"},
    {"id": "method_missing", "args": [{"$": "array", "pairs": []}, "x"], "note": "no method: refused"},
    {"id": "method_unknown", "args": [{"$": "array", "pairs": [["method", "nonsense"]]}, "x"]},
    {"id": "checkbox_on", "args": [{"$": "array", "pairs": [["method", "checkbox"]]}, "on"]},
    {"id": "checkbox_empty", "args": [{"$": "array", "pairs": [["method", "checkbox"]]}, ""]},
    {"id": "drop_array_key_present", "args": [{"$": "array", "pairs": [["method", "drop_array"], ["array", {"$": "array", "pairs": [["a", "Alpha"], ["1", "One"], ["0", "Zero"], ["", "Blank"]]}]]}, "a"]},
    {"id": "drop_array_key_absent", "args": [{"$": "array", "pairs": [["method", "drop_array"], ["array", {"$": "array", "pairs": [["a", "Alpha"], ["1", "One"], ["0", "Zero"], ["", "Blank"]]}]]}, "b"]},
    {"id": "drop_array_int_key_as_text", "args": [{"$": "array", "pairs": [["method", "drop_array"], ["array", {"$": "array", "pairs": [["a", "Alpha"], ["1", "One"], ["0", "Zero"], ["", "Blank"]]}]]}, "1"], "note": "numeric keys are ints; array_key_exists(\"1\") finds them"},
    {"id": "drop_sql_id_found", "args": [{"$": "array", "pairs": [["method", "drop_sql"], ["sql", "SELECT id, name FROM data_source_profiles_rra ORDER BY steps"]]}, "1"], "record_sql": true},
    {"id": "drop_sql_id_missing", "args": [{"$": "array", "pairs": [["method", "drop_sql"], ["sql", "SELECT id, name FROM data_source_profiles_rra ORDER BY steps"]]}, "999"], "record_sql": true},
    {"id": "drop_sql_missing_sql", "args": [{"$": "array", "pairs": [["method", "drop_sql"]]}, "1"], "note": "undefined key sql", "record_sql": true},
    {"id": "drop_sql_bad_sql", "args": [{"$": "array", "pairs": [["method", "drop_sql"], ["sql", "SELECT nothing FROM nowhere"]]}, "1"], "note": "the database error is swallowed and the loop sees no rows", "record_sql": true},
    {"id": "drop_callback_none_value", "args": [{"$": "array", "pairs": [["method", "drop_callback"], ["none_value", "None"], ["sql", "SELECT id FROM data_source_profiles_rra"]]}, "0"], "note": "none_value set and \"0\": accepted without a query", "record_sql": true},
    {"id": "radio_found", "args": [{"$": "array", "pairs": [["method", "radio"], ["items", {"$": "array", "pairs": [["0", {"$": "array", "pairs": [["radio_value", "a"]]}], ["1", {"$": "array", "pairs": [["radio_value", 2]]}]]}]]}, "a"]},
    {"id": "radio_missing", "args": [{"$": "array", "pairs": [["method", "radio"], ["items", {"$": "array", "pairs": [["0", {"$": "array", "pairs": [["radio_value", "a"]]}]]}]]}, "b"]},
    {"id": "drop_files_file_present", "args": [{"$": "array", "pairs": [["method", "drop_files"], ["directory", "include/themes"]]}, "classic"], "note": "relative to the application directory"},
    {"id": "drop_files_not_a_file", "args": [{"$": "array", "pairs": [["method", "drop_files"], ["directory", "include/themes"]]}, "nonexistent"]},
    {"id": "drop_files_excluded", "args": [{"$": "array", "pairs": [["method", "drop_files"], ["directory", "include/themes"], ["exclusions", ["classic"]]]}, "classic"]},
    {"id": "drop_files_exclusions_not_matching", "args": [{"$": "array", "pairs": [["method", "drop_files"], ["directory", "include/themes"], ["exclusions", ["dark"]]]}, "classic"]},
    {"id": "drop_files_no_directory", "args": [{"$": "array", "pairs": [["method", "drop_files"]]}, "classic"]},
    {"id": "textbox_password_within_max", "args": [{"$": "array", "pairs": [["method", "textbox_password"], ["max_length", 5]]}, "abcde"]},
    {"id": "textbox_password_over_max", "args": [{"$": "array", "pairs": [["method", "textbox_password"], ["max_length", 5]]}, "abcdef"]},
    {"id": "textbox_plain", "args": [{"$": "array", "pairs": [["method", "textbox"]]}, "Plain text 123"]},
    {"id": "textbox_multibyte", "args": [{"$": "array", "pairs": [["method", "textbox"]]}, "Ünï 設備 ✓"]},
    {"id": "textbox_lt", "args": [{"$": "array", "pairs": [["method", "textbox"]]}, "a<b"]},
    {"id": "textbox_nul", "args": [{"$": "array", "pairs": [["method", "textbox"]]}, {"$": "bytes", "hex": "610062"}]},
    {"id": "textbox_max_length_boundary_over", "args": [{"$": "array", "pairs": [["method", "textbox"], ["max_length", 3]]}, "abcd"]},
    {"id": "textbox_numeric_default_accepts_number", "args": [{"$": "array", "pairs": [["method", "textbox"], ["default", "100"]]}, "250"]},
    {"id": "textbox_numeric_default_rejects_text", "args": [{"$": "array", "pairs": [["method", "textbox"], ["default", "100"]]}, "abc"]},
    {"id": "textbox_numeric_default_accepts_exponent", "args": [{"$": "array", "pairs": [["method", "textbox"], ["default", "100"]]}, "1e3"], "note": "is_numeric accepts exponent notation"},
    {"id": "textbox_numeric_default_rejects_trailing_space", "args": [{"$": "array", "pairs": [["method", "textbox"], ["default", "100"]]}, "5 "], "note": "PHP 8 allows trailing whitespace in numeric strings"},
    {"id": "font_plain", "args": [{"$": "array", "pairs": [["method", "font"], ["default", "Arial"]]}, "DejaVu Sans"]}
  ]
}
