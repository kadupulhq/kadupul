# MariaDB 10.11 settings for the Boost load test database host
# (s-8vcpu-16gb by default). provision.sh fills in DB_BUFFER_POOL and
# DB_LOG_FILE_SIZE for the chosen size, and setup-db.sh replaces BIND_ADDRESS
# with the droplet's private IP.
[mysqld]
bind-address                   = BIND_ADDRESS
skip-name-resolve              = 1
character-set-server           = utf8mb4
collation-server               = utf8mb4_unicode_ci
max_connections                = 500
max_allowed_packet             = 128M
table_open_cache               = 4000
tmp_table_size                 = 256M
# poller_output_boost_processes and other Boost tables use the MEMORY engine.
max_heap_table_size            = 256M

innodb_buffer_pool_size        = DB_BUFFER_POOL
innodb_buffer_pool_instances   = 8
innodb_log_file_size           = DB_LOG_FILE_SIZE
innodb_log_buffer_size         = 64M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method            = O_DIRECT
innodb_io_capacity             = 2000
innodb_io_capacity_max         = 4000
innodb_file_per_table          = 1
innodb_lock_wait_timeout       = 50

slow_query_log                 = 1
slow_query_log_file            = /var/log/mysql/slow.log
long_query_time                = 0.1

# Statement digests for the per-run top-20 export. The digest table is reset
# before every measured run.
performance_schema             = ON
performance_schema_digests_size = 20000
