    "require": {
        "php": ">=8.0",
        "ext-PDO": "*",
        "ext-Phar": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-gmp": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-ldap": "*",
        "ext-mbstring": "*",
        "ext-mysqlnd": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo_mysql": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "ext-sqlite3": "*",
        "ext-xml": "*",
        "ezyang/htmlpurifier": "^4.19",
        "paragonie/constant_time_encoding": "^3.1",
        "paragonie/random_compat": "^9.99",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {},
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "vendor-dir": "./include/vendor"
