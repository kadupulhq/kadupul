{
    "_comment": [
        "SPDX-FileCopyrightText: 2004-2026 The Cacti Group",
        "SPDX-FileCopyrightText: 2026 The Kadupul project and contributors",
        "SPDX-License-Identifier: GPL-3.0-or-later"
    ],
    "name": "kadupulhq/kadupul",
    "description": "Network monitoring and graphing",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-PDO": "*",
        "ext-Phar": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-gmp": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-ldap": "*",
        "ext-mbstring": "*",
        "ext-mysqlnd": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo_mysql": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "ext-sqlite3": "*",
        "ext-xml": "*",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.3",
        "ezyang/htmlpurifier": "^4.19",
        "paragonie/constant_time_encoding": "^3.1",
        "paragonie/random_compat": "^9.99",
        "phpseclib/phpseclib": "^4.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/cache": "7.4.*",
        "symfony/cache-contracts": "^3.7",
        "symfony/clock": "7.4.*",
        "symfony/config": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/doctrine-bridge": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/options-resolver": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/translation-contracts": "^3.7",
        "symfony/twig-bundle": "7.4.*",
        "symfony/workflow": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/twig": "^3.29"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^10.5",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "vendor-dir": "./include/vendor",
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Kadupul\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kadupul\\Tests\\": "tests/Symfony/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php tools/dependencies/install-legacy.php"
        ],
        "post-update-cmd": [
            "@php tools/dependencies/install-legacy.php"
        ],
        "test": "@php include/vendor/bin/phpunit --configuration phpunit-symfony.xml",
        "phpstan": [
            "@putenv APP_ENV=dev",
            "@putenv APP_DEBUG=1",
            "@php bin/console cache:warmup",
            "@php include/vendor/bin/phpstan analyse --memory-limit=2G --no-progress"
        ],
        "deptrac": "@php include/vendor/bin/deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered --no-progress",
        "dependency-analyser": "@php include/vendor/bin/composer-dependency-analyser --config=tools/composer-dependency-analyser.php",
        "analyse": [
            "@phpstan",
            "@deptrac",
            "@dependency-analyser"
        ]
    }
}
