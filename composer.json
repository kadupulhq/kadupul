{
    "_comment": [
        "SPDX-FileCopyrightText: 2004-2026 The Cacti Group",
        "SPDX-FileCopyrightText: 2026 The Kadupul project and contributors",
        "SPDX-License-Identifier: GPL-3.0-or-later"
    ],
    "name": "kadupulhq/kadupul",
    "description": "Network monitoring and graphing",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-PDO": "*",
        "ext-Phar": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-gmp": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-ldap": "*",
        "ext-mbstring": "*",
        "ext-mysqlnd": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo_mysql": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "ext-sqlite3": "*",
        "ext-xml": "*",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.3",
        "ezyang/htmlpurifier": "^4.19",
        "paragonie/constant_time_encoding": "^3.1",
        "paragonie/random_compat": "^9.99",
        "phpseclib/phpseclib": "^4.0",
        "symfony/cache": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "vendor-dir": "./include/vendor"
    },
    "autoload": {
        "psr-4": {
            "Kadupul\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kadupul\\Tests\\": "tests/Symfony/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php tools/dependencies/install-legacy.php"
        ],
        "post-update-cmd": [
            "@php tools/dependencies/install-legacy.php"
        ],
        "test": "@php include/vendor/bin/phpunit --configuration phpunit-symfony.xml"
    }
}
