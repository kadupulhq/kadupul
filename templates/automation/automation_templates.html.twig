{% extends 'base.html.twig' %}
{% import '_list.html.twig' as list %}
{% block title %}{{ 'Device Automation Templates'|trans({}, 'automation') }} · Kadupul{% endblock %}
{% block body %}
<main>
    <h1>{{ 'Device Automation Templates'|trans({}, 'automation') }}</h1>
    {% if saved %}<output>{{ 'Automation template saved.'|trans({}, 'automation') }}</output>{% endif %}
    {% if deleted %}<output>{{ 'Automation templates deleted.'|trans({}, 'automation') }}</output>{% endif %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
    <p><a href="{{ path('automation_template_create') }}">{{ 'Add Automation Template'|trans({}, 'automation') }}</a></p>
    {% embed '_list_filter.html.twig' with {action: path('automation_templates')} %}
    {% block filters %}
        {% import '_list.html.twig' as list %}
        <label for="automation-template-filter">{{ 'Search'|trans({}, 'automation') }}</label>
        <input id="automation-template-filter" name="filter" type="search" maxlength="200" value="{{ filters.filter }}">
        {{ list.rows_per_page('automation-template-rows', 'Templates', {'-1': 'Default', '10': '10', '15': '15', '16': '16', '17': '17', '18': '18', '19': '19', '20': '20', '21': '21', '22': '22', '23': '23', '24': '24', '25': '25', '26': '26', '27': '27', '30': '30', '40': '40', '44': '44', '45': '45', '50': '50', '100': '100', '250': '250', '500': '500', '750': '750', '1000': '1000', '2000': '2000', '3000': '3000', '4000': '4000', '5000': '5000'}, filters.rows, 'automation', defaultRows) }}
        <button type="submit">{{ 'Go'|trans({}, 'automation') }}</button>
        {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        <a href="{{ path('automation_templates', {clear: 1}) }}">{{ 'Clear'|trans({}, 'automation') }}</a>
    {% endblock %}
    {% endembed %}
    {% set selectionLimit = constant('Kadupul\\Automation\\Application\\Port\\AutomationTemplateStore::MAX_SELECTION') %}
    <p id="automation-template-help">{{ 'Discovery uses the first template that matches, in this order. Select up to %count% templates at a time.'|trans({'%count%': selectionLimit}, 'automation') }}</p>
    {# Move forms sit outside the selection form; HTML does not allow nested forms.
       Each button names its own direction, so only an allowed move is offered. #}
    {% for template in page.templates %}
        {{ form_start(moves[template.id], {action: path('automation_templates'), attr: {id: 'automation-template-move-' ~ template.id}}) }}
        {{ form_widget(moves[template.id]) }}
        {{ form_end(moves[template.id]) }}
    {% endfor %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
    <form method="get" action="{{ path('automation_template_delete') }}" aria-describedby="automation-template-help">
        <table class="cactiTable">
            <caption>{{ 'Device Automation Templates'|trans({}, 'automation') }}</caption>
            <thead><tr class="tableHeader">
                <th scope="col">{{ 'Select'|trans({}, 'automation') }}</th>
                <th scope="col">{{ 'Template Name'|trans({}, 'automation') }}</th>
                <th scope="col">{{ 'Availability Method'|trans({}, 'automation') }}</th>
                <th scope="col">{{ 'System Description Match'|trans({}, 'automation') }}</th>
                <th scope="col">{{ 'System Name Match'|trans({}, 'automation') }}</th>
                <th scope="col">{{ 'System ObjectId Match'|trans({}, 'automation') }}</th>
                <th scope="col">{{ 'Order'|trans({}, 'automation') }}</th>
            </tr></thead>
            <tbody>
            {% for template in page.templates %}
                {% set name = template.deviceTemplate ?? 'Unknown Template'|trans({}, 'automation') %}
                <tr>
                    {{ list.selection_cell(template.id, name, 'automation', 'automation-template-select-' ~ template.id, loop.index > selectionLimit) }}
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                    <td><a href="{{ path('automation_template_edit', {id: template.id}) }}">{{ name }}</a></td>
                    <td>{{ (availability[template.availabilityMethod] ?? 'Unknown')|trans({}, 'automation') }}</td>
                    <td>{{ template.sysDescr }}</td>
                    <td>{{ template.sysName }}</td>
                    <td>{{ template.sysOid }}</td>
                    <td>
                        {% if template.id != page.last %}<button type="submit" form="automation-template-move-{{ template.id }}" formaction="{{ path('automation_template_move', {id: template.id, direction: 'down'}) }}">{{ 'Move Down'|trans({}, 'automation') }}</button>{% endif %}
                        {% if template.id != page.first %}<button type="submit" form="automation-template-move-{{ template.id }}" formaction="{{ path('automation_template_move', {id: template.id, direction: 'up'}) }}">{{ 'Move Up'|trans({}, 'automation') }}</button>{% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7"><em>{{ 'No Automation Device Templates Found'|trans({}, 'automation') }}</em></td></tr>
            {% endfor %}
            </tbody>
        </table>
        <button type="submit">{{ 'Delete selected'|trans({}, 'automation') }}</button>
    </form>
    {{ list.pagination('automation_templates', filters, filters.page, page.hasPrevious, page.hasNext, 'Automation template pages', 'Page %page% of %total% Templates', {'%page%': filters.page, '%total%': page.total}, 'automation') }}
</main>
{% endblock %}
