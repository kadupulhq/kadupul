{% extends '_action_confirm.html.twig' %}
{% set domain = 'automation' %}
{% set heading = t('Delete Automation Templates', {}, 'automation') %}
{% set intro = t('Click Continue to delete the following Automation Templates.', {}, 'automation') %}
{% set cancel_url = path('automation_templates') %}
{% block items %}
    {% for template in templates %}<li>{{ template.deviceTemplate ?? 'Unknown Template'|trans({}, 'automation') }}{% if template.sysDescr != '' %} ({{ template.sysDescr }}){% endif %}</li>{% endfor %}
{% endblock %}
