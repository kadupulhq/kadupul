<!DOCTYPE html>
<html>
<head>
{# Trusted html_common_header() output retains native theme, assets and hooks. #}
{{ page.head|raw }}
</head>
<body class="logoutBody">
<div class="logoutLeft"></div>
<div class="logoutCenter">
    <div class="logoutArea">
        <div class="cactiLogoutLogo"></div>
        <h1 class="loginHeading">{{ page.heading }}</h1>
        <div class="logoutTitle">
            {% if page.confirmation is not null %}
            {# Absolute same-origin target is produced by the native HTTP boundary. #}
            <form method="post" action="{{ page.confirmation.target }}" id="logout-confirmation">
                <input type="hidden" name="action" value="{{ page.confirmation.action }}">
                <input type="hidden" name="__csrf_magic" value="{{ page.confirmation.token }}">
                <button type="submit">{{ page.confirmation.label }}</button>
            </form>
            {% else %}
            <p>{{ page.message }}</p>
            {# Existing gettext HTML message; its link arguments are fixed in logout.php. #}
            <p>{{ page.loginPrompt|raw }}</p>
            {% endif %}
        </div>
        <div class="logoutErrors"></div>
    </div>
    <div class="versionInfo">{{ page.version }} | {{ page.copyright }}</div>
</div>
<div class="logoutRight"></div>
{# nosemgrep: generic.html-templates.security.unquoted-attribute-var.unquoted-attribute-var -- CactiSecureHeaders::getNonceAttribute() emits the complete quoted nonce attribute; never supplied by an HTTP parameter. #}
<script type="text/javascript" {{ page.nonceAttribute|raw }}>
$(function() {
    if (typeof myRefresh != 'undefined') {
        clearTimeout(myRefresh);
    }
    $('.loginLeft').css('width',parseInt($(window).width()*0.33)+'px');
    $('.loginRight').css('width',parseInt($(window).width()*0.33)+'px');
});
</script>
{# Trusted include/global_session.php output, evaluated in the native scope. #}
{{ page.footer|raw }}
</body>
</html>
