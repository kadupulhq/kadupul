{% trans_default_domain 'console' %}
{{ compatibility.before }}
{% if home.content.showIntroduction %}
<table class="cactiTable" id="console-welcome" aria-label="{{ 'Console Page'|trans }}">
<tr class="tableRow">
<td class="textAreaNotes top left">
    {# The trans blocks retain repository-owned gettext HTML. URL substitutions
       are escaped for HTML attributes before translation; client HTML is never translated. #}
    {% set linked_message %}{% trans %}You are now logged into <a href="%s"><b>Kadupul</b></a>. You can follow these basic steps to get started.{% endtrans %}{% endset %}{{ linked_message|format(installation_path('about.php')|e('html_attr'))|raw }}
    <ul>
        <li>{% set linked_message %}{% trans %}<a href="%s">Create devices</a> for network{% endtrans %}{% endset %}{{ linked_message|format(installation_path('host.php')|e('html_attr'))|raw }}</li>
        <li>{% set linked_message %}{% trans %}<a href="%s">Create graphs</a> for your new devices{% endtrans %}{% endset %}{{ linked_message|format(installation_path('graphs_new.php')|e('html_attr'))|raw }}</li>
        <li>{% set linked_message %}{% trans %}<a href="%s">View</a> your new graphs{% endtrans %}{% endset %}{{ linked_message|format(installation_path('graph_view.php')|e('html_attr'))|raw }}</li>
    </ul>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed route below the validated installation path; Twig escapes the attribute. #}
    <a href="{{ installation_path('app.php/help') }}">{{ 'Help'|trans({}, 'help') }}</a>
</td>
<td class="textAreaNotes top right">
    <strong>{{ 'Version %s %s'|trans|format(home.release.version, home.release.beta is not null ? ('- Beta %s'|trans|format(home.release.beta)) : '')|trim }}</strong>
</td>
</tr>
{% if home.content.collector is not null %}
<tr class="tableRow"><td colspan="2"><hr></td></tr>
<tr class="tableRow"><td colspan="2"><strong>{{ 'Remote Data Collector Status:'|trans }}</strong>
    {% set labels = {online: 'Online'|trans, recovery: 'Recovery'|trans, offline: 'Offline'|trans} %}
    <i>{{ labels[home.content.collector.connection] }}</i></td></tr>
{% if home.content.collector.queuedRecords is not null %}
<tr class="tableRow"><td colspan="2"><strong>{{ 'Number of Offline Records:'|trans }}</strong> <i>{{ home.content.collector.queuedRecords|console_number(app.request.locale) }}</i></td></tr>
{% endif %}
<tr class="tableRow"><td colspan="2"><hr></td></tr>
<tr class="tableRow"><td class="textAreaNotes top left" colspan="2">{% trans %}<strong>NOTE:</strong> You are logged into a Remote Data Collector.  When <b>'online'</b>, you will be able to view and control much of the Main Kadupul Web Site just as if you were logged into it.  Also, it's important to note that Remote Data Collectors are required to use the Kadupul's Performance Boosting Services <b>'On Demand Updating'</b> feature, and we always recommend using Spine.  When the Remote Data Collector is <b>'offline'</b>, the Remote Data Collectors Web Site will contain much less information.  However, it will cache all updates until the Main Kadupul Database and Web Server are reachable.  Then it will dump it's Boost table output back to the Main Kadupul Database for updating.{% endtrans %}</td></tr>
<tr class="tableRow"><td class="textAreaNotes top left" colspan="2">{% trans %}<strong>NOTE:</strong> None of the Core Kadupul Plugins, to date, have been re-designed to work with Remote Data Collectors.  Therefore, Plugins such as MacTrack, and HMIB, which require direct access to devices will not work with Remote Data Collectors at this time.  However, plugins such as Thold will work so long as the Remote Data Collector is in <b>'online'</b> mode.{% endtrans %}</td></tr>
{% endif %}
</table>
{% endif %}
{{ compatibility.after }}
