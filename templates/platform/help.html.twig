{% extends 'base.html.twig' %}
{% trans_default_domain 'help' %}
{% block title %}{{ 'Help'|trans }}{% endblock %}
{% block body %}
<main>
<h1>{{ 'Help'|trans }}</h1>
<p>{{ 'Choose a topic to open the Kadupul documentation.'|trans }}</p>
<ul>
{% for topic in topics %}
    <li>{% if topic.url is not null %}<a href="{{ topic.url }}">{{ topic.label|trans }}</a>{% else %}{{ topic.label|trans }}: {{ 'Not available locally.'|trans }}{% endif %}</li>
{% endfor %}
</ul>
<p><a href="{{ installation_path('index.php') }}">{{ 'Back to console'|trans }}</a></p>
</main>
{% endblock %}
