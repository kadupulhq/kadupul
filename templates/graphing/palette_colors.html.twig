{% extends 'base.html.twig' %}
{% block title %}{{ 'Colors'|trans({}, 'palette') }} · Kadupul{% endblock %}
{% block body %}
<main>
    <h1>{{ 'Colors'|trans({}, 'palette') }}</h1>
    {% if deleted %}<output>{{ 'Colors deleted.'|trans({}, 'palette') }}</output>{% endif %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
    <p><a href="{{ path('palette_color_create', filters) }}">{{ 'Add Color'|trans({}, 'palette') }}</a></p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route with encoded filter parameters. #}
    <p><a href="{{ path('palette_color_import') }}">{{ 'Import Colors'|trans({}, 'palette') }}</a> <a href="{{ path('palette_color_export', filters) }}">{{ 'Export Colors'|trans({}, 'palette') }}</a></p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route; path() encodes parameters and Twig escapes attributes. #}
    <form method="get" action="{{ path('palette_color_list') }}">
        <label for="palette-filter">{{ 'Search'|trans({}, 'palette') }}</label>
        <input id="palette-filter" name="filter" type="search" maxlength="200" value="{{ filters.filter }}">
        <label for="palette-rows">{{ 'Colors per page'|trans({}, 'palette') }}</label>
        <select id="palette-rows" name="rows">
            {% for value, label in {'-1': 'Default', '10': '10', '15': '15', '16': '16', '17': '17', '18': '18', '19': '19', '20': '20', '21': '21', '22': '22', '23': '23', '24': '24', '25': '25', '26': '26', '27': '27', '30': '30', '40': '40', '44': '44', '45': '45', '50': '50', '100': '100', '250': '250', '500': '500', '750': '750', '1000': '1000', '2000': '2000', '3000': '3000', '4000': '4000', '5000': '5000'} %}
                <option value="{{ value }}"{% if filters.rows == value %} selected{% endif %}>{{ (value == '-1' ? 'Default (%count%)' : label)|trans({'%count%': defaultRows}, 'palette') }}</option>
            {% endfor %}
        </select>
        <input type="hidden" name="sort_column" value="{{ filters.sort_column }}">
        <input type="hidden" name="sort_direction" value="{{ filters.sort_direction }}">
        <input type="hidden" name="has_graphs" value="false">
        <label><input type="checkbox" name="has_graphs" value="true"{% if filters.has_graphs == 'true' %} checked{% endif %}> {{ 'Has Graphs'|trans({}, 'palette') }}</label>
        <button type="submit">{{ 'Go'|trans({}, 'palette') }}</button>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        <a href="{{ path('palette_color_list', {reset: 1}) }}">{{ 'Clear'|trans({}, 'palette') }}</a>
    <input type="hidden" name="named" value="false"><label><input type="checkbox" name="named" value="true"{% if filters.named == 'true' %} checked{% endif %}> {{ 'Named Colors'|trans({}, 'palette') }}</label>
    </form>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
    <form method="get" action="{{ path('palette_color_delete', filters) }}">
        <table>
            <caption>{{ 'Colors'|trans({}, 'palette') }}</caption>
            <thead><tr>
                <th scope="col">{{ 'Select'|trans({}, 'palette') }}</th>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                <th scope="col"><a href="{{ path('palette_color_list', filters|merge({sort_column: 'name', sort_direction: filters.sort_column == 'name' and filters.sort_direction == 'ASC' ? 'DESC' : 'ASC'})) }}">{{ 'Color Name'|trans({}, 'palette') }}</a></th>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                <th scope="col"><a href="{{ path('palette_color_list', filters|merge({sort_column: 'hex', sort_direction: filters.sort_column == 'hex' and filters.sort_direction == 'ASC' ? 'DESC' : 'ASC'})) }}">{{ 'Hex'|trans({}, 'palette') }}</a></th>
                <th scope="col">{{ 'Named Color'|trans({}, 'palette') }}</th><th scope="col">{{ 'Color templates using'|trans({}, 'palette') }}</th>
                <th scope="col">{{ 'Deletable'|trans({}, 'palette') }}</th>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                <th scope="col"><a href="{{ path('palette_color_list', filters|merge({sort_column: 'graphs', sort_direction: filters.sort_column == 'graphs' and filters.sort_direction == 'ASC' ? 'DESC' : 'ASC'})) }}">{{ 'Graphs Using'|trans({}, 'palette') }}</a></th>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                <th scope="col"><a href="{{ path('palette_color_list', filters|merge({sort_column: 'templates', sort_direction: filters.sort_column == 'templates' and filters.sort_direction == 'ASC' ? 'DESC' : 'ASC'})) }}">{{ 'Templates Using'|trans({}, 'palette') }}</a></th>
            </tr></thead>
            <tbody>
            {% for preset in page.presets %}
                {% set displayName = preset.name|trim is not empty ? preset.name : preset.hex %}
                <tr>
                    <td><input type="checkbox" name="ids[]" value="{{ preset.id }}"{% if not preset.deletable %} disabled{% endif %} aria-label="{{ 'Select %name%'|trans({'%name%': displayName}, 'palette') }}"></td>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                    <td><a href="{{ path('palette_color_edit', filters|merge({id: preset.id})) }}">{{ displayName }}</a></td>
                    <td>{{ preset.hex }} <input type="color" value="#{{ preset.previewHex }}" disabled aria-label="{{ 'Color preview'|trans({}, 'palette') }}"></td><td>{{ (preset.readOnly ? 'Yes' : 'No')|trans({}, 'palette') }}</td><td>{{ preset.otherReferences }}</td>
                    <td>{{ (preset.deletable ? 'Yes' : 'No')|trans({}, 'palette') }}</td>
                    <td>{{ preset.graphs }}</td>
                    <td>{{ preset.templates }}</td>
                </tr>
            {% else %}
                <tr><td colspan="8"><em>{{ 'No Colors'|trans({}, 'palette') }}</em></td></tr>
            {% endfor %}
            </tbody>
        </table>
        <button type="submit">{{ 'Delete selected'|trans({}, 'palette') }}</button>
    </form>
    <nav aria-label="{{ 'Color pages'|trans({}, 'palette') }}">
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        {% if page.hasPrevious %}<a rel="prev" href="{{ path('palette_color_list', filters|merge({page: filters.page - 1})) }}">{{ 'Previous'|trans({}, 'palette') }}</a>{% endif %}
        <span>{{ 'Page %page%'|trans({'%page%': filters.page}, 'palette') }}</span>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        {% if page.hasNext %}<a rel="next" href="{{ path('palette_color_list', filters|merge({page: filters.page + 1})) }}">{{ 'Next'|trans({}, 'palette') }}</a>{% endif %}
    </nav>
</main>
{% endblock %}
