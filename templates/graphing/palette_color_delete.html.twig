{% extends '_action_confirm.html.twig' %}
{% set domain = 'palette' %}
{% set heading = t('Delete Colors', {}, 'palette') %}
{% set intro = t('Click Continue to delete the following Colors.', {}, 'palette') %}
{% set used_message = t('Colors in use by a graph or graph template cannot be deleted.', {}, 'palette') %}
{% set cancel_url = path('palette_color_list') %}
{% block items %}
    {% for preset in presets %}<li>{{ preset.hex }}{% if preset.visibleName %} · {{ preset.displayName }}{% endif %}</li>{% endfor %}
{% endblock %}
