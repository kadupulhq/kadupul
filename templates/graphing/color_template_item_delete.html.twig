{% extends '_item_delete.html.twig' %}
{% set domain = 'color_template' %}
{% set heading = t('Delete Color Item', {}, 'color_template') %}
{% set intro = t('Click Continue to delete the following Color Template Color.', {}, 'color_template') %}
{% set cancel_url = path('color_template_edit', {id: template.id}) %}
{% block details %}
    <p>{{ 'Color Template: %name%'|trans({'%name%': template.name}, 'color_template') }}<br>{{ 'Color Hex: %hex%'|trans({'%hex%': item.hex}, 'color_template') }}</p>
{% endblock %}
