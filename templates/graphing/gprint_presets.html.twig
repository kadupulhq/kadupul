{% extends 'base.html.twig' %}
{% import '_list.html.twig' as list %}
{% block title %}{{ 'GPRINT Presets'|trans({}, 'gprint') }} · Kadupul{% endblock %}
{% block body %}
<main>
    <h1>{{ 'GPRINT Presets'|trans({}, 'gprint') }}</h1>
    {% if deleted %}<output>{{ 'GPRINT Presets deleted.'|trans({}, 'gprint') }}</output>{% endif %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
    <p><a href="{{ path('gprint_preset_create', filters) }}">{{ 'Add GPRINT Preset'|trans({}, 'gprint') }}</a></p>
    {% embed '_list_filter.html.twig' with {action: path('gprint_preset_list')} %}
    {% block filters %}
        {% import '_list.html.twig' as list %}
        <label for="gprint-filter">{{ 'Search'|trans({}, 'gprint') }}</label>
        <input id="gprint-filter" name="filter" type="search" maxlength="200" value="{{ filters.filter }}">
        {{ list.rows_per_page('gprint-rows', 'GPRINTs per page', {'-1': 'Default', '10': '10', '15': '15', '16': '16', '17': '17', '18': '18', '19': '19', '20': '20', '21': '21', '22': '22', '23': '23', '24': '24', '25': '25', '26': '26', '27': '27', '30': '30', '40': '40', '44': '44', '45': '45', '50': '50', '100': '100', '250': '250', '500': '500', '750': '750', '1000': '1000', '2000': '2000', '3000': '3000', '4000': '4000', '5000': '5000'}, filters.rows, 'gprint', defaultRows) }}
        <input type="hidden" name="sort_column" value="{{ filters.sort_column }}">
        <input type="hidden" name="sort_direction" value="{{ filters.sort_direction }}">
        <input type="hidden" name="has_graphs" value="false">
        <label><input type="checkbox" name="has_graphs" value="true"{% if filters.has_graphs == 'true' %} checked{% endif %}> {{ 'Has Graphs'|trans({}, 'gprint') }}</label>
        <button type="submit">{{ 'Go'|trans({}, 'gprint') }}</button>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        <a href="{{ path('gprint_preset_list', {reset: 1}) }}">{{ 'Clear'|trans({}, 'gprint') }}</a>
    {% endblock %}
    {% endembed %}
    {% set selectionLimit = constant('Kadupul\\Graphing\\Application\\Port\\GprintPresetStore::MAX_DELETE_SELECTION') %}
    <p id="gprint-selection-help">{{ 'Select up to %count% presets from the first %count% rows. Use %count% rows per page or search to select other presets.'|trans({'%count%': selectionLimit}, 'gprint') }}</p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
    <form method="get" action="{{ path('gprint_preset_delete') }}" aria-describedby="gprint-selection-help">
        {% for key, value in filters %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
        <table class="cactiTable">
            <caption>{{ 'GPRINT Presets'|trans({}, 'gprint') }}</caption>
            <thead><tr class="tableHeader">
                <th scope="col">{{ 'Select'|trans({}, 'gprint') }}</th>
                {{ list.sort_header('gprint_preset_list', filters, 'name', 'GPRINT Preset Name', 'gprint') }}
                {{ list.sort_header('gprint_preset_list', filters, 'gprint_text', 'Format', 'gprint') }}
                <th scope="col">{{ 'Deletable'|trans({}, 'gprint') }}</th>
                {{ list.sort_header('gprint_preset_list', filters, 'graphs', 'Graphs Using', 'gprint') }}
                {{ list.sort_header('gprint_preset_list', filters, 'templates', 'Templates Using', 'gprint') }}
            </tr></thead>
            <tbody>
            {% for preset in page.presets %}
                <tr>
                    {{ list.selection_cell(preset.id, preset.name, 'gprint', 'gprint-select-' ~ preset.id, not preset.deletable or loop.index > selectionLimit) }}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                    <td><a href="{{ path('gprint_preset_edit', filters|merge({id: preset.id})) }}">{{ preset.name }}</a></td>
                    <td>{{ preset.gprintText }}</td>
                    <td>{{ (preset.deletable ? 'Yes' : 'No')|trans({}, 'gprint') }}</td>
                    <td>{{ preset.graphs }}</td>
                    <td>{{ preset.templates }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6"><em>{{ 'No GPRINT Presets'|trans({}, 'gprint') }}</em></td></tr>
            {% endfor %}
            </tbody>
        </table>
        <button type="submit">{{ 'Delete selected'|trans({}, 'gprint') }}</button>
    </form>
    {{ list.pagination('gprint_preset_list', filters, filters.page, page.hasPrevious, page.hasNext, 'GPRINT Preset pages', 'Page %page%', {'%page%': filters.page}, 'gprint') }}
</main>
{% endblock %}
