{% extends 'base.html.twig' %}
{% block title %}{{ 'GPRINT Presets'|trans({}, 'gprint') }} · Kadupul{% endblock %}
{% block body %}
<main>
    <h1>{{ 'GPRINT Presets'|trans({}, 'gprint') }}</h1>
    {% if deleted %}<output>{{ 'GPRINT Presets deleted.'|trans({}, 'gprint') }}</output>{% endif %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
    <p><a href="{{ path('gprint_preset_create', filters) }}">{{ 'Add GPRINT Preset'|trans({}, 'gprint') }}</a></p>
    <form method="get" action="{{ path('gprint_preset_list') }}">
        <label for="gprint-filter">{{ 'Search'|trans({}, 'gprint') }}</label>
        <input id="gprint-filter" name="filter" type="search" maxlength="200" value="{{ filters.filter }}">
        <label for="gprint-rows">{{ 'GPRINTs per page'|trans({}, 'gprint') }}</label>
        <select id="gprint-rows" name="rows">
            {% for value, label in {'-1': 'Default', '10': '10', '15': '15', '16': '16', '17': '17', '18': '18', '19': '19', '20': '20', '21': '21', '22': '22', '23': '23', '24': '24', '25': '25', '26': '26', '27': '27', '30': '30', '40': '40', '44': '44', '45': '45', '50': '50', '100': '100', '250': '250', '500': '500', '750': '750', '1000': '1000', '2000': '2000', '3000': '3000', '4000': '4000', '5000': '5000'} %}
                <option value="{{ value }}"{% if filters.rows == value %} selected{% endif %}>{{ (value == '-1' ? 'Default (%count%)' : label)|trans({'%count%': defaultRows}, 'gprint') }}</option>
            {% endfor %}
        </select>
        <input type="hidden" name="sort_column" value="{{ filters.sort_column }}">
        <input type="hidden" name="sort_direction" value="{{ filters.sort_direction }}">
        <input type="hidden" name="has_graphs" value="false">
        <label><input type="checkbox" name="has_graphs" value="true"{% if filters.has_graphs == 'true' %} checked{% endif %}> {{ 'Has Graphs'|trans({}, 'gprint') }}</label>
        <button type="submit">{{ 'Go'|trans({}, 'gprint') }}</button>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        <a href="{{ path('gprint_preset_list', {reset: 1}) }}">{{ 'Clear'|trans({}, 'gprint') }}</a>
    </form>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
    <form method="get" action="{{ path('gprint_preset_delete', filters) }}">
        <table>
            <caption>{{ 'GPRINT Presets'|trans({}, 'gprint') }}</caption>
            <thead><tr>
                <th scope="col">{{ 'Select'|trans({}, 'gprint') }}</th>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                <th scope="col"><a href="{{ path('gprint_preset_list', filters|merge({sort_column: 'name', sort_direction: filters.sort_column == 'name' and filters.sort_direction == 'ASC' ? 'DESC' : 'ASC'})) }}">{{ 'GPRINT Preset Name'|trans({}, 'gprint') }}</a></th>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                <th scope="col"><a href="{{ path('gprint_preset_list', filters|merge({sort_column: 'gprint_text', sort_direction: filters.sort_column == 'gprint_text' and filters.sort_direction == 'ASC' ? 'DESC' : 'ASC'})) }}">{{ 'Format'|trans({}, 'gprint') }}</a></th>
                <th scope="col">{{ 'Deletable'|trans({}, 'gprint') }}</th>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                <th scope="col"><a href="{{ path('gprint_preset_list', filters|merge({sort_column: 'graphs', sort_direction: filters.sort_column == 'graphs' and filters.sort_direction == 'ASC' ? 'DESC' : 'ASC'})) }}">{{ 'Graphs Using'|trans({}, 'gprint') }}</a></th>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                <th scope="col"><a href="{{ path('gprint_preset_list', filters|merge({sort_column: 'templates', sort_direction: filters.sort_column == 'templates' and filters.sort_direction == 'ASC' ? 'DESC' : 'ASC'})) }}">{{ 'Templates Using'|trans({}, 'gprint') }}</a></th>
            </tr></thead>
            <tbody>
            {% for preset in page.presets %}
                <tr>
                    <td><input type="checkbox" name="ids[]" value="{{ preset.id }}"{% if not preset.deletable %} disabled{% endif %} aria-label="{{ 'Select %name%'|trans({'%name%': preset.name}, 'gprint') }}"></td>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                    <td><a href="{{ path('gprint_preset_edit', filters|merge({id: preset.id})) }}">{{ preset.name }}</a></td>
                    <td>{{ preset.gprintText }}</td>
                    <td>{{ (preset.deletable ? 'Yes' : 'No')|trans({}, 'gprint') }}</td>
                    <td>{{ preset.graphs }}</td>
                    <td>{{ preset.templates }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6"><em>{{ 'No GPRINT Presets'|trans({}, 'gprint') }}</em></td></tr>
            {% endfor %}
            </tbody>
        </table>
        <button type="submit">{{ 'Delete selected'|trans({}, 'gprint') }}</button>
    </form>
    <nav aria-label="{{ 'GPRINT Preset pages'|trans({}, 'gprint') }}">
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        {% if page.hasPrevious %}<a rel="prev" href="{{ path('gprint_preset_list', filters|merge({page: filters.page - 1})) }}">{{ 'Previous'|trans({}, 'gprint') }}</a>{% endif %}
        <span>{{ 'Page %page%'|trans({'%page%': filters.page}, 'gprint') }}</span>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        {% if page.hasNext %}<a rel="next" href="{{ path('gprint_preset_list', filters|merge({page: filters.page + 1})) }}">{{ 'Next'|trans({}, 'gprint') }}</a>{% endif %}
    </nav>
</main>
{% endblock %}
