{% extends 'base.html.twig' %}
{% import '_list.html.twig' as list %}
{% block title %}{{ 'Data Source Profiles'|trans({}, 'data_source_profile') }} · Kadupul{% endblock %}
{% block body %}
<main>
    <h1>{{ 'Data Source Profiles'|trans({}, 'data_source_profile') }}</h1>
    {% if deleted %}<output>{{ 'Data Source Profiles deleted.'|trans({}, 'data_source_profile') }}</output>{% endif %}
    {% if duplicated %}<output>{{ 'Data Source Profiles duplicated.'|trans({}, 'data_source_profile') }}</output>{% endif %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
    <p><a href="{{ path('data_source_profile_create') }}">{{ 'Add Data Source Profile'|trans({}, 'data_source_profile') }}</a></p>
    {% embed '_list_filter.html.twig' with {action: path('data_source_profile_list')} %}
    {% block filters %}
        {% import '_list.html.twig' as list %}
        <label for="data-source-profile-filter">{{ 'Search'|trans({}, 'data_source_profile') }}</label>
        <input id="data-source-profile-filter" name="filter" type="search" maxlength="200" value="{{ filters.filter }}">
        {{ list.rows_per_page('data-source-profile-rows', 'Profiles', {'-1': 'Default', '10': '10', '15': '15', '16': '16', '17': '17', '18': '18', '19': '19', '20': '20', '21': '21', '22': '22', '23': '23', '24': '24', '25': '25', '26': '26', '27': '27', '30': '30', '40': '40', '44': '44', '45': '45', '50': '50', '100': '100', '250': '250', '500': '500', '750': '750', '1000': '1000', '2000': '2000', '3000': '3000', '4000': '4000', '5000': '5000'}, filters.rows, 'data_source_profile', defaultRows) }}
        <input type="hidden" name="sort_column" value="{{ filters.sort_column }}">
        <input type="hidden" name="sort_direction" value="{{ filters.sort_direction }}">
        <input type="hidden" name="has_data" value="false">
        <label><input type="checkbox" name="has_data" value="true"{% if filters.has_data == 'true' %} checked{% endif %}> {{ 'Has Data Sources'|trans({}, 'data_source_profile') }}</label>
        <button type="submit">{{ 'Go'|trans({}, 'data_source_profile') }}</button>
        {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        <a href="{{ path('data_source_profile_list', {clear: 1}) }}">{{ 'Clear'|trans({}, 'data_source_profile') }}</a>
    {% endblock %}
    {% endembed %}
    {% set selectionLimit = constant('Kadupul\\Graphing\\Application\\Port\\DataSourceProfileStore::MAX_SELECTION') %}
    <p id="data-source-profile-selection-help">{{ 'Select up to %count% profiles at a time.'|trans({'%count%': selectionLimit}, 'data_source_profile') }}</p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
    <form method="get" action="{{ path('data_source_profile_action', {operation: 'delete'}) }}" aria-describedby="data-source-profile-selection-help">
        {% for key, value in filters %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
        <table class="cactiTable">
            <caption>{{ 'Data Source Profiles'|trans({}, 'data_source_profile') }}</caption>
            <thead><tr class="tableHeader">
                <th scope="col">{{ 'Select'|trans({}, 'data_source_profile') }}</th>
                {{ list.sort_header('data_source_profile_list', filters, 'name', 'Data Source Profile Name', 'data_source_profile') }}
                <th scope="col" title="{{ 'Is this the default Profile for all new Data Templates?'|trans({}, 'data_source_profile') }}">{{ 'Default'|trans({}, 'data_source_profile') }}</th>
                <th scope="col" title="{{ 'Profiles that are in use cannot be Deleted. In use is defined as being referenced by a Data Source or a Data Template.'|trans({}, 'data_source_profile') }}">{{ 'Deletable'|trans({}, 'data_source_profile') }}</th>
                <th scope="col" title="{{ 'Profiles that are in use by Data Sources become read only for now.'|trans({}, 'data_source_profile') }}">{{ 'Read Only'|trans({}, 'data_source_profile') }}</th>
                {{ list.sort_header('data_source_profile_list', filters, 'step', 'Poller Interval', 'data_source_profile') }}
                {{ list.sort_header('data_source_profile_list', filters, 'heartbeat', 'Heartbeat', 'data_source_profile') }}
                {{ list.sort_header('data_source_profile_list', filters, 'data_sources', 'Data Sources Using', 'data_source_profile') }}
                {{ list.sort_header('data_source_profile_list', filters, 'templates', 'Templates Using', 'data_source_profile') }}
            </tr></thead>
            <tbody>
            {% for profile in page.profiles %}
                <tr>
                    {# In-use profiles stay selectable: duplication applies to them. #}
                    {{ list.selection_cell(profile.id, profile.name, 'data_source_profile', 'data-source-profile-select-' ~ profile.id, loop.index > selectionLimit) }}
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                    <td><a href="{{ path('data_source_profile_edit', {id: profile.id}) }}">{{ profile.name }}</a></td>
                    <td>{{ profile.isDefault ? 'Yes'|trans({}, 'data_source_profile') : '' }}</td>
                    <td>{{ (profile.deletable ? 'Yes' : 'No')|trans({}, 'data_source_profile') }}</td>
                    <td>{{ (profile.readOnly ? 'Yes' : 'No')|trans({}, 'data_source_profile') }}</td>
                    <td>{{ profile_interval(profile.step) }}</td>
                    <td>{{ profile_heartbeat(profile.heartbeat) }}</td>
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed script path below the validated url_path; the ID is an integer. #}
                    <td>{% if profile.dataSources > 0 %}<a href="{{ installation_path('data_sources.php') }}?reset=true&amp;profile={{ profile.id }}">{{ profile.dataSources|console_number(app.request.locale) }}</a>{% else %}0{% endif %}</td>
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed script path below the validated url_path; the ID is an integer. #}
                    <td>{% if profile.templates > 0 %}<a href="{{ installation_path('data_templates.php') }}?reset=true&amp;profile={{ profile.id }}">{{ profile.templates|console_number(app.request.locale) }}</a>{% else %}0{% endif %}</td>
                </tr>
            {% else %}
                <tr><td colspan="9"><em>{{ 'No Data Source Profiles Found'|trans({}, 'data_source_profile') }}</em></td></tr>
            {% endfor %}
            </tbody>
        </table>
        <button type="submit">{{ 'Delete selected'|trans({}, 'data_source_profile') }}</button>
        {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
        <button type="submit" formaction="{{ path('data_source_profile_action', {operation: 'duplicate'}) }}">{{ 'Duplicate selected'|trans({}, 'data_source_profile') }}</button>
    </form>
    {{ list.pagination('data_source_profile_list', filters, filters.page, page.hasPrevious, page.hasNext, 'Data Source Profile pages', 'Page %page% of %total% profiles', {'%page%': filters.page, '%total%': page.total}, 'data_source_profile') }}
</main>
{% endblock %}
