{% extends '_action_confirm.html.twig' %}
{% set domain = 'gprint' %}
{% set heading = t('Delete GPRINT Presets', {}, 'gprint') %}
{% set intro = t('Click Continue to delete the following GPRINT Presets.', {}, 'gprint') %}
{% set used_message = t('GPRINT Presets in use by a graph or graph template cannot be deleted.', {}, 'gprint') %}
{% set cancel_url = path('gprint_preset_list', filters) %}
{% block items %}
    {% for preset in presets %}<li>{{ preset.name }}</li>{% endfor %}
{% endblock %}
