{% extends '_item_delete.html.twig' %}
{% set domain = 'data_source_profile' %}
{% set heading = t('Delete Data Source Profile Item', {}, 'data_source_profile') %}
{% set intro = t("Click 'Continue' to delete the following Data Source Profile RRA.", {}, 'data_source_profile') %}
{% set blocked = profile.readOnly %}
{% set blocked_message = t('Profiles that are in use by Data Sources become read only for now.', {}, 'data_source_profile') %}
{% set cancel_url = path('data_source_profile_edit', {id: profile.id}) %}
{% block details %}
    <p>{{ 'Data Source Profile: %name%'|trans({'%name%': profile.name}, 'data_source_profile') }}<br>{{ 'RRA Name: %name%'|trans({'%name%': archive.name}, 'data_source_profile') }}</p>
{% endblock %}
