GET filter form for a list; embed it and fill the filters block. The
filterTable class is the legacy filter hook themes style.
#}
<form method="get" action="{{ action }}"{% if role|default %} role="{{ role }}"{% endif %} class="filterTable">
    {% block filters %}{% endblock %}
</form>
