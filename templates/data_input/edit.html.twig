{% extends 'base.html.twig' %}{% trans_default_domain 'data_input' %}
{% block title %}{{ 'Data Input Method'|trans }} · Kadupul{% endblock %}
{% block body %}<main><p>{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_inputs') }}">{{ 'Back to data inputs'|trans }}</a></p><h1>{{ 'Data Input Method'|trans }}{% if state.method.id is defined %}: {{ state.method.name }}{% endif %}</h1>
{% if operation == 'propagate' %}
{% if saved == '1' %}<output>{{ 'Collector propagation completed.'|trans }}</output>{% elseif saved == 'partial' %}<output role="alert">{{ 'Collector propagation is incomplete. Retry propagation; remote collectors may need a FullSync.'|trans }}</output>{% endif %}
{% elseif operation == 'whitelist' %}
{% if saved == '1' %}<output>{{ 'Whitelist verification and collector propagation completed.'|trans }}</output>{% elseif saved == 'partial' %}<output role="alert">{{ 'Whitelist verification or collector propagation is incomplete. Retry the whitelist update; remote collectors may need a FullSync.'|trans }}</output>{% endif %}
{% elseif saved == '1' %}<output>{{ 'Data input saved.'|trans }}</output>{% elseif saved == 'partial' %}<output role="alert">{{ 'Local changes were saved. Collector or whitelist propagation is incomplete. Retry propagation; remote collectors may need a FullSync.'|trans }}</output>{% endif %}
{{ form_start(form) }}{{ form_widget(form) }}<button>{{ 'Save'|trans }}</button>{{ form_end(form) }}
{% if state.method.id is defined %}{% if saved != '' and (state.counts.templates > 0 or state.counts.data_sources > 0) %}<p>{{ 'Update dependent Data Templates before collectors use new or changed input fields.'|trans }}</p>{% endif %}<p>{{ 'Templates using'|trans }}: {{ state.counts.templates }} · {{ 'Data sources using'|trans }}: {{ state.counts.data_sources }}</p>
{% if state.whitelist != 'disabled' %}<p>{{ state.whitelist == 'verified' ? 'Whitelist verification succeeded.'|trans : 'Whitelist requires an update.'|trans }} {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_input_action',{id:state.method.id,operation:'whitelist'}) }}">{{ 'Update whitelist'|trans }}</a></p>{% endif %}
<p>{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_input_action',{id:state.method.id,operation:'propagate'}) }}">{{ 'Retry collector propagation'|trans }}</a></p>
{% for direction,label in {in:'Input Fields',out:'Output Fields'} %}<h2>{{ label|trans }}</h2>{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_input_field',{id:state.method.id,field:0,direction:direction}) }}">{{ 'Add field'|trans }}</a><table><thead><tr><th>{{ 'Field name'|trans }}</th><th>{{ 'Friendly name'|trans }}</th><th>{{ 'Field order'|trans }}</th><th>{{ 'Update RRA'|trans }}</th><th>{{ 'Actions'|trans }}</th></tr></thead><tbody>{% for field in state.fields %}{% if field.input_output == direction %}<tr><td>{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_input_field',{id:state.method.id,field:field.id}) }}">{{ field.data_name }}</a></td><td>{{ field.name }}</td><td>{{ field.sequence }}{% if field.sequence == 0 and direction == 'in' %} {{ '(Not In Use)'|trans }}{% endif %}</td><td>{{ field.update_rra == 'on' ? 'Yes'|trans : 'No'|trans }}</td><td>{% if direction == 'in' or state.counts.data_sources == 0 %}{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_input_action',{id:state.method.id,operation:'field_delete',field:field.id}) }}">{{ 'Delete'|trans }}</a>{% else %}{{ 'Output fields in use cannot be removed.'|trans }}{% endif %}</td></tr>{% endif %}{% endfor %}</tbody></table>{% endfor %}{% endif %}</main>{% endblock %}
