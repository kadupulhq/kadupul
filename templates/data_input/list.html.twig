{% extends 'base.html.twig' %}
{% trans_default_domain 'data_input' %}
{% block title %}{{ 'Data Input Methods'|trans }} · Kadupul{% endblock %}
{% block body %}<main><h1>{{ 'Data Input Methods'|trans }}</h1>
{% if saved == '1' %}<output>{{ 'Data input saved.'|trans }}</output>{% elseif saved == 'partial' %}<output role="alert">{{ 'Local changes were saved. Collector or whitelist propagation is incomplete. Retry propagation; remote collectors may need a FullSync.'|trans }}</output>
<ul>{% for id in retry_ids %}<li>{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony confirmation route and validated numeric ID. #}<a href="{{ path('data_input_action',{id:id,operation:'propagate'}) }}">{{ 'Retry propagation for input %id%'|trans({'%id%':id}) }}</a></li>{% endfor %}</ul>{% endif %}
<p>{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_input_create') }}">{{ 'Create data input'|trans }}</a></p>
<form method="get"><label>{{ 'Search'|trans }} <input name="filter" value="{{ data.filter }}" maxlength="200"></label><label>{{ 'Rows'|trans }} <select name="rows"><option value="-1" {% if data.default_rows %}selected{% endif %}>{{ 'Default'|trans }}</option>{% if data.rows not in [10,25,50,100,250,500] %}<option value="{{ data.rows }}" {% if not data.default_rows %}selected{% endif %}>{{ data.rows }}</option>{% endif %}{% for rows in [10,25,50,100,250,500] %}<option value="{{ rows }}" {% if not data.default_rows and data.rows == rows %}selected{% endif %}>{{ rows }}</option>{% endfor %}</select></label><button>{{ 'Apply'|trans }}</button> {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_inputs',{clear:1}) }}">{{ 'Clear'|trans }}</a></form>
<form method="get" action="{{ path('data_input_bulk',{operation:'delete'}) }}"><table><thead><tr>{% for key,label in {name:'Name',id:'ID',type_id:'Input type',templates:'Templates using',data_sources:'Data sources using'} %}<th>{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_inputs',{filter:data.filter,rows:data.default_rows ? -1 : data.rows,sort:key,direction:data.sort == key and data.direction == 'ASC' ? 'DESC' : 'ASC'}) }}">{{ label|trans }}</a></th>{% endfor %}<th>{{ 'Actions'|trans }}</th><th>{{ 'Select'|trans }}</th></tr></thead><tbody>
{% for item in data.items %}<tr><td>{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_input_edit',{id:item.id}) }}">{{ item.name }}</a></td><td>{{ item.id }}</td><td>{{ {1:'Script/Command',2:'SNMP Get',3:'SNMP Query',4:'Script Query',5:'Script Server',6:'Script Server Query'}[item.type_id]|default('Unknown')|trans }}</td><td>{{ item.templates }}</td><td>{{ item.data_sources }}</td><td>{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_input_action',{id:item.id,operation:'duplicate'}) }}">{{ 'Duplicate'|trans }}</a> {% if item.templates == 0 and item.data_sources == 0 %}{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_input_action',{id:item.id,operation:'delete'}) }}">{{ 'Delete'|trans }}</a>{% endif %}</td><td><input type="checkbox" name="ids[]" value="{{ item.id }}" aria-label="{{ 'Select %name%'|trans({'%name%':item.name}) }}"></td></tr>{% else %}<tr><td colspan="7">{{ 'No Data Input Methods Found'|trans }}</td></tr>{% endfor %}</tbody></table><button formaction="{{ path('data_input_bulk',{operation:'delete'}) }}">{{ 'Delete selected'|trans }}</button><button formaction="{{ path('data_input_bulk',{operation:'duplicate'}) }}">{{ 'Duplicate selected'|trans }}</button></form>
<p>{{ 'Total'|trans }}: {{ data.total }}</p>{% if data.page > 1 %}{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_inputs',{filter:data.filter,rows:data.default_rows ? -1 : data.rows,sort:data.sort,direction:data.direction,page:data.page-1}) }}">{{ 'Previous'|trans }}</a>{% endif %} {% if data.page * data.rows < data.total %}{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route names and validated encoded parameters. #}<a href="{{ path('data_inputs',{filter:data.filter,rows:data.default_rows ? -1 : data.rows,sort:data.sort,direction:data.direction,page:data.page+1}) }}">{{ 'Next'|trans }}</a>{% endif %}</main>{% endblock %}
