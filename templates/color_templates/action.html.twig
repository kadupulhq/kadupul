{% extends 'base.html.twig' %}
{% block title %}{{ (actionName|capitalize)|trans({}, 'color_templates') }} · Kadupul{% endblock %}
{% block body %}
<main>
    <h1>{{ (actionName|capitalize)|trans({}, 'color_templates') }}</h1>
    {% if actionName == 'delete' %}<p>{{ 'Continue to delete these color templates. Templates referenced by aggregate templates cannot be deleted.'|trans({}, 'color_templates') }}</p>{% endif %}
    {% if actionName == 'duplicate' %}<p>{{ 'Continue to duplicate these color templates.'|trans({}, 'color_templates') }}</p>{% endif %}
    {% if actionName == 'sync' %}<p>{{ 'Synchronize aggregate graphs using these color templates.'|trans({}, 'color_templates') }}</p>{% endif %}
    <ul>{% for template in templates %}<li>{{ template.name }}{% if not template.deletable %} — {{ 'In use by aggregate templates'|trans({}, 'color_templates') }}{% endif %}</li>{% endfor %}</ul>
    {{ form_start(form) }}{{ form_errors(form) }}
    {% if actionName == 'duplicate' %}{{ form_row(form.title_format) }}{% else %}{{ form_widget(form.title_format, {attr: {hidden: 'hidden'}}) }}{% endif %}
    {{ form_widget(form.selection) }}{{ form_widget(form.continue) }}{{ form_end(form) }}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
    <p><a href="{{ path('color_template_list', filters) }}">{{ 'Cancel'|trans({}, 'color_templates') }}</a></p>
</main>
{% endblock %}
