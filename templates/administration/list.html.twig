{% extends 'base.html.twig' %}
{% import '_list.html.twig' as lists %}
{% trans_default_domain 'administration' %}
{% block title %}{{ screen.title|trans }}{% endblock %}
{% block body %}
{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony generates the fixed management_snmp_mibs route without supplied URL or parameters. #}
{% if screen.value in ['snmp-objects', 'snmp-notifications'] %}<p><a href="{{ path('management_snmp_mibs') }}">{{ 'Registered SNMP MIBs'|trans({}, 'management') }}</a></p>{% endif %}
<h1>{{ screen.title|trans }}</h1>
<p>{{ 'Changes and advanced filters use the existing administration forms.'|trans }}</p>
{% if screen.value == 'rrd-candidates' %}<p>{{ 'This view reads the last recorded scan. Refresh and cleanup use the existing RRD Cleaner.'|trans }}</p>{% endif %}
<p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Enum-owned script and action below the validated installation root. #}
    {% if screen.creatable %}<a href="{{ installation_path(screen.legacyScript) }}?{{ screen.editQuery|url_encode }}">{{ 'Create'|trans }}</a>{% endif %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Enum-owned script; query values are URL encoded then attribute escaped. #}
    <a href="{{ installation_path(screen.legacyScript) }}?{{ screen.legacyQuery|merge({filter: filters.filter, rows: filters.rows})|url_encode }}">{{ 'Bulk actions and advanced filters'|trans }}</a>
</p>
<div class="cactiTable"><div class="cactiTableTitle">{{ 'Filters'|trans }}</div>
{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- The router supplies this fixed route name. #}
<form method="get" action="{{ path(route) }}" class="filterTable">
    <label for="filter">{{ 'Search'|trans }}</label>
    <input id="filter" name="filter" value="{{ filters.filter }}" maxlength="255">
    {{ lists.rows_per_page('rows', 'Rows', {10: '10', 25: '25', 50: '50', 100: '100'}, filters.rows, 'administration') }}
    <input type="hidden" name="sort_column" value="{{ filters.sort_column }}">
    <input type="hidden" name="sort_direction" value="{{ filters.sort_direction }}">
    <button type="submit">{{ 'Go'|trans }}</button>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed route supplied by the router. #}
    <a href="{{ path(route) }}">{{ 'Clear'|trans }}</a>
</form></div>
{% set device_classes = {
    wireless: 'Access Points, Controllers', application: 'Application Related', cacti: 'Kadupul Related',
    database: 'Database Related', facilities: 'Facilities Related', general: 'Generic Device',
    hpc: 'HPC/Grid Computing', hypervisor: 'Hypervisor Related', remotemgmt: 'ILO, IPMI, iDrac, etc.',
    license: 'Licensing Related', linux: 'Linux Related', loadbalancer: 'Load Balancer', switch: 'Network Switch',
    router: 'Network Router', nassan: 'NAS/SAN Related', firewall: 'Network Firewalls', power: 'Power Related PDUs/STS, etc.',
    printer: 'Printer Related', storage: 'Storage Related', telephony: 'Telco Related', webserver: 'Web Server Related',
    windows: 'Windows Related', ups: 'UPS Related', unassigned: 'Unassigned'
} %}
{% set value_labels = {
    device_class: device_classes,
    image_format: {1: 'PNG', 3: 'SVG'},
    collector_status: {0: 'New/Idle', 1: 'Running', 2: 'Idle', 3: 'Down', 4: 'Disabled', 5: 'Recovering', 6: 'Heartbeat'},
    auth_realm: {0: 'Local', 2: 'Web Basic', 3: 'LDAP'},
    domain_type: {1: 'LDAP', 2: 'Active Directory'}, default_domain: {0: 'No', 1: 'Yes'},
    graph_policy: {0: 'DENY', 1: 'ALLOW', 2: 'DENY'}, device_policy: {0: 'DENY', 1: 'ALLOW', 2: 'DENY'},
    template_policy: {0: 'DENY', 1: 'ALLOW', 2: 'DENY'}, locked: {0: 'No', 1: 'Yes'},
    result: {0: 'Failed', 1: 'Success - Password', 2: 'Success - Token', 3: 'Success - Password Change'},
    severity: {1: 'LOW', 2: 'MEDIUM', 3: 'HIGH', 4: 'CRITICAL'},
    snmp_available: {0: 'Down', 1: 'Up'}, device_up: {0: 'Down', 1: 'Up'},
    network_status: {'Disabled': 'Disabled', 'Running': 'Running', 'Idle': 'Idle'},
    enabled: {'on': 'Enabled', '': 'Disabled'}, active: {'on': 'Active', '': 'Disabled'},
    disabled: {'on': 'Disabled', '': 'Enabled'},
    sched_type: {1: 'Manual', 2: 'Daily', 3: 'Weekly', 4: 'Monthly', 5: 'Monthly on Day'},
    leaf_type: {1: 'Header', 2: 'Graph', 3: 'Device'},
    host_grouping_type: {1: 'Graph Template', 2: 'Data Query Index'}
} %}
<table class="cactiTable" id="administration-list">
    <caption>{{ screen.title|trans }}</caption>
    <thead><tr>{% for column, label in screen.columns %}{{ lists.sort_header(route, filters|merge({page: 1}), column, label, 'administration') }}{% endfor %}</tr></thead>
    <tbody>
    {% for record in records %}
        <tr class="{{ loop.index is odd ? 'odd' : 'even' }}">
        {% for column, label in screen.columns %}
            {% set value = record[column] %}
            <td>{% if column == 'name' and screen.editable %}
                {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Script/action are enum constants, ID is read from its numeric primary key, and the query is URL encoded. #}
                <a class="linkEditMain" href="{{ installation_path(screen.legacyScript) }}?{{ screen.editQuery(record.id)|url_encode }}">{{ value is same as('') or value is null ? 'Unnamed'|trans : value }}</a>
            {% if screen.value == 'graph-templates' %}
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed child route and numeric template identity. #}
                    <a href="{{ path('management_graph_template_items', {id: record.id}) }}">{{ 'Graph Items'|trans({}, 'management') }}</a>
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed child route and numeric template identity. #}
                    <a href="{{ path('management_graph_template_inputs', {id: record.id}) }}">{{ 'Graph Inputs'|trans({}, 'management') }}</a>
                {% elseif screen.value == 'device-templates' %}
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed child route and numeric template identity. #}
                    <a href="{{ path('management_device_template_graphs', {id: record.id}) }}">{{ 'Associated Graphs'|trans({}, 'management') }}</a>
                {% elseif screen.value == 'data-queries' %}
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed child route and numeric query identity. #}
                    <a href="{{ path('management_data_query_graphs', {id: record.id}) }}">{{ 'Graph Mappings'|trans({}, 'management') }}</a>
                {% endif %}
                {% set metadataRoutes = {'graph-templates': 'management_graph_device_templates', 'data-queries': 'management_query_device_templates'} %}
                {% if metadataRoutes[screen.value] is defined %}
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed route and the template/query numeric primary key. #}
                    <a href="{{ path(metadataRoutes[screen.value], {id: record.id}) }}">{{ 'Device Templates'|trans({}, 'management') }}</a>
                {% endif %}

                {% set related = {
                    'users': {'relationships_user_group_memberships': 'User Group Memberships', 'relationships_user_graphs_permissions': 'User Graph Permission Exceptions', 'relationships_user_devices_permissions': 'User Device Permission Exceptions', 'relationships_user_templates_permissions': 'User Template Permission Exceptions', 'relationships_user_trees_permissions': 'User Tree Permission Exceptions'},
                    'user-groups': {'relationships_group_members': 'Group Members', 'relationships_group_graphs_permissions': 'Group Graph Permission Exceptions', 'relationships_group_devices_permissions': 'Group Device Permission Exceptions', 'relationships_group_templates_permissions': 'Group Template Permission Exceptions', 'relationships_group_trees_permissions': 'Group Tree Permission Exceptions'},
                    'device-templates': {'relationships_device_template_queries': 'Device queries'},
                    'data-templates': {'relationships_data_template_definitions': 'Definitions'},
                    'aggregate-templates': {'relationships_aggregate_template_items': 'Aggregate items'},
                    'snmp-options': {'relationships_snmp_option_entries': 'SNMP entries'},
                    'graph-rules': {'relationships_graph_rule_device_criteria': 'Device criteria', 'relationships_graph_rule_query_criteria': 'Query criteria'},
                    'tree-rules': {'relationships_tree_rule_device_criteria': 'Device criteria', 'relationships_tree_rule_steps': 'Tree steps'},
                    'notification-receivers': {'relationships_receiver_subscriptions': 'Subscriptions', 'relationships_receiver_history': 'History'}
                } %}
                {% for destination, label in related[screen.value] ?? {} %}
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed route names in this template and the parent's numeric primary key. #}
                    <a href="{{ path(destination, {id: record.id}) }}">{{ label|trans({}, 'relationships') }}</a>
                {% endfor %}
            {% elseif column == 'name' %}{{ value is same as('') or value is null ? 'Unnamed'|trans : value }}
            {% elseif column in ['event_time', 'last_check'] %}
                {% if value > 0 %}{{ value|date('Y-m-d H:i:s') }}{% else %}{{ 'N/A'|trans }}{% endif %}
            {% elseif column == 'full_name' and value is null and screen.value == 'login-history' %}{{ '(User Removed)'|trans }}
            {% elseif column == 'auth_realm' and value is null %}{{ 'Unavailable'|trans }}
            {% elseif column in ['count_notify', 'count_log'] %}
                {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed receiver editor with URL encoded primary key and a fixed tab. #}
                <a href="{{ installation_path('managers.php') }}?{{ {action: 'edit', id: record.id, tab: column == 'count_notify' ? 'notifications' : 'logs'}|url_encode }}">{{ value }}</a>
            {% elseif value_labels[column][value ?? ''] is defined %}
                {{ value_labels[column][value ?? '']|trans }}
            {% elseif value is null or value is same as('') %}
                {{ (column == 'device_class' ? 'Unassigned' : (column == 'profile_name' ? 'External' : (column == 'next_start' ? 'N/A' : (column == 'subtree_name' ? 'ROOT' : 'None'))))|trans }}
            {% elseif value == '0000-00-00 00:00:00' %}
                {{ (column == 'last_started' ? 'Never' : 'N/A')|trans }}
            {% elseif column in ['last_started', 'next_start'] %}{{ value|slice(0, 16) }}
            {% else %}{{ value }}{% endif %}</td>
        {% endfor %}
        </tr>
    {% else %}<tr><td colspan="{{ screen.columns|length }}">{{ 'No records found.'|trans }}</td></tr>{% endfor %}
    </tbody>
</table>
{{ lists.pagination(route, filters, filters.page, filters.page > 1, hasNext, 'List pages', 'Page %page%', {'%page%': filters.page}, 'administration') }}
{% endblock %}
