{% extends 'base.html.twig' %}
{% block title %}{{ details.device.description }} · Kadupul{% endblock %}
{% block body %}
<main>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses fixed route names and encodes parameters; no user-supplied URI. #}
    <p><a href="{{ path('inventory_devices', filters) }}">{{ 'Back to devices'|trans({}, 'inventory') }}</a></p>
    <h1>{{ details.device.description }}</h1>
    <dl>
        <dt>{{ 'ID'|trans({}, 'inventory') }}</dt><dd>{{ details.device.id }}</dd>
        <dt>{{ 'Hostname'|trans({}, 'inventory') }}</dt><dd>{{ details.device.hostname }}</dd>
        <dt>{{ 'Status'|trans({}, 'inventory') }}</dt><dd>{{ (details.device.disabled ? 'Disabled' : details.device.status)|trans({}, 'inventory') }}</dd>
        <dt>{{ 'Site'|trans({}, 'inventory') }}</dt><dd>{{ details.siteId == 0 ? 'Unassigned'|trans({}, 'inventory') : (details.siteName ?? 'Unavailable'|trans({}, 'inventory')) }}</dd>
        <dt>{{ 'Location'|trans({}, 'inventory') }}</dt><dd>{{ details.device.location }}</dd>
        <dt>{{ 'External ID'|trans({}, 'inventory') }}</dt><dd>{{ details.device.externalId }}</dd>
    </dl>
    <h2>{{ 'Notes'|trans({}, 'inventory') }}</h2>
    {% if details.notes == '' %}<p>{{ 'No notes.'|trans({}, 'inventory') }}</p>{% else %}<pre>{{ details.notes }}</pre>{% endif %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses fixed route names and encodes parameters; no user-supplied URI. #}
    <p><a href="{{ path('inventory_device_edit', {id: details.device.id, list: filters}) }}">{{ 'Edit device'|trans({}, 'inventory') }}</a></p>
</main>
{% endblock %}
