{% extends 'base.html.twig' %}
{% block title %}{{ 'Edit site'|trans({}, 'inventory') }} · Kadupul{% endblock %}
{% block body %}
<main>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route name and encoded validated parameters, not a supplied URL. #}
    <p><a href="{{ path('inventory_sites', filters) }}">{{ 'Back to sites'|trans({}, 'inventory') }}</a></p>
    {% set siteLabel = site.name|trim == '' ? 'Unnamed site #%id%'|trans({'%id%': site.id}, 'inventory') : site.name %}
    <h1>{{ 'Edit %site%'|trans({'%site%': siteLabel}, 'inventory') }}</h1>
    {% if saved %}<output>{{ 'Site saved.'|trans({}, 'inventory') }}</output>{% endif %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony routes and integer site identifier. #}
    <p><a href="{{ path('inventory_site_action', {operation: 'duplicate', ids: [site.id], list: filters}) }}">{{ 'Duplicate site'|trans({}, 'inventory') }}</a></p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony routes and integer site identifier. #}
    <p><a href="{{ path('inventory_site_action', {operation: 'delete', ids: [site.id], list: filters}) }}">{{ 'Delete site'|trans({}, 'inventory') }}</a></p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_widget(form) }}
        <button type="submit">{{ 'Save site'|trans({}, 'inventory') }}</button>
    {{ form_end(form) }}
</main>
{% endblock %}
