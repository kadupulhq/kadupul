{% extends 'base.html.twig' %}
{% block title %}{{ 'Edit device'|trans({}, 'inventory') }} · Kadupul{% endblock %}
{% block body %}
<main>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() encodes fixed-route parameters. #}
    <p><a href="{{ path('inventory_devices', filters) }}">{{ 'Back to devices'|trans({}, 'inventory') }}</a></p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() encodes fixed-route parameters. #}
    <p><a href="{{ path('inventory_device_details', {id: device.id, list: filters}) }}">{{ 'View device details'|trans({}, 'inventory') }}</a></p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() encodes fixed-route parameters. #}
    <p><a href="{{ path('inventory_device_associations', {id: device.id, kind: 'graph', list: filters}) }}">{{ 'Device graph-template associations'|trans({}, 'inventory') }}</a></p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() encodes fixed-route parameters. #}
    <p><a href="{{ path('inventory_device_template', {id: device.id, list: filters}) }}">{{ 'Assign device template'|trans({}, 'inventory') }}</a></p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() encodes fixed-route parameters. #}
    <p><a href="{{ path('inventory_device_collector', {id: device.id, list: filters}) }}">{{ 'Assign device collector'|trans({}, 'inventory') }}</a></p>
    <h1>{{ 'Edit %device%'|trans({'%device%': device.description}, 'inventory') }}</h1>
    {% if saved %}<output>{{ 'Device saved.'|trans({}, 'inventory') }}</output>{% endif %}
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.description) }}
        {{ form_row(form.hostname) }}
        {{ form_row(form.location) }}
        {{ form_row(form.external_id) }}
        {{ form_row(form.notes) }}
        {{ form_row(form.enabled) }}
        {{ form_row(form.site_id) }}
        {{ form_row(form.polling) }}
        {{ form_row(form.snmp) }}
        <button type="submit">{{ 'Save device'|trans({}, 'inventory') }}</button>
    {{ form_end(form) }}
</main>
{% endblock %}
