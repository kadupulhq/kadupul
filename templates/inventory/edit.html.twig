{% extends 'base.html.twig' %}
{% block title %}Edit device · Kadupul{% endblock %}
{% block body %}
<main>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses fixed route names and encodes parameters; no user-supplied URI. #}
    <p><a href="{{ path('inventory_devices', filters) }}">Back to devices</a></p>
    <h1>Edit {{ device.description }}</h1>
    {% if saved %}<output>Device saved.</output>{% endif %}
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.description) }}
        {{ form_row(form.hostname) }}
        {{ form_row(form.location) }}
        {{ form_row(form.external_id) }}
        {{ form_row(form.notes) }}
        {{ form_row(form.enabled) }}
        <button type="submit">Save device</button>
    {{ form_end(form) }}
</main>
{% endblock %}
