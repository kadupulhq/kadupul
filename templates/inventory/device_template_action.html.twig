{% extends 'base.html.twig' %}{% trans_default_domain 'inventory' %}{% block title %}{{ 'Device Templates'|trans }} · Kadupul{% endblock %}
{% block body %}<main><h1>{{ 'Confirm device template action'|trans }}</h1><p>{{ operation|trans }}</p><ul>{% for row in rows %}<li>{{ row.name }}</li>{% endfor %}</ul>
{% if partial %}<p role="alert">{{ 'Synchronization may have reached devices, collectors or plugins. Reload and inspect their state before retrying. This operation will not be replayed.'|trans }}</p>{% else %}
{% if operation == 'delete' %}<p>{{ 'Deleting templates detaches active devices and keeps their existing graphs and queries.'|trans }}</p>{% elseif operation == 'sync' %}<p>{{ 'Synchronize reachable devices with these templates. Collector, SNMP and plugin effects cannot be rolled back together.'|trans }}</p>{% endif %}
{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed local Symfony routes encode validated IDs and filters; device URL uses the local application mount and fixed host.php path. #}
{{ form_start(form) }}{{ form_widget(form) }}<button>{{ 'Continue'|trans }}</button>{{ form_end(form) }}{% endif %}<p><a href="{{ path('inventory_device_templates') }}">{{ 'Cancel'|trans }}</a></p></main>{% endblock %}
