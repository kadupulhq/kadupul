{% extends 'base.html.twig' %}
{% trans_default_domain 'inventory' %}
{% block title %}{{ 'Device Templates'|trans }} · Kadupul{% endblock %}
{% block body %}<main><h1>{{ 'Device Templates'|trans }}</h1>
{{ hooks.device_template_top|default('') }}
{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed local Symfony routes encode validated IDs and filters; device URL uses the local application mount and fixed host.php path. #}
<p><a href="{{ path('inventory_device_template_definition_create') }}">{{ 'Add device template'|trans }}</a></p>
<form method="get" action="{{ path('inventory_device_templates') }}">
<label for="q">{{ 'Search'|trans }}</label><input id="q" name="q" value="{{ filters.q }}" maxlength="200">
<label for="class">{{ 'Class'|trans }}</label><select id="class" name="class"><option value="-1">{{ 'All'|trans }}</option>{% for class in classes %}<option value="{{ class }}"{% if filters.class == class %} selected{% endif %}>{{ class|trans }}</option>{% endfor %}</select>
<label for="graph">{{ 'Graph template'|trans }}</label><select id="graph" name="graph"><option value="0">{{ 'All'|trans }}</option>{% for id,name in choices.graphs %}<option value="{{ id }}"{% if filters.graph == id %} selected{% endif %}>{{ name }}</option>{% endfor %}</select>
<label for="sort">{{ 'Sort by'|trans }}</label><select id="sort" name="sort">{% for value,label in {name:'Name', id:'ID', class:'Class', hosts:'Devices'} %}<option value="{{ value }}"{% if filters.sort == value %} selected{% endif %}>{{ label|trans }}</option>{% endfor %}</select>
<label for="direction">{{ 'Order'|trans }}</label><select id="direction" name="direction"><option value="asc"{% if filters.direction == 'asc' %} selected{% endif %}>{{ 'Ascending'|trans }}</option><option value="desc"{% if filters.direction == 'desc' %} selected{% endif %}>{{ 'Descending'|trans }}</option></select>
{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed local Symfony routes encode validated IDs and filters; device URL uses the local application mount and fixed host.php path. #}
<label for="size">{{ 'Per page'|trans }}</label><select id="size" name="size">{% for size in sizes %}<option value="{{ size }}"{% if filters.size == size %} selected{% endif %}>{{ size }}</option>{% endfor %}</select><label for="has-hosts">{{ 'Has Devices'|trans }}</label><select id="has-hosts" name="has_hosts"><option value="false"{% if filters.has_hosts == 'false' %} selected{% endif %}>{{ 'All'|trans }}</option><option value="true"{% if filters.has_hosts == 'true' %} selected{% endif %}>{{ 'Has Devices'|trans }}</option></select><button>{{ 'Apply'|trans }}</button><a href="{{ path('inventory_device_templates', {reset:'1'}) }}">{{ 'Reset'|trans }}</a></form>
<form method="get" action="{{ path('inventory_device_template_definition_action', {operation:'delete'}) }}"><table><thead><tr><th>{{ 'Select'|trans }}</th><th>{{ 'Name'|trans }}</th><th>{{ 'Class'|trans }}</th><th>{{ 'ID'|trans }}</th><th>{{ 'Deletable'|trans }}</th><th>{{ 'Devices'|trans }}</th></tr></thead><tbody>
{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed local Symfony routes encode validated IDs and filters; device URL uses the local application mount and fixed host.php path. #}
{% for row in result.rows %}<tr><td><input type="checkbox" name="ids[]" value="{{ row.id }}" aria-label="{{ row.name }}"></td><td><a href="{{ path('inventory_device_template_definition_edit', {id:row.id}) }}">{{ row.name }}</a></td><td>{{ (row.class == '' ? 'Unassigned' : row.class)|trans }}</td><td>{{ row.id }}</td><td>{{ (row.hosts > 0 ? 'No' : 'Yes')|trans }}</td><td><a href="{{ legacyDevices ~ '?reset=true&host_template_id=' ~ row.id }}">{{ row.hosts }}</a></td></tr>{% else %}<tr><td colspan="6">{{ 'No device templates match these filters.'|trans }}</td></tr>{% endfor %}</tbody></table>
<button>{{ 'Delete'|trans }}</button><button formaction="{{ path('inventory_device_template_definition_action', {operation:'duplicate'}) }}">{{ 'Duplicate'|trans }}</button><button formaction="{{ path('inventory_device_template_definition_action', {operation:'sync'}) }}">{{ 'Sync Devices'|trans }}</button></form>
{# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed local Symfony routes encode validated IDs and filters; device URL uses the local application mount and fixed host.php path. #}
<nav>{% if filters.page > 1 %}<a rel="prev" href="{{ path('inventory_device_templates', filters|merge({page:filters.page-1})) }}">{{ 'Previous'|trans }}</a>{% endif %}<span>{{ 'Page %page%'|trans({'%page%':filters.page}) }}</span>{% if result.hasNext %}<a rel="next" href="{{ path('inventory_device_templates', filters|merge({page:filters.page+1})) }}">{{ 'Next'|trans }}</a>{% endif %}</nav></main>{% endblock %}
