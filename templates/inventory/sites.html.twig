{% extends 'base.html.twig' %}

{% block title %}{{ 'Sites'|trans({}, 'inventory') }} · Kadupul{% endblock %}

{% block body %}
<main>
    <h1>{{ 'Sites'|trans({}, 'inventory') }}</h1>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses fixed route names and encodes parameters; no user-supplied URI. #}
    <p><a href="{{ path('inventory_devices') }}">{{ 'Devices'|trans({}, 'inventory') }}</a></p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route and encoded validated list context. #}
    <p><a href="{{ path('inventory_site_create', {list: filters}) }}">{{ 'Add site'|trans({}, 'inventory') }}</a></p>
    <form method="get" action="{{ path('inventory_sites') }}" role="search">
        <label for="site-search">{{ 'Search by name, city, state or country'|trans({}, 'inventory') }}</label>
        <input id="site-search" type="search" name="q" value="{{ criteria.search }}" maxlength="200">
        <label for="site-direction">{{ 'Name order'|trans({}, 'inventory') }}</label>
        <select id="site-direction" name="direction">
            <option value="asc"{% if criteria.direction == 'asc' %} selected{% endif %}>{{ 'Ascending'|trans({}, 'inventory') }}</option>
            <option value="desc"{% if criteria.direction == 'desc' %} selected{% endif %}>{{ 'Descending'|trans({}, 'inventory') }}</option>
        </select>
        <label for="site-size">{{ 'Per page'|trans({}, 'inventory') }}</label>
        <select id="site-size" name="size">
            {% for size in [25, 50, 100] %}
            <option value="{{ size }}"{% if criteria.pageSize == size %} selected{% endif %}>{{ size }}</option>
            {% endfor %}
        </select>
        <button type="submit">{{ 'Apply'|trans({}, 'inventory') }}</button>
    </form>
    <p>{{ 'Device counts include only devices you can access. Select a site name to edit its name and notes.'|trans({}, 'inventory') }}</p>
    <table>
        <caption>{{ 'Sites and devices you can access at each site'|trans({}, 'inventory') }}</caption>
        <thead><tr><th scope="col">{{ 'Name'|trans({}, 'inventory') }}</th><th scope="col">{{ 'ID'|trans({}, 'inventory') }}</th><th scope="col">{{ 'Accessible devices'|trans({}, 'inventory') }}</th><th scope="col">{{ 'City'|trans({}, 'inventory') }}</th><th scope="col">{{ 'State'|trans({}, 'inventory') }}</th><th scope="col">{{ 'Country'|trans({}, 'inventory') }}</th></tr></thead>
        <tbody>
        {% for site in result.sites %}
            {% set siteLabel = site.name|trim == '' ? 'Unnamed site #%id%'|trans({'%id%': site.id}, 'inventory') : site.name %}
            <tr>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route with integer site ID and encoded validated list context. #}
                <td><a href="{{ path('inventory_site_edit', {id: site.id, list: filters}) }}">{{ siteLabel }}</a></td><td>{{ site.id }}</td>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses fixed route names and encodes parameters; no user-supplied URI. #}
                <td><a href="{{ path('inventory_devices', {site: site.id}) }}" aria-label="{{ 'Devices at %site%'|trans({'%site%': siteLabel}, 'inventory') }}">{{ site.visibleDevices }}</a></td>
                <td>{{ site.city }}</td><td>{{ site.state }}</td><td>{{ site.country }}</td>
            </tr>
        {% else %}
            <tr><td colspan="6">{{ 'No sites match these filters.'|trans({}, 'inventory') }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    <nav aria-label="{{ 'Site pages'|trans({}, 'inventory') }}">
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses fixed route names and encodes parameters; no user-supplied URI. #}
        {% if criteria.page > 1 %}<a rel="prev" href="{{ path('inventory_sites', filters|merge({page: criteria.page - 1})) }}">{{ 'Previous'|trans({}, 'inventory') }}</a>{% endif %}
        <span>{{ 'Page %page%'|trans({'%page%': criteria.page}, 'inventory') }}</span>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses fixed route names and encodes parameters; no user-supplied URI. #}
        {% if result.hasNext %}<a rel="next" href="{{ path('inventory_sites', filters|merge({page: criteria.page + 1})) }}">{{ 'Next'|trans({}, 'inventory') }}</a>{% endif %}
    </nav>
</main>
{% endblock %}
