{% extends 'base.html.twig' %}
{% block title %}{{ (operation == 'clear-statistics' ? 'Clear device statistics' : (operation == 'enable' ? 'Enable devices' : 'Disable devices'))|trans({}, 'inventory') }} · Kadupul{% endblock %}
{% block body %}
<main>
    <h1>{{ (operation == 'clear-statistics' ? 'Clear device statistics' : (operation == 'enable' ? 'Enable devices' : 'Disable devices'))|trans({}, 'inventory') }}</h1>
    <p>{{ (operation == 'clear-statistics' ? 'Reset response times, poll counts and availability for these devices. Graphs, historical data and device settings are retained. Statistics resume with the next poll.' : 'Confirm the polling state for these devices. Their graphs, data and other settings are retained.')|trans({}, 'inventory') }}</p>
    <p>{{ 'Affected remote collectors must be online. A failed operation may have changed remote devices; verify every selected device before retrying.'|trans({}, 'inventory') }}</p>
    <ul>{% for device in devices %}<li>{{ device.description }} (#{{ device.id }}) — {{ device.hostname }} — {{ (device.enabled ? 'Enabled' : 'Disabled')|trans({}, 'inventory') }}</li>{% endfor %}</ul>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_widget(form) }}
        <button type="submit">{{ (operation == 'clear-statistics' ? 'Confirm clearing statistics' : (operation == 'enable' ? 'Confirm enabling' : 'Confirm disabling'))|trans({}, 'inventory') }}</button>
    {{ form_end(form) }}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route and validated list context. #}
    <p><a href="{{ path('inventory_devices', filters) }}">{{ 'Cancel'|trans({}, 'inventory') }}</a></p>
</main>
{% endblock %}
