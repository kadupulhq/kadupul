{% extends '_item_delete.html.twig' %}
{% set domain = 'cdef' %}
{% set heading = t('Delete CDEF Item', {}, 'cdef') %}
{% set intro = t('Click Continue to delete the following CDEF Item.', {}, 'cdef') %}
{% set cancel_url = path('graph_cdef_edit', {id: cdef.id}) %}
{% block details %}
    <p>{{ 'CDEF Name: %name%'|trans({'%name%': cdef.name}, 'cdef') }}<br>
    <em>{{ (types[item.type] ?? 'Unknown')|trans({}, 'cdef') }}</em>: <strong>{{ item.type == 4 ? item.label|trans({}, 'cdef') : item.label }}</strong></p>
{% endblock %}
{# The CDEF item form renders its own wrapper around the revision field. #}
{% block fields %}{{ form_widget(form) }}{% endblock %}
