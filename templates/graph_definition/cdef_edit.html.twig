{% extends 'base.html.twig' %}

{% block title %}{{ cdef.id ? 'Edit CDEF'|trans({}, 'graph_definition') : 'Create CDEF'|trans({}, 'graph_definition') }}{% endblock %}

{% block body %}
<main>
    <h1>{{ cdef.id ? 'Edit CDEF'|trans({}, 'graph_definition') : 'Create CDEF'|trans({}, 'graph_definition') }}</h1>
    {{ form_start(form) }}{{ form_errors(form) }}{{ form_row(form.id) }}{{ form_row(form.name) }}
    <button type="submit">{{ 'Save CDEF'|trans({}, 'graph_definition') }}</button>{{ form_end(form) }}
    {% if cdef.id %}
        <h2>{{ 'CDEF preview'|trans({}, 'graph_definition') }}</h2>
        <pre>cdef={{ preview }}</pre>
        <h2>{{ 'CDEF items'|trans({}, 'graph_definition') }}</h2>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        <p><a href="{{ path('graph_cdef_item_edit', {cdefId: cdef.id, itemId: 0}) }}">{{ 'Add item'|trans({}, 'graph_definition') }}</a></p>
        <table><thead><tr><th>{{ 'Sequence'|trans({}, 'graph_definition') }}</th><th>{{ 'Item type'|trans({}, 'graph_definition') }}</th><th>{{ 'Value'|trans({}, 'graph_definition') }}</th><th>{{ 'Order'|trans({}, 'graph_definition') }}</th><th>{{ 'Actions'|trans({}, 'graph_definition') }}</th></tr></thead>
            <tbody>
            {% for item in cdef.items %}
                <tr><td>{{ loop.index }}</td><td>{{ ('type.' ~ item.type)|trans({}, 'graph_definition') }}</td><td>{{ item.type == 4 ? item.label|trans({}, 'graph_definition') : item.label }}</td>
                    <td>
                        {% if not loop.first or not loop.last %}
                            {% set itemIds = cdef.items|map(i => i.id)|json_encode %}
                            <form method="post" action="{{ path('graph_cdef_item_reorder', {cdefId: cdef.id}) }}">
                                <input type="hidden" name="order[items]" value="{{ itemIds }}">
                                {% if not loop.first %}<button name="order[moveUp]" value="{{ item.id }}">{{ 'Move up'|trans({}, 'graph_definition') }}</button>{% endif %}
                                {% if not loop.last %}<button name="order[moveDown]" value="{{ item.id }}">{{ 'Move down'|trans({}, 'graph_definition') }}</button>{% endif %}
                                <input type="hidden" name="order[_token]" value="{{ csrf_token('graph_cdef_edit') }}">
                            </form>
                        {% endif %}
                    </td>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                    <td><a href="{{ path('graph_cdef_item_edit', {cdefId: cdef.id, itemId: item.id}) }}">{{ 'Edit'|trans({}, 'graph_definition') }}</a>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                        <a href="{{ path('graph_cdef_item_delete', {cdefId: cdef.id, itemId: item.id}) }}">{{ 'Delete'|trans({}, 'graph_definition') }}</a></td></tr>
            {% else %}<tr><td colspan="5"><em>{{ 'No items'|trans({}, 'graph_definition') }}</em></td></tr>{% endfor %}
            </tbody>
        </table>
    {% endif %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
    <p><a href="{{ path('graph_cdefs') }}">{{ 'Back to CDEFs'|trans({}, 'graph_definition') }}</a></p>
</main>
{% endblock %}
