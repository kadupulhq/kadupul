{% extends '_action_confirm.html.twig' %}
{% set domain = 'cdef' %}
{% set heading = operation == 'delete' ? t('Delete CDEFs', {}, 'cdef') : t('Duplicate CDEFs', {}, 'cdef') %}
{% set intro = operation == 'delete' ? t('Click Continue to delete the following CDEFs.', {}, 'cdef') : t('Click Continue to duplicate the following CDEFs. You can optionally change the title format for the new CDEFs.', {}, 'cdef') %}
{% set used_message = t('CDEFs in use by a graph, template, aggregate or another CDEF cannot be deleted.', {}, 'cdef') %}
{% set cancel_url = path('graph_cdefs') %}
{% block extra_fields %}{% if form.title_format is defined %}{{ form_row(form.title_format) }}{% endif %}{% endblock %}
{% block items %}
    {% for cdef in cdefs %}<li>{{ cdef.name }}</li>{% endfor %}
{% endblock %}
