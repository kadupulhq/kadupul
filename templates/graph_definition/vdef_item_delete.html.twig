{% extends 'base.html.twig' %}

{% block title %}{{ 'Delete VDEF item'|trans({}, 'graph_definition') }} · Kadupul{% endblock %}

{% block body %}
<main>
    <h1>{{ 'Delete VDEF item'|trans({}, 'graph_definition') }}</h1>
    <p>{{ 'Continue to remove this item from %name%?'|trans({'%name%': vdef.name}, 'graph_definition') }}</p>
    <p><em>{{ item_type|trans({}, 'graph_definition') }}</em>: <strong>{{ item.label }}</strong></p>
    {{ form_start(form) }}{{ form_widget(form) }}<button type="submit">{{ 'Continue'|trans({}, 'graph_definition') }}</button>{{ form_end(form) }}
    <p><a href="{{ path('graph_vdef_edit', {id: vdef.id}) }}">{{ 'Cancel'|trans({}, 'graph_definition') }}</a></p>
</main>
{% endblock %}
