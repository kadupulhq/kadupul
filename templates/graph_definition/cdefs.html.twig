{% extends 'base.html.twig' %}
{% import '_list.html.twig' as list %}
{% block title %}{{ 'CDEFs'|trans({}, 'cdef') }} · Kadupul{% endblock %}
{% block body %}
<main>
    <h1>{{ 'CDEFs'|trans({}, 'cdef') }}</h1>
    {% if deleted %}<output>{{ 'CDEFs deleted.'|trans({}, 'cdef') }}</output>{% endif %}
    {% if duplicated %}<output>{{ 'CDEFs duplicated.'|trans({}, 'cdef') }}</output>{% endif %}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
    <p><a href="{{ path('graph_cdef_create') }}">{{ 'Add CDEF'|trans({}, 'cdef') }}</a></p>
    {% embed '_list_filter.html.twig' with {action: path('graph_cdefs')} %}
    {% block filters %}
        {% import '_list.html.twig' as list %}
        <label for="cdef-filter">{{ 'Search'|trans({}, 'cdef') }}</label>
        <input id="cdef-filter" name="filter" type="search" maxlength="200" value="{{ filters.filter }}">
        {{ list.rows_per_page('cdef-rows', 'CDEFs', {'-1': 'Default', '10': '10', '15': '15', '16': '16', '17': '17', '18': '18', '19': '19', '20': '20', '21': '21', '22': '22', '23': '23', '24': '24', '25': '25', '26': '26', '27': '27', '30': '30', '40': '40', '44': '44', '45': '45', '50': '50', '100': '100', '250': '250', '500': '500', '750': '750', '1000': '1000', '2000': '2000', '3000': '3000', '4000': '4000', '5000': '5000'}, filters.rows, 'cdef', defaultRows) }}
        <input type="hidden" name="sort_column" value="{{ filters.sort_column }}">
        <input type="hidden" name="sort_direction" value="{{ filters.sort_direction }}">
        <input type="hidden" name="has_graphs" value="false">
        <label><input type="checkbox" name="has_graphs" value="true"{% if filters.has_graphs == 'true' %} checked{% endif %}> {{ 'Has Graphs'|trans({}, 'cdef') }}</label>
        <button type="submit">{{ 'Go'|trans({}, 'cdef') }}</button>
        {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
        <a href="{{ path('graph_cdefs', {clear: 1}) }}">{{ 'Clear'|trans({}, 'cdef') }}</a>
    {% endblock %}
    {% endembed %}
    {% set selectionLimit = constant('Kadupul\\GraphDefinition\\Application\\Port\\CdefStore::MAX_SELECTION') %}
    <p id="cdef-selection-help">{{ 'Select up to %count% CDEFs at a time.'|trans({'%count%': selectionLimit}, 'cdef') }}</p>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
    <form method="get" action="{{ path('graph_cdef_action', {operation: 'delete'}) }}" aria-describedby="cdef-selection-help">
        <table class="cactiTable">
            <caption>{{ 'CDEFs'|trans({}, 'cdef') }}</caption>
            <thead><tr class="tableHeader">
                <th scope="col">{{ 'Select'|trans({}, 'cdef') }}</th>
                {{ list.sort_header('graph_cdefs', filters, 'name', 'CDEF Name', 'cdef') }}
                <th scope="col">{{ 'Deletable'|trans({}, 'cdef') }}</th>
                {{ list.sort_header('graph_cdefs', filters, 'graphs', 'Graphs Using', 'cdef') }}
                {{ list.sort_header('graph_cdefs', filters, 'templates', 'Templates Using', 'cdef') }}
                <th scope="col">{{ 'CDEFs Using'|trans({}, 'cdef') }}</th>
            </tr></thead>
            <tbody>
            {% for cdef in page.cdefs %}
                <tr>
                    {{ list.selection_cell(cdef.id, cdef.name, 'cdef', 'cdef-select-' ~ cdef.id, loop.index > selectionLimit) }}
                    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                    <td><a href="{{ path('graph_cdef_edit', {id: cdef.id}) }}">{{ cdef.name }}</a></td>
                    <td>{{ (cdef.deletable ? 'Yes' : 'No')|trans({}, 'cdef') }}</td>
                    <td>{{ cdef.graphs }}</td>
                    <td>{{ cdef.templates }}</td>
                    <td>{{ cdef.referencingCdefs }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6"><em>{{ 'No CDEFs'|trans({}, 'cdef') }}</em></td></tr>
            {% endfor %}
            </tbody>
        </table>
        <button type="submit">{{ 'Delete selected'|trans({}, 'cdef') }}</button>
        {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Fixed Symfony route. #}
        <button type="submit" formaction="{{ path('graph_cdef_action', {operation: 'duplicate'}) }}">{{ 'Duplicate selected'|trans({}, 'cdef') }}</button>
    </form>
    {{ list.pagination('graph_cdefs', filters, filters.page, page.hasPrevious, page.hasNext, 'CDEF pages', 'Page %page% of %total% CDEFs', {'%page%': filters.page, '%total%': page.total}, 'cdef') }}
</main>
{% endblock %}
