{% extends 'base.html.twig' %}
{% import '_list.html.twig' as list %}

{% block title %}{{ 'VDEFs'|trans({}, 'graph_definition') }} · Kadupul{% endblock %}

{% block body %}
<main>
    <h1>{{ 'VDEFs'|trans({}, 'graph_definition') }}</h1>
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
    <p><a href="{{ path('graph_vdef_create') }}">{{ 'Create VDEF'|trans({}, 'graph_definition') }}</a></p>
    {% embed '_list_filter.html.twig' with {action: path('graph_vdefs'), role: 'search'} %}
    {% block filters %}
        {% import '_list.html.twig' as list %}
        <label for="vdef-filter">{{ 'Search VDEFs'|trans({}, 'graph_definition') }}</label>
        <input id="vdef-filter" type="search" name="filter" value="{{ criteria.search }}" maxlength="255">
        <label for="vdef-sort">{{ 'Sort by'|trans({}, 'graph_definition') }}</label>
        <select id="vdef-sort" name="sort">
            {% for value, label in {name: 'VDEF name', graphs: 'Graphs using', templates: 'Templates using'} %}
                <option value="{{ value }}"{% if criteria.sort == value %} selected{% endif %}>{{ label|trans({}, 'graph_definition') }}</option>
            {% endfor %}
        </select>
        <label for="vdef-direction">{{ 'Order'|trans({}, 'graph_definition') }}</label>
        <select id="vdef-direction" name="direction">
            <option value="asc"{% if criteria.direction == 'asc' %} selected{% endif %}>{{ 'Ascending'|trans({}, 'graph_definition') }}</option>
            <option value="desc"{% if criteria.direction == 'desc' %} selected{% endif %}>{{ 'Descending'|trans({}, 'graph_definition') }}</option>
        </select>
        {{ list.rows_per_page('vdef-rows', 'Rows', {30: '30', 50: '50', 100: '100'}, criteria.pageSize, 'graph_definition') }}
        <label><input type="checkbox" name="has_graphs" value="true"{% if criteria.hasGraphs %} checked{% endif %}>{{ 'Has graphs'|trans({}, 'graph_definition') }}</label>
        <button type="submit">{{ 'Apply'|trans({}, 'graph_definition') }}</button>
    {% endblock %}
    {% endembed %}
    <form method="get" action="{{ path('graph_vdef_action', {operation: 'delete'}) }}">
        <table class="cactiTable">
            <caption>{{ 'Variable definitions and graph usage'|trans({}, 'graph_definition') }}</caption>
            <thead><tr class="tableHeader"><th scope="col">{{ 'Select'|trans({}, 'graph_definition') }}</th><th scope="col">{{ 'VDEF name'|trans({}, 'graph_definition') }}</th><th scope="col">{{ 'Deletable'|trans({}, 'graph_definition') }}</th><th scope="col">{{ 'Graphs using'|trans({}, 'graph_definition') }}</th><th scope="col">{{ 'Templates using'|trans({}, 'graph_definition') }}</th><th scope="col">{{ 'Referenced by VDEFs'|trans({}, 'graph_definition') }}</th></tr></thead>
            <tbody>
            {% for vdef in rows %}
                <tr>
                    {{ list.selection_cell(vdef.id, vdef.name, 'graph_definition') }}
    {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- Symfony path() uses a fixed route and encodes parameters; no supplied URI. #}
                    <td><a href="{{ path('graph_vdef_edit', {id: vdef.id}) }}">{{ vdef.name }}</a></td>
                    <td>{{ vdef.inUse ? 'No'|trans({}, 'graph_definition') : 'Yes'|trans({}, 'graph_definition') }}</td>
                    <td>{{ vdef.graphs }}</td><td>{{ vdef.templates }}</td><td>{{ vdef.referencingVdefs }}</td>
                </tr>
            {% else %}<tr><td colspan="6">{{ 'No VDEFs match these filters.'|trans({}, 'graph_definition') }}</td></tr>{% endfor %}
            </tbody>
        </table>
        <button type="submit">{{ 'Delete selected VDEFs'|trans({}, 'graph_definition') }}</button>
        <button type="submit" formaction="{{ path('graph_vdef_action', {operation: 'duplicate'}) }}">{{ 'Duplicate selected VDEFs'|trans({}, 'graph_definition') }}</button>
    </form>
    {{ list.pagination('graph_vdefs', {filter: criteria.search, sort: criteria.sort, direction: criteria.direction, rows: criteria.pageSize, has_graphs: criteria.hasGraphs ? 'true' : 'false'}, page, page > 1, page < pages, 'VDEF pages', 'Page %page% of %pages%', {'%page%': page, '%pages%': pages}, 'graph_definition') }}
</main>
{% endblock %}
