{% extends 'base.html.twig' %}

{% block title %}{{ 'VDEF Item'|trans({}, 'graph_definition') }} · Kadupul{% endblock %}

{% block body %}
<main>
    <h1>{{ vdef.name }} — {{ form.vars.value.id ? 'Edit item'|trans({}, 'graph_definition') : 'New item'|trans({}, 'graph_definition') }}</h1>
    <section aria-labelledby="vdef-preview"><h2 id="vdef-preview">{{ 'VDEF Preview'|trans({}, 'graph_definition') }}</h2><pre>vdef={{ preview }}</pre></section>
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit">{{ 'Save item'|trans({}, 'graph_definition') }}</button>
    {{ form_end(form) }}
    <script>
        document.getElementById('vdef_item_type').addEventListener('change', event => {
            const target = new URL(window.location.href);
            target.searchParams.set('type', event.currentTarget.value);
            window.location.assign(target);
        });
    </script>
    <p><a href="{{ path('graph_vdef_edit', {id: vdef.id}) }}">{{ 'Cancel'|trans({}, 'graph_definition') }}</a></p>
</main>
{% endblock %}
