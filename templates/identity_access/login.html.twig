{# Sections render around native hooks. Markup values come only from native
   html_escape() or CactiSecureHeaders, preserving legacy entity/charset rules. #}
{% block begin %}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html lang='{{ locale }}'>
<head>
{% endblock %}
{% block form_start %}
</head>
<body class='loginBody'>
    <div class='loginLeft'></div>
    <div class='loginCenter'>
    <div class='loginArea'>
        <div class='cactiLoginLogo'></div>
        <h1 class='loginHeading'>{{ heading }}</h1>
        <form id='login' name='login' method='post' action='{{ target }}'>
            <input type='hidden' name='action' value='login'>
{% endblock %}
{% block credentials %}
            <div class='loginTitle'><p>{{ instructions }}</p></div>
            <div class='cactiLogin'>
                <table class='cactiLoginTable'>
                    <tr>
                        <td><label for='login_username'>{{ usernameLabel }}</label></td>
                        <td><input type='text' class='ui-state-default ui-corner-all' id='login_username' name='login_username' value='{{ username }}' placeholder='{{ usernameLabel }}'></td>
                    </tr>
                    <tr>
                        <td><label for='login_password'>{{ passwordLabel }}</label></td>
                        <td><input type='password' autocomplete='current-password' class='ui-state-default ui-corner-all' id='login_password' name='login_password' placeholder='********'></td>
                    </tr>
{% endblock %}
{% block realms %}
                    <tr>
                        <td><label for='realm'>{{ label }}</label></td>
                        <td><select id='realm' name='realm' class='ui-state-default ui-corner-all'>
                            {% for choice in choices %}
                            <option value='{{ choice.value }}'{% if choice.selected %} selected="selected"{% endif %}>{{ choice.name }}</option>
                            {% endfor %}
                        </select></td>
                    </tr>
{% endblock %}
{% block remember %}
                    <tr>
                        <td colspan='2'>
                            <input style='vertical-align:-3px;' type='checkbox' id='remember_me' name='remember_me'{% if checked %} checked{% endif %}>
                            <label for='remember_me'>{{ label }}</label>
                        </td>
                    </tr>
{% endblock %}
{% block submit %}
                    <tr><td colspan='2'><input type='submit' class='ui-button ui-corner-all ui-widget' value='{{ label }}'></td></tr>
                </table>
            </div>
{% endblock %}
{% block result %}
        </form>
        <div class='loginErrors'>{{ error }}</div>
    </div>
    <div class='versionInfo'>{{ version }}</div>
    </div>
    <div class='loginRight'></div>
    {# nosemgrep: generic.html-templates.security.unquoted-attribute-var.unquoted-attribute-var -- CactiSecureHeaders::getNonceAttribute() emits the complete quoted nonce attribute as Markup. #}
    <script type='text/javascript' {{ nonceAttribute }}>
    var storage = Storages.localStorage;

    $(function() {
        if (storage.isSet('user_realm')) {
            var preferredRealm = storage.get('user_realm');
        } else {
            var preferredRealm = null;
        }
        if (preferredRealm == null) {
            preferredRealm = $('#realm option:selected').val();
        }
        if ($('#realm').length) {
            if (preferredRealm !== null) {
                $('#realm').val(preferredRealm);
                if ($('#realm').selectmenu('instance') !== undefined) {
                    $('#realm').selectmenu('refresh');
                }
            }
        }
        $('#login').on('submit', function(event) {
            event.preventDefault();
            if ($('#realm').length) {
                storage.set('user_realm', $('#realm').val());
            }
            $('#login').off('submit').trigger('submit');
        });
        $('body').css('height', $(window).height());
        $('.loginLeft').css('width',parseInt($(window).width()*0.33)+'px');
        $('.loginRight').css('width',parseInt($(window).width()*0.33)+'px');
        {% if focusUsername %}
        $('#login_username').focus();
        {% else %}
        $('#login_password').focus();
        {% endif %}
    });
    </script>
{% endblock %}
{% block end %}
</body>
</html>
{% endblock %}
