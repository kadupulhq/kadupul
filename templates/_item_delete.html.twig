Confirmation page for deleting one child item. The caller sets domain,
cancel_url, heading and intro (t() messages, so translation:extract finds
them in the caller), fills the details block with the item summary, and
sets blocked and blocked_message when the parent is read only. `form` carries the
revision field; override fields when the form needs a different widget.
#}
{% extends 'base.html.twig' %}
{% set blocked = blocked ?? false %}
{% block title %}{{ heading|trans }} · Kadupul{% endblock %}
{% block body %}
<main>
    <h1>{{ heading|trans }}</h1>
    <p>{{ intro|trans }}</p>
    {% block details %}{% endblock %}
    {% if blocked %}<p role="alert">{{ blocked_message|trans }}</p>{% endif %}
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {% block fields %}{{ form_widget(form.revision) }}{% endblock %}
        {% if not blocked %}<button type="submit">{{ 'Continue'|trans({}, domain) }}</button>{% endif %}
        {# nosemgrep: generic.html-templates.security.var-in-href.var-in-href -- cancel_url is path() output from the caller's fixed route. #}
        <a href="{{ cancel_url }}">{{ 'Cancel'|trans({}, domain) }}</a>
    {{ form_end(form) }}
</main>
{% endblock %}
